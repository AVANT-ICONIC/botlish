# The portable Hello World (CONTEXT-TRAITS.md): hello() declares no context;
# std::io::print_line requires the std::io::IO context trait; the installed
# std::linux::io::LinuxIO is the one context that implements it, so the call
# compiles to a direct call of std::linux::io::write_text -- one write(2) of
# "Hello, world!\n" to descriptor 1, with no libc in the path.
import std::io
import std::linux::io

fn hello() errors std::io::WriteFailed:
    std::io::print_line("Hello, world!")

with context std::linux::io::create()

hello():
    on std::io::WriteFailed:
        unit
