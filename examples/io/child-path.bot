# Generic paths (CONTEXT-TRAITS.md): child() is written against the portable
# std::io::path::Path trait and specialized for std::linux::path::LinuxPath, so
# path.concat compiles to a direct call of std::linux::path::concat and the
# result is the same LinuxPath witness, with no wrapper.
import std::io::path
import std::linux::path
import std::str
import type std::io::path::Path

fn child(path: Path) -> Path errors std::io::path::NotAPath:
    path.concat("child")

fn add_config(path: Path) -> Path errors std::io::path::NotAPath:
    path.concat(".config").concat("awesome_tool")

fn run(value: str) -> str errors std::io::path::NotAPath:
    std::linux::path::validate(value)
    home = add_config(value)
    std::str::concat(std::str::concat(std::io::path::text(child(value)), " "), std::io::path::text(home))

run("/home/me"):
    on std::io::path::NotAPath:
        "not a path"
