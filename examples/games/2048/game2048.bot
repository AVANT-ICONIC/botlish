# game2048.bot -- a deterministic 2048 engine (2048-ENGINE-WORKLOAD.md).
#
# The board is four rows of four cells; a cell is `empty` (0) or a tile, a
# power of two from 2 up. A move looks at the board from its direction as
# four lines, each starting at the cell its tiles slide toward, slides
# every line, and looks back: left reads the rows as they are, right reads
# each row backwards, up reads the columns, down each column backwards.
# Sliding a line drops its empty cells, merges each pair of equal
# neighbours once, from the start of the line on (a merged tile never
# merges again in the same move), and fills the line up with empty cells
# again. Each merge scores the tile it produces.
#
# Nothing here is random. A caller playing the usual game picks one of the
# board's `empty_positions` and a `SpawnTile` itself, and `spawn` places it.
import std::list
import std::mutable_vector

# The value of an empty cell.
empty = 0

# The number of rows of a board, and of cells of a row.
size = 4

# A row or column index.
type Coordinate = Int in 0..3

struct Position:
    row: Coordinate
    column: Coordinate

enum Direction:
    Left,
    Right,
    Up,
    Down,

# The tiles a spawn may place.
enum SpawnTile:
    Two,
    Four,

# Four rows of four cells, each empty or a tile. Only this module builds a
# Board (`empty_board`, `board`, and the moves and spawns below), so every
# Board has that shape.
opaque struct Board:
    rows: List[List[int]]

# A game in progress: the board and the score so far.
struct Game:
    board: Board
    score: int

# A line after a slide, and the sum of the tiles its merges produced.
struct Slide:
    cells: List[int]
    score: int

# The outcome of a move: the game after it, the score the move gained, and
# whether it changed the board (only a move that changed it is followed by
# a spawn).
struct Move:
    game: Game
    gained: int
    changed: bool

# `board` was given rows that are not four rows of four empty cells or
# tiles.
error InvalidBoard

# `spawn` was asked to place a tile on a cell that holds one.
error CellOccupied

# ---------------------------------------------------------------------------
# Tiles and lines

# Whether VALUE is a tile: 2, 4, 8, ...
fn tile?(value: int) -> bool:
    fn reached?(power: int) -> bool:
        if power >= value:
            power == value
        else:
            reached?(power * 2)
    reached?(2)

# The value of the tile SPAWN places.
fn value(spawn: SpawnTile) -> int:
    if spawn == SpawnTile::Two:
        2
    else:
        4

# TILES, a line without empty cells, with each pair of equal neighbours
# merged once, from the start on, and the sum of the merged tiles.
fn merged(tiles: List[int]) -> Slide:
    # The tiles from position I on, merged, after DONE. (nomethod: I is a
    # position, not a receiver.)
    nomethod fn from(i: int, done: Slide) -> Slide:
        if i >= std::list::length(tiles):
            return done
        tile = tiles.get(i, empty)
        if tiles.get(i + 1, empty) == tile:
            from(i + 2, Slide {cells: done.cells.append(tile * 2), score: done.score + tile * 2})
        else:
            from(i + 1, Slide {cells: done.cells.append(tile), score: done.score})
    from(0, Slide {cells: [], score: 0})

# CELLS slid toward their start: the tiles, merged, then empty cells up to
# the line's length.
fn slide(cells: List[int]) -> Slide:
    tiles = loop cell in cells:
        if cell == empty:
            continue
        cell
    merge = tiles.merged()
    padded = loop i from 0 to std::list::length(cells):
        merge.cells.get(i, empty)
    Slide {cells: padded, score: merge.score}

# LINE backwards.
fn reversed(line: List[int]) -> List[int]:
    n = std::list::length(line)
    loop i from 0 to n:
        line.get(n - 1 - i, empty)

fn each_reversed(lines: List[List[int]]) -> List[List[int]]:
    loop line in lines:
        line.reversed()

# The columns of ROWS, as rows.
fn transposed(rows: List[List[int]]) -> List[List[int]]:
    loop column from 0 to size:
        loop row in rows:
            row.get(column, empty)

# The board's ROWS seen from DIRECTION: four lines, each starting at the
# cell its tiles slide toward.
fn lines_toward(rows: List[List[int]], direction: Direction) -> List[List[int]]:
    if direction == Direction::Left:
        rows
    elif direction == Direction::Right:
        rows.each_reversed()
    elif direction == Direction::Up:
        rows.transposed()
    else:
        rows.transposed().each_reversed()

# The rows of the board that, seen from DIRECTION, has LINES: the inverse
# of lines_toward.
fn rows_from(lines: List[List[int]], direction: Direction) -> List[List[int]]:
    if direction == Direction::Left:
        lines
    elif direction == Direction::Right:
        lines.each_reversed()
    elif direction == Direction::Up:
        lines.transposed()
    else:
        lines.each_reversed().transposed()

# LINE with the cell at INDEX replaced by VALUE.
fn replaced(line: List[int], index: int, value: int) -> List[int]:
    loop cell in line and i from 0 to std::list::length(line):
        if i == index:
            value
        else:
            cell

# The sum of SCORES.
fn total(scores: List[int]) -> int:
    fn from(i: int) -> int:
        if i >= std::list::length(scores):
            return 0
        scores.get(i, 0) + from(i + 1)
    from(0)

# ---------------------------------------------------------------------------
# Boards

fn empty_board() -> Board:
    rows = loop r from 0 to size:
        loop c from 0 to size:
            empty
    Board {rows: rows}

fn cell?(value: int) -> bool:
    value == empty or value.tile?()

fn board_row?(row: List[int]) -> bool:
    std::list::length(row) == size and row.all?(cell?)

# Whether ROWS are four rows of four cells, each empty or a tile.
fn board_rows?(rows: List[List[int]]) -> bool:
    std::list::length(rows) == size and rows.all?(board_row?)

# The board whose rows are ROWS, top to bottom, each left to right.
fn board(rows: List[List[int]]) -> Board errors InvalidBoard:
    if not rows.board_rows?():
        fail InvalidBoard
    Board {rows: rows}

# BOARD's rows, top to bottom, each left to right.
fn rows(board: Board) -> List[List[int]]:
    board.rows

# The cell of BOARD at AT.
fn cell(board: Board, at: Position) -> int:
    board.rows.get(at.row, []).get(at.column, empty)

fn no_positions() -> MutableVector[Position]:
    std::mutable_vector::from_list([])

# The positions of BOARD's empty cells, row by row.
fn empty_positions(board: Board) -> List[Position]:
    found = no_positions()
    loop r from 0 to size:
        loop c from 0 to size:
            at = Position {row: r, column: c}
            if board.cell(at) == empty:
                found.push(at)
    loop at in found:
        at

# Whether some cell of BOARD holds TILE or a larger one.
fn reached?(board: Board, tile: int) -> bool:
    loop row in board.rows:
        loop cell in row:
            if cell >= tile:
                return true
    false

# ---------------------------------------------------------------------------
# Games

fn new_game() -> Game:
    Game {board: empty_board(), score: 0}

# GAME after a move toward DIRECTION.
fn move(game: Game, direction: Direction) -> Move:
    rows = game.board.rows
    slides = loop line in rows.lines_toward(direction):
        line.slide()
    lines = loop s in slides:
        s.cells
    moved = lines.rows_from(direction)
    scores = loop s in slides:
        s.score
    gained = scores.total()
    Move {game: Game {board: Board {rows: moved}, score: game.score + gained}, gained: gained, changed: moved != rows}

# GAME with TILE placed on the empty cell at AT.
fn spawn(game: Game, at: Position, tile: SpawnTile) -> Game errors CellOccupied:
    if game.board.cell(at) != empty:
        fail CellOccupied
    old = game.board.rows
    rows = loop row in old and r from 0 to std::list::length(old):
        if r == at.row:
            row.replaced(at.column, tile.value())
        else:
            row
    Game {board: Board {rows: rows}, score: game.score}

# Whether some cell of ROWS is empty.
fn has_empty?(rows: List[List[int]]) -> bool:
    loop row in rows:
        loop cell in row:
            if cell == empty:
                return true
    false

# Whether two neighbouring cells of some line of LINES are equal.
fn equal_neighbours?(lines: List[List[int]]) -> bool:
    loop line in lines:
        loop i from 1 to std::list::length(line):
            if line.get(i - 1, empty) == line.get(i, empty):
                return true
    false

# Whether GAME is over: no cell is empty and no move can merge two tiles.
fn game_over?(game: Game) -> bool:
    rows = game.board.rows
    not rows.has_empty?() and not rows.equal_neighbours?() and not rows.transposed().equal_neighbours?()
