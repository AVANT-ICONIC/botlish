# numeric-domains.bot -- ABI numeric domains (ABI-NUMERIC-DOMAINS.md):
#
#   ordinary computation in Int
#       --std::abi::u8(...), std::abi::i32(...), std::abi::usize(...)-->   ABI numeric domain
#       --std::abi::x86_64::from_u8(...), from_i32(...), ...-->   Register64 transport
#
# An ABI numeric value is an ordinary Int plus the static proof that it lies
# in its domain. std::abi::u8(255) is not an 8-bit integer that wraps: its value
# is the Int 255, `x.value + 1` is the Int 256, and the only way back into
# U8 is the checked creator, which reports AbiIntegerAboveRange instead of
# wrapping to 0. Pure Botlish: runs on every backend (nothing here makes a
# syscall).
#
# expect: [255, "above", 256, [-1, -1], true, 18446744073709551615]

import std::abi
import std::abi::x86_64

# The next U8 after x, if there is one: computed in Int, re-checked into the
# domain. BelowRange needs no handler: x.value + 1 >= 1 is proven from U8's
# declared domain.
fn next_u8(x: std::abi::U8):
    r = std::abi::u8(x.value + 1):
        on std::abi::AbiIntegerAboveRange:
            return "above"
    r.value

x = std::abi::u8(255)

# Signed values are sign-extended into a register word: I32 -1 travels as
# 0xffffffffffffffff, whose signed reading (to_int) is -1.
fd = std::abi::i32(0 - 1)
reg = std::abi::x86_64::from_i32(fd)

# Usize is the full unsigned address-width domain (64 bits on x86-64):
# 2^64 - 1 is a valid value, and it travels as the same 64 bits as I64 -1.
len = std::abi::usize(18446744073709551615)
same_bits = std::abi::x86_64::from_usize(len) == std::abi::x86_64::from_i64(std::abi::i64(0 - 1))

[x.value, next_u8(x), x.value + 1, [fd.value, std::abi::x86_64::to_int(reg)], same_bits, len.value]
