# sha256.bot -- SHA-256 of Botlish bytes, over the BoringSSL binding
# (C-FFI.md). `digest` exposes DATA to C for reading, with no copy, and a
# fresh 32-byte MutableBytes for writing: C writes a private copy of it, which
# the call returns as its `out` (the caller's own value never changes).
import std::abi
import std::abi::bytes
import boringssl

# The SHA-256 digest of DATA: 32 bytes.
fn digest(data: std::abi::bytes::Bytes) -> std::abi::bytes::Bytes:
    written = data.SHA256(std::abi::bytes::length(data).value, std::abi::bytes::zeroed(std::abi::usize(32)))
    std::abi::bytes::freeze(written.out)
