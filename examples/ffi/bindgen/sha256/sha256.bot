# sha256.bot -- SHA-256 of Botlish bytes over the GENERATED BoringSSL
# binding (C-BINDGEN.md, "BoringSSL"): boringssl::sha2 is generated from
# include/openssl/sha2.h of the pinned release for the symbol-prefixed build,
# so its SHA256 links botlish_bssl_SHA256, with the profile's contract
# (data read noescape, out write noescape, the result an alias of out).
# `digest` exposes DATA to C for reading, with no copy, and a fresh 32-byte
# MutableBytes for writing: C writes a private copy of it, which the call
# returns as its `out`.
import abi
import abi::bytes
import boringssl::sha2

# The SHA-256 digest of DATA: 32 bytes.
fn digest(data: abi::bytes::Bytes) -> abi::bytes::Bytes:
    written = data.SHA256(abi::bytes::length(data).value, abi::bytes::zeroed(abi::usize(32)))
    abi::bytes::freeze(written.out)
