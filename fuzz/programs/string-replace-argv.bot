# string-replace-argv.bot -- the string_replace example as an
# input-driven program: haystack, needle and replacement are argv()[1..3]
# (missing arguments default to "", which per the example's own contract
# leaves the haystack unchanged or returns it as-is).
#
# Fuzz-campaign program (FUZZING-ARGV-PROGRAMS.md), not an example: the
# definitions are copied verbatim from examples/stdlib/string_replace.bot;
# only the driver reads argv().
#
# Behavior contract:
#   * any arguments, valid UTF-8  -> replace(a1, a2, a3) with "" for
#     missing ones (empty needle -> haystack unchanged, per the example)
#   * invalid UTF-8 anywhere      -> replace("", "", "") -> ""
import list
import str

# true if needle occurs in haystack starting at index.
fn matches_at(haystack, needle, index) errors LowerUnderrun, UpperOverrun:
    end = index + str::length(needle)
    if end > str::length(haystack):
        return false

    str::substring(haystack, index, end) == needle

# haystack from index on with its matches replaced, appended to done;
# unmatched text from run_start up to index has not been copied yet.
fn replace_from(haystack, needle, replacement, index, run_start, done) errors LowerUnderrun, UpperOverrun:
    if index + str::length(needle) > str::length(haystack):
        return str::concat(done, str::substring(haystack, run_start, str::length(haystack)))

    if matches_at(haystack, needle, index):
        copied = str::concat(done, str::substring(haystack, run_start, index))
        after = index + str::length(needle)
        return replace_from(haystack, needle, replacement, after, after, str::concat(copied, replacement))

    replace_from(haystack, needle, replacement, index + 1, run_start, done)

fn replace(haystack, needle, replacement) errors LowerUnderrun, UpperOverrun:
    if str::length(needle) == 0:
        return haystack

    replace_from(haystack, needle, replacement, 0, 0, "")

# Argument i of the captured vector, or "" when it does not exist.
fn argument(args, index):
    if list::length(args) > index:
        list::get(args, index, "")
    else:
        ""

args = argv():
    on InvalidArgumentEncoding:
        []

result = replace(argument(args, 1), argument(args, 2), argument(args, 3)):
    on LowerUnderrun:
        ""
    on UpperOverrun:
        ""
result
