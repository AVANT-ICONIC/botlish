# string-reverse-argv.bot -- the string_reverse example as an
# input-driven program: the text to reverse is argv()[1].
#
# Fuzz-campaign program (FUZZING-ARGV-PROGRAMS.md), not an example: the
# definitions are copied verbatim from examples/stdlib/string_reverse.bot;
# only the driver reads argv().
#
# Behavior contract:
#   * no argument             -> reverse_chars("")
#   * valid UTF-8 argument    -> reverse_chars(argument)
#   * invalid UTF-8 anywhere  -> reverse_chars("")
import list
import str

# The characters of text from index on, reversed, followed by reversed.
fn reverse_from(text, index, reversed) errors LowerUnderrun, UpperOverrun:
    if index == str::length(text):
        return reversed

    character = str::substring(text, index, index + 1)
    reverse_from(text, index + 1, str::concat(character, reversed))

fn reverse_chars(text) errors LowerUnderrun, UpperOverrun:
    reverse_from(text, 0, "")

args = argv():
    on InvalidArgumentEncoding:
        []

text = if list::length(args) > 1:
    list::get(args, 1, "")
else:
    ""

result = reverse_chars(text):
    on LowerUnderrun:
        ""
    on UpperOverrun:
        ""
result
