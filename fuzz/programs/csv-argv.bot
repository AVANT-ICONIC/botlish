# csv-argv.bot -- the csv example as an input-driven program: the CSV text
# is the first process argument (argv()[1]), not a literal.
#
# This is a fuzz-campaign program (FUZZING-ARGV-PROGRAMS.md), not an
# example: the function definitions below are copied verbatim from
# examples/stdlib/csv.bot (same names, same bodies) and only the driver
# differs -- it reads argv() instead of the fixed sample string. The
# InvalidArgumentEncoding handler mirrors ARGV.md's documented pattern.
#
# Behavior contract (the differential oracle's baseline):
#   * no argument (or only argv[0])        -> csv_parse("")
#   * any argument bytes, valid UTF-8      -> csv_parse(argument)
#   * invalid UTF-8 anywhere in argv       -> csv_parse("") (the fallback
#     vector is [], so there is no first argument)
#   * a scan error (impossible by construction, as in the example)  -> []
#
# FZ-001 fix (this file only; the example keeps its documented valid-CSV
# contract): scan_quoted ends at end-of-text instead of walking past it,
# so an unterminated quoted field yields the text accumulated so far and
# the parse terminates. Valid inputs parse exactly as before (the new
# branch fires only where the old code recursed forever).
import std::list
import std::str

# The character at index as text, or "" past the end.
fn peek(text, index) errors LowerUnderrun:
    if index >= std::str::length(text):
        return ""

    text.substring(index, index + 1)

# true if the character at index is a double quote (false past the end).
fn quote_at?(text, index) errors IndexNotFound:
    index < std::str::length(text) and text.char_at(index) == '"'

# An unquoted field that started at start, scanned up to index:
# {field, index of the "," or "\n" that ends it, or the end}.
fn scan_unquoted(text, start, index) errors IndexNotFound, LowerUnderrun, UpperOverrun:
    if index < std::str::length(text):
        character = text.char_at(index)
        if character != ',' and character != '\n':
            return text.scan_unquoted(start, index + 1)

    {field: text.substring(start, index), index: index}

# A quoted field whose decoded content so far is field, scanned from index
# (inside the quotes): {field, index just after the closing quote}. A
# doubled quote stands for one: the first quote's own text is kept.
# FZ-001: end of text ends the field (the example's original walked past
# the end forever on an unterminated quote).
fn scan_quoted(text, index, field) errors IndexNotFound, LowerUnderrun:
    if index >= std::str::length(text):
        return {field: field, index: index}

    character = text.peek(index)
    if text.quote_at?(index):
        if text.quote_at?(index + 1):
            return text.scan_quoted(index + 2, field.concat(character))

        return {field: field, index: index + 1}

    text.scan_quoted(index + 1, field.concat(character))

# The field starting at index: {field, index just after it}.
fn scan_field(text, index) errors IndexNotFound, LowerUnderrun, UpperOverrun:
    if text.quote_at?(index):
        return text.scan_quoted(index + 1, "")

    text.scan_unquoted(index, index)

# The rest of the record whose fields so far are fields, from index:
# {fields, stop: index just after the record's "\n", or the end}.
fn scan_record(text, index, fields) errors IndexNotFound, LowerUnderrun, UpperOverrun:
    scanned = text.scan_field(index)
    more = fields.append(scanned.field)
    stop = scanned.index
    if stop < std::str::length(text):
        delimiter = text.char_at(stop)
        if delimiter == ',':
            return text.scan_record(stop + 1, more)

        if delimiter == '\n':
            return {fields: more, stop: stop + 1}

    {fields: more, stop: stop}

# The records from index on, appended to records.
fn scan_records(text, index, records) errors IndexNotFound, LowerUnderrun, UpperOverrun:
    if index >= std::str::length(text):
        return records

    scanned = text.scan_record(index, [])
    text.scan_records(scanned.stop, records.append(scanned.fields))

fn csv_parse(text) errors IndexNotFound, LowerUnderrun, UpperOverrun:
    text.scan_records(0, [])

args = argv():
    on InvalidArgumentEncoding:
        []

text = if std::list::length(args) > 1:
    std::list::get(args, 1, "")
else:
    ""

result = csv_parse(text):
    on IndexNotFound:
        []
    on LowerUnderrun:
        []
    on UpperOverrun:
        []
result
