# emit.tcl -- the generated artifacts of a binding model (C-BINDGEN.md,
# "Generated source", "The shim", "Manifest", "Report").
#
#   ::cbind::emit::files MODEL   a dict RELATIVE-PATH -> TEXT
#
# for one profile and target:
#
#   NS/ctypes.bot          the C type identities (one opaque struct per C tag
#                          a bound signature points to) and the converters
#                          that type the constants
#   NS/MODULE.bot          per public header: its constants and the externs
#                          of its directly linkable APIs (direct and alias)
#   NS/thunks/MODULE.bot   per header with thunked APIs: their externs, the
#                          shim library and the C library
#   shim.c                 the thunks, one translation unit (only if any)
#   manifest.txt           what was generated from what, deterministically
#   report.txt, report.tsv every public name: what it became, or why not
#
# Ordinary Botlish source: the compiler reads it like any application
# module and never learns that a generator wrote it. Everything is emitted
# in translation-unit order (declarations) and definition order (macros);
# nothing depends on hash or file-system order, and no time, temporary path
# or host name is written.

namespace eval ::cbind::emit {
    # The generator's version: bumped when what it emits changes meaning.
    variable version 1
    variable model {}
    variable ns ""
}

# The Botlish text of a type TEXT with its pointee identities (\x01KEY\x02)
# spelled as their owner module's members, NS::ctypes::NAME (`import type`
# names `type` declarations only, not structs).
proc ::cbind::emit::Type {text} {
    variable model
    variable ns
    set ids [dict get $model identities]
    while {[regexp {\x01([^\x02]+)\x02} $text -> key]} {
        set text [string map [list \x01$key\x02 "${ns}::ctypes::[dict get $ids $key name]"] $text]
    }
    return $text
}

# The identity keys TEXT mentions.
proc ::cbind::emit::Keys {text} {
    set out {}
    foreach {_ key} [regexp -all -inline {\x01([^\x02]+)\x02} $text] { lappend out $key }
    return $out
}

proc ::cbind::emit::Quote {s} {
    return "\"[string map {\\ \\\\ \" \\\"} $s]\""
}

# The facts of parameter P as extern grammar words.
proc ::cbind::emit::ParamFacts {p} {
    set words {}
    if {[dict get $p access] ne ""} { lappend words [dict get $p access] }
    switch -- [dict get $p escape] {
        declared-noescape { lappend words noescape }
        proven-noescape { lappend words proven noescape }
        captures { lappend words captures }
    }
    return $words
}

proc ::cbind::emit::ResultFacts {result} {
    set p [dict get $result provenance]
    if {$p eq ""} { return {} }
    return $p
}

# The C declaration of ENTRY for the comment above its extern.
proc ::cbind::emit::CText {entry} {
    variable model
    set decl [dict get $entry decl]
    set name [dict get $entry name]
    set text [::cir::render [dict get $decl type] $name]
    if {[dict get $entry kind] eq "alias"} {
        set text "$name: an alias of [dict get $entry targetName], [::cir::render [dict get $decl type] [dict get $entry targetName]]"
    } elseif {[dict get $entry kind] eq "thunk"} {
        switch -- [dict get $entry via] {
            inline { set text "static inline $text" }
            stub { set text "$text (called through [::cmacro::meaning [dict get $model macros $name]])" }
            macro { set text "macro $name, as $text" }
            macro-shadow { set text "$text, shadowed by a function-like macro of its name" }
        }
    }
    return [regsub -all {\s+} $text " "]
}

# The extern declaration of ENTRY.
proc ::cbind::emit::Extern {entry} {
    set name [dict get $entry botlish]
    set head "extern c fn $name"
    if {[dict get $entry symbol] ne $name} {
        append head " named [Quote [dict get $entry symbol]]"
    }
    set params {}
    foreach p [dict get $entry params] {
        set words [concat [list "[dict get $p name]: [Type [dict get $p type]]"] [ParamFacts $p]]
        lappend params [join $words " "]
    }
    set result [Type [dict get $entry result type]]
    set tail ") -> [join [concat [list $result] [ResultFacts [dict get $entry result]]] { }]"
    set one "$head\([join $params {, }]$tail"
    if {[llength $params] <= 1 && [string length $one] <= 96} {
        return $one
    }
    return "$head\(\n    [join $params ",\n    "]\n$tail"
}

# The module header comment.
proc ::cbind::emit::Banner {module what} {
    variable model
    set p [dict get $model profile]
    set t [dict get $model target]
    set lines [list "# $module -- GENERATED by tools/c-bindgen.tcl (profile [dict get $p name], target $t):" \
        "# do not edit; regenerate with `tclsh9.0 tools/c-bindgen.tcl generate [dict get $p name] -target $t`." ]
    foreach l $what { lappend lines "# $l" }
    return [join $lines \n]\n
}

# The converter of the scalar SCALAR (ffi::c::UInt -> c_uint).
proc ::cbind::emit::Converter {scalar} {
    set base [string range $scalar 8 end]
    return c_[string tolower [regsub -all {([a-z])([A-Z])} $base {\1_\2}]]
}

# A constant's value expression in a module.
proc ::cbind::emit::ConstantValue {c} {
    variable ns
    if {[dict get $c type] eq "ffi::c::Bool"} {
        return [expr {[dict get $c value] ? "true" : "false"}]
    }
    return "${ns}::ctypes::[Converter [dict get $c type]]([dict get $c value])"
}

# Every generated file of MODEL (see the file header).
proc ::cbind::emit::files {theModel} {
    variable model $theModel
    variable ns [dict get $model profile name]
    set p [dict get $model profile]
    set target [dict get $model target]
    set out [dict create]

    # Group the bound APIs and the constants by module, in order.
    set headerOf [dict create]
    set groups [dict create]
    set moduleOrder {}
    foreach entry [dict get $model apis] {
        set kind [dict get $entry kind]
        if {$kind ni {direct alias thunk}} continue
        set m [dict get $entry module]
        set key [expr {$kind eq "thunk" ? "thunks::$m" : $m}]
        if {![dict exists $groups $key]} { lappend moduleOrder $key; dict set groups $key {constants {} externs {}} }
        dict set headerOf $key [dict get $entry header]
        dict with groups $key { lappend externs $entry }
    }
    set converters {}
    foreach c [dict get $model constants] {
        if {[dict get $c status] ne "constant"} continue
        set key [dict get $c module]
        if {![dict exists $groups $key]} { lappend moduleOrder $key; dict set groups $key {constants {} externs {}} }
        if {![dict exists $headerOf $key]} { dict set headerOf $key [dict get $c header] }
        dict with groups $key { lappend constants $c }
        if {[dict get $c type] ne "ffi::c::Bool" && [dict get $c type] ni $converters} {
            lappend converters [dict get $c type]
        }
    }
    # Modules: plain ones in the order their header first appears, thunk
    # modules after them in the same order.
    set plain [lsearch -all -inline -not -glob $moduleOrder thunks::*]
    set thunked [lsearch -all -inline -glob $moduleOrder thunks::*]

    # The type identities every module uses.
    set used [dict create]
    set shim [ShimName]
    foreach key [concat $plain $thunked] {
        set g [dict get $groups $key]
        set keys {}
        foreach e [dict get $g externs] {
            foreach q [dict get $e params] { lappend keys {*}[Keys [dict get $q type]] }
            lappend keys {*}[Keys [dict get $e result type]]
        }
        set keys [lsort -unique $keys]
        set text [Banner "${ns}::[string map {:: ::} $key]" [ModuleWhat $key [dict get $headerOf $key]]]
        set imports {}
        if {[llength [dict get $g externs]]} { lappend imports "import ffi::c" }
        if {[llength [dict get $g constants]] || [llength $keys]} { lappend imports "import ${ns}::ctypes" }
        if {[llength $imports]} { append text [join $imports \n]\n }
        if {[llength [dict get $g externs]]} {
            append text \n
            set libs [::cbind::profile::librariesOf $p [dict get $headerOf $key] $target]
            if {[string match thunks::* $key]} { set libs [concat [list $shim] $libs] }
            foreach l $libs { append text "extern c library [Quote $l]\n" }
        }
        set lastEnum ""
        if {[llength [dict get $g constants]]} {
            append text \n
            foreach c [dict get $g constants] {
                set group [expr {[dict get $c kind] eq "enumerator" ? [dict get $c enum] : ""}]
                if {$group ne $lastEnum && $group ne ""} {
                    append text "# $group ([dict get $c ctype])\n"
                }
                set lastEnum $group
                append text "[::cbind::model::Ident [dict get $c name]] = [ConstantValue $c]\n"
            }
        }
        foreach e [dict get $g externs] {
            append text "\n# C: [CText $e]\n"
            append text [Extern $e]\n
        }
        dict set out "$ns/[string map {:: /} $key].bot" $text
        dict set used $key $keys
    }

    # The ctypes module: every identity some module uses, in the order the
    # translation unit declares their tags, and the converters.
    set allKeys {}
    dict for {k keys} $used { lappend allKeys {*}$keys }
    set allKeys [lsort -unique $allKeys]
    set ids [dict get $model identities]
    if {[llength $allKeys] || [llength $converters]} {
        set text [Banner "${ns}::ctypes" [list \
            "The C type identities of the ${ns} binding: one opaque pointee identity per" \
            "C tag a bound signature points to (never its fields), and the converters" \
            "that give its constants their C types (C-BINDGEN.md, \"Opaque types\"," \
            "\"Constants\")."]]
        if {[llength $converters]} { append text "import ffi::c\n" }
        foreach k [IdentityOrder $allKeys] {
            set id [dict get $ids $k]
            # A system header is named by its origin only: its path is the
            # host's, never generated source.
            set where [expr {[dict get $id loc] eq "" ? "" : ([dict get $id origin] in {public bundled internal} ? " ([lindex [dict get $id loc] 0])" : " (a system header)")}]
            set note [expr {[dict get $id complete] ? ", a complete C type seen through pointers only" : ""}]
            append text "\n# $k$where$note\nopaque struct [dict get $id name]:\n    tag: unit\n"
        }
        foreach scalar [lsort $converters] {
            append text "\n# A constant of C [dict get [core::cabi::scalarInfo [string range $scalar 8 end] $target] c].\nfn [Converter $scalar](value: $scalar) -> $scalar:\n    value\n"
        }
        dict set out "$ns/ctypes.bot" $text
    }
    set thunks [lsearch -all -inline -index 1 [lmap e [dict get $model apis] {list $e [dict get $e kind]}] thunk]
    if {[llength $thunks]} {
        dict set out shim.c [Shim [lmap t $thunks {lindex $t 0}]]
    }
    return $out
}

# The identity keys KEYS in translation-unit order of their tags.
proc ::cbind::emit::IdentityOrder {keys} {
    variable model
    set order {}
    set rank [dict create]
    set i 0
    foreach r [dict get $model records] {
        lassign $r kind name body
        if {$kind eq "struct"} {
            set k "[dict get $body kind] $name"
            if {![dict exists $rank $k]} { dict set rank $k $i }
        }
        incr i
    }
    return [lsort -command [list ::cbind::emit::RankCompare $rank] $keys]
}

proc ::cbind::emit::RankCompare {rank a b} {
    set ra [expr {[dict exists $rank $a] ? [dict get $rank $a] : 1 << 30}]
    set rb [expr {[dict exists $rank $b] ? [dict get $rank $b] : 1 << 30}]
    if {$ra != $rb} { return [expr {$ra < $rb ? -1 : 1}] }
    return [string compare $a $b]
}

proc ::cbind::emit::ModuleWhat {key header} {
    if {[string match thunks::* $key]} {
        return [list "The thunked APIs of $header (static inline functions, table-redirected" \
            "names, macros): externs of the C wrappers in the shim library (C-BINDGEN.md," \
            "\"Thunks\"). Build the shim with `tools/c-bindgen.tcl build`."]
    }
    return [list "The constants and directly linked functions of $header (C-BINDGEN.md)."]
}

# The shim library's name: profile-qualified and keyed by the shim's own
# text, so a changed shim is a different library, never a stale one.
proc ::cbind::emit::ShimName {} {
    variable model
    variable ns
    set thunks [lsearch -all -inline -index 1 [lmap e [dict get $model apis] {list $e [dict get $e kind]}] thunk]
    if {![llength $thunks]} { return "" }
    return botlish_shim_${ns}_[::chdr::crc32 [Shim [lmap t $thunks {lindex $t 0}]]]
}

# The C source of the thunks ENTRIES: one translation unit including the
# profile's entry headers, one function per thunked API, of the original's
# C signature, calling the original API by its name (an inline function, a
# table-redirecting macro, a macro the profile gave a signature).
proc ::cbind::emit::Shim {entries} {
    variable model
    set p [dict get $model profile]
    set h [::cbind::profile::headersFor $p [dict get $model target]]
    set text "/* GENERATED by tools/c-bindgen.tcl (profile [dict get $p name], target [dict get $model target]): do not edit.\n"
    append text " * The thunks of the [dict get $p name] binding (C-BINDGEN.md, \"Thunks\"): C functions\n"
    append text " * with exactly the C signature of an API that has no link symbol of its\n"
    append text " * own, each calling that API by its name. Compiled once per target into\n"
    append text " * one static library (tools/c-bindgen.tcl build). */\n"
    foreach d [dict get $h defines] {
        if {[regexp {^([^=]+)=(.*)$} $d -> n v]} {
            append text "#ifndef $n\n#define $n $v\n#endif\n"
        } else {
            append text "#ifndef $d\n#define $d 1\n#endif\n"
        }
    }
    foreach e [dict get $h entry] { append text "#include <$e>\n" }
    foreach e $entries {
        set decl [dict get $e decl]
        lassign [dict get $decl type] _ result params flags
        set names {}
        set i 0
        set cparams {}
        foreach q $params {
            incr i
            set n [expr {[lindex $q 0] eq "" ? "botlish_arg$i" : "botlish_[lindex $q 0]"}]
            lappend names $n
            lappend cparams [list $n [lindex $q 1] {}]
        }
        set fn [list fn $result $cparams {}]
        set call "[dict get $e name]([join $names {, }])"
        set body [expr {[::cbind::model::Unq $result] eq "void" ? "$call;" : "return $call;"}]
        append text "\n[::cir::render $fn [dict get $e symbol]] {\n    $body\n}\n"
    }
    return $text
}
