# win32.bot -- the Windows toolchain probe's Win32 program
# (WINDOWS-TOOLCHAIN-CENSUS.md): writes a line to the console through
# kernel32 alone -- GetStdHandle and WriteFile, no C runtime -- and returns
# whether the process id is positive and WriteFile's result (nonzero:
# success): [true, 1]. Windows only.
# The declarations are written by hand, with the facts a Botlish exposure
# needs; the generated binding (generated/c/win32/) declares no facts.
import std::abi
import std::abi::bytes
import std::ffi::c
import std::str

extern c library "kernel32"

extern c fn GetCurrentProcessId() -> std::ffi::c::ULong
extern c fn GetStdHandle(which: std::ffi::c::ULong) -> std::ffi::c::Ptr[std::ffi::c::Void]
extern c fn WriteFile(handle: std::ffi::c::Ptr[std::ffi::c::Void] noescape, buffer: std::ffi::c::Ptr[std::ffi::c::Void] read noescape, count: std::ffi::c::ULong, written: std::ffi::c::Ptr[std::ffi::c::Void] write noescape, overlapped: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int

text = std::abi::bytes::from_list(std::str::encode_utf8("hello from kernel32\n"))
# STD_OUTPUT_HANDLE is (DWORD)-11.
out = GetStdHandle(4294967285)
none = std::ffi::c::null[std::ffi::c::Void]()
done = out.WriteFile(text, 20, std::abi::bytes::zeroed(std::abi::usize(4)), none)
[GetCurrentProcessId() > 0, done.result]
