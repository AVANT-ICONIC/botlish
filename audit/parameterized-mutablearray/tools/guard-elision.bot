import std::mutable_array

fn typed_next(m: MutableArray[int], i: int) -> int:
    std::mutable_array::at(m, i) + 1

fn raw_next(m: mutarray, i: int) -> int:
    std::mutable_array::at(m, i) + 1

fn go():
    a = std::mutable_array::create(4, 10)
    b = std::mutable_array::allocate(4)
    std::mutable_array::set(b, 1, 20)
    [typed_next(a, 1), raw_next(b, 1)]

go()
