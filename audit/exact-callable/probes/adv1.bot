# Probe (audit only): recursion (tail and non-tail) inside a de-closured closure with two exact instances.
# Not a benchmark.
#
# expect: [2, 3, 2, 3, 3]

import std::str

fn run(v):
    fn walk(i, p):
        if i < 0 or i >= std::str::length(v):
            return i
        if p(std::str::substring(v, i, i + 1)):
            return walk(i + 1, p)
        i
    fn depth(i, p):
        if i < 0 or i >= std::str::length(v):
            return 0
        if p(std::str::substring(v, i, i + 1)):
            return 1 + depth(i + 1, p)
        0
    fn a():
        walk(0, std::str::is_tcl_alpha)
    fn b():
        walk(0, std::str::is_tcl_alnum)
    [a(), b(), depth(0, std::str::is_tcl_alpha), depth(0, std::str::is_tcl_alnum), walk(1, std::str::is_tcl_alnum)]

run("ab1_")
