# Probe (audit only): one exact native through a HOF (the native one-site probe, #52).
# Not a benchmark.
#
# expect: 3

import std::str

fn count_while(p, s):
    loop i from 0 to std::str::length(s):
        if p(std::str::substring(s, i, i + 1)):
            continue
        return i
    std::str::length(s)

count_while(std::str::is_tcl_alpha, "abc1")
