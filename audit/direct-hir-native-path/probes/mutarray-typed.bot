import std::mutable_array

# MutableArray[T]: create/get/set/freeze/copy and a raw mutable array.
fn fill(n):
    a = std::mutable_array::create(n, 0)
    loop i from 0 to n:
        std::mutable_array::set(a, i, i * i)
    a
a = fill(6)
c = std::mutable_array::allocate(3)
std::mutable_array::set(c, 0, "x")
std::mutable_array::set(c, 1, "y")
std::mutable_array::set(c, 2, "z")
d = std::mutable_array::allocate(3)
std::mutable_array::copy(d, 0, c, 0, 3)
[std::mutable_array::get(a, 5, -1), std::mutable_array::freeze(a, std::mutable_array::capacity(a)), std::mutable_array::freeze(d, 3)]
