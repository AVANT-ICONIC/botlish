import std::list

# Semantic instances: identity at several types, std::list::find with a handled
# NotFound.
fn identity(v):
    v
fn is_big(n):
    n > 10
fn find_big(xs):
    r = std::list::find(xs, is_big):
        on std::list::NotFound:
            0
    r
[identity(3), identity("s"), identity([1, 2]), find_big([1, 20, 3]), find_big([5])]
