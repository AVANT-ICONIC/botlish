# memo2 -- memo.bot's workload (Collatz step counts of 1..N memoized in an
# Int-keyed table) restructured around today's value semantics
# (HASH-TABLE-EXPERIMENT.md, "Value semantics"): memo.bot's natural
# recursion returns the table inside a struct (`Steps {memo: memo, ...}`),
# which makes the recursion's result a logical copy its caller shares, and
# the next insert then copies every slot array. Here a read-only walk
# collects the values the table does not know yet (no table in its result),
# and a tail loop then inserts them, threading the table linearly. Same
# result as memo.bot.
#
#   argv: N
import std::list
import std::str
import std::char
import table
import keys

# The values from V on that the table does not know, in sequence order, and
# the step count of the first value after them (0 for 1, else the table's).
struct Unknown:
    path: List[int]
    known: int

fn int_of(text: str) -> int errors IndexNotFound:
    n = text.length()
    fn digits(i: int, acc: int) -> int errors IndexNotFound:
        if i >= n:
            return acc
        digits(i + 1, acc * 10 + std::char::scalar_value(text.char_at(i)) - 48)
    digits(0, 0)

fn successor(v: int) -> int:
    if bit_and(v, 1) == 0:
        return shift_right(v, 1)
    3 * v + 1

fn unknown(memo: table::Table, v: int, path: List[int]) -> Unknown errors IndexNotFound:
    if v == 1:
        return Unknown {path: path, known: 0}
    found = table::get(memo, v, -1)
    if found >= 0:
        return Unknown {path: path, known: found}
    unknown(memo, successor(v), path.append(v))

# MEMO with PATH's values from position I down to 0 inserted, the value at
# I having COUNT steps.
fn inserted(memo: table::Table, path: List[int], i: int, count: int) -> table::Table errors IndexNotFound:
    if i < 0:
        return memo
    inserted(table::put(memo, path.at(i), count), path, i - 1, count + 1)

fn all(memo: table::Table, i: int, n: int, sum: int) errors IndexNotFound:
    if i > n:
        return sum
    u = unknown(memo, i, [])
    count = u.known + std::list::length(u.path)
    all(inserted(memo, u.path, std::list::length(u.path) - 1, u.known + 1), i + 1, n, sum + count)

fn main(args: List[str]) errors IndexNotFound:
    all(table::fresh(0), 1, int_of(args.get(1, "100")), 0)

args = argv():
    on InvalidArgumentEncoding:
        []
result = main(args):
    on IndexNotFound:
        -1
result
