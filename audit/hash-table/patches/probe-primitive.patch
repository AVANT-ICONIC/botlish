+/// EXPERIMENT (HASH-TABLE-EXPERIMENT.md, "Runtime experiments"):
+/// `mutable_array::probe_linear(hashes, keys, h, key)`, core/mutarray.tcl's
+/// probeLinear: the slot of KEY along hash H's linear probing sequence over
+/// the stored hashes (negative = empty) and keys, or -1 - the first empty
+/// slot, or -1 - capacity when no slot is empty.
+#[unsafe(no_mangle)]
+pub extern "C" fn rt_mutarray_probe(p: *mut Vm, hashes: Value, keys: Value, h: Value, key: Value) -> Value {
+    let hs = mutarray_of(hashes).items();
+    let ks = mutarray_of(keys).items();
+    let cap = hs.len();
+    let Some(hv) = int_small(h) else { return vm(p).new_int(-1) };
+    if cap == 0 {
+        return make_small(-1);
+    }
+    let mut i = hv.rem_euclid(cap as i64) as usize;
+    for _ in 0..cap {
+        let stored = hs[i];
+        match int_small(stored) {
+            Some(s) if s < 0 => return make_small(-1 - i as i64),
+            Some(s) if s == hv => {
+                if i >= ks.len() {
+                    return index_not_found(p);
+                }
+                match equal(p, ks[i], key) {
+                    Ok(true) => return make_small(i as i64),
+                    Ok(false) => {}
+                    Err(()) => return NO_VALUE,
+                }
+            }
+            _ => {}
+        }
+        i += 1;
+        if i == cap {
+            i = 0;
+        }
+    }
+    make_small(-1 - cap as i64)
+}
+
