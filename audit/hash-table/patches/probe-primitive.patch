--- a/core/mutarray.tcl
+++ b/core/mutarray.tcl
@@ -176,6 +176,42 @@ proc core::mutarray::generateDrop {count factory descriptor} {
         [core::affine::Tree [core::value::strOf $descriptor] mutable_array#generate_drop] mutable_array#generate_drop]
 }
 
+# EXPERIMENT (HASH-TABLE-EXPERIMENT.md, "Runtime experiments"; not a
+# shipped intrinsic): (mutable_array::probe_linear HASHES KEYS H KEY) walks
+# the linear probing sequence of hash H over the slot arrays HASHES (a
+# stored hash, or a negative Int for an empty slot) and KEYS, from slot
+# H mod capacity(HASHES): the slot I whose stored hash is H and whose key ==
+# KEY, or -1 - I for the first empty slot I; -1 - capacity when every slot
+# is occupied by other keys. A slot outside KEYS is IndexNotFound.
+proc core::mutarray::probeLinear {hashes keys h key} {
+    variable store
+    set hs $store([Id $hashes mutable_array::probe_linear])
+    set ks $store([Id $keys mutable_array::probe_linear])
+    set hv [core::value::intOf [core::value::expect int $h mutable_array::probe_linear]]
+    set cap [llength $hs]
+    if {$cap == 0} {
+        return [core::value::intFromNumber -1]
+    }
+    set i [expr {$hv % $cap}]
+    for {set step 0} {$step < $cap} {incr step} {
+        set stored [core::value::intOf [lindex $hs $i]]
+        if {$stored < 0} {
+            return [core::value::intFromNumber [expr {-1 - $i}]]
+        }
+        if {$stored == $hv} {
+            if {$i >= [llength $ks]} {
+                core::native::failDeclared IndexNotFound \
+                    "mutable_array::probe_linear: slot $i is outside the keys 0..[expr {[llength $ks] - 1}]"
+            }
+            if {[core::value::equal [lindex $ks $i] $key]} {
+                return [core::value::intFromNumber $i]
+            }
+        }
+        set i [expr {($i + 1) % $cap}]
+    }
+    return [core::value::intFromNumber [expr {-1 - $cap}]]
+}
+
 proc core::mutarray::capacity {v} {
     variable store
     return [core::value::intFromNumber [llength $store([Id $v mutable_array::capacity])]]
@@ -378,6 +414,9 @@ core::native::register mutable_array::generate -arity 2 -impl core::mutarray::ge
     -param-types {int any} -result-type mutarray -runtime mutarray-alloc -completion 1 \
     -result-shape {mutarray-generate 1} -errors-from 1 -result-length {int 0} \
     -drop-form {mutable_array#generate_drop result} -ownership {observe factory}
+core::native::register mutable_array::probe_linear -arity 4 -impl core::mutarray::probeLinear \
+    -param-types {mutarray mutarray int any} -result-type int -runtime {range-check structural-equality} \
+    -errors IndexNotFound -ownership {observe observe observe equality}
