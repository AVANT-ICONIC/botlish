# lp -- linear probing with stored hashes and backward-shift deletion
# (audit/hash-table/SPEC.md section 3), written the straightforward modular
# way: one small function per concept (the slot of a hash, the next slot,
# the probe walk, growth, placement). Keys and values are untyped: a call
# site's specialization decides what they are.
#
# A table is a value (MUTABLE-ARRAY.md): an update returns the updated
# table. Its three slot arrays are updated in place through the parameter's
# field places (`t.hashes.set(i, h)`); the entry count is an Int field, so
# an insert or a removal builds a new Table around the same arrays.
#
# policy: 7/10
import list
import mutable_array

struct Table:
    hashes: MutableArray[int]
    keys: mutarray
    vals: mutarray
    count: int

# ---------------------------------------------------------------------------
# Policy (SPEC.md section 2)

fn min_slots() -> int:
    8

fn load_num() -> int:
    7

fn load_den() -> int:
    10

# The smallest power-of-two capacity from CAP on that holds EXPECTED entries
# under the maximum load.
fn slots_for(expected: int, cap: int) -> int:
    if expected * load_den() <= cap * load_num():
        return cap
    slots_for(expected, cap * 2)

fn empty_table(cap: int) -> Table:
    Table {hashes: mutable_array::create(cap, -1), keys: mutable_array::allocate(cap), vals: mutable_array::allocate(cap), count: 0}

fn fresh(expected: int) -> Table:
    empty_table(slots_for(expected, min_slots()))

fn slots(t: Table) -> int:
    t.hashes.capacity()

fn size(t: Table) -> int:
    t.count

# Whether one more entry would exceed the maximum load.
fn full?(t: Table) -> bool:
    (t.count + 1) * load_den() > slots(t) * load_num()

# ---------------------------------------------------------------------------
# Probing

fn home(h: int, cap: int) -> int:
    h.mod(cap)

fn next_slot(i: int, cap: int) -> int:
    mod(i + 1, cap)

# The slot holding KEY (hash H), or the empty slot that ends its probe
# sequence.
fn find(t: Table, h: int, key) -> int errors IndexNotFound:
    hashes = t.hashes
    keys = t.keys
    cap = hashes.capacity()
    fn walk(i: int) -> int errors IndexNotFound:
        s = hashes.at(i)
        if s < 0 or s == h and keys.at(i) == key:
            return i
        walk(next_slot(i, cap))
    walk(home(h, cap))

# The first empty slot of hash H's probe sequence.
fn find_empty(hashes: MutableArray[int], h: int) -> int errors IndexNotFound:
    cap = hashes.capacity()
    fn walk(i: int) -> int errors IndexNotFound:
        if hashes.at(i) < 0:
            return i
        walk(next_slot(i, cap))
    walk(home(h, cap))

# ---------------------------------------------------------------------------
# Lookup

fn get(t: Table, key, default) errors IndexNotFound:
    i = find(t, hash(key), key)
    if t.hashes.at(i) < 0:
        return default
    t.vals.at(i)

fn has?(t: Table, key) -> bool errors IndexNotFound:
    i = find(t, hash(key), key)
    t.hashes.at(i) >= 0

# The number of slots a lookup of KEY examines (diagnostic, SPEC.md
# section 4).
fn probes(t: Table, key) -> int errors IndexNotFound:
    h = hash(key)
    i = find(t, h, key)
    mod(i - home(h, slots(t)), slots(t)) + 1

# ---------------------------------------------------------------------------
# Insertion and growth

# T with the entry (H, KEY, VALUE) stored at slot I.
fn store(t: Table, i: int, h: int, key, value) -> Table errors IndexNotFound:
    t.hashes.set(i, h)
    t.keys.set(i, key)
    t.vals.set(i, value)
    t

# DEST with every entry of the slot arrays HASHES, KEYS and VALS from slot I
# on placed into it (DEST has room for all of them).
fn moved(hashes: MutableArray[int], keys, vals, i: int, dest: Table) -> Table errors IndexNotFound:
    if i >= hashes.capacity():
        return dest
    h = hashes.at(i)
    if h < 0:
        return moved(hashes, keys, vals, i + 1, dest)
    placed = store(dest, find_empty(dest.hashes, h), h, keys.at(i), vals.at(i))
    moved(hashes, keys, vals, i + 1, placed)

# T at twice the capacity, its entries placed in old slot order.
fn grown(t: Table) -> Table errors IndexNotFound:
    dest = moved(t.hashes, t.keys, t.vals, 0, empty_table(2 * slots(t)))
    Table {hashes: dest.hashes, keys: dest.keys, vals: dest.vals, count: t.count}

fn with_count(t: Table, count: int) -> Table:
    Table {hashes: t.hashes, keys: t.keys, vals: t.vals, count: count}

fn put(t: Table, key, value) -> Table errors IndexNotFound:
    h = hash(key)
    i = find(t, h, key)
    if t.hashes.at(i) >= 0:
        t.vals.set(i, value)
        return t
    if full?(t):
        g = grown(t)
        return with_count(store(g, find_empty(g.hashes, h), h, key, value), t.count + 1)
    with_count(store(t, i, h, key, value), t.count + 1)

# ---------------------------------------------------------------------------
# Removal: backward shift

# Whether slot K is cyclically in the interval (I, J].
fn between?(k: int, i: int, j: int) -> bool:
    if i <= j:
        i < k and k <= j
    else:
        i < k or k <= j

# T after the entry at slot HOLE was removed, the entries after it shifted
# back: J is the last slot looked at.
fn shifted(t: Table, hole: int, j: int) -> Table errors IndexNotFound:
    cap = slots(t)
    n = next_slot(j, cap)
    s = t.hashes.at(n)
    if s < 0:
        t.hashes.set(hole, -1)
        t.keys.set(hole, unit)
        t.vals.set(hole, unit)
        return t
    if between?(home(s, cap), hole, n):
        return shifted(t, hole, n)
    moved_in = store(t, hole, s, t.keys.at(n), t.vals.at(n))
    shifted(moved_in, n, n)

fn drop(t: Table, key) -> Table errors IndexNotFound:
    i = find(t, hash(key), key)
    if t.hashes.at(i) < 0:
        return t
    with_count(shifted(t, i, i), t.count - 1)

# ---------------------------------------------------------------------------
# Bulk construction (SPEC.md section 4)

# The table of KEYS[i] -> VALS[i], in order (a later duplicate's value wins).
fn from_lists(keys: list, vals: list) -> Table errors IndexNotFound:
    n = list::length(keys)
    fn fill(t: Table, i: int) -> Table errors IndexNotFound:
        if i >= n:
            return t
        fill(put(t, list::at(keys, i), list::at(vals, i)), i + 1)
    fill(fresh(n), 0)
