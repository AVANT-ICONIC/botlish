# lpp -- lpa (audit/hash-table/impl/lpa.bot) with its probe walk delegated
# to the EXPERIMENTAL runtime primitive mutable_array::probe_linear
# (HASH-TABLE-EXPERIMENT.md, "Runtime experiments"; core/mutarray.tcl): one
# helper call walks the linear probing sequence over the stored hashes and
# keys in Rust and answers the key's slot or -1 - the empty slot ending its
# sequence. Everything else -- the representation, the capacity and load
# policy, growth, replacement, backward-shift removal, the count -- is lpa's
# Botlish, unchanged. It measures the smallest privileged primitive that
# keeps the policy in Botlish against the compiler improvements that would
# make lpa's own probe loop as cheap.
#
# It compiles only against the branch exp-probe-primitive, which adds the
# primitive (tools/lib.tcl's BOTLISH_HT_ROOT points the tools at that
# checkout); this checkout's compiler rejects it.
#
# policy: 7/10
import list
import mutable_array

struct Table:
    hashes: MutableArray[int]
    keys: mutarray
    vals: mutarray
    meta: MutableArray[int]

# ---------------------------------------------------------------------------
# Policy (SPEC.md section 2)

fn min_slots() -> int:
    8

fn load_num() -> int:
    7

fn load_den() -> int:
    10

fn slots_for(expected: int, cap: int) -> int:
    if expected * load_den() <= cap * load_num():
        return cap
    slots_for(expected, cap * 2)

fn empty_table(cap: int) -> Table:
    Table {hashes: mutable_array::create(cap, -1), keys: mutable_array::allocate(cap), vals: mutable_array::allocate(cap), meta: mutable_array::create(1, 0)}

fn fresh(expected: int) -> Table:
    empty_table(slots_for(expected, min_slots()))

fn slots(t: Table) -> int:
    t.hashes.capacity()

fn size(t: Table) -> int errors IndexNotFound:
    t.meta.at(0)

fn full?(t: Table) -> bool errors IndexNotFound:
    (size(t) + 1) * load_den() > slots(t) * load_num()

# ---------------------------------------------------------------------------
# Probing

fn home(h: int, cap: int) -> int:
    h.mod(cap)

fn next_slot(i: int, cap: int) -> int:
    mod(i + 1, cap)

# The slot holding KEY (hash H), or the empty slot that ends its probe
# sequence (the primitive answers -1 - that slot).
fn find(t: Table, h: int, key) -> int errors IndexNotFound:
    i = mutable_array::probe_linear(t.hashes, t.keys, h, key)
    if i < 0:
        return -1 - i
    i

# The first empty slot of hash H's probe sequence (no stored hash is -1).
fn find_empty(t: Table, h: int) -> int errors IndexNotFound:
    -1 - mutable_array::probe_linear(t.hashes, t.keys, h, unit)

# ---------------------------------------------------------------------------
# Lookup

fn get(t: Table, key, default) errors IndexNotFound:
    i = find(t, hash(key), key)
    if t.hashes.at(i) < 0:
        return default
    t.vals.at(i)

fn has?(t: Table, key) -> bool errors IndexNotFound:
    t.hashes.at(find(t, hash(key), key)) >= 0

fn probes(t: Table, key) -> int errors IndexNotFound:
    h = hash(key)
    mod(find(t, h, key) - home(h, slots(t)), slots(t)) + 1

# ---------------------------------------------------------------------------
# Insertion and growth

# T with the entry (H, KEY, VALUE) stored at slot I.
fn store(t: Table, i: int, h: int, key, value) -> Table errors IndexNotFound:
    t.hashes.set(i, h)
    t.keys.set(i, key)
    t.vals.set(i, value)
    t

# T with its entry count increased by DELTA.
fn counted(t: Table, delta: int) -> Table errors IndexNotFound:
    t.meta.set(0, t.meta.at(0) + delta)
    t

# DEST with every entry of OLD from slot I on placed into it.
fn moved(old: Table, i: int, dest: Table) -> Table errors IndexNotFound:
    if i >= slots(old):
        return dest
    h = old.hashes.at(i)
    if h < 0:
        return moved(old, i + 1, dest)
    j = find_empty(dest, h)
    moved(old, i + 1, store(dest, j, h, old.keys.at(i), old.vals.at(i)))

# T at twice the capacity, its entries placed in old slot order.
fn grown(t: Table) -> Table errors IndexNotFound:
    count = size(t)
    dest = moved(t, 0, empty_table(2 * slots(t)))
    counted(dest, count)

fn put(t: Table, key, value) -> Table errors IndexNotFound:
    h = hash(key)
    i = find(t, h, key)
    if t.hashes.at(i) >= 0:
        t.vals.set(i, value)
        return t
    if full?(t):
        g = grown(t)
        j = find_empty(g, h)
        return counted(store(g, j, h, key, value), 1)
    counted(store(t, i, h, key, value), 1)

# ---------------------------------------------------------------------------
# Removal: backward shift

# Whether slot K is cyclically in the interval (I, J].
fn between?(k: int, i: int, j: int) -> bool:
    if i <= j:
        i < k and k <= j
    else:
        i < k or k <= j

# T after the entry at slot HOLE was removed, the entries after it shifted
# back: J is the last slot looked at.
fn shifted(t: Table, hole: int, j: int) -> Table errors IndexNotFound:
    cap = slots(t)
    n = next_slot(j, cap)
    stored = t.hashes.at(n)
    if stored < 0:
        t.hashes.set(hole, -1)
        t.keys.set(hole, unit)
        t.vals.set(hole, unit)
        return t
    if between?(home(stored, cap), hole, n):
        return shifted(t, hole, n)
    k = t.keys.at(n)
    v = t.vals.at(n)
    shifted(store(t, hole, stored, k, v), n, n)

fn drop(t: Table, key) -> Table errors IndexNotFound:
    i = find(t, hash(key), key)
    if t.hashes.at(i) < 0:
        return t
    counted(shifted(t, i, i), -1)

# ---------------------------------------------------------------------------
# Bulk construction (SPEC.md section 4)

# The table of KEYS[i] -> VALS[i], in order (a later duplicate's value wins).
fn from_lists(keys: list, vals: list) -> Table errors IndexNotFound:
    n = list::length(keys)
    fn fill(t: Table, i: int) -> Table errors IndexNotFound:
        if i >= n:
            return t
        fill(put(t, list::at(keys, i), list::at(vals, i)), i + 1)
    fill(fresh(n), 0)
