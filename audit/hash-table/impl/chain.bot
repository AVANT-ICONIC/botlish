# chain -- separate chaining (audit/hash-table/SPEC.md section 3): `cap`
# buckets, each an immutable List of entries {hash, key, value} in insertion
# order. A key's bucket is home(hash(key), cap); a lookup scans that one
# bucket from the front, comparing an entry's stored hash first and only
# then its key. An insert of an absent key appends an entry to its bucket;
# a replacement or a removal builds the bucket's List again with the entry
# replaced or left out, and stores it back into the bucket's slot.
#
# The table grows at load 1/1 (SPEC.md section 2: one entry per bucket on
# average): an insert of an absent key that would make the count exceed the
# capacity first doubles it, appending every entry to its new bucket in old
# bucket order, each bucket's entries in order -- the state the Rust
# reference's Chain builds (reference/src/main.rs), so probe counts compare.
#
# State is held the way the value-semantics rules ask (SPEC.md section 7;
# impl/lpa.bot has the same organization):
#
#   * the buckets are one MutableArray whose slots hold Lists and the
#     entries are structs: both immutable, so nothing mutable sits in a slot
#     (rule 10) and a bucket read out of its slot is never a copy of the
#     array;
#   * the entry count lives in a one-slot MutableArray[int], `meta`, mutated
#     in place: no update builds a new Table;
#   * every mutating helper takes the table as its last use and returns it;
#     readers only read;
#   * growth builds the destination with its constructors inline in the
#     struct literal and appends the entries one by one.
#
# The bucket array is typed, MutableArray[List[Entry]], not a raw
# `mutarray`: an element of a raw array is `any`, and a field projection
# (`e.hash`) on an `any` receiver is rejected statically, with no way to
# narrow it back to Entry. Keys and values stay untyped (`any` fields).
#
# The lookup, replacement and removal scans are counted loops over the List
# they read, so their std::list::at needs no IndexNotFound (proven); growth's
# walk of a bucket is tail recursion, whose std::list::at is checked, and the
# bucket array's own at/set index by a computed `mod` and are checked too.
#
# policy: 1/1
import std::list
import std::mutable_array

struct Entry:
    hash: int
    key: any
    value: any

struct Table:
    buckets: MutableArray[List[Entry]]
    meta: MutableArray[int]

# ---------------------------------------------------------------------------
# Policy (SPEC.md section 2)

fn min_slots() -> int:
    8

fn load_num() -> int:
    1

fn load_den() -> int:
    1

# The smallest power-of-two capacity from CAP on that holds EXPECTED entries
# under the maximum load.
fn slots_for(expected: int, cap: int) -> int:
    if expected * load_den() <= cap * load_num():
        return cap
    slots_for(expected, cap * 2)

fn empty_table(cap: int) -> Table:
    Table {buckets: std::mutable_array::create(cap, []), meta: std::mutable_array::create(1, 0)}

fn fresh(expected: int) -> Table:
    empty_table(slots_for(expected, min_slots()))

fn slots(t: Table) -> int:
    t.buckets.capacity()

fn size(t: Table) -> int errors IndexNotFound:
    t.meta.at(0)

# Whether one more entry would exceed the maximum load.
fn full?(t: Table) -> bool errors IndexNotFound:
    (size(t) + 1) * load_den() > slots(t) * load_num()

# ---------------------------------------------------------------------------
# Buckets

fn home(h: int, cap: int) -> int:
    h.mod(cap)

# The bucket of hash H.
fn bucket(t: Table, h: int) -> List[Entry] errors IndexNotFound:
    t.buckets.at(home(h, slots(t)))

# The position of KEY (hash H) in bucket B, or -1. An entry holds KEY when
# its stored hash is H and, only then, its key equals KEY. (The test is
# written in both scans rather than as a helper: native lowering would call
# the helper once per entry examined.)
fn position(b: List[Entry], h: int, key) -> int:
    loop j from 0 to std::list::length(b):
        e = std::list::at(b, j)
        if e.hash == h and e.key == key:
            return j
    -1

# The value of KEY (hash H) in bucket B, or DEFAULT.
fn value_in(b: List[Entry], h: int, key, default):
    loop j from 0 to std::list::length(b):
        e = std::list::at(b, j)
        if e.hash == h and e.key == key:
            return e.value
    default

# Bucket B with its entry at J replaced by E.
fn replaced(b: List[Entry], j: int, e: Entry) -> List[Entry]:
    loop k from 0 to std::list::length(b):
        if k == j:
            e
        else:
            std::list::at(b, k)

# Bucket B without its entry at J.
fn without(b: List[Entry], j: int) -> List[Entry]:
    loop k from 0 to std::list::length(b):
        if k == j:
            continue
        std::list::at(b, k)

# ---------------------------------------------------------------------------
# Lookup

fn get(t: Table, key, default) errors IndexNotFound:
    h = hash(key)
    value_in(bucket(t, h), h, key, default)

fn has?(t: Table, key) -> bool errors IndexNotFound:
    h = hash(key)
    position(bucket(t, h), h, key) >= 0

# The entries a lookup of KEY examines: up to and including KEY's entry, or
# its whole bucket when it is absent.
fn probes(t: Table, key) -> int errors IndexNotFound:
    h = hash(key)
    b = bucket(t, h)
    j = position(b, h, key)
    if j < 0:
        return std::list::length(b)
    j + 1

# ---------------------------------------------------------------------------
# Insertion and growth

# T with entry E appended to its bucket (E's key is absent from T).
fn appended(t: Table, e: Entry) -> Table errors IndexNotFound:
    i = home(e.hash, slots(t))
    t.buckets.set(i, std::list::append(t.buckets.at(i), e))
    t

# T with its entry count increased by DELTA.
fn counted(t: Table, delta: int) -> Table errors IndexNotFound:
    t.meta.set(0, t.meta.at(0) + delta)
    t

# DEST with the entries of bucket B from position J on appended to it.
fn rehomed(b: List[Entry], j: int, dest: Table) -> Table errors IndexNotFound:
    if j >= std::list::length(b):
        return dest
    rehomed(b, j + 1, appended(dest, std::list::at(b, j)))

# DEST with the entries of OLD's buckets from bucket I on appended to it.
fn moved(old: Table, i: int, dest: Table) -> Table errors IndexNotFound:
    if i >= slots(old):
        return dest
    moved(old, i + 1, rehomed(old.buckets.at(i), 0, dest))

# T at twice the capacity, its entries placed in old bucket order.
fn grown(t: Table) -> Table errors IndexNotFound:
    count = size(t)
    dest = moved(t, 0, empty_table(2 * slots(t)))
    counted(dest, count)

fn put(t: Table, key, value) -> Table errors IndexNotFound:
    h = hash(key)
    i = home(h, slots(t))
    b = t.buckets.at(i)
    j = position(b, h, key)
    if j >= 0:
        t.buckets.set(i, replaced(b, j, Entry {hash: h, key: key, value: value}))
        return t
    if full?(t):
        return counted(appended(grown(t), Entry {hash: h, key: key, value: value}), 1)
    t.buckets.set(i, std::list::append(b, Entry {hash: h, key: key, value: value}))
    counted(t, 1)

# ---------------------------------------------------------------------------
# Removal: the bucket without the entry

fn drop(t: Table, key) -> Table errors IndexNotFound:
    h = hash(key)
    i = home(h, slots(t))
    b = t.buckets.at(i)
    j = position(b, h, key)
    if j < 0:
        return t
    t.buckets.set(i, without(b, j))
    counted(t, -1)

# ---------------------------------------------------------------------------
# Bulk construction (SPEC.md section 4)

# The table of KEYS[i] -> VALS[i], in order (a later duplicate's value wins).
fn from_lists(keys: list, vals: list) -> Table errors IndexNotFound:
    n = std::list::length(keys)
    fn fill(t: Table, i: int) -> Table errors IndexNotFound:
        if i >= n:
            return t
        fill(put(t, std::list::at(keys, i), std::list::at(vals, i)), i + 1)
    fill(fresh(n), 0)
