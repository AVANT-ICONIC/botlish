# rh -- Robin Hood hashing (audit/hash-table/SPEC.md section 3) over lp's
# slot arrays and probe sequence: `hashes` (-1 for an empty slot, else the
# entry's hash), `keys` and `vals`, probed i0, i0+1, ... mod cap from the
# home i0 = hash mod cap. The algorithm is the Rust reference's `Rh`
# (reference/src/main.rs): the two compute the same slots and the same
# probe counts.
#
# A resident's distance is how far its slot lies past its own home,
# dist(i) = (i - home(hashes[i])) mod cap. Robin Hood keeps every run of
# occupied slots in the order of its entries' homes, so along a run the
# distance grows by at most one a slot; three rules keep it so:
#
#   * insertion carries an entry and its distance d from its home; at an
#     occupied slot whose resident is nearer home (dist < d) the two swap,
#     and insertion goes on with the evicted entry and the resident's
#     distance (an insert of a present key replaces its value instead);
#   * a lookup at distance d stops at an empty slot, or at a resident with
#     dist < d: the key, had it been present, would have displaced it;
#   * removal shifts the following residents back one slot each, while the
#     next one is away from its home (dist > 0), then empties the last slot
#     shifted from (backward shift: no tombstones).
#
# Growth doubles the capacity and reinserts in old slot order with the same
# displacing insertion (SPEC.md section 2); the maximum load is 7/10.
#
# The table's state is held as lpa holds it (HASH-TABLE-EXPERIMENT.md,
# "Value semantics"; SPEC.md section 7): the entry count in a one-slot
# MutableArray[int], `meta`, mutated in place, so no update builds a new
# Table; every mutating helper takes the table as its last use and returns
# it; readers only read; growth builds the destination with its
# constructors inline in the struct literal.
#
# policy: 7/10
import list
import mutable_array

struct Table:
    hashes: MutableArray[int]
    keys: mutarray
    vals: mutarray
    meta: MutableArray[int]

# ---------------------------------------------------------------------------
# Policy (SPEC.md section 2)

fn min_slots() -> int:
    8

fn load_num() -> int:
    7

fn load_den() -> int:
    10

# The smallest power-of-two capacity from CAP on that holds EXPECTED entries
# under the maximum load.
fn slots_for(expected: int, cap: int) -> int:
    if expected * load_den() <= cap * load_num():
        return cap
    slots_for(expected, cap * 2)

fn empty_table(cap: int) -> Table:
    Table {hashes: mutable_array::create(cap, -1), keys: mutable_array::allocate(cap), vals: mutable_array::allocate(cap), meta: mutable_array::create(1, 0)}

fn fresh(expected: int) -> Table:
    empty_table(slots_for(expected, min_slots()))

fn slots(t: Table) -> int:
    t.hashes.capacity()

fn size(t: Table) -> int errors IndexNotFound:
    t.meta.at(0)

# Whether one more entry would exceed the maximum load.
fn full?(t: Table) -> bool errors IndexNotFound:
    (size(t) + 1) * load_den() > slots(t) * load_num()

# ---------------------------------------------------------------------------
# Probing

fn home(h: int, cap: int) -> int:
    h.mod(cap)

fn next_slot(i: int, cap: int) -> int:
    mod(i + 1, cap)

# How far slot I lies past the home of the hash STORED there.
fn dist(stored: int, i: int, cap: int) -> int:
    mod(i - home(stored, cap), cap)

# The slot holding KEY (hash H), looked for from slot I, D slots past its
# home; or, when KEY is absent, -1 - S for the slot S that ends the walk
# (empty, or holding a resident nearer its home than D). The hash test comes
# before the distance test: a resident with KEY's hash has KEY's home, so its
# distance is D and the order changes no outcome and no probe count.
fn find_from(t: Table, h: int, key, i: int, d: int) -> int errors IndexNotFound:
    stored = t.hashes.at(i)
    if stored < 0:
        return -1 - i
    if stored == h and t.keys.at(i) == key:
        return i
    cap = slots(t)
    if dist(stored, i, cap) < d:
        return -1 - i
    find_from(t, h, key, next_slot(i, cap), d + 1)

fn find(t: Table, h: int, key) -> int errors IndexNotFound:
    find_from(t, h, key, home(h, slots(t)), 0)

# ---------------------------------------------------------------------------
# Lookup

fn get(t: Table, key, default) errors IndexNotFound:
    i = find(t, hash(key), key)
    if i < 0:
        return default
    t.vals.at(i)

fn has?(t: Table, key) -> bool errors IndexNotFound:
    find(t, hash(key), key) >= 0

# The slot a walk that returned I (find_from's result) ended at.
fn last_slot(i: int) -> int:
    if i < 0:
        return -1 - i
    i

# The number of slots a lookup of KEY examines (diagnostic, SPEC.md
# section 4): the walk's last slot, found or not, and every slot before it.
fn probes(t: Table, key) -> int errors IndexNotFound:
    h = hash(key)
    mod(last_slot(find(t, h, key)) - home(h, slots(t)), slots(t)) + 1

# ---------------------------------------------------------------------------
# Insertion and growth

# T with the entry (H, KEY, VALUE) stored at slot I.
fn store(t: Table, i: int, h: int, key, value) -> Table errors IndexNotFound:
    t.hashes.set(i, h)
    t.keys.set(i, key)
    t.vals.set(i, value)
    t

# T with its entry count increased by DELTA.
fn counted(t: Table, delta: int) -> Table errors IndexNotFound:
    t.meta.set(0, t.meta.at(0) + delta)
    t

# T with the entry (H, KEY, VALUE), absent from T, placed by Robin Hood
# insertion from slot I, D slots past the entry's home: at the first empty
# slot, or in the place of the first resident nearer its home, which is then
# placed the same way from the next slot.
fn placed_from(t: Table, i: int, d: int, h: int, key, value) -> Table errors IndexNotFound:
    stored = t.hashes.at(i)
    if stored < 0:
        return store(t, i, h, key, value)
    cap = slots(t)
    e = dist(stored, i, cap)
    if e < d:
        t.hashes.set(i, h)
        k = t.keys.swap(i, key)
        v = t.vals.swap(i, value)
        return placed_from(t, next_slot(i, cap), e + 1, stored, k, v)
    placed_from(t, next_slot(i, cap), d + 1, h, key, value)

# (The home is bound first: T, moving into placed_from, must be the last
# read of T in the argument list, or it is shared.)
fn placed(t: Table, h: int, key, value) -> Table errors IndexNotFound:
    i = home(h, slots(t))
    placed_from(t, i, 0, h, key, value)

# DEST with every entry of OLD from slot I on placed into it.
fn moved(old: Table, i: int, dest: Table) -> Table errors IndexNotFound:
    if i >= slots(old):
        return dest
    h = old.hashes.at(i)
    if h < 0:
        return moved(old, i + 1, dest)
    moved(old, i + 1, placed(dest, h, old.keys.at(i), old.vals.at(i)))

# T at twice the capacity, its entries placed in old slot order.
fn grown(t: Table) -> Table errors IndexNotFound:
    count = size(t)
    dest = moved(t, 0, empty_table(2 * slots(t)))
    counted(dest, count)

# Like the reference, an insert of an absent key walks again from the home
# (of the grown table, when it grows) rather than resuming the lookup's walk.
fn put(t: Table, key, value) -> Table errors IndexNotFound:
    h = hash(key)
    i = find(t, h, key)
    if i >= 0:
        t.vals.set(i, value)
        return t
    if full?(t):
        return counted(placed(grown(t), h, key, value), 1)
    counted(placed(t, h, key, value), 1)

# ---------------------------------------------------------------------------
# Removal: backward shift

# T after the entry at slot HOLE was removed: each following resident away
# from its home moves back one slot, then the last slot moved from is
# emptied.
fn shifted(t: Table, hole: int) -> Table errors IndexNotFound:
    cap = slots(t)
    n = next_slot(hole, cap)
    stored = t.hashes.at(n)
    if stored < 0 or dist(stored, n, cap) == 0:
        t.hashes.set(hole, -1)
        t.keys.set(hole, unit)
        t.vals.set(hole, unit)
        return t
    k = t.keys.at(n)
    v = t.vals.at(n)
    shifted(store(t, hole, stored, k, v), n)

fn drop(t: Table, key) -> Table errors IndexNotFound:
    i = find(t, hash(key), key)
    if i < 0:
        return t
    counted(shifted(t, i), -1)

# ---------------------------------------------------------------------------
# Bulk construction (SPEC.md section 4)

# The table of KEYS[i] -> VALS[i], in order (a later duplicate's value wins).
fn from_lists(keys: list, vals: list) -> Table errors IndexNotFound:
    n = list::length(keys)
    fn fill(t: Table, i: int) -> Table errors IndexNotFound:
        if i >= n:
            return t
        fill(put(t, list::at(keys, i), list::at(vals, i)), i + 1)
    fill(fresh(n), 0)
