# lpc -- lp's algorithm (linear probing with stored hashes and backward-shift
# deletion, audit/hash-table/SPEC.md section 3) and lp's modular helpers,
# with the table's state held so that no update copies a slot array.
#
# A MutableArray is a value with a copy-on-write backing (MUTABLE-ARRAY.md):
# a read-out of a place that is not the place's last use is a logical copy
# that shares the backing, and the next write through either copy then
# detaches it -- copies every slot. lp rebuilds its Table from three field
# reads (`Table {hashes: t.hashes, keys: t.keys, vals: t.vals, count: c}`)
# and passes the table to mutating helpers while still reading its count, so
# nearly every insert copies the arrays (HASH-TABLE-EXPERIMENT.md, "Value
# semantics"). Here:
#
#   * the arrays live in one Slots struct, so a Table is rebuilt from a
#     single collection-bearing field;
#   * every update reads what it needs (the count) first, and then hands the
#     slots to the mutating call as their last use, so the header moves;
#   * a mutating helper returns the Slots it was given (an update a helper
#     made to a parameter is otherwise invisible to its caller).
#
# policy: 7/10
import list
import mutable_array

struct Slots:
    hashes: MutableArray[int]
    keys: mutarray
    vals: mutarray

struct Table:
    slots: Slots
    count: int

# ---------------------------------------------------------------------------
# Policy (SPEC.md section 2)

fn min_slots() -> int:
    8

fn load_num() -> int:
    7

fn load_den() -> int:
    10

fn slots_for(expected: int, cap: int) -> int:
    if expected * load_den() <= cap * load_num():
        return cap
    slots_for(expected, cap * 2)

fn empty_slots(cap: int) -> Slots:
    Slots {hashes: mutable_array::create(cap, -1), keys: mutable_array::allocate(cap), vals: mutable_array::allocate(cap)}

fn fresh(expected: int) -> Table:
    Table {slots: empty_slots(slots_for(expected, min_slots())), count: 0}

fn capacity(s: Slots) -> int:
    s.hashes.capacity()

fn slots(t: Table) -> int:
    capacity(t.slots)

fn size(t: Table) -> int:
    t.count

fn full?(count: int, cap: int) -> bool:
    (count + 1) * load_den() > cap * load_num()

# ---------------------------------------------------------------------------
# Probing

fn home(h: int, cap: int) -> int:
    h.mod(cap)

fn next_slot(i: int, cap: int) -> int:
    mod(i + 1, cap)

# The slot holding KEY (hash H), or the empty slot that ends its probe
# sequence, from slot I on.
fn find_from(s: Slots, h: int, key, i: int) -> int errors IndexNotFound:
    stored = s.hashes.at(i)
    if stored < 0 or stored == h and s.keys.at(i) == key:
        return i
    find_from(s, h, key, next_slot(i, capacity(s)))

fn find(s: Slots, h: int, key) -> int errors IndexNotFound:
    find_from(s, h, key, home(h, capacity(s)))

# The first empty slot of hash H's probe sequence from slot I on.
fn empty_from(s: Slots, i: int) -> int errors IndexNotFound:
    if s.hashes.at(i) < 0:
        return i
    empty_from(s, next_slot(i, capacity(s)))

fn find_empty(s: Slots, h: int) -> int errors IndexNotFound:
    empty_from(s, home(h, capacity(s)))

# ---------------------------------------------------------------------------
# Lookup

fn get(t: Table, key, default) errors IndexNotFound:
    s = t.slots
    i = find(s, hash(key), key)
    if s.hashes.at(i) < 0:
        return default
    s.vals.at(i)

fn has?(t: Table, key) -> bool errors IndexNotFound:
    s = t.slots
    s.hashes.at(find(s, hash(key), key)) >= 0

fn probes(t: Table, key) -> int errors IndexNotFound:
    s = t.slots
    h = hash(key)
    cap = capacity(s)
    mod(find(s, h, key) - home(h, cap), cap) + 1

# ---------------------------------------------------------------------------
# Insertion and growth

# S with the entry (H, KEY, VALUE) stored at slot I.
fn store(s: Slots, i: int, h: int, key, value) -> Slots errors IndexNotFound:
    s.hashes.set(i, h)
    s.keys.set(i, key)
    s.vals.set(i, value)
    s

# DEST with every entry of OLD from slot I on placed into it.
fn moved(old: Slots, i: int, dest: Slots) -> Slots errors IndexNotFound:
    if i >= capacity(old):
        return dest
    h = old.hashes.at(i)
    if h < 0:
        return moved(old, i + 1, dest)
    j = find_empty(dest, h)
    moved(old, i + 1, store(dest, j, h, old.keys.at(i), old.vals.at(i)))

fn grown(s: Slots) -> Slots errors IndexNotFound:
    moved(s, 0, empty_slots(2 * capacity(s)))

fn put(t: Table, key, value) -> Table errors IndexNotFound:
    count = t.count
    s = t.slots
    h = hash(key)
    i = find(s, h, key)
    if s.hashes.at(i) >= 0:
        s.vals.set(i, value)
        return Table {slots: s, count: count}
    if full?(count, capacity(s)):
        g = grown(s)
        j = find_empty(g, h)
        return Table {slots: store(g, j, h, key, value), count: count + 1}
    Table {slots: store(s, i, h, key, value), count: count + 1}

# ---------------------------------------------------------------------------
# Removal: backward shift

fn between?(k: int, i: int, j: int) -> bool:
    if i <= j:
        i < k and k <= j
    else:
        i < k or k <= j

# S after the entry at slot HOLE was removed, the entries after it shifted
# back: J is the last slot looked at.
fn shifted(s: Slots, hole: int, j: int) -> Slots errors IndexNotFound:
    cap = capacity(s)
    n = next_slot(j, cap)
    stored = s.hashes.at(n)
    if stored < 0:
        s.hashes.set(hole, -1)
        s.keys.set(hole, unit)
        s.vals.set(hole, unit)
        return s
    if between?(home(stored, cap), hole, n):
        return shifted(s, hole, n)
    k = s.keys.at(n)
    v = s.vals.at(n)
    shifted(store(s, hole, stored, k, v), n, n)

fn drop(t: Table, key) -> Table errors IndexNotFound:
    count = t.count
    s = t.slots
    i = find(s, hash(key), key)
    if s.hashes.at(i) < 0:
        return Table {slots: s, count: count}
    Table {slots: shifted(s, i, i), count: count - 1}

# ---------------------------------------------------------------------------
# Bulk construction (SPEC.md section 4)

# The table of KEYS[i] -> VALS[i], in order (a later duplicate's value wins).
fn from_lists(keys: list, vals: list) -> Table errors IndexNotFound:
    n = list::length(keys)
    fn fill(t: Table, i: int) -> Table errors IndexNotFound:
        if i >= n:
            return t
        fill(put(t, list::at(keys, i), list::at(vals, i)), i + 1)
    fill(fresh(n), 0)
