import std::list
import std::mutable_array

fn g(storage, length, value):
    if length < std::mutable_array::capacity(storage):
        return storage

    fresh = std::mutable_array::allocate(length * 2 + 1)
    std::mutable_array::copy(fresh, 0, storage, 0, length)
    fresh

s = std::mutable_array::allocate(1)
std::list::length(std::mutable_array::freeze(g(s, 1, "b"), 1))
