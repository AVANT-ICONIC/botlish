# corpus.tcl -- the unsupported-shape corpus of the header experiment
# (C-HEADER-ARCHAEOLOGY.md, "The unsupported corpus").
#
#   tclsh9.0 audit/c-header/tools/corpus.tcl LIBRARY
#
# Reads results/LIBRARY-*/ir.txt and system.txt (run.tcl's output, every
# profile of the library) and writes unsupported/LIBRARY/: one small C file
# per distinct shape the low-level FFI cannot take as an ordinary
# declaration, each holding
#
#   a header comment: category, shape, how often and in which profiles it
#   occurs, the first occurrence's source location, the reason, and an
#   `expect:` line (what the parser must produce for it);
#   the typedefs the declaration needs to parse (their own preprocessed
#   text, the transitive closure); and the preprocessed declaration itself.
#
# A fixture reproduces the parser's behavior without the library:
# tests/corpus.test parses every fixture and checks its expect: line. The
# categories are the research taxonomy of C-HEADER-ARCHAEOLOGY.md ("Failure
# taxonomy"), not diagnostics.

set here [file dirname [file normalize [info script]]]
source [file join $here common.tcl]
::chdr::use cdecl.tcl
::chdr::use ir.tcl
source [file join $here census.tcl]

namespace eval ::corpus {}

# Shapes of one profile: a list of {CATEGORY SHAPE RECORD REASON EXPECT}.
proc ::corpus::Shapes {library} {
    set out {}
    foreach r $library {
        lassign $r kind name b
        if {[dict get $b origin] ni {public bundled}} continue
        if {$kind eq "unsupported"} {
            lappend out [list [dict get $b category] [Slug [dict get $b reason]] $r [dict get $b reason] \
                "unsupported [dict get $b category]"]
            continue
        }
        if {$kind eq "function"} {
            lassign [::census::sig $r] result params flags
            if {[dict get $b definition]} {
                set gen "written directly in the header"
                if {[dict exists $b srcmacros]} {
                    foreach m [dict get $b srcmacros] {
                        if {[regexp {DEFINE|DECLARE} $m]} { set gen "generated by $m" }
                    }
                }
                lappend out [list POSSIBLE-THUNK-REQUIRED "inline definition, $gen" $r \
                    "a static inline definition has no link symbol: callable only through a generated C thunk (or reimplemented)" \
                    "function $name"]
            }
            if {"variadic" in $flags} {
                lappend out [list TYPE-SHAPE-UNSUPPORTED "variadic function" $r \
                    "C varargs: the caller must know the promoted types of the extra arguments" "function $name"]
            }
            if {"noproto" in $flags} {
                lappend out [list TYPE-SHAPE-UNSUPPORTED "function without a prototype" $r \
                    "an empty parameter list declares no prototype: default argument promotions" "function $name"]
            }
            set ts [list result $result]
            foreach p $params { lappend ts param [lindex $p 1] }
            foreach {role t} $ts {
                set c [::census::cat $t]
                if {$c in {struct union}} {
                    lappend out [list ABI-INFORMATION-REQUIRED "$c by value ($role)" $r \
                        "passing or returning an aggregate by value follows the target ABI's classification rules" "function $name"]
                }
                if {$c eq "builtin"} {
                    lappend out [list ABI-INFORMATION-REQUIRED "va_list $role" $r \
                        "va_list is a target-specific builtin type (an array of one struct on x86-64 SysV)" "function $name"]
                }
                if {$c eq "enum"} {
                    lappend out [list ABI-INFORMATION-REQUIRED "enum $role" $r \
                        "an enum's integer type is implementation-defined: its width and signedness need the compiler" "function $name"]
                }
                if {[::census::isFnPtr $t] || $c eq "fn"} {
                    set f [::census::CallbackFn $t]
                    if {"variadic" in [lindex $f 3]} {
                        lappend out [list TYPE-SHAPE-UNSUPPORTED "variadic callback $role" $r \
                            "a callback the library calls with C varargs" "function $name"]
                    }
                }
            }
        }
        if {[dict exists $b attrs]} {
            foreach a [::census::AllAttrs $r] {
                lassign $a form position aname args
                set cls [expr {[dict exists $::census::attrClass $aname] ? [dict get $::census::attrClass $aname] : "unclassified"}]
                if {$cls in {abi unclassified} && $form ni {asm cc extension}} {
                    lappend out [list ATTRIBUTE-UNSUPPORTED "attribute $aname" $r \
                        "__attribute__(($aname)) [expr {$cls eq "abi" ? "changes the type or the layout" : "is not classified"}]" "$kind $name"]
                }
            }
        }
        if {$kind eq "struct" && [dict get $b complete]} {
            foreach f [dict get $b fields] {
                lassign $f fname ftype bits
                if {$bits ne ""} {
                    lappend out [list ABI-INFORMATION-REQUIRED "bitfield" $r \
                        "bit allocation within storage units is the ABI's" "struct $name"]
                    if {[lindex $bits 0] eq "expr"} {
                        lappend out [list CONSTANT-EXPRESSION-UNSUPPORTED "bitfield width [::census::ExprShape [lindex $bits 1]]" $r \
                            "the width is an expression" "struct $name"]
                    }
                }
                foreach n [::census::ownNodes $ftype] {
                    if {[lindex $n 0] eq "array" && [lindex $n 2 0] eq "expr"} {
                        set shape [::census::ExprShape [lindex $n 2 1]]
                        set cat [expr {[string match *sizeof* $shape] ? "ABI-INFORMATION-REQUIRED" : "CONSTANT-EXPRESSION-UNSUPPORTED"}]
                        lappend out [list $cat "array bound $shape" $r \
                            "the array bound [list [lindex $n 2 1]] is an expression, not a literal" "struct $name"]
                    }
                    if {[lindex $n 0] eq "array" && [lindex $n 2] eq ""} {
                        lappend out [list TYPE-SHAPE-UNSUPPORTED "unknown-length array field" $r \
                            "a flexible array member (or unknown-length array) in a struct" "struct $name"]
                    }
                }
                if {[::census::cat $ftype] eq "union" && $fname ne ""} {
                    lappend out [list ABI-INFORMATION-REQUIRED "union embedded by value" $r \
                        "a union field: overlapping storage the current layout cannot describe" "struct $name"]
                }
            }
        }
        if {$kind eq "enum" && [dict get $b complete]} {
            foreach e [dict get $b enumerators] {
                if {[lindex $e 1] eq "expr"} {
                    lappend out [list CONSTANT-EXPRESSION-UNSUPPORTED "enumerator value [::census::ExprShape [lindex $e 3]]" $r \
                        "the enumerator value [list [lindex $e 3]] is an expression" "enum $name"]
                }
            }
        }
        if {[dict exists $b unknowntypes]} {
            lappend out [list DECLARATION-PARSE-FAILURE "unknown type name" $r \
                "[dict get $b unknowntypes] was taken as a type without a typedef in sight" "$kind $name"]
        }
        if {$kind eq "pragma"} {
            set word [lindex [dict get $b text] 0]
            if {$word in {pack redefine_extname weak}} {
                lappend out [list ABI-INFORMATION-REQUIRED "pragma $word" $r \
                    "#pragma $word survives preprocessing and changes layout or link names" "pragma -"]
            }
        }
    }
    return $out
}

proc ::corpus::Slug {text} {
    set s [string tolower [regsub -all {[^A-Za-z0-9]+} $text -]]
    return [string trim [string range $s 0 50] -]
}

# The preprocessed text of the typedefs a record needs, transitively, in
# their original order.
proc ::corpus::Context {r byName order} {
    set need [dict create]
    set queue [Words [dict get [lindex $r 2] text]]
    while {[llength $queue]} {
        set w [lindex $queue 0]
        set queue [lrange $queue 1 end]
        if {[dict exists $need $w] || ![dict exists $byName $w]} continue
        dict set need $w 1
        lappend queue {*}[Words [dict get [lindex [dict get $byName $w] 2] text]]
    }
    set out [dict create]
    foreach n $order {
        if {[dict exists $need $n] && $n ne [lindex $r 1]} {
            dict set out [dict get [lindex [dict get $byName $n] 2] text] 1
        }
    }
    return [dict keys $out]
}

proc ::corpus::Words {text} {
    regexp -all -inline {[A-Za-z_][A-Za-z0-9_]*} $text
}

proc ::corpus::main {libraryName} {
    set results [file join $::chdr::root results]
    set profiles [dict keys [::chdr::loadProfiles $libraryName]]
    set shapes [dict create]
    foreach p $profiles {
        set dir [file join $results $p]
        if {![file exists [file join $dir ir.txt]]} continue
        set library [::cir::read [file join $dir ir.txt]]
        set system [::cir::read [file join $dir system.txt]]
        set ::census::ix [::cir::index [concat $system $library]]
        set ::census::libIx [::cir::index $library]
        set revision [lindex [regexp -inline -line {^revision (\S+)} [::chdr::readFile [file join $dir profile.txt]]] 1]
        # typedef name -> record, in order (for fixture context).
        set byName [dict create]
        set order {}
        foreach r [concat $system $library] {
            if {[lindex $r 0] eq "typedef" && ![dict exists $byName [lindex $r 1]]} {
                dict set byName [lindex $r 1] $r
                lappend order [lindex $r 1]
            }
        }
        foreach s [Shapes $library] {
            lassign $s category shape r reason expect
            set key [list $category $shape]
            if {![dict exists $shapes $key]} {
                dict set shapes $key [dict create category $category shape $shape record $r reason $reason \
                    expect $expect profile $p revision $revision context [Context $r $byName $order] \
                    count [dict create] names [dict create] profiles {}]
            }
            set e [dict get $shapes $key]
            dict set e count $p [expr {[dict exists $e count $p] ? [dict get $e count $p] + 1 : 1}]
            if {[lindex $r 1] ne "-"} { dict set e names [lindex $r 1] 1 }
            if {$p ni [dict get $e profiles]} { dict lappend e profiles $p }
            dict set shapes $key $e
        }
    }
    set out [file join $::chdr::root unsupported $libraryName]
    file delete -force $out
    file mkdir $out
    set index {}
    set i 0
    foreach key [lsort -index 0 [lsort -index 1 [dict keys $shapes]]] {
        set e [dict get $shapes $key]
        incr i
        set file [format "%s--%s.c" [dict get $e category] [Slug [dict get $e shape]]]
        set r [dict get $e record]
        set b [lindex $r 2]
        set counts {}
        foreach {p n} [dict get $e count] { lappend counts "$p $n" }
        set names [lrange [dict keys [dict get $e names]] 0 7]
        set text "/* C-HEADER-ARCHAEOLOGY.md unsupported corpus: $libraryName\n"
        append text " * category:    [dict get $e category]\n"
        append text " * shape:       [dict get $e shape]\n"
        append text " * occurrences: [join $counts {, }]\n"
        append text " * examples:    [join $names {, }]\n"
        append text " * first seen:  [dict get $e profile] (revision [dict get $e revision]), [lindex [dict get $b loc] 0]:[lindex [dict get $b loc] 1]\n"
        append text " * reason:      [dict get $e reason]\n"
        append text " * expect:      [dict get $e expect]\n"
        append text " */\n"
        foreach c [dict get $e context] { append text "$c\n" }
        set decl [dict get $b text]
        if {[lindex $r 0] eq "pragma"} { set decl "#pragma $decl" }
        if {[lindex $r 0] eq "struct" && [string index $decl end] ne ";"} { append decl ";" }
        append text "$decl\n"
        ::chdr::writeFile [file join $out $file] $text
        lappend index [list $file [join $counts {, }]]
    }
    set lines {}
    foreach x $index { lappend lines "[lindex $x 0]\t[lindex $x 1]" }
    ::chdr::writeFile [file join $out INDEX.tsv] [join $lines \n]\n
    puts "$libraryName: [llength $index] shapes in $out"
}

::corpus::main [lindex $argv 0]
