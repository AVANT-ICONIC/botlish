# expect: [8]
import std::binary

# struct openssl_method_common_st { int references; char is_static; }
layout OPENSSL_METHOD_COMMON_ST:
    size 8
    align 4
    field references: std::binary::I32 at 0
    field is_static: std::binary::I8 at 4

[std::binary::layout_length(OPENSSL_METHOD_COMMON_ST)]
