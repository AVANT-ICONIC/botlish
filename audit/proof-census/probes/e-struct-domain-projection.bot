# Journey E: a source-defined domain on a nominal struct field reaches a
# consumer through projection. std::byte::from_int declares
# ByteBelowRange/ByteAboveRange; x.value : AbiU8Value (0..255) rules both
# out, both through a local and directly as an argument.
fn via_local(x: std::abi::U8):
    v = x.value
    std::byte::from_int(v)

fn direct(x: std::abi::U8):
    std::byte::from_int(x.value)

fn plus_one(x: std::abi::U8):
    x.value + 1

fn dynamic(n):
    a = std::abi::u8(n):
        on std::abi::AbiIntegerBelowRange:
            std::abi::u8(0)
        on std::abi::AbiIntegerAboveRange:
            std::abi::u8(255)
    direct(a)

[via_local(std::abi::u8(7)), direct(std::abi::u8(9)), plus_one(std::abi::u8(255)), dynamic(200)]
