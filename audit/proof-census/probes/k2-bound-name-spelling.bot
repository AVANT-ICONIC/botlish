# Isolates the method-spelling difference: the module-level binding
# (at = std::list::at), spelled free, vs the qualified intrinsic.
length = std::list::length
at = std::list::at

fn qualified(xs):
    loop i from 0 to std::list::length(xs):
        std::list::at(xs, i)

fn bound(xs):
    loop i from 0 to length(xs):
        at(xs, i)

fn method(xs):
    loop i from 0 to xs.length():
        xs.at(i)

fn local_bound(xs):
    at2 = std::list::at
    loop i from 0 to std::list::length(xs):
        at2(xs, i)

[qualified([1, 2]), bound([1, 2]), method([1, 2]), local_bound([1, 2])]
