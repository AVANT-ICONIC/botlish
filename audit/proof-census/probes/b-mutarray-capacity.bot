# Journey B: MutableArray capacity. Reads and writes in a counted loop to
# std::mutable_array::capacity(a), and to the allocation's own size n.
fn fill(n):
    a = std::mutable_array::allocate(n)
    loop i from 0 to std::mutable_array::capacity(a):
        std::mutable_array::set(a, i, i * 3)
    loop i from 0 to n:
        std::mutable_array::at(a, i)

fn read_param(a):
    loop i from 0 to std::mutable_array::capacity(a):
        std::mutable_array::at(a, i)

[fill(4), read_param(std::mutable_array::create(3, 7))]
