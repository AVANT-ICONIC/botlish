# Journey I: std::list::get in a counted loop. The caller's loop proves the
# index in range; get is ordinary Botlish (std::list::at plus an IndexNotFound
# handler) called as an ordinary function.
fn doubled(xs):
    loop i from 0 to std::list::length(xs):
        std::list::get(xs, i, 0) * 2

doubled([1, 2, 3])
