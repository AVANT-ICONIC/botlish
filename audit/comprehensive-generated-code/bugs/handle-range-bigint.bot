import std::byte

# S0 miscompile repro (same root cause): from_int<int>'s entry Range is [45,45], so a
# BigInt reaching it through the handled call is compared raw. interp: [45, [1, 2]].
a = std::byte::from_int(45)
ns = [0 - 100000000000000000000000, 100000000000000000000000]
bs = loop n in ns:
    b = std::byte::from_int(n):
        on std::byte::BelowRange:
            1
        on std::byte::AboveRange:
            2
    b
[a, bs]
