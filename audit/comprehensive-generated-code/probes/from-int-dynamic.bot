import std::byte

# Probe A: std::byte::from_int on an unconstrained Int (a listloop element: no
# range fact reaches it), both errors handled. Shape of tests/ascii.test's
# loop-over-ns programs.
ns = [0 - 1, 45, 300]
loop n in ns:
    b = std::byte::from_int(n):
        on std::byte::BelowRange:
            0
        on std::byte::AboveRange:
            0
    b
