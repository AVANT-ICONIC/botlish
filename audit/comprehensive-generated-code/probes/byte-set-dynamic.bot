import std::byte

# std::byte::set on a List[UnicodeChar] that is not a literal (a listloop's
# result), so the static completion proof cannot enumerate it: AboveRange
# stays a runtime obligation (handled). U+0100 fails at runtime.
cs = loop c in ['A', 'Ā', 'B']:
    c
s = std::byte::set(cs):
    on std::byte::AboveRange:
        std::byte::set(['A'])
s
