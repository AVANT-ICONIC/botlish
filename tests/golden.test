# golden.test -- the Botlish golden suites (tests/golden/*.bot,
# GOLDEN-TEST-FRAMEWORK.md) as part of the Tcl suite -- by default the eight
# suites of the framework's validation sample, every suite with
# BOTLISH_GOLDEN_SUITES=all (see goldenSelected below): every suite compiles,
# runs on the backends of this pass, reports no failed test, and reports
# exactly the tests tests/golden/manifest.tsv lists for it -- so a ported
# test cannot disappear, or one be added, without the manifest saying so.
#
# Backends: the outer pass's own (CORE_BACKEND interp or compile), plus
# Cranelift in the interp pass and unspecialized Cranelift
# (cranelift-generic) in the compile pass, so the two passes of
# tests/all.tcl cover the four executable paths the Tcl suite's own
# differential tests use, each once; native-coverage's cranelift pass runs
# Cranelift; run directly, the file runs all four. (tests/golden/run.tcl runs every suite on every
# backend at once, for a quick look.)

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot tests golden run.tcl]

interp recursionlimit {} 100000

if {![info exists ::env(CORE_BACKEND)]} {
    set goldenBackends {interp compile cranelift-generic cranelift}
} elseif {$::env(CORE_BACKEND) eq "interp"} {
    set goldenBackends {interp cranelift}
} elseif {$::env(CORE_BACKEND) eq "compile"} {
    set goldenBackends {compile cranelift-generic}
} else {
    set goldenBackends [list $::env(CORE_BACKEND)]
}
# Native coroutines exist on x86-64 Linux only (COROUTINES.md), and
# lib/test.bot's runner is a coroutine: elsewhere the suites run on the Tcl
# backends of this pass only (and not at all in a native-only pass).
testConstraint goldenBackends [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]
if {![testConstraint goldenBackends]} {
    set goldenBackends [lsearch -all -inline -not -glob $goldenBackends cranelift*]
    testConstraint goldenBackends [expr {[llength $goldenBackends] > 0}]
}

# The manifest's ported tests: a dict suite file -> the list of its test
# names, in manifest order.
proc goldenManifest {} {
    set path [file join $::projectRoot tests golden manifest.tsv]
    if {![file exists $path]} {
        return [dict create]
    }
    set channel [open $path]
    fconfigure $channel -encoding utf-8
    set lines [split [string trimright [read $channel] \n] \n]
    close $channel
    set header [split [lindex $lines 0] \t]
    set suiteColumn [lsearch -exact $header suite]
    set testColumn [lsearch -exact $header new_test]
    set ported [dict create]
    foreach line [lrange $lines 1 end] {
        set fields [split $line \t]
        set suite [lindex $fields $suiteColumn]
        set name [lindex $fields $testColumn]
        if {$name eq "-" || $suite eq "-"} continue
        dict lappend ported $suite $name
    }
    return $ported
}

set goldenPorted [goldenManifest]

# Which suites this file runs. By default the eight suites of the framework's
# validation sample (GOLDEN-TEST-FRAMEWORK.md): this file runs inside both
# passes of tests/all.tcl, and the large-scale migration's suites
# (LARGE-SCALE-GOLDEN-MIGRATION.md) multiply the front-end work far beyond
# them -- which suites a local run includes is the next milestone's decision,
# so the local default stays what it was. BOTLISH_GOLDEN_SUITES=all runs every
# tests/golden/*.bot (CI's golden jobs run every suite on every backend
# through audit/golden/tools/check.tcl); a list of file names runs those.
set goldenAll [lsort [glob -directory [file join $::projectRoot tests golden] *.bot]]
set goldenSample {collections.bot diagnostics.bot errors.bot harness.bot modules.bot ownership.bot representation.bot values.bot}
if {![info exists ::env(BOTLISH_GOLDEN_SUITES)] || $::env(BOTLISH_GOLDEN_SUITES) eq ""} {
    set goldenSelected [lmap p $goldenAll {expr {[file tail $p] in $goldenSample ? $p : [continue]}}]
} elseif {$::env(BOTLISH_GOLDEN_SUITES) eq "all"} {
    set goldenSelected $goldenAll
} else {
    set goldenSelected [lmap p $goldenAll {expr {[file tail $p] in [split $::env(BOTLISH_GOLDEN_SUITES) ", "] ? $p : [continue]}}]
}
# Suite file -> the economics of its static decisions (hir/static.tcl's
# staticStats), for golden-static-economics below.
set goldenStatic [dict create]

foreach path $goldenSelected {
    set suite [file tail $path]
    test golden-$suite "the golden suite $suite: compiles once, passes every test on [join $goldenBackends {, }] (the same report on each), and reports exactly the manifest's tests" -constraints goldenBackends -body {
        set result [golden::suite $path $goldenBackends]
        set status [dict get $result status]
        if {$status eq "compile-error"} {
            return "compile error: [lindex [dict get $result compile] 1]"
        }
        if {$status eq "host-excluded"} {
            # Compiled, not run: its golden-host is another host (run.tcl).
            return ok
        }
        set hir [lindex [dict get $result compile] 1]
        if {[dict exists $hir staticStats]} {
            dict set ::goldenStatic $suite [dict get $hir staticStats]
        }
        set problems {}
        foreach {backend outcome} [dict get $result outcomes] {
            if {[lindex $outcome 0] eq "abort"} {
                lappend problems "$backend aborted: [lindex $outcome 1]"
                continue
            }
            foreach line [lindex $outcome 1] {
                if {[string match "FAIL *" $line] || [string match "  *" $line]} {
                    lappend problems "$backend: $line"
                }
            }
        }
        if {$status eq "disagree"} {
            lappend problems "the backends' reports differ"
        }
        set first [lindex [dict get $result outcomes] 1]
        if {[lindex $first 0] eq "lines"} {
            set names [lmap line [golden::verdicts [lindex $first 1]] {string range $line 5 end}]
            set listed [expr {[dict exists $::goldenPorted $suite] ? [dict get $::goldenPorted $suite] : {}}]
            if {[llength $names] != [llength [lsort -unique $names]]} {
                lappend problems "a test name is reported twice"
            }
            # Several Tcl tests may map to one golden test: the manifest
            # lists it once per row.
            if {[lsort -unique $names] ne [lsort -unique $listed]} {
                foreach n $names { if {$n ni $listed} { lappend problems "not in the manifest: $n" } }
                foreach n $listed { if {$n ni $names} { lappend problems "in the manifest, not reported: $n" } }
            }
        }
        if {$problems eq {}} {
            return ok
        }
        return [join $problems \n]
    } -result ok
}

# The static decisions' economics over every suite (STATIC-COMPILE.md,
# "Decision economics"; STATIC-DECISION-ECONOMICS.md): whole-program builds
# grow with the suites' semantic dependency depth, not with how many blocks
# they hold or how they are laid out. Loose ceilings, not exact counts (a
# harmless new build in some phase should not fail them): per suite at most 8
# decision rounds and at most 15 whole builds besides the method-call trial
# builds (one per candidate of an undecided method-style call in a round:
# bounded by the candidates, never by the number of tests), and on average at
# most 6 builds per suite in all. The eight suites of the validation sample
# took 79 builds before the batched scheduler (one of them 194 in its natural
# layout) and 37 with it, 4.6 per suite. The large-scale migration
# (LARGE-SCALE-GOLDEN-MIGRATION.md) found suites whose method-heavy code costs
# more trial builds (one suite 30 builds in 5 rounds) and traced every one to
# the method decisions or the deliberate internal-id ordering, none to a
# missed dependency; audit/golden/tools/check.tcl applies the same ceilings to
# every suite in CI. A suite that needs more is a compiler regression or a
# real dependency to explain, never a ceiling to raise automatically.
testConstraint goldenAllSuites [expr {[dict size $goldenStatic] > 0
    && [dict size $goldenStatic] == [llength $goldenSelected]}]
test golden-static-economics {the golden suites' static decisions take at most 8 rounds and 15 whole-program builds besides method-call trials in any one suite and on average at most 6 builds per suite, with no build contradicting a prediction of the batched scheduler (over the suites this run selected)} -constraints goldenAllSuites -body {
    set problems {}
    set total 0
    dict for {suite stats} $goldenStatic {
        set builds [dict get $stats builds]
        incr total $builds
        if {[dict get $stats rounds] > 8 || $builds - [dict get $stats methodTrials] > 15} {
            lappend problems "$suite: $builds builds, [dict get $stats methodTrials] method trials ([dict get $stats rounds] rounds)"
        }
        if {[dict get $stats mispredicted] ne {}} {
            lappend problems "$suite: mispredicted [dict get $stats mispredicted]"
        }
    }
    if {$total > 6 * [dict size $goldenStatic]} {
        lappend problems "$total builds in all over [dict size $goldenStatic] suites"
    }
    expr {$problems eq {} ? "ok" : [join $problems \n]}
} -result ok

cleanupTests
