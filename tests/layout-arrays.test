# layout-arrays.test -- fixed arrays in binary layouts (FIXED-LAYOUT-ARRAYS.md):
# `field NAME: array N of E at OFFSET`, its copied value (a List of exactly N
# element values), its live native array (NativeView[array N of E] /
# NativeEdit[array N of E]: binary::element, binary::store_element,
# binary::load), whole-array writes (binary::store, binary::write,
# binary::write_foreign with a List) and static element designators
# (L.items[3], L.pts[2].x, L.m[1][2]).
#
# A fixed array is repetition in a representation, not a new object model:
# the copied value is an ordinary List, the extent is the layout's, element i
# lies at the field's offset plus i times the element's own width (a nested
# layout's size, tail padding included; never a C alignment rule), and an
# array of characters is an array of integers, never text.
#
# Every expectation is the test's own: bytes written out by hand or by
# laBytes (the test's little-endian model, never a descriptor or generated
# code), native memory copied back by the fixture with no layout, and the C
# oracle (tests/cffi/narray-fixture.c), whose arrays C itself lays out and
# checks with its own typed reads. Byte-side behaviour runs on all four
# backends; live native memory on the native ones (the Tcl backends have
# none, and refuse a view or an edit before any array could exist).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]

core::cabi::installTestFixture

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint nativeLinux [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64 aarch64} && [testConstraint nativeBuilt]}]
testConstraint executableAot [expr {[testConstraint nativeLinux]}]
testConstraint cCompiler [expr {[auto_execok cc] ne ""}]

set laBackends {interp compile cranelift-generic cranelift}
set laNative {cranelift-generic cranelift}

# The imports and helpers every program below starts with: bytes_of(xs),
# mutable(xs), memory(xs) and dump(p, n) as in native-edit.test (the
# fixture's memory and its layout-free copy back); u8(v) ... i64(v) an Int
# clamped into a scalar domain (0 outside it: the tests pass values inside),
# u8s(xs) ... i64s(xs) a List of them -- a List[binary::U8] is what an array
# of binary::U8 holds, and a List literal is a List[int] (List element types
# are invariant).
set laPrelude {import abi
import abi::bytes
import binary
import binary::native
import byte
import ffi::c
import ffi_fixture
import list

fn bytes_of(values: List[int]) -> abi::bytes::Bytes:
    bs = loop v in values:
        b = byte::from_int(v):
            on byte::BelowRange:
                0
            on byte::AboveRange:
                255
        b
    abi::bytes::from_list(bs)

fn mutable(values: List[int]) -> abi::bytes::MutableBytes:
    abi::bytes::from_bytes(bytes_of(values))

fn memory(values: List[int]) -> ffi::c::Ptr[ffi::c::Void]:
    ffi_fixture::memory[ffi::c::Void](bytes_of(values))

fn dump(p: ffi::c::Ptr[ffi::c::Void], n: int) -> List[any]:
    ffi_fixture::memory_bytes(p, n)

fn frozen(data: abi::bytes::MutableBytes) -> abi::bytes::Bytes:
    abi::bytes::freeze(data)

fn fill(n: int, byte: int) -> List[int]:
    loop i from 0 to n:
        byte

fn u8(v: int) -> binary::U8:
    if v < 0 or v > 255:
        0
    else:
        v

fn i8(v: int) -> binary::I8:
    if v < -128 or v > 127:
        0
    else:
        v

fn u16(v: int) -> binary::U16:
    if v < 0 or v > 65535:
        0
    else:
        v

fn i16(v: int) -> binary::I16:
    if v < -32768 or v > 32767:
        0
    else:
        v

fn u32(v: int) -> binary::U32:
    if v < 0 or v > 4294967295:
        0
    else:
        v

fn i32(v: int) -> binary::I32:
    if v < -2147483648 or v > 2147483647:
        0
    else:
        v

fn u64(v: int) -> binary::U64:
    if v < 0 or v > 18446744073709551615:
        0
    else:
        v

fn i64(v: int) -> binary::I64:
    if v < -9223372036854775808 or v > 9223372036854775807:
        0
    else:
        v

fn u8s(xs: List[int]) -> List[binary::U8]:
    loop x in xs:
        u8(x)

fn i8s(xs: List[int]) -> List[binary::I8]:
    loop x in xs:
        i8(x)

fn u16s(xs: List[int]) -> List[binary::U16]:
    loop x in xs:
        u16(x)

fn i16s(xs: List[int]) -> List[binary::I16]:
    loop x in xs:
        i16(x)

fn u32s(xs: List[int]) -> List[binary::U32]:
    loop x in xs:
        u32(x)

fn i32s(xs: List[int]) -> List[binary::I32]:
    loop x in xs:
        i32(x)

fn u64s(xs: List[int]) -> List[binary::U64]:
    loop x in xs:
        u64(x)

fn i64s(xs: List[int]) -> List[binary::I64]:
    loop x in xs:
        i64(x)

}

# The representative layouts (tests/golden/layout-arrays.bot declares the same).
set laLayouts {opaque struct Node:
    tag: unit

layout PT:
    size 4
    align 2
    field x: binary::I16 at 0
    field y: binary::U16 at 2

layout TAILED:
    size 8
    align 4
    field a: binary::U32 at 0
    field b: binary::U8 at 4

layout PACKED:
    size 5
    align 1
    field a: binary::U8 at 0
    field b: binary::U32 at 1

layout ALIGNED:
    size 16
    align 16
    field v: binary::U32 at 0

layout SCALARS:
    size 64
    align 8
    field u8: array 3 of binary::U8 at 0
    field i8: array 3 of binary::I8 at 3
    field u16: array 2 of binary::U16 at 6
    field i16: array 2 of binary::I16 at 10
    field u32: array 2 of binary::U32 at 16
    field i32: array 2 of binary::I32 at 24
    field u64: array 1 of binary::U64 at 32
    field i64: array 2 of binary::I64 at 40

layout SHAPES:
    size 48
    align 4
    field first: array 4 of binary::U8 at 0
    field mid: binary::U16 at 4
    field m: array 2 of array 3 of binary::U16 at 6
    field tails: array 2 of TAILED at 20
    field pts: array 2 of PT at 36
    field last: array 4 of binary::U8 at 44

layout PACKS:
    size 16
    align 1
    field tag: binary::U8 at 0
    field ps: array 3 of PACKED at 1

layout ALIGNS:
    size 48
    align 16
    field n: binary::U8 at 0
    field vs: array 2 of ALIGNED at 16

layout CUBE:
    size 24
    align 1
    field c: array 2 of array 3 of array 4 of binary::U8 at 0

layout PTRS:
    size 32
    align 8
    field n: binary::U32 at 0
    field ps: array 2 of ffi::c::Ptr[Node] at 8
    field fs: array 1 of ffi::c::FnPtr[Fn{args: [ffi::c::Int], return: ffi::c::Int}] at 24

layout PREC:
    size 16
    align 8
    field k: binary::U32 at 0
    field p: ffi::c::Ptr[Node] at 8

layout PRECS:
    size 40
    align 8
    field n: binary::U8 at 0
    field rs: array 2 of PREC at 8

layout BIG:
    size 592
    align 4
    field attrs: binary::U32 at 0
    field name: array 260 of binary::U16 at 44
    field alt: array 14 of binary::U16 at 564

}

# A program's value as text: an abi::bytes::Bytes as bytes(HEX ...), a List
# element-wise, anything else as core::value::show does.
proc laShow {v} {
    switch -- [core::value::kind $v] {
        struct {
            if {[core::value::structId $v] eq [core::bytestore::bytesType]} {
                set hex [core::value::bytestoreHex [lindex [core::value::structValues $v] 0]]
                return "bytes([join [regexp -all -inline .. $hex] { }])"
            }
        }
        list {
            return "\[[join [lmap item [core::value::items $v] {laShow $item}] {, }]\]"
        }
    }
    return [core::value::show $v]
}

# The outcome of HIR on BACKEND: {value TEXT} or {error KIND MESSAGE}.
proc laOutcome {backend hir} {
    resetEffects
    if {[catch {
        switch -- $backend {
            interp {
                set saved [core::useBackend]
                core::useBackend interp
                try {
                    core::evalProgram [hir::lower $hir]
                } finally {
                    core::useBackend $saved
                }
            }
            compile { core::compiler::evalHir $hir }
            cranelift-generic { native::evalHir $hir -specialize 0 }
            cranelift { native::evalHir $hir }
        }
    } result options]} {
        return [list error [lindex [dict get $options -errorcode] end] $result]
    }
    return [list value [laShow $result]]
}

# The whole program text of SOURCE: the prelude, the layouts and SOURCE --
# headed `direct module` when SOURCE makes a native view or edit.
proc laProgram {source} {
    set direct [expr {[string first binary::native::edit( $source] >= 0
        || [string first binary::native::view( $source] >= 0}]
    set marker [expr {$direct ? "direct module\n\n" : ""}]
    return "$marker$::laPrelude$::laLayouts$source"
}

# The program SOURCE (after the prelude and the layouts), compiled strictly
# once and run on BACKENDS (all four by default): "same: TEXT" when every
# backend agrees, otherwise every outcome.
proc laRun {source {backends ""}} {
    if {$backends eq ""} {
        set backends $::laBackends
    }
    set hir [surface::compile [laProgram $source] arrays.bot -warnings off]
    set outcomes [lmap backend $backends {laOutcome $backend $hir}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        set first [lindex $outcomes 0]
        if {[lindex $first 0] eq "value"} {
            return "same: [lindex $first 1]"
        }
        return "same error: [lindex $first 1]: [lindex $first 2]"
    }
    return [join [lmap backend $backends outcome $outcomes {list $backend $outcome}] " / "]
}

# laRun on the native backends.
proc laNativeRun {source} {
    return [laRun $source $::laNative]
}

# The diagnostics compiling SOURCE (with the prelude and the layouts unless
# BARE) raises: a list of {KIND LINE:COLUMN MESSAGE}, or "accepted".
proc laDiagnostics {source {bare 0}} {
    set text [expr {$bare ? $source : [laProgram $source]}]
    if {![catch {surface::compile $text arrays.bot -warnings off} message options]} {
        return accepted
    }
    if {[dict exists $options -diagnostics]} {
        set raised [lmap d [dict get $options -diagnostics] {
            list [dict get $d errorcode] [dict get $d message]
        }]
    } else {
        set raised [list [list [dict get $options -errorcode] $message]]
    }
    lmap d $raised {
        lassign $d code message
        set at ?
        regexp {^arrays\.bot:([0-9]+:[0-9]+): (.*)$} $message -> at message
        list [lindex $code end] $at $message
    }
}

# The kinds of laDiagnostics, without a stale direct marker's.
proc laKinds {source {bare 0}} {
    set result [laDiagnostics $source $bare]
    if {$result eq "accepted"} {
        return accepted
    }
    set kinds [lmap d $result {
        if {[lindex $d 0] eq "STALE-DIRECT-MODULE"} continue
        lindex $d 0
    }]
    return [expr {$kinds eq {} ? "accepted" : $kinds}]
}

# The first diagnostic's KIND and MESSAGE other than a stale marker's.
proc laFirst {source {bare 0}} {
    foreach d [laDiagnostics $source $bare] {
        if {[lindex $d 0] ne "STALE-DIRECT-MODULE" && $d ne "accepted"} {
            return [list [lindex $d 0] [lindex $d 2]]
        }
    }
    return accepted
}

# The bare layout declarations TEXT, compiled alone with binary and ffi::c
# imported: their diagnostics (laDiagnostics), "accepted" otherwise.
proc laDeclaration {text} {
    return [laDiagnostics "import binary\nimport ffi::c\n\n$text\n0\n" 1]
}

# The NIR text of function NAME of the program SOURCE (after the prelude and
# the layouts), lowered with specialization (SPECIALIZE 0: without), without
# expression markers.
proc laNir {source name {specialize 1}} {
    set hir [surface::compile [laProgram $source] arrays.bot -warnings off]
    set lines {}
    set inside 0
    foreach line [split [native::nir $hir -specialize $specialize] \n] {
        if {[regexp {^func [0-9]+ "([^"]*)"} $line -> fname]} {
            set inside [expr {$fname eq $name}]
        }
        if {$inside} {
            lappend lines [regsub { @e[0-9]+$} $line {}]
            if {$line eq "end"} {
                set inside 0
            }
        }
    }
    return [join $lines \n]
}

# The `op` names of the NIR text NIR, in order.
proc laOps {nir} {
    return [regexp -all -inline -line {(?:= op |^\s+op )(\S+)} $nir]
}

# The op names alone (laOps without the matched prefixes).
proc laOpNames {nir} {
    set names {}
    foreach line [split $nir \n] {
        if {[regexp {= op (\S+)} $line -> op]} {
            lappend names $op
        }
    }
    return $names
}

# The WIDTH little-endian bytes of the Int N (two's complement for a
# negative N): the test's own model.
proc laLe {n width} {
    set bits [expr {8 * $width}]
    set u [expr {$n < 0 ? $n + (1 << $bits) : $n}]
    set bytes {}
    for {set i 0} {$i < $width} {incr i} {
        lappend bytes [expr {($u >> (8 * $i)) & 255}]
    }
    return $bytes
}

# SIZE bytes of FILL with every {OFFSET VALUE WIDTH} of FIELDS written in
# (laLe): the test's model of a record.
proc laBytes {size fill fields} {
    set bytes [lrepeat $size $fill]
    foreach field $fields {
        lassign $field offset value width
        set i $offset
        foreach b [laLe $value $width] {
            lset bytes $i $b
            incr i
        }
    }
    return $bytes
}

# BYTES (Ints) as laShow shows an abi::bytes::Bytes.
proc laHex {bytes} {
    return "bytes([join [lmap b $bytes {format %02x $b}] { }])"
}

# BYTES as a Botlish List literal.
proc laList {bytes} {
    return "\[[join $bytes {, }]\]"
}

# A per-element run of FIELDS for laBytes: COUNT elements of WIDTH bytes
# from OFFSET, STRIDE apart, valued VALUES.
proc laRow {offset stride width values} {
    set fields {}
    set i 0
    foreach v $values {
        lappend fields [list [expr {$offset + $i * $stride}] $v $width]
        incr i
    }
    return $fields
}

# ---------------------------------------------------------------------------
# Declarations: syntax, registry, descriptor, validation

test la-syntax {`array N of TYPE` is a field type (the element any representation, an array included, C's dimension order); "array" and "of" are contextual -- a type or a binding called array is unaffected -- and the AST prints the form as written; a missing "of" is a located syntax error} -body {
    set ast [surface::formatAst [surface::parse "layout L:\n    size 8\n    align 2\n    field m: array 2 of array 2 of binary::U16 at 0\n" a.bot]]
    list [regexp -inline {array 2 of array 2 of binary::U16} $ast] \
        [laKinds "array = 3\nfn f(array: int) -> int:\n    array + 1\nf(array)\n" 1] \
        [lrange [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 8 binary::U8 at 0"] 0] 1 2]
} -cleanup {unset -nocomplain ast} -result {{{array 2 of array 2 of binary::U16}} accepted {7:22 {expected "of" and the element representation after "array 8" (array N of TYPE), found name "binary"}}}

test la-registry {an array field's registry entry is its representation -- extent, stride (the element's width: a scalar's encoding, a nested layout's size with its tail padding, a nested array's whole width), width extent * stride and its element, recursively -- and its consumer type the List of its element's; the descriptor carries the same, so no backend reads the registry} -body {
    set hir [surface::compile [laProgram "0\n"] arrays.bot -warnings off]
    hir::activate $hir
    set fields [dict get [hir::layouts::entry SHAPES] fields]
    set m [lindex $fields 2]
    set tails [lindex $fields 3]
    list [dict get $m kind] [dict get $m extent] [dict get $m stride] [dict get $m width] \
        [dict get $m element kind] [dict get $m element extent] [dict get $m element stride] [dict get $m element element width] \
        [hir::types::show [dict get $m type]] \
        [dict get $tails stride] [dict get $tails width] [hir::types::show [dict get $tails type]] \
        [lindex [hir::layouts::descriptor SHAPES] 3 2] [lindex [hir::layouts::descriptor SHAPES] 3 3]
} -cleanup {unset -nocomplain hir fields m tails} -result {array 2 6 12 array 3 2 2 {List[List[int[binary::U16]]]} 8 16 {List[LayoutStruct[TAILED]]} {m 6 array 2 6 {array 3 2 {u 2 little}}} {tails 20 array 2 8 {layout {{LayoutStruct[TAILED]} 8 4 {{a 0 u 4 little} {b 4 u 1 little}}}}}}

test la-declaration-errors {a malformed array is a located declaration error: an extent of 0 (LAYOUT-ARRAY-EXTENT: a zero-length or flexible array is no fixed array), an array wider than the largest layout (an extent of any size is computed exactly, never wrapped), a field past the layout's size or overlapping a neighbour at either end (LAYOUT-FIELD-BOUNDS, LAYOUT-FIELD-OVERLAP, the array's whole width), an element of no representation (LAYOUT-FIELD-TYPE: int, a struct, bool), a layout containing itself through an array (LAYOUT-CYCLE)} -body {
    list \
        [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 0 of binary::U8 at 0"] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 99999999999999999999999 of binary::U64 at 0"] 0 0] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 3 of array 4294967296 of binary::U8 at 0"] 0 0] \
        [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 9 of binary::U8 at 0"] \
        [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 8 of binary::U8 at 0"] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of binary::U16 at 2\n    field b: binary::U8 at 5"] 0 0] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field b: binary::U8 at 5\n    field a: array 2 of binary::U16 at 2"] 0 0] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of int at 0"] 0 0] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of L at 0"] 0 0] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of array 2 of bool at 0"] 0 0]
} -result {{{LAYOUT-ARRAY-EXTENT 7:14 {field "a" of layout "L" is an array of 0 elements: a fixed array's extent is a positive integer (a C zero-length or flexible array is not a fixed array)}}} LAYOUT-ARRAY-EXTENT LAYOUT-ARRAY-EXTENT {{LAYOUT-FIELD-BOUNDS 7:39 {field "a" of layout "L" occupies bytes 0..8 (offset 0, width 9), outside the layout's size 8}}} accepted LAYOUT-FIELD-OVERLAP LAYOUT-FIELD-OVERLAP LAYOUT-FIELD-TYPE LAYOUT-CYCLE LAYOUT-FIELD-TYPE}

test la-declaration-element-messages {an invalid element says what the element is, and how deep: the elements of a field, the elements of its elements} -body {
    list \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of int at 0"] 0 2] \
        [lindex [laDeclaration "layout L:\n    size 8\n    align 1\n    field a: array 2 of array 0 of binary::U8 at 0"] 0 2]
} -result {{the elements of field "a" of layout "L" cannot have type int: int has no fixed width: a scalar field is an integer domain whose values are exactly one fixed-width encoding's (e.g. binary::U32, Int in 0..4294967295)} {the elements of field "a" of layout "L" are arrays of 0 elements: a fixed array's extent is a positive integer (a C zero-length or flexible array is not a fixed array)}}

test la-not-a-type {`array N of T` describes bytes, like a layout: it is no type of values (LAYOUT-NOT-A-TYPE, saying a copied array is a List), no LayoutStruct argument (LAYOUT-STRUCT-PARAMETER); it is the argument of NativeView and NativeEdit -- the live array -- whose extent and element are checked like a field's (LAYOUT-ARRAY-EXTENT, LAYOUT-STRUCT-PARAMETER)} -body {
    list \
        [laFirst "fn f(x: array 3 of binary::U8) -> int:\n    0\n0\n"] \
        [laKinds "fn f(x: List\[array 3 of binary::U8\]) -> int:\n    0\n0\n"] \
        [laKinds "fn f(x: LayoutStruct\[array 3 of binary::U8\]) -> int:\n    0\n0\n"] \
        [laKinds "fn f(x: NativeView\[array 0 of binary::U8\]) -> int:\n    0\n0\n"] \
        [laKinds "fn f(x: NativeView\[array 3 of int\]) -> int:\n    0\n0\n"] \
        [laKinds "fn f(x: NativeView\[array 3 of PT\], y: NativeEdit\[array 2 of array 3 of binary::U16\]) -> int:\n    0\n0\n"]
} -result {{LAYOUT-NOT-A-TYPE {unknown or invalid type array 3 of binary::U8 for parameter "x": array 3 of binary::U8 is a layout representation, not a type: a fixed array is a layout field's type (field NAME: array 3 of binary::U8 at OFFSET) or the live array NativeView[array 3 of binary::U8], and a copied fixed array is a List}} LAYOUT-NOT-A-TYPE LAYOUT-STRUCT-PARAMETER LAYOUT-ARRAY-EXTENT LAYOUT-STRUCT-PARAMETER accepted}

test la-stride-is-the-elements-width {stride is the element's own width, from the representation, never a C rule: a nested layout's size with its tail padding (TAILED: 8, its fields end at 5), a packed layout's (PACKED: 5, unaligned elements), an over-aligned layout's (ALIGNED: 16), a row's whole width (SHAPES.m: 6)} -body {
    set hir [surface::compile [laProgram "0\n"] arrays.bot -warnings off]
    hir::activate $hir
    lmap {layout field} {SHAPES tails PACKS ps ALIGNS vs SHAPES m CUBE c} {
        set entry [lsearch -inline -index 0 [lindex [hir::layouts::descriptor $layout] 3] $field]
        lrange $entry 1 4
    }
} -cleanup {unset -nocomplain hir} -result {{20 array 2 8} {1 array 3 5} {16 array 2 16} {6 array 2 6} {0 array 2 12}}

# ---------------------------------------------------------------------------
# The copied value: binary::parse, binary::emit (all four backends)

# Case values of SCALARS, its padding (14..15, 56..63) 0xA5: {FIELD
# OFFSET WIDTH VALUES} each.
set laScalarRows {
    u8 0 1 {0 255 7}
    i8 3 1 {-128 127 -1}
    u16 6 2 {0 65535}
    i16 10 2 {-32768 32767}
    u32 16 4 {4294967295 1}
    i32 24 4 {-2147483648 2147483647}
    u64 32 8 {18446744073709551615}
    i64 40 8 {-9223372036854775808 9223372036854775807}
}

# The model bytes of SCALARS holding laScalarRows, its padding FILL.
proc laScalarBytes {fill} {
    set fields {}
    foreach {name offset width values} $::laScalarRows {
        lappend fields {*}[laRow $offset $width $width $values]
    }
    return [laBytes 64 $fill $fields]
}

# SCALARS holding laScalarRows, as LayoutStruct[SCALARS] shows.
proc laScalarStruct {} {
    set parts {}
    foreach {name offset width values} $::laScalarRows {
        lappend parts "$name: \[[join $values {, }]\]"
    }
    return "LayoutStruct\[SCALARS\] {[join $parts {, }]}"
}

# The construction of LayoutStruct[SCALARS] holding laScalarRows.
proc laScalarConstruction {} {
    set parts {}
    foreach {name offset width values} $::laScalarRows {
        lappend parts "$name: ${name}s(\[[join $values {, }]\])"
    }
    return "LayoutStruct\[SCALARS\] {[join $parts {, }]}"
}

# A program imprinting layout L from the Ints BYTES: [the value].
proc laParseProgram {layout bytes} {
    return "fn go() -> List\[any\]:\n    r = binary::parse($layout, bytes_of([laList $bytes])):\n        on LayoutLengthMismatch:\n            return \[\]\n    \[r\]\ngo()\n"
}

test la-parse-every-scalar-width {an array of every scalar encoding imprints into a List of exactly its extent, each element at its offset plus i times its width, every width's extremes and zero, little-endian, two's complement for the signed ones, a u64 above i64::MAX a BigInt; padding is read by no one -- on every backend} -body {
    list [laRun [laParseProgram SCALARS [laScalarBytes 165]]] [laRun [laParseProgram SCALARS [laScalarBytes 0]]]
} -result [list "same: \[[laScalarStruct]\]" "same: \[[laScalarStruct]\]"]

test la-emit-explicit-bytes {emission writes every element of every array at its offset in its encoding into the layout's size of zero bytes -- the test's own byte model, padding zero -- and parse(emit(v)) == v; on every backend} -body {
    laRun "fn go() -> List\[any\]:\n    v = [laScalarConstruction]\n    b = binary::emit(v):\n        on LayoutExtentMismatch:\n            return \[\]\n    back = binary::parse(SCALARS, b):\n        on LayoutLengthMismatch:\n            return \[\]\n    \[b, back == v\]\ngo()\n"
} -result "same: \[[laHex [laScalarBytes 0]], true\]"

test la-emit-literal-bytes {the same, written out by hand for a two-row array and an array of records: SHAPES with first [1, 2, 3, 4], mid 0x0506, m [[0x0708, 0x090a, 0x0b0c], [0x0d0e, 0x0f10, 0x1112]], tails [(0x13141516, 0x17), (0x18191a1b, 0x1c)], pts [(-2, 3), (4, 65535)], last [0xfd, 0xfe, 0xff, 0]} -body {
    laRun "fn go() -> List\[any\]:\n    v = LayoutStruct\[SHAPES\] {first: u8s(\[1, 2, 3, 4\]), mid: 1286, m: \[u16s(\[1800, 2314, 2828\]), u16s(\[3342, 3856, 4370\])\], tails: \[LayoutStruct\[TAILED\] {a: [expr 0x13141516], b: 23}, LayoutStruct\[TAILED\] {a: 404298267, b: 28}\], pts: \[LayoutStruct\[PT\] {x: -2, y: 3}, LayoutStruct\[PT\] {x: 4, y: 65535}\], last: u8s(\[253, 254, 255, 0\])}\n    b = binary::emit(v):\n        on LayoutExtentMismatch:\n            return \[\]\n    \[b\]\ngo()\n"
} -result {same: [bytes(01 02 03 04 06 05 08 07 0a 09 0c 0b 0e 0d 10 0f 12 11 00 00 16 15 14 13 17 00 00 00 1b 1a 19 18 1c 00 00 00 fe ff 03 00 04 00 ff ff fd fe ff 00)]}

test la-parse-shapes {an array as the first field, between fields, of rows (C's dimension order: element [i][j] at i * 6 + j * 2), of records with tail padding (stride 8: the padding of each element is read by no one), ending exactly at the layout's size; the bytes 0x00..0x2f imprint every element from its own bytes} -body {
    set bytes {}
    for {set i 0} {$i < 48} {incr i} {
        lappend bytes $i
    }
    laRun [laParseProgram SHAPES $bytes]
} -cleanup {unset -nocomplain bytes i} -result {same: [LayoutStruct[SHAPES] {first: [0, 1, 2, 3], mid: 1284, m: [[1798, 2312, 2826], [3340, 3854, 4368]], tails: [LayoutStruct[TAILED] {a: 387323156, b: 24}, LayoutStruct[TAILED] {a: 522067228, b: 32}], pts: [LayoutStruct[PT] {x: 9508, y: 10022}, LayoutStruct[PT] {x: 10536, y: 11050}], last: [44, 45, 46, 47]}]}

test la-parse-packed-and-aligned {arrays of packed records (PACKED, 5 bytes: element i at 1 + 5i, its u32 unaligned) and of over-aligned records (ALIGNED, 16 bytes: element i at 16 + 16i): the stride is the nested layout's size, whatever its alignment} -body {
    set packs [laBytes 16 0 {{0 9 1} {1 1 1} {2 0x04030201 4} {6 2 1} {7 0x08070605 4} {11 3 1} {12 0x0c0b0a09 4}}]
    set aligns [laBytes 48 165 {{0 7 1} {16 0x11223344 4} {32 0x55667788 4}}]
    list [laRun [laParseProgram PACKS $packs]] [laRun [laParseProgram ALIGNS $aligns]]
} -cleanup {unset -nocomplain packs aligns} -result {{same: [LayoutStruct[PACKS] {tag: 9, ps: [LayoutStruct[PACKED] {a: 1, b: 67305985}, LayoutStruct[PACKED] {a: 2, b: 134678021}, LayoutStruct[PACKED] {a: 3, b: 202050057}]}]} {same: [LayoutStruct[ALIGNS] {n: 7, vs: [LayoutStruct[ALIGNED] {v: 287454020}, LayoutStruct[ALIGNED] {v: 1432778632}]}]}}

test la-three-dimensions {an array of arrays of arrays: element [i][j][k] at i * 12 + j * 4 + k (CUBE), imprinted, emitted back exactly, and named by a static designator (CUBE.c[1][2][3] is byte 23)} -body {
    set bytes {}
    for {set i 0} {$i < 24} {incr i} {
        lappend bytes [expr {$i + 100}]
    }
    laRun "fn go() -> List\[any\]:\n    r = binary::parse(CUBE, bytes_of([laList $bytes])):\n        on LayoutLengthMismatch:\n            return \[\]\n    b = binary::emit(r):\n        on LayoutExtentMismatch:\n            return \[\]\n    d = binary::write(mutable(fill(24, 0)), CUBE.c\[1\]\[2\]\[3\], 9):\n        on LayoutLengthMismatch:\n            return \[\]\n    \[r.c, b == bytes_of([laList $bytes]), frozen(d)\]\ngo()\n"
} -cleanup {unset -nocomplain bytes i} -result {same: [[[[100, 101, 102, 103], [104, 105, 106, 107], [108, 109, 110, 111]], [[112, 113, 114, 115], [116, 117, 118, 119], [120, 121, 122, 123]]], true, bytes(00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 09)]}

test la-round-trip {parse(L, emit(v)) == v for values built element by element, rows, records and three dimensions included; emit(parse(L, b)) == b exactly when b's padding is zero (emission canonicalizes padding, inside array elements too: TAILED's three tail bytes)} -body {
    set bytes {}
    for {set i 0} {$i < 48} {incr i} {
        lappend bytes [expr {($i * 37 + 11) % 256}]
    }
    set zeroPadding $bytes
    foreach at {18 19 25 26 27 33 34 35} {
        lset zeroPadding $at 0
    }
    laRun "fn go() -> List\[any\]:\n    a = binary::parse(SHAPES, bytes_of([laList $bytes])):\n        on LayoutLengthMismatch:\n            return \[\]\n    b = binary::parse(SHAPES, bytes_of([laList $zeroPadding])):\n        on LayoutLengthMismatch:\n            return \[\]\n    ea = binary::emit(a):\n        on LayoutExtentMismatch:\n            return \[\]\n    eb = binary::emit(b):\n        on LayoutExtentMismatch:\n            return \[\]\n    aa = binary::parse(SHAPES, ea):\n        on LayoutLengthMismatch:\n            return \[\]\n    \[aa == a, ea == bytes_of([laList $bytes]), eb == bytes_of([laList $zeroPadding]), a == b\]\ngo()\n"
} -cleanup {unset -nocomplain bytes zeroPadding i at} -result {same: [true, false, true, true]}

test la-emit-extent {emission checks every List against its array's extent -- a short one, a long one, a ragged row, a record element's own array -- and fails with the declared LayoutExtentMismatch (nothing is emitted); a List whose length the compiler proves its extent (a literal, a counted collecting loop) needs no handler -- every List of the value proven, a function's result being no proof (its length is not part of its type) -- one proven another length is KNOWN-ERROR} -body {
    set short "fn go(n: int) -> List\[any\]:\n    xs = loop i from 0 to n:\n        u8(i)\n    v = LayoutStruct\[SHAPES\] {first: xs, mid: 0, m: \[u16s(\[1, 2, 3\]), u16s(\[4, 5, 6\])\], tails: \[LayoutStruct\[TAILED\] {a: 1, b: 2}, LayoutStruct\[TAILED\] {a: 3, b: 4}\], pts: \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 3, y: 4}\], last: u8s(\[1, 2, 3, 4\])}\n    b = binary::emit(v):\n        on LayoutExtentMismatch:\n            return \[-1\]\n    \[b\]\n"
    set ragged "fn rows(n: int) -> List\[List\[binary::U16\]\]:\n    loop i from 0 to n:\n        u16s(\[1, 2, 3\])\nfn go(n: int) -> List\[any\]:\n    v = LayoutStruct\[SHAPES\] {first: u8s(\[1, 2, 3, 4\]), mid: 0, m: rows(n), tails: \[LayoutStruct\[TAILED\] {a: 1, b: 2}, LayoutStruct\[TAILED\] {a: 3, b: 4}\], pts: \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 3, y: 4}\], last: u8s(\[1, 2, 3, 4\])}\n    b = binary::emit(v):\n        on LayoutExtentMismatch:\n            return \[-1\]\n    \[abi::bytes::length(b).value\]\n"
    list \
        [laRun "${short}\[go(3), go(5), go(4) == \[\]\]\n"] \
        [laRun "${ragged}\[go(1), go(3), go(2)\]\n"] \
        [laKinds "fn go() -> abi::bytes::Bytes:\n    xs = loop i from 0 to 4:\n        u8(i)\n    r0 = loop i from 0 to 3:\n        u16(i)\n    r1 = loop i from 0 to 3:\n        u16(i)\n    binary::emit(LayoutStruct\[SHAPES\] {first: xs, mid: 0, m: \[r0, r1\], tails: \[LayoutStruct\[TAILED\] {a: 1, b: 2}, LayoutStruct\[TAILED\] {a: 3, b: 4}\], pts: \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 3, y: 4}\], last: xs})\n0\n"] \
        [laKinds "fn go() -> abi::bytes::Bytes:\n    xs = loop i from 0 to 4:\n        u8(i)\n    binary::emit(LayoutStruct\[SHAPES\] {first: xs, mid: 0, m: \[u16s(\[1, 2, 3\]), u16s(\[4, 5, 6\])\], tails: \[LayoutStruct\[TAILED\] {a: 1, b: 2}, LayoutStruct\[TAILED\] {a: 3, b: 4}\], pts: \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 3, y: 4}\], last: xs})\n0\n"] \
        [laKinds "fn go() -> abi::bytes::Bytes:\n    binary::emit(LayoutStruct\[SHAPES\] {first: \[u8(1)\], mid: 0, m: \[u16s(\[1, 2, 3\]), u16s(\[4, 5, 6\])\], tails: \[LayoutStruct\[TAILED\] {a: 1, b: 2}, LayoutStruct\[TAILED\] {a: 3, b: 4}\], pts: \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 3, y: 4}\], last: u8s(\[1, 2, 3, 4\])})\n0\n"] \
        [laKinds "fn go(v: LayoutStruct\[SHAPES\]) -> abi::bytes::Bytes:\n    binary::emit(v)\n0\n"] \
        [laKinds "fn go(v: LayoutStruct\[TAILED\]) -> abi::bytes::Bytes:\n    binary::emit(v)\n0\n"]
} -cleanup {unset -nocomplain short ragged} -result {{same: [[-1], [-1], false]} {same: [[-1], [-1], [48]]} accepted UNHANDLED-ERROR KNOWN-ERROR UNHANDLED-ERROR accepted}

test la-characters-are-not-text {an array of characters is an array of integers of its element type, never a String: a C char array imprints every byte as an ffi::c::Char Int -- a NUL in the middle and the bytes after it included, nothing trimmed, terminated or decoded -- and a wide-character array every unit as an ffi::c::UShort; the field's type is a List of the scalar, not str} -body {
    set chars "layout CHARS:\n    size 16\n    align 2\n    field name: array 8 of ffi::c::Char at 0\n    field wide: array 4 of ffi::c::UShort at 8\n\n"
    set bytes {72 105 0 66 255 128 0 0 65 0 0 216 0 220 0 0}
    list \
        [laRun "${chars}[laParseProgram CHARS $bytes]"] \
        [laKinds "${chars}fn f(v: LayoutStruct\[CHARS\]) -> List\[ffi::c::Char\]:\n    v.name\n0\n"] \
        [laKinds "${chars}fn f(v: LayoutStruct\[CHARS\]) -> str:\n    v.name\n0\n"]
} -cleanup {unset -nocomplain chars bytes} -result {{same: [LayoutStruct[CHARS] {name: [72, 105, 0, 66, -1, -128, 0, 0], wide: [65, 55296, 56320, 0]}]} accepted TYPE}

# ---------------------------------------------------------------------------
# Byte storage: binary::write of a whole array, static element designators,
# binary::write_foreign of an array of pointers (all four backends)

test la-write-whole-array {binary::write(d, L.arr, xs) writes every element of the List into the array's bytes -- a row of scalars, rows of a two-dimensional array, records (each element's fields only: TAILED's tail padding keeps the operand's bytes) -- and returns a new MutableBytes; every byte the array does not own keeps the operand's (0xA5 sentinels), and the operand itself is unchanged} -body {
    set expected [laBytes 48 165 [concat [laRow 0 1 1 {1 2 3 4}] [laRow 6 2 2 {10 11 12 20 21 22}] \
        {{20 0x01020304 4} {24 5 1} {28 0x0a0b0c0d 4} {32 14 1}}]]
    laRun "fn go() -> List\[any\]:\n    d0 = mutable(fill(48, 165))\n    d1 = binary::write(d0, SHAPES.first, u8s(\[1, 2, 3, 4\])):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            return \[\]\n    d2 = binary::write(d1, SHAPES.m, \[u16s(\[10, 11, 12\]), u16s(\[20, 21, 22\])\]):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            return \[\]\n    d3 = binary::write(d2, SHAPES.tails, \[LayoutStruct\[TAILED\] {a: [expr 0x01020304], b: 5}, LayoutStruct\[TAILED\] {a: [expr 0x0a0b0c0d], b: 14}\]):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            return \[\]\n    \[frozen(d3), frozen(d0) == bytes_of(fill(48, 165))\]\ngo()\n"
} -cleanup {unset -nocomplain expected} -result "same: \[[laHex [laBytes 48 165 [concat [laRow 0 1 1 {1 2 3 4}] [laRow 6 2 2 {10 11 12 20 21 22}] {{20 0x01020304 4} {24 5 1} {28 0x0a0b0c0d 4} {32 14 1}}]]], true\]"

test la-write-static-designators {a designator names an element by its static index -- L.first[3], a row's element L.m[1][2], a record element's field L.tails[1].b, L.pts[0].x -- or a whole row L.m[1]: one write at the element's absolute offset (field offset + index * stride), nothing else touched} -body {
    laRun "fn go() -> List\[any\]:\n    d0 = mutable(fill(48, 0))\n    d1 = binary::write(d0, SHAPES.first\[3\], 250):\n        on LayoutLengthMismatch:\n            return \[\]\n    d2 = binary::write(d1, SHAPES.m\[1\]\[2\], 513):\n        on LayoutLengthMismatch:\n            return \[\]\n    d3 = binary::write(d2, SHAPES.tails\[1\].b, 7):\n        on LayoutLengthMismatch:\n            return \[\]\n    d4 = binary::write(d3, SHAPES.pts\[0\].x, -2):\n        on LayoutLengthMismatch:\n            return \[\]\n    d5 = binary::write(d4, SHAPES.m\[0\], u16s(\[1, 2, 3\])):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            return \[\]\n    \[frozen(d5)\]\ngo()\n"
} -result "same: \[[laHex [laBytes 48 0 {{3 250 1} {16 513 2} {32 7 1} {36 -2 2} {6 1 2} {8 2 2} {10 3 2}}]]\]"

test la-write-extent {a whole-array byte write requires the List's exact extent -- fewer or more elements, a ragged row: the declared LayoutExtentMismatch, the operand unchanged (a write never writes its operand); the storage's own size is checked first (LayoutLengthMismatch)} -body {
    laRun "fn w(d: abi::bytes::MutableBytes, xs: List\[binary::U8\]) -> int:\n    r = binary::write(d, SHAPES.first, xs):\n        on LayoutLengthMismatch:\n            return -2\n        on LayoutExtentMismatch:\n            return -1\n    0\nfn rows(d: abi::bytes::MutableBytes, rs: List\[List\[binary::U16\]\]) -> int:\n    r = binary::write(d, SHAPES.m, rs):\n        on LayoutLengthMismatch:\n            return -2\n        on LayoutExtentMismatch:\n            return -1\n    0\nd = mutable(fill(48, 1))\n\[w(d, u8s(\[1, 2, 3\])), w(d, u8s(\[1, 2, 3, 4, 5\])), w(d, u8s(\[1, 2, 3, 4\])), w(mutable(fill(47, 1)), u8s(\[1\])), rows(d, \[u16s(\[1, 2, 3\]), u16s(\[1, 2\])\]), rows(d, \[u16s(\[1, 2, 3\])\]), rows(d, \[u16s(\[1, 2, 3\]), u16s(\[4, 5, 6\])\]), frozen(d) == bytes_of(fill(48, 1))\]\n"
} -result {same: [-1, -1, 0, -2, -1, -1, 0, true]}

test la-designator-diagnostics {a designator's index is checked statically: past the extent LAYOUT-ARRAY-INDEX (at the index), an index of a scalar LAYOUT-OPERAND, a field after an array without an index UNKNOWN-FIELD (saying how an element is named), a designator ending at a record element LAYOUT-OPERAND; an index outside a designator LAYOUT-OPERAND: Botlish has no index expression} -body {
    set f "fn f(d: abi::bytes::MutableBytes) -> int errors LayoutLengthMismatch, LayoutExtentMismatch:\n"
    list \
        [laFirst "${f}    x = binary::write(d, SHAPES.first\[4\], 1)\n    0\n0\n"] \
        [laFirst "${f}    x = binary::write(d, SHAPES.m\[1\]\[3\], 1)\n    0\n0\n"] \
        [laFirst "${f}    x = binary::write(d, SHAPES.mid\[0\], 1)\n    0\n0\n"] \
        [laFirst "${f}    x = binary::write(d, SHAPES.tails.b, 1)\n    0\n0\n"] \
        [laFirst "${f}    x = binary::write(d, SHAPES.tails\[0\], 1)\n    0\n0\n"] \
        [laFirst "fn f(v: LayoutStruct\[SHAPES\]) -> int:\n    0\nfn g(v: LayoutStruct\[SHAPES\]) -> int:\n    v.first\[0\]\n0\n"]
} -cleanup {unset -nocomplain f} -result {{LAYOUT-ARRAY-INDEX {SHAPES.first is a fixed array of 4 elements (indices 0..3): the element index [4] lies outside it}} {LAYOUT-ARRAY-INDEX {SHAPES.m[1] is a fixed array of 3 elements (indices 0..2): the element index [3] lies outside it}} {LAYOUT-OPERAND {SHAPES.mid is a scalar, not a fixed array: an element index [0] names an element of an array}} {UNKNOWN-FIELD {SHAPES.tails is a fixed array, which has no field "b" (an element of a fixed array is named by its index: SHAPES.tails[0])}} {LAYOUT-OPERAND {SHAPES.tails[0] is the nested layout TAILED, not a field a write can name: a write names one scalar or pointer field, or a fixed array (SHAPES.tails[0].a)}} {LAYOUT-OPERAND {an element index (first[0]) is written only in a layout field designator, binary::store(e, L.items[3], v) or binary::write(d, L.items[3], v): Botlish has no index expression (an element of a live array is binary::element(a, i), of a List list::at(xs, i))}}}

test la-write-value-types {a whole-array write's value is held to the field's List type by the ordinary admission rule: a List[binary::U8] for an array of binary::U8 (a List[int] literal is TYPE: List element types are invariant), a List of LayoutStruct[TAILED] for an array of TAILED, never a LayoutStruct of another layout; a static element's value to the element's domain (256 into a U8 element is TYPE)} -body {
    set f "fn f(d: abi::bytes::MutableBytes) -> int errors LayoutLengthMismatch, LayoutExtentMismatch:\n"
    list \
        [laKinds "${f}    x = binary::write(d, SHAPES.first, \[1, 2, 3, 4\])\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write(d, SHAPES.tails, \[LayoutStruct\[PT\] {x: 1, y: 2}, LayoutStruct\[PT\] {x: 1, y: 2}\])\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write(d, SHAPES.first\[0\], 256)\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write(d, SHAPES.first\[0\], 255)\n    0\n0\n"]
} -cleanup {unset -nocomplain f} -result {TYPE TYPE TYPE accepted}

test la-pointer-arrays-from-bytes {pointer authority, recursively inside arrays: a layout holding an array of pointers -- directly, or in an array of records with a pointer field -- is never imprinted from bytes nor emitted into them (LAYOUT-NATIVE-ONLY, the pointer named by its path: ps[], rs[].p); an ordinary byte write of the array is LAYOUT-NATIVE-ONLY; binary::write_foreign of an array of scalars, or of records holding pointers, is LAYOUT-FOREIGN-WRITE (no recursive foreign serialization)} -body {
    set f "fn f(d: abi::bytes::MutableBytes, b: abi::bytes::Bytes, q: ffi::c::Ptr\[Node\]) -> int errors LayoutLengthMismatch, LayoutExtentMismatch:\n"
    list \
        [laFirst "${f}    x = binary::parse(PTRS, b)\n    0\n0\n"] \
        [laFirst "${f}    x = binary::parse(PRECS, b)\n    0\n0\n"] \
        [laKinds "${f}    ps = \[ffi::c::clone(q), ffi::c::clone(q)\]\n    x = binary::write(d, PTRS.ps, ps)\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write_foreign(d, SHAPES.first, u8s(\[1, 2, 3, 4\]))\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write_foreign(d, PRECS.rs, \[\])\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write(d, PRECS.rs\[1\].k, 3)\n    0\n0\n"] \
        [laKinds "${f}    x = binary::write_foreign(d, PRECS.rs\[1\].p, q)\n    0\n0\n"]
} -cleanup {unset -nocomplain f} -result {{LAYOUT-NATIVE-ONLY {binary::parse cannot imprint layout "PTRS" from bytes: its field "ps[]" is a C pointer, and imprinting arbitrary bytes into it would make a pointer no foreign code handed out; a layout with a pointer field is read through a native view of live native memory (binary::native::view, binary::load)}} {LAYOUT-NATIVE-ONLY {binary::parse cannot imprint layout "PRECS" from bytes: its field "rs[].p" is a C pointer, and imprinting arbitrary bytes into it would make a pointer no foreign code handed out; a layout with a pointer field is read through a native view of live native memory (binary::native::view, binary::load)}} LAYOUT-NATIVE-ONLY LAYOUT-FOREIGN-WRITE LAYOUT-FOREIGN-WRITE accepted accepted}

test la-write-foreign-array {binary::write_foreign(d, L.ps, ps) encodes a List of existing pointers of exactly the element's type into an array of pointers: each one's address bits in the target's pointer width, null as zero bytes, the List's extent checked (LayoutExtentMismatch); the pointers are observed -- still their binding's after the write -- and bytes never decode back into one; on every backend (the Tcl ones have the fixture's addresses too)} -body {
    laRun "fn alone(p: ffi::c::Ptr\[Node\]) -> List\[ffi::c::Ptr\[Node\]\]:\n    \[p\]\nfn go() -> List\[any\]:\n    q = ffi_fixture::address\[Node\](4886718345)\n    ps = \[ffi::c::null\[Node\](), ffi::c::clone(q)\]\n    d = binary::write_foreign(mutable(fill(32, 165)), PTRS.ps, ps):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            return \[\]\n    one = alone(ffi::c::clone(q))\n    short = binary::write_foreign(mutable(fill(32, 165)), PTRS.ps, one):\n        on LayoutLengthMismatch:\n            return \[\]\n        on LayoutExtentMismatch:\n            mutable(\[0\])\n    \[frozen(d), frozen(short), ffi::c::null?(q), ffi_fixture::address_of(q)\]\ngo()\n"
} -result "same: \[[laHex [laBytes 32 165 {{8 0 8} {16 4886718345 8}}]], bytes(00), false, 4886718345\]"

