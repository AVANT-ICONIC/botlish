test errors-byte-from-int-branch-refinement-result {byte::from_int's own body proves its final else-branch value is a Byte through ordinary branch-sensitive range facts, no builtin escape hatch -- STATIC-COMPLETION-PROOFS.md items 6-10} -body {
    hir::diagnostics [surface::readProgramFile [file join $::projectRoot lib byte.bot] -strict 0]
} -result {}

test errors-generic-bounded-fixture {a test-defined, non-Byte bounded function demonstrates the same call-specific completion proof generically -- STATIC-COMPLETION-PROOFS.md item 15/67} -body {
    proc boundedSrc {} {
        return {error TooSmall
error TooLarge
fn bounded(x: int) -> int errors TooSmall, TooLarge:
    if x < 10:
        fail TooSmall
    else:
        if x > 20:
            fail TooLarge
        else:
            x
}
    }
    set safe [diagKinds [sourceHir "[boundedSrc]bounded(15)"]]
    set tooSmall [diagKinds [sourceHir "[boundedSrc]bounded(5)"]]
    set tooLarge [diagKinds [sourceHir "[boundedSrc]bounded(25)"]]
    set dynamicHir [sourceHir "[boundedSrc]fn g(m: int):\n    bounded(m)"]
    set dynamic [list [diagKinds $dynamicHir] [unhandledSets $dynamicHir]]
    list $safe $tooSmall $tooLarge $dynamic
} -result {{} KNOWN-ERROR KNOWN-ERROR {UNHANDLED-ERROR {{TooLarge TooSmall}}}}

# ---------------------------------------------------------------------------
# An empty literal List never runs a loop body (STATIC-COMPLETION-PROOFS.md,
# "Small literal-list proof", item 92). The completion analysis must keep the
# empty literal `[]` (exactly zero elements) apart from a List it knows
# nothing about -- as a loop's own iterable, and threaded into a callee's
# parameter through an exact call. Both used to be "no fact" (an empty list
# of element values), so the empty literal was charged its loop body's errors:
# an UNHANDLED-ERROR where none can occur (found by the golden migration,
# tests/golden/completion-regressions.bot).

# EACH fails Boom for every element of XS.
set emptyLoopEach {error Boom
fn each(xs) errors Boom:
    loop x in xs:
        fail Boom
    0
}

# The diagnostics of TEXT (-strict 0) as sorted {KIND FUNCTION} pairs,
# FUNCTION the function whose own body holds the diagnosed expression ("top"
# for the program's).
proc diagWhere {text} {
    set hir [sourceHir $text]
    return [lsort [lmap d [hir::diagnostics $hir] {
        set block [dict get $hir scopes [hir::get $hir [dict get $d expr] scope] invocation]
        list [dict get $d kind] [expr {$block eq "" ? "top" : [hir::signatures::Name $hir $block]}]
    }]]
}

test errors-empty-literal-loop-no-handler {each([]) needs no handler: its loop runs zero times, so the call can only complete normally (item 92) -- and so can a loop written over the literal [] itself; accepted strictly, value 0 on every backend} -body {
    set text "${emptyLoopEach}fn direct() errors Boom:\n    loop x in \[\]:\n        fail Boom\n    0\neach(\[\]) + direct()\n"
    list [diagKinds [sourceHir $text]] [parity $text] [value $text]
} -result {{} same 0}

test errors-one-element-literal-loop-known-error {each([1]) runs its body once, which always fails: still a KNOWN-ERROR, handled or not (the per-element walk is unchanged)} -body {
