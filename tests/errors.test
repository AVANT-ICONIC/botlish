        x
f(0)
} {fn make(n: int) -> MutableVector[int] errors Boom:
    mutable_vector::from_list([h(n), 2])
fn f(n: int) -> List[int]:
    v = make(n)
    loop x in v:
        x
f(0)
}
        array {fn make(n: int) -> MutableArray[int] errors Boom:
    mutable_array::create(2, h(n))
fn f(n: int) -> List[int]:
    loop x in make(n):
        x
f(0)
} {fn make(n: int) -> MutableArray[int] errors Boom:
    mutable_array::create(2, h(n))
fn f(n: int) -> List[int]:
    a = make(n)
    loop x in a:
