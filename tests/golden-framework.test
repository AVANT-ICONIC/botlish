# golden-framework.test -- the Botlish golden test framework, lib/test.bot
# (GOLDEN-TEST-FRAMEWORK.md): an ordinary library, tested here like any other
# Botlish program. Every suite program below is compiled once and run on the
# Tcl interpreter, the Tcl compiler and Cranelift, and the backends must
# agree on its report.
#
# What a Botlish program cannot observe -- how often a test body ran,
# coroutine releases -- is observed from here: on the Tcl backends through a
# test-only native, golden_probe(x), that records x and returns it; natively
# through the allocation sites of the body (native::allocationReport), the
# probe written out of the program first (it does not exist natively).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot tests golden run.tcl]

interp recursionlimit {} 100000

testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set gfBackends {interp compile cranelift}

proc gfProbeImpl {v} {
    lappend ::gfProbes [core::value::intOf $v]
    return $v
}
set ::gfProbes {}
if {"golden_probe" ni [core::native::names]} {
    core::registerNative golden_probe -arity 1 -impl gfProbeImpl \
        -param-types {int} -result-type int
}

# The suite program SOURCE compiled once (warnings off), or a Tcl error.
proc gfCompile {source} {
    lassign [golden::compileSource $source] status hir
    if {$status ne "ok"} {
        error "suite does not compile: $hir"
    }
    return $hir
}

# SOURCE's report (its value: a List of Strings) as a Tcl list of lines, the
# same on every backend of BACKENDS -- or "abort: MESSAGE" when every
# backend's run fails the same way. A disagreement is a Tcl error.
proc gfReport {source {backends ""}} {
    if {$backends eq ""} { set backends $::gfBackends }
    set hir [gfCompile $source]
    set outcomes [lmap b $backends {
        set o [golden::run $hir $b]
        if {[lindex $o 0] eq "abort"} {
            # (The message names the backend's own error code; the class
            # of failure is what must agree.)
            list abort [lindex [regexp -inline {\(([A-Z]+ [A-Z-]+)[^)]*\)$} [lindex $o 1]] 1]
        } else {
            lrange $o 0 1
        }
    }]
    if {[llength [lsort -unique $outcomes]] != 1} {
        error "backends disagree: [join [lmap b $backends o $outcomes {list $b $o}] { / }]"
    }
    lassign [lindex $outcomes 0] kind payload
    if {$kind eq "abort"} {
        return "abort: $payload"
    }
    return $payload
}

# The value of SOURCE (any value) as core::value::show prints it, the same
# on every backend.
proc gfValue {source {backends ""}} {
    if {$backends eq ""} { set backends $::gfBackends }
    set hir [gfCompile $source]
    set outcomes [lmap b $backends {lrange [outcomeUnderHir $b $hir] 0 1}]
    if {[llength [lsort -unique $outcomes]] != 1} {
        error "backends disagree: [join [lmap b $backends o $outcomes {list $b $o}] { / }]"
    }
    return [lindex $outcomes 0 1]
}

# The strict compile error of SOURCE as "KIND: message", or "no error".
proc gfStaticError {source} {
    if {[catch {surface::compile $source suite.bot -warnings off} message options]} {
        return "[lindex [dict get $options -errorcode] end]: $message"
    }
    return "no error"
}

# Runs SOURCE (which calls golden_probe) on a Tcl backend: {VALUE PROBES},
# PROBES the values golden_probe recorded, in order.
proc gfProbed {source backend} {
    set hir [gfCompile $source]
    set ::gfProbes {}
    set outcome [outcomeUnderHir $backend $hir]
    return [list [lindex $outcome 1] $::gfProbes]
}

# SOURCE with golden_probe(X) written as X: the program the native backend
# runs (the probe is a Tcl-side test native).
proc gfUnprobed {source} {
    return [regsub -all {golden_probe\(([^()]*)\)} $source {\1}]
}

# The native allocations SOURCE's run makes at sites on line LINE of the
# suite file (summed over those sites).
proc gfNativeAllocationsAt {source line} {
    set hir [gfCompile [gfUnprobed $source]]
    set report [native::allocationReport $hir sites]
    set total 0
    foreach site [dict get $report sites] {
        set location [dict get $site location]
        if {[dict get $location file] eq "suite.bot" && [dict get $location line] == $line} {
            incr total [dict get $site allocations]
        }
    }
    return $total
}

# Every coroutine SOURCE's run creates and releases, on the Tcl backends:
# "created N released IDS", IDS the release order (ids relative to the run).
proc gfReleases {source backend} {
    set hir [gfCompile $source]
    set before $::core::coroutines::nextId
    set ::core::coroutines::releaseCalls {}
    try {
        set outcome [outcomeUnderHir $backend $hir]
        set created [expr {$::core::coroutines::nextId - $before}]
        set released [lmap id $::core::coroutines::releaseCalls {expr {$id - $before}}]
    } finally {
        set ::core::coroutines::releaseCalls none
    }
    return [list [lindex $outcome 1] "created $created released [lsort -integer $released]"]
}

# The native coroutine census of SOURCE's run.
proc gfNativeCoroutines {source} {
    set hir [gfCompile $source]
    set report [native::allocationReport $hir summary]
    return [dict get $report coroutines]
}

proc withGcStress {script} {
    set had [info exists ::env(BOTLISH_NATIVE_GC_STRESS)]
    set saved [expr {$had ? $::env(BOTLISH_NATIVE_GC_STRESS) : ""}]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        return [uplevel 1 $script]
    } finally {
        if {$had} {
            set ::env(BOTLISH_NATIVE_GC_STRESS) $saved
        } else {
            unset ::env(BOTLISH_NATIVE_GC_STRESS)
        }
    }
}

# ---------------------------------------------------------------------------
# The basic shape: one suite, every kind of verdict

set gfMixed {import compiler
import list
import test

error Boom

fn boom(x: int) -> int errors Boom:
    if x > 3:
        fail Boom
    x

fn register_mixed():
    fn adds() errors compiler::CompilerError:
        static compile:
            20 + 22
    test::value("adds", 42, adds)
    fn off_by_one() errors compiler::CompilerError:
        static compile:
            20 + 21
    test::value("off by one", 42, off_by_one)
    fn unbound() errors compiler::CompilerError:
        static compile:
            missing + 1
    test::rejects("unbound", compiler::DiagnosticCode::Unbound, unbound)
    test::rejects("unbound, expecting Type", compiler::DiagnosticCode::Type, unbound)
    test::rejects_at("unbound at its column", compiler::DiagnosticCode::Unbound, 23, 13, unbound)
    test::rejects_at("unbound, wrong column", compiler::DiagnosticCode::Unbound, 23, 14, unbound)
    test::rejects_any("unbound, any diagnostic", unbound)
    test::value("value expected, block rejected", 1, unbound)
    test::rejects("rejection expected, block accepted", compiler::DiagnosticCode::Unbound, adds)
    test::rejects_at("located rejection expected, block accepted", compiler::DiagnosticCode::Unbound, 23, 13, adds)
    test::rejects_any("any rejection expected, block accepted", adds)
    fn lists() errors compiler::CompilerError:
        static compile:
            [1, 2].append(3)
    test::value("lists", [1, 2, 3], lists)
    fn positive?(n):
        n > 0
    test::holds("positive", "a positive number", positive?, adds)
    test::holds("positive, another value", "a positive number", positive?, off_by_one)
    fn negative?(n):
        n < 0
    test::holds("negative, failing", "a negative number", negative?, adds)
}
append gfMixed {
with context test::suite()
register_mixed()
test::report()
}

test gf-verdicts {every helper's pass and mismatch, as data: the report names what was expected, what was observed and the diagnostic's message} -body {
    join [gfReport $gfMixed] \n
} -result {PASS adds
FAIL off by one
  expected: 42
  actual: 41
PASS unbound
FAIL unbound, expecting Type
  expected: compiler diagnostic Type
  actual: compiler diagnostic Unbound at line 23, column 13
  detail: unbound name "missing"
PASS unbound at its column
FAIL unbound, wrong column
  expected: compiler diagnostic Unbound at line 23, column 14
  actual: compiler diagnostic Unbound at line 23, column 13
  detail: unbound name "missing"
PASS unbound, any diagnostic
FAIL value expected, block rejected
  expected: 1
  actual: compiler diagnostic Unbound at line 23, column 13
  detail: unbound name "missing"
FAIL rejection expected, block accepted
  expected: compiler diagnostic Unbound
  actual: value 42
FAIL located rejection expected, block accepted
  expected: compiler diagnostic Unbound at line 23, column 13
  actual: value 42
FAIL any rejection expected, block accepted
  expected: a compiler diagnostic
  actual: value 42
PASS lists
PASS positive
PASS positive, another value
FAIL negative, failing
  expected: a negative number
  actual: 42
7 passed, 8 failed}

# ---------------------------------------------------------------------------
# Registration records; running executes

# A suite whose one case's body records golden_probe(n) when it runs; END is
# the program's last statement.
proc gfCounted {end} {
    return [string map [list END $end] {import compiler
import test

fn register_counted(n: int):
    fn body() errors compiler::CompilerError:
        static compile:
            [golden_probe(n), n]
    test::value("counted", [7, 7], body)

with context test::suite()
register_counted(7)
END
}]
}

test gf-context-required {a registration function needs the installed suite: without one, the call is the ordinary MISSING-CONTEXT, not a test-specific diagnostic} -body {
    gfStaticError {import compiler
import test

fn body() errors compiler::CompilerError:
    static compile:
        1
test::value("one", 1, body)
}
} -match glob -result {MISSING-CONTEXT: suite.bot:7:1: test::Suite is required by this call but is not installed here*}

test gf-registration-does-not-run {registering a case stores its check: the body has not run when registration returns (the probe recorded nothing), on the Tcl backends} -body {
    lmap backend {interp compile} {gfProbed [gfCounted {test::count()}] $backend}
} -result {{1 {}} {1 {}}}

test gf-registration-does-not-run-native {natively: registration allocates the body's closure and the case, but nothing at the body's own List literal (line 7)} -constraints linuxX86_64 -body {
    list [gfNativeAllocationsAt [gfCounted {test::count()}] 7] [gfNativeAllocationsAt [gfCounted {test::report()}] 7]
} -result {0 1}

test gf-run-executes-once {one run calls each check exactly once} -body {
    lmap backend {interp compile} {gfProbed [gfCounted {test::report()}] $backend}
} -result {{{["PASS counted", "1 passed, 0 failed"]} 7} {{["PASS counted", "1 passed, 0 failed"]} 7}}

test gf-registration-would-abort {a body whose run would abort the whole program (a run-time TYPE no handler catches) is registered without running: the registering program completes; the running one aborts} -body {
    set source {import compiler
import test

fn register_poisoned(text: str):
    fn body() errors compiler::CompilerError:
        static compile:
            1 + text
    test::value("poisoned", 1, body)

with context test::suite()
register_poisoned("x")
END
}
    list [gfValue [string map {END test::count()} $source]] \
        [gfReport [string map {END test::report()} $source]]
} -result {1 {abort: CORE SEMANTIC}}

test gf-repeated-runs {re-running starts every registered case again: two runs, two calls of each check, identical reports} -body {
    lmap backend {interp compile} {gfProbed [gfCounted {[test::report(), test::report()]}] $backend}
} -result {{{[["PASS counted", "1 passed, 0 failed"], ["PASS counted", "1 passed, 0 failed"]]} {7 7}} {{[["PASS counted", "1 passed, 0 failed"], ["PASS counted", "1 passed, 0 failed"]]} {7 7}}}

test gf-repeated-runs-native {natively, two runs execute the body twice} -constraints linuxX86_64 -body {
    gfNativeAllocationsAt [gfCounted {[test::report(), test::report()]}] 7
} -result 2

test gf-registration-order {cases run, and report, in registration order} -body {
    golden::verdicts [gfReport {import compiler
import test

fn register_five():
    fn one() errors compiler::CompilerError:
        static compile:
            1
    test::value("e", 1, one)
    test::value("b", 1, one)
    test::value("d", 1, one)
    test::value("a", 1, one)
    test::value("c", 1, one)

with context test::suite()
register_five()
test::report()
}]
} -result {{PASS e} {PASS b} {PASS d} {PASS a} {PASS c}}

test gf-empty-suite {an empty suite reports no case: the runner completes during its construction, sending the empty batch} -body {
    list [gfReport {import test
with context test::suite()
test::report()
}] [gfValue {import coroutine
import test
with context test::suite()
coroutine {step, first} = test::run()
[first, coroutine::done?(step)]
}]
} -result {{{0 passed, 0 failed}} {[[], true]}}

test gf-failures-continue {a mismatch is data: pass, value mismatch, pass, compiler-diagnostic mismatch, pass are five results} -body {
    gfReport {import compiler
import test

fn register_alternating():
    fn one() errors compiler::CompilerError:
        static compile:
            1
    fn unbound() errors compiler::CompilerError:
        static compile:
            nothing
    test::value("first", 1, one)
    test::value("second", 2, one)
    test::value("third", 1, one)
    test::rejects("fourth", compiler::DiagnosticCode::Type, unbound)
    test::value("fifth", 1, one)

with context test::suite()
register_alternating()
test::report()
}
} -result {{PASS first} {FAIL second} {  expected: 2} {  actual: 1} {PASS third} {FAIL fourth} {  expected: compiler diagnostic Type} {  actual: compiler diagnostic Unbound at line 10, column 13} {  detail: unbound name "nothing"} {PASS fifth} {3 passed, 2 failed}}

test gf-runner-protocol {the runner coroutine sends one result per segment, as a one-element List, then the empty List, and is done} -body {
    gfValue {import compiler
import coroutine
import test

fn register_two():
    fn one() errors compiler::CompilerError:
        static compile:
            1
    test::value("a", 1, one)
    test::value("b", 2, one)

with context test::suite()
register_two()
coroutine {step, first} = test::run()
d0 = coroutine::done?(step)
second = step()
d1 = coroutine::done?(step)
third = step()
d2 = coroutine::done?(step)
names = loop r in [first, second, third]:
    loop x in r:
        [x.name, x.passed]
[names, d0, d1, d2]
}
} -result {[[[["a", true]], [["b", false]], []], false, false, true]}

test gf-runner-abandoned {a driver may stop early: the runner is an ordinary coroutine, released (once) when its handle dies; the cases after the stop do not run} -body {
    set source {import compiler
import test

fn register_two():
    fn one() errors compiler::CompilerError:
        static compile:
            golden_probe(1)
    fn two() errors compiler::CompilerError:
        static compile:
            golden_probe(2)
    test::value("one", 1, one)
    test::value("two", 2, two)

with context test::suite()
register_two()
coroutine {step, first} = test::run()
first == []
}
    lmap backend {interp compile} {
        concat [gfReleases $source $backend] [lindex [gfProbed $source $backend] 1]
    }
} -result {{false {created 1 released 1} 1} {false {created 1 released 1} 1}}

# ---------------------------------------------------------------------------
# Suites are context values: isolation

test gf-one-suite-per-program {a context is installed once per program (CONTEXTS.md): a second suite in the same program is the ordinary DUPLICATE-CONTEXT -- suites are isolated by being separate programs} -body {
    gfStaticError {import test
with context test::suite()
with context test::suite()
test::report()
}
} -match glob -result {DUPLICATE-CONTEXT: *}

test gf-isolation {two suite programs run one after the other in one process, each twice, on every backend: neither sees the other's cases, and a re-created suite starts empty (no state survives a program)} -body {
    set a {import compiler
import test

fn register_a():
    fn one() errors compiler::CompilerError:
        static compile:
            1
    test::value("a1", 1, one)
    test::value("a2", 1, one)

with context test::suite()
register_a()
test::report()
}
    set b {import compiler
import test

fn register_b():
    fn two() errors compiler::CompilerError:
        static compile:
            2
    test::value("b1", 2, two)

with context test::suite()
register_b()
test::report()
}
    list [gfReport $a] [gfReport $b] [gfReport $a] [gfReport $b]
} -result {{{PASS a1} {PASS a2} {2 passed, 0 failed}} {{PASS b1} {1 passed, 0 failed}} {{PASS a1} {PASS a2} {2 passed, 0 failed}} {{PASS b1} {1 passed, 0 failed}}}

test gf-composition {registration functions compose as ordinary functions: one calls two others, and their cases run in call order} -body {
    golden::verdicts [gfReport {import compiler
import test

fn register_math():
    fn sum() errors compiler::CompilerError:
        static compile:
            2 + 3
    test::value("math: sum", 5, sum)

fn register_errors():
    fn missing() errors compiler::CompilerError:
        static compile:
            nowhere
    test::rejects("errors: unbound", compiler::DiagnosticCode::Unbound, missing)

fn register_all():
    register_errors()
    register_math()
    register_errors()

with context test::suite()
register_all()
test::report()
}]
} -result {{PASS errors: unbound} {PASS math: sum} {PASS errors: unbound}}

test gf-application-context {the suite is one ordinary context among others: a program installs its own context too, a registration function reads it and its tests capture the value read; no priority or lookup interaction} -body {
    gfReport {import compiler
import mutable_vector
import test

context struct Config:
    levels: MutableVector[int]

fn levels() -> MutableVector[int]:
    mutable_vector::from_list([3, 4])

fn level_count(context config: Config) -> int:
    mutable_vector::length(config.levels)

fn register_config_tests(context config: Config):
    count = level_count()
    fn counted() errors compiler::CompilerError:
        static compile:
            count * 10
    test::value("config read at registration", 20, counted)

with context Config {levels: levels()}
with context test::suite()
register_config_tests()
summary = test::report()
summary
}
} -result {{PASS config read at registration} {1 passed, 0 failed}}

test gf-body-cannot-use-context {a body is a function value, so it cannot require a context (CONTEXT-FUNCTION-VALUE): it cannot register, or reach the suite, while it runs} -body {
    gfStaticError {import compiler
import test

fn register_nested():
    fn body() errors compiler::CompilerError:
        static compile:
            test::count()
    test::value("nested", 0, body)

with context test::suite()
register_nested()
test::report()
}
} -match glob -result {CONTEXT-FUNCTION-VALUE: *}

# ---------------------------------------------------------------------------
# Eager coroutines and deferral

test gf-eager-coroutine-start {why a case is a function value: constructing a coroutine runs its body to the first yield at once, so a registry of started coroutines would run every test while registering it (the probe fires at construction)} -body {
    lmap backend {interp compile} {gfProbed {import coroutine

struct Event:
    n: int

fn body() -> Event:
    golden_probe(1)
    yield Event {n: 1}
    Event {n: 2}

coroutine {step, first} = body()
first.n
} $backend}
} -result {{1 1} {1 1}}

test gf-coroutine-body-deferred {a case whose body constructs and drives a coroutine: registering it runs nothing; running it runs the coroutine's body once} -body {
    set source {import compiler
import test

struct Event:
    n: int

fn producer(k: int) -> Event:
    golden_probe(k)
    yield Event {n: k}
    Event {n: k + 1}

fn register_coroutine_case(k: int):
    fn body() errors compiler::CompilerError:
        static compile:
            coroutine {step, first} = producer(k)
            first.n + step().n
    test::value("coroutine", 11, body)

with context test::suite()
register_coroutine_case(5)
END
}
    list {*}[lmap backend {interp compile} {gfProbed [string map {END test::count()} $source] $backend}] \
        {*}[lmap backend {interp compile} {gfProbed [string map {END test::report()} $source] $backend}]
} -result {{1 {}} {1 {}} {{["PASS coroutine", "1 passed, 0 failed"]} 5} {{["PASS coroutine", "1 passed, 0 failed"]} 5}}

# ---------------------------------------------------------------------------
# Coroutine cleanup

# A suite whose cases own coroutines that complete, fail (handled inside the
# body) and are abandoned suspended.
set gfCoroutineSuite {import compiler
import test

struct Event:
    n: int

error Broken

fn finite(k: int) -> Event:
    yield Event {n: k}
    Event {n: k + 1}

fn breaking(k: int) -> Event errors Broken:
    yield Event {n: k}
    if k > 0:
        fail Broken
    Event {n: 0}

fn register_coroutine_cases(k: int):
    fn completes() errors compiler::CompilerError:
        static compile:
            coroutine {step, first} = finite(k)
            first.n + step().n
    test::value("completes", 3, completes)
    fn fails() errors compiler::CompilerError:
        static compile:
            coroutine {step, first} = breaking(k):
                on Broken:
                    Event {n: -1}
            last = step():
                on Broken:
                    Event {n: -2}
            first.n * 10 + last.n
    test::value("fails, handled", 8, fails)
    fn abandons() errors compiler::CompilerError:
        static compile:
            coroutine {first} = finite(k)
            first.n
    test::value("abandons", 1, abandons)

with context test::suite()
register_coroutine_cases(1)
test::report()
}

test gf-coroutine-cleanup {every coroutine a run creates -- the runner and each case's own, completed, failed and abandoned while suspended -- is released exactly once, deterministically, on the Tcl backends} -body {
    lmap backend {interp compile} {gfReleases $gfCoroutineSuite $backend}
} -result {{{["PASS completes", "PASS fails, handled", "PASS abandons", "3 passed, 0 failed"]} {created 4 released 1 2 3 4}} {{["PASS completes", "PASS fails, handled", "PASS abandons", "3 passed, 0 failed"]} {created 4 released 1 2 3 4}}}

test gf-coroutine-cleanup-native {natively: four coroutines, four releases (two of them suspended: the abandoned case's and none other), none swept by the collector; the same under GC stress} -constraints linuxX86_64 -body {
    set plain [gfNativeCoroutines $gfCoroutineSuite]
    set stressed [withGcStress {gfNativeCoroutines $gfCoroutineSuite}]
    list [dict get $plain released] [dict get $plain sweptSuspended] \
        [dict get $stressed released] [dict get $stressed sweptSuspended] \
        [expr {[dict get $plain stacksMapped] + [dict get $plain stacksReused]}]
} -result {4 0 4 0 4}


# ---------------------------------------------------------------------------
# Affine captures: the ordinary ownership rules decide

test gf-affine-capture-rejected {a body that captures a coroutine handle owned by the registration function is the ordinary AFFINE-CAPTURE-UNSUPPORTED: the framework neither needs nor gets an exception} -body {
    gfStaticError {import compiler
import test

struct Event:
    n: int

fn finite(k: int) -> Event:
    yield Event {n: k}
    Event {n: k + 1}

fn register_capturing():
    coroutine {step, first} = finite(1)
    fn body() errors compiler::CompilerError:
        step().n
    test::value("captures", 2, body)

with context test::suite()
register_capturing()
test::report()
}
} -match glob -result {AFFINE-CAPTURE-UNSUPPORTED: suite.bot:14:9: `step` is an affine Coroutine*}

test gf-affine-capture-in-a-case {the same capture written inside a case's static compile block is that case's rejection, AffineCaptureUnsupported; a body that owns its coroutine passes; and an ordinary move inside a block is UseAfterMove} -body {
    gfReport {import compiler
import test

struct Event:
    n: int

fn finite(k: int) -> Event:
    yield Event {n: k}
    Event {n: k + 1}

fn register_affine():
    fn captures() errors compiler::CompilerError:
        static compile:
            coroutine {step} = finite(1)
            fn later() -> int:
                step().n
            later()
    test::rejects("capture", compiler::DiagnosticCode::AffineCaptureUnsupported, captures)
    fn owns() errors compiler::CompilerError:
        static compile:
            coroutine {step, first} = finite(1)
            first.n + step().n
    test::value("owns", 3, owns)
    fn moves() errors compiler::CompilerError:
        static compile:
            coroutine {step} = finite(1)
            other = step
            step().n + other().n
    test::rejects("moved", compiler::DiagnosticCode::UseAfterMove, moves)

with context test::suite()
register_affine()
test::report()
}
} -result {{PASS capture} {PASS owns} {PASS moved} {3 passed, 0 failed}}

# ---------------------------------------------------------------------------
# What a body may complete with

test gf-body-error-contract {a body that may raise a declared error other than compiler::CompilerError does not fit a helper: the registration call is rejected (TYPE), naming the error -- there is no catch-all to turn it into data} -body {
    gfStaticError {import compiler
import test

error Boom

fn boom(x: int) -> int errors Boom:
    if x > 3:
        fail Boom
    x

fn register_raising(n: int):
    fn body() errors Boom, compiler::CompilerError:
        boom(n)
    test::value("raises", 1, body)

with context test::suite()
register_raising(1)
test::report()
}
