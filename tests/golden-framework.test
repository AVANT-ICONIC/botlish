} -result {{ok 9} {PASS probe}}

test gf-precision-affine {affine analysis: a coroutine moved to another binding and then resumed is USE-AFTER-MOVE in both; the moved-to binding is fine in both} -body {
    set prelude "struct Event:\n    n: int\nfn finite(k: int) -> Event:\n    yield Event {n: k}\n    Event {n: k + 1}\n"
