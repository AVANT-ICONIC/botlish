# The NIR text of function NAME in the native lowering of SOURCE, without
# its HIR expression ids and its function number.
proc gfFunctionNir {source name} {
    set hir [gfCompile $source]
    set text [native::nir $hir]
    if {![regexp "func \\d+ \"$name\" (\[^\n\]*)\n(.*?)\nend" $text -> header body]} {
        error "no function $name"
    }
    return [regsub -all { ?@e\d+} "$header\n$body" ""]
}

