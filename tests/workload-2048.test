# workload-2048.test -- the 2048 workload (examples/games/2048/,
# 2048-ENGINE-WORKLOAD.md) as part of the Tcl suite: its golden suite on the
# backends of this pass, its programs warning-clean, its benchmark's
# checksum on every backend, and its demo as a standalone executable, with
# and without GC stress.
#
# The engine is an ordinary module that is not standard library, so it is
# not in lib/: it is an application module, the file beside its programs
# (IMPORTS.md, "Application modules"), and every program here is compiled as
# it is, by the front end main.tcl uses. (Before application modules they
# were compiled against a private copy of lib/ with the engine added: S4.)
#
# Backends, as tests/golden.test's: the outer pass's own (CORE_BACKEND
# interp or compile) plus cranelift in the interp pass and
# cranelift-generic in the compile pass; all four when run directly.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot examples games 2048 run.tcl]

interp recursionlimit {} 100000

if {![info exists ::env(CORE_BACKEND)]} {
    set workloadBackends {interp compile cranelift-generic cranelift}
} elseif {$::env(CORE_BACKEND) eq "interp"} {
    set workloadBackends {interp cranelift}
} elseif {$::env(CORE_BACKEND) eq "compile"} {
    set workloadBackends {compile cranelift-generic}
} else {
    set workloadBackends [list $::env(CORE_BACKEND)]
}
# lib/test.bot's runner is a coroutine: natively, x86-64 Linux only
# (COROUTINES.md), as tests/golden.test.
set nativeSuite [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]
set suiteBackends [expr {$nativeSuite ? $workloadBackends : [lsearch -all -inline -not -glob $workloadBackends cranelift*]}]
testConstraint suiteBackends [expr {[llength $suiteBackends] > 0}]
testConstraint executableAot [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64 aarch64}}]
# linux::io's syscalls (the demo's output) exist on Linux x86-64 only.
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" &&
    $::tcl_platform(machine) in {x86_64 amd64}}]

set gameDir [file join $::projectRoot examples games 2048]
testConstraint nativeBuilt [expr {![catch {native::binary}]}]

# The HIR of bench.bot making MOVES moves: its text, with its own directory
# as its application root.
proc benchHir {moves} {
    set path [file join $::gameDir bench.bot]
    regsub -line {^benchmark\(\d+, (.*)\)$} [core::ReadFile $path] "benchmark($moves, \\1)" text
    return [surface::compile $text $path -warnings off -root $::gameDir]
}

test workload-2048-golden-suite "golden.bot: compiles once, all 68 tests pass on [join $suiteBackends {, }], the same report on each" -constraints suiteBackends -body {
    set result [golden::suite [file join $gameDir golden.bot] $suiteBackends]
    set status [dict get $result status]
    if {$status eq "compile-error"} {
        return "compile error: [lindex [dict get $result compile] 1]"
    }
    set problems {}
    foreach {backend outcome} [dict get $result outcomes] {
        if {[lindex $outcome 0] eq "abort"} {
            lappend problems "$backend aborted: [lindex $outcome 1]"
            continue
        }
        set lines [lindex $outcome 1]
        foreach line $lines {
            if {[string match "FAIL *" $line]} { lappend problems "$backend: $line" }
        }
        set names [lmap line [golden::verdicts $lines] {string range $line 5 end}]
        if {[llength $names] != 68 || [llength [lsort -unique $names]] != 68} {
            lappend problems "$backend: [llength $names] verdicts, [llength [lsort -unique $names]] distinct, expected 68"
        }
        if {[lindex $lines end] ne "68 passed, 0 failed"} {
            lappend problems "$backend: [lindex $lines end]"
        }
    }
    if {$status eq "disagree"} {
        lappend problems "the backends' reports differ"
    }
    expr {$problems eq {} ? "ok" : [join $problems \n]}
} -result ok

test workload-2048-warning-clean {the engine, the demo, the suite and the benchmark have no warnings of their own (the stdlib's own findings, manifested by the warning gate, are not theirs)} -body {
    set found {}
    foreach name {game2048.bot demo.bot golden.bot bench.bot} {
        set hir [surface::readProgramFile [file join $gameDir $name] -warnings default -warning-channel ""]
        foreach warning [hir::warnings::of $hir] {
            set text [hir::warnings::render $hir $warning]
            if {[string match "$::core::libraryDir/*" $text]} {
                continue
            }
            lappend found "$name: [lindex [split $text \n] 0]"
        }
    }
    join $found \n
} -result {}

test workload-2048-strict-warnings {S16: the engine, the demo, the suite and the benchmark compile under -warnings error -- the stdlib modules they load (io, linux::io, test, ...) carry no warning either, so nothing their authors did not write rejects them} -body {
    set rejected {}
    foreach name {game2048.bot demo.bot golden.bot bench.bot} {
        if {[catch {surface::readProgramFile [file join $gameDir $name] -warnings error -warning-channel ""} message]} {
            lappend rejected "$name: [lindex [split $message \n] 0]"
        }
    }
    join $rejected \n
} -result {}

test workload-2048-bench-checksum "bench.bot's 200-move checksum is the same on [join $workloadBackends {, }] (and equals the independent Python oracle's, audit/2048/oracle.py)" -body {
    set hir [benchHir 200]
    lmap backend $workloadBackends {
        core::value::show [game2048::run $hir $backend]
    }
} -result [lrepeat [llength $workloadBackends] 2002720]

test workload-2048-application-module {S4: the engine is an application module -- the file beside its programs, one namespace -- and no copy of it is in the standard library} -body {
    set hir [surface::readProgramFile [file join $gameDir demo.bot] -warnings off -cache ""]
    set engine [lmap {id file} [dict get $hir files] {
        expr {[file tail [dict get $file path]] eq "game2048.bot" ? [dict get $file path] : [continue]}
    }]
    list [expr {$engine eq [list [file join $gameDir game2048.bot]]}] \
        [file exists [file join $::core::libraryDir game2048.bot]]
} -result {1 0}

# The demo's whole output: a deterministic game from a fixed seed.
set demoOutput {start
     .     .     .     .
     2     .     .     .
     .     2     .     .
     .     .     .     .
move 1: down, +0
     .     .     .     .
     .     .     .     .
     .     .     .     .
     2     2     .     .
move 2: down, +0
     .     .     .     .
     .     .     .     .
     .     .     .     .
     2     2     .     2
move 3: down, +0
     .     .     .     .
     .     .     .     .
     .     .     .     .
     2     2     2     2
move 4: down, +4
     .     .     .     .
     .     .     .     .
     .     .     .     .
     2     4     2     2
move 5: down, +4
     .     .     .     .
     .     .     .     .
     .     .     .     .
     2     4     4     2
game over after 316 moves
     2     8     4     2
    32    16     8     4
   128    64     2     8
   256     4   128    32
score 3888, largest tile 256
unit}

# 2048-ENGINE-WORKLOAD.md, S19: under GC stress this executable crashed
# (native/src/codegen/roots.rs shared a root slot between a call's result
# and a List live across the call; tests/native-root-liveness.test's
# root-def-interference-1 is the reduced case). It prints through
# linux::io, whose syscalls exist on Linux x86-64 only (AGENTS.md, "Linux
# AArch64"), hence linuxX86_64.
test workload-2048-demo-executable {the demo as a standalone executable prints the whole game, identically under GC stress} -constraints {executableAot linuxX86_64} -body {
    set dir [makeDirectory workload-2048-demo]
    try {
        set hir [surface::readProgramFile [file join $gameDir demo.bot] -warnings off]
        native::executable $hir [file join $dir demo]
        list [string equal [exec [file join $dir demo]] $demoOutput] \
            [string equal [exec env BOTLISH_NATIVE_GC_STRESS=1 [file join $dir demo]] $demoOutput]
    } finally {
        removeDirectory workload-2048-demo
    }
} -result {1 1}

# S4 and S15 together: `main.tcl -backend cranelift demo.bot` used to need the
# private library to compile, and then showed only `value: unit`. Now it
# compiles the demo as it is and shows the game the executable prints, then
# the value.
test workload-2048-demo-main-native {main.tcl -backend cranelift (and cranelift-generic) runs demo.bot as it is and prints its whole game before its value} -constraints {linuxX86_64 nativeBuilt} -body {
    set game [string range $demoOutput 0 end-[string length unit]]
    lmap backend {cranelift cranelift-generic} {
        string equal [exec [info nameofexecutable] [file join $::projectRoot main.tcl] -warnings off \
            -backend $backend [file join $gameDir demo.bot]] \
            "== demo.bot ($backend)\n${game}   value: unit"
    }
} -result {1 1}

cleanupTests
