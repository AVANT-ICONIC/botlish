# 2048-ENGINE-WORKLOAD.md, S19: under GC stress this executable crashed
# (native/src/codegen/roots.rs shared a root slot between a call's result
# and a List live across the call; tests/native-root-liveness.test's
# root-def-interference-1 is the reduced case).
test workload-2048-demo-executable {the demo as a standalone executable prints the whole game, identically under GC stress} -constraints executableAot -body {
    set dir [makeDirectory workload-2048-demo]
    try {
        with2048 {
            set hir [surface::readProgramFile [file join $gameDir demo.bot] -warnings off]
            native::executable $hir [file join $dir demo]
        }
        list [string equal [exec [file join $dir demo]] $demoOutput] \
            [string equal [exec env BOTLISH_NATIVE_GC_STRESS=1 [file join $dir demo]] $demoOutput]
    } finally {
        removeDirectory workload-2048-demo
    }
} -result {1 1}

cleanupTests
