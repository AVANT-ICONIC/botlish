# branch-form-boolean.bot -- Boolean conditions are lowered as branches,
# with their meaning unchanged (BRANCH-FORM-BOOLEAN-LOWERING.md): the
# source-level specification of
#
#   * short circuits: `false and _` and `true or _` never run their right
#     operand, `true and _` and `false or _` run it once; operands run left
#     to right, each at most once, in nested trees, under `not` and `!=`,
#     and with yields inside them (a coroutine's segments are the log);
#   * a right operand that may fail fails only where it runs: its error is
#     raised exactly there, the left one's first; a constant left operand
#     that skips a right operand known to fail is no KnownError;
#   * value positions keep their Bools: a binding, an argument, a return, a
#     List element and a struct field built from and/or/not;
#   * proofs are the analyses': the converter's `or` guard proves its result,
#     `0 <= x and x <= 9` admits x into the domain, an exact argument in
#     range needs no handler and one out of range is KnownError;
#   * size: a conjunction past the proof's node budget, a long chain and a
#     deep alternating tree evaluate exactly;
#   * an affine value moved by a right operand is moved only where it runs.
#
# Ported from tests/branch-form-boolean.test, which stays authoritative
# (audit/golden/migration/fragments/branch-form-boolean.tsv maps every
# test; what only Tcl observes -- the generated Tcl, NIR and Cranelift IR,
# the shared rule, the lowering's linearity -- stays there).
#
# Imports: compiler and test (the framework); coroutine (the logs); list
# and str (the programs).
import std::compiler
import std::coroutine
import std::list
import std::str
import std::test

error Boom
error Left
error Right
error OutOfRange

type Small = Int in 0..9

struct Job:
    n: int

struct Flag:
    v: bool

fn small(x: int) -> Small errors OutOfRange:
    if x < 0 or x > 9:
        fail OutOfRange
    x

fn use_small(s: Small) -> int:
    s + 100

# Inputs no static analysis decides (the bodies capture them): K, a value
# a guard compares, and XS, the values a converter or an admission is
# tried on.
fn register_order_tests(k: int):
    # bf-order: left to right, each operand at most once, the right one only
    # when the left one does not decide. log(n, v) yields [n] and returns
    # v; drive() runs the program and collects its log.
    fn b_and() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int, v: bool) -> List[int]:
                yield [n]
                if v:
                    [1]
                else:
                    [0]
            fn run() -> List[int]:
                r1 = if log(1, false) == [1] and log(2, true) == [1]:
                    10
                else:
                    11
                r2 = if log(5, true) == [1] and log(6, false) == [1]:
                    14
                else:
                    15
                [r1, r2]
            coroutine {step, first} = run()
            rest = loop i from 0 to 100:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("bf-order/and-short-circuit", [[1], [[5], [6], [11, 15]]], b_and)
    fn b_or() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int, v: bool) -> bool:
                yield [n]
                v
            fn run() -> List[int]:
                r1 = if log(3, true) or log(4, true):
                    12
                else:
                    13
                r2 = if log(7, false) or log(8, false):
                    16
                else:
                    17
                [r1, r2]
            coroutine {step, first} = run()
            rest = loop i from 0 to 100:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("bf-order/or-short-circuit", [[3], [[7], [8], [12, 17]]], b_or)
    fn b_not() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int, v: bool) -> bool:
                yield [n]
                v
            fn run() -> List[int]:
                r1 = if not (log(9, true) and log(10, true)):
                    18
                else:
                    19
                r2 = if not log(14, false):
                    22
                else:
                    23
                r3 = if log(15, true) != log(16, true):
                    24
                else:
                    25
                [r1, r2, r3]
            coroutine {step, first} = run()
            rest = loop i from 0 to 100:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("bf-order/not", [[9], [[10], [14], [15], [16], [19, 22, 25]]], b_not)
    fn b_nested() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int, v: bool) -> bool:
                yield [n]
                v
            fn run() -> List[int]:
                r1 = if log(11, k > 0) and (log(12, false) or log(13, true)):
                    20
                else:
                    21
                r2 = if log(17, k > 1) and log(18, true) or log(19, false):
                    26
                else:
                    27
                [r1, r2]
            coroutine {step, first} = run()
            rest = loop i from 0 to 100:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("bf-order/nested", [[11], [[12], [13], [17], [18], [20, 26]]], b_nested)
    fn b_value_position() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int, v: bool) -> bool:
                yield [n]
                v
            fn run() -> List[int]:
                x = log(20, true) and log(21, false)
                y = log(22, false) or log(23, true)
                r1 = if x:
                    28
                else:
                    29
                r2 = if y:
                    30
                else:
                    31
                [r1, r2]
            coroutine {step, first} = run()
            rest = loop i from 0 to 100:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("bf-order/value-position", [[20], [[21], [22], [23], [29, 30]]], b_value_position)

    # bf-methods: conditions of method calls behave as the free calls do.
    fn b_methods() errors std::compiler::CompilerError:
        static compile:
            fn ready?(j: Job) -> bool:
                j.n > 0
            fn valid?(j: Job) -> bool:
                j.n < 10
            fn check(x: Job, y: Job) -> int:
                if x.ready?() and y.valid?():
                    1
                elif not x.ready?() or y.valid?():
                    2
                else:
                    3
            [check(Job {n: k}, Job {n: 3}), check(Job {n: 0}, Job {n: 30}), check(Job {n: 5}, Job {n: 30})]
    std::test::value("bf-methods", [1, 2, 3], b_methods)

fn register_error_tests(ks: List[int]):
    # bf-errors: a right operand that may fail runs only where the left
    # operand lets it.
    fn b_skipped() errors std::compiler::CompilerError:
        static compile:
            fn risky(k: int) -> bool errors Boom:
                if k > 7:
                    fail Boom
                true
            fn guarded_and(k: int) -> int errors Boom:
                if k > 3 and risky(k):
                    1
                else:
                    0
            fn guarded_or(k: int) -> int errors Boom:
                if k <= 3 or risky(k):
                    1
                else:
                    0
            fn try_guards(k: int) -> List[int]:
                a = guarded_and(k):
                    on Boom:
                        -1
                b = guarded_or(k):
                    on Boom:
                        -2
                [a, b]
            loop k in ks:
                try_guards(k)
    std::test::value("bf-errors/rhs-skipped", [[0, 1], [1, 1], [-1, -2]], b_skipped)
    fn b_constant() errors std::compiler::CompilerError:
        static compile:
            fn risky(k: int) -> bool errors Boom:
                if k > 7:
                    fail Boom
                true
            a = if false and risky(9):
                1
            else:
                0
            b = if true or risky(9):
                1
            else:
                0
            [a, b]
    std::test::value("bf-errors/constant-left-skips-known-error", [0, 1], b_constant)

    # bf-errors-order: when both operands may fail, the left one's error
    # comes first, the right one's only past it.
    fn b_error_order() errors std::compiler::CompilerError:
        static compile:
            fn left(k: int) -> bool errors Left:
                if k == 1:
                    fail Left
                k > 2
            fn right(k: int) -> bool errors Right:
                if k == 3:
                    fail Right
                k > 4
            fn both(k: int) -> int errors Left, Right:
                if left(k) and right(k):
                    1
                else:
                    0
            fn probe(k: int) -> str:
                r = both(k):
                    on Left:
                        return "Left"
                    on Right:
                        return "Right"
                if r == 1:
                    "yes"
                else:
                    "no"
            [probe(1), probe(2), probe(3), probe(4), probe(5)]
    std::test::value("bf-errors-order", ["Left", "no", "Right", "no", "yes"], b_error_order)

fn register_proof_tests(xs: List[int]):
    # bf-proofs: the converter's `or` guard proves its result, an `and` of
    # comparisons admits a value into the domain, an exact argument in
    # range needs no handler, one out of range is KnownError.
    fn b_converter() errors std::compiler::CompilerError:
        static compile:
            fn h(x: int) -> int:
                s = small(x):
                    on OutOfRange:
                        return -1
                use_small(s)
            loop x in xs:
                h(x)
    std::test::value("bf-proofs/converter-or-guard", [103, -1, -1], b_converter)
    fn b_admitted() errors std::compiler::CompilerError:
        static compile:
            fn g(x: int) -> int:
                if 0 <= x and x <= 9:
                    use_small(x)
                else:
                    0
            loop x in xs:
                g(x)
    std::test::value("bf-proofs/range-through-and", [103, 0, 0], b_admitted)
    fn b_exact() errors std::compiler::CompilerError:
        static compile:
            use_small(small(3))
    std::test::value("bf-proofs/exact-in-range", 103, b_exact)
    fn b_known() errors std::compiler::CompilerError:
        static compile:
            s = small(12):
                on OutOfRange:
                    return -1
            use_small(s)
    std::test::rejects("bf-proofs/known-error", std::compiler::DiagnosticCode::KnownError, b_known)

fn register_size_tests(n: int):
    # bf-beyond-proof-budget: a conjunction of 40 logged operands, past the
    # proof's node budget, evaluates exactly: each operand once, in order,
    # stopping at the first false one (operand n), or all of them.
    fn b_budget() errors std::compiler::CompilerError:
        static compile:
            fn log(i: int, v: bool) -> int:
                yield i
                if v:
                    1
                else:
                    0
            fn run(k: int) -> int:
                if log(1, k != 1) == 1 and log(2, k != 2) == 1 and log(3, k != 3) == 1 and log(4, k != 4) == 1 and log(5, k != 5) == 1 and log(6, k != 6) == 1 and log(7, k != 7) == 1 and log(8, k != 8) == 1 and log(9, k != 9) == 1 and log(10, k != 10) == 1 and log(11, k != 11) == 1 and log(12, k != 12) == 1 and log(13, k != 13) == 1 and log(14, k != 14) == 1 and log(15, k != 15) == 1 and log(16, k != 16) == 1 and log(17, k != 17) == 1 and log(18, k != 18) == 1 and log(19, k != 19) == 1 and log(20, k != 20) == 1 and log(21, k != 21) == 1 and log(22, k != 22) == 1 and log(23, k != 23) == 1 and log(24, k != 24) == 1 and log(25, k != 25) == 1 and log(26, k != 26) == 1 and log(27, k != 27) == 1 and log(28, k != 28) == 1 and log(29, k != 29) == 1 and log(30, k != 30) == 1 and log(31, k != 31) == 1 and log(32, k != 32) == 1 and log(33, k != 33) == 1 and log(34, k != 34) == 1 and log(35, k != 35) == 1 and log(36, k != 36) == 1 and log(37, k != 37) == 1 and log(38, k != 38) == 1 and log(39, k != 39) == 1 and log(40, k != 40) == 1:
                    -1
                else:
                    -2
            fn drive(k: int):
                coroutine {step, first} = run(k)
                rest = loop i from 0 to 100:
                    if std::coroutine::done?(step):
                        break
                    step()
                last = std::list::at(rest, std::list::length(rest) - 1):
                    on IndexNotFound:
                        return [first, -9]
                [first, std::list::length(rest), last]
            [drive(n), drive(500)]
    std::test::value("bf-beyond-proof-budget", [[1, 7, -2], [1, 40, -1]], b_budget)

    # bf-deep-nesting: an alternating and/or/not tree, twelve levels deep.
    fn b_deep() errors std::compiler::CompilerError:
        static compile:
            fn f(x: int) -> int:
                if not ((not ((((not ((((x > 3 and x < 7) or x < 14) and x != 3)) or x < 28) and x < 35) or x != 6)) and x < 49) or x < 56):
                    1
                else:
                    2
            loop x in [0, 4, n, 500, 841]:
                f(x)
    std::test::value("bf-deep-nesting", [2, 2, 2, 1, 1], b_deep)

    # bf-nir-affine-rhs: a right operand that moves a coroutine handle moves
    # it only where it runs; the other path releases it.
    fn b_affine() errors std::compiler::CompilerError:
        static compile:
            fn ticker() -> int:
                loop i from 0 to 1000:
                    yield i
                return -1
            fn take(c: Coroutine{args: [], return: int}) -> bool:
                c() > 0
            fn f(flag: bool) -> int:
                coroutine {step: h} = ticker()
                if flag and take(h):
                    1
                else:
                    2
            fn g(flag: bool) -> int:
                coroutine {step: h} = ticker()
                if flag or take(h):
                    3
                else:
                    4
            [f(n > 0), f(n < 0), g(n > 0), g(n < 0)]
    std::test::value("bf-nir-affine-rhs", [1, 2, 3, 3], b_affine)

    # bf-tcl-value-positions, bf-nir-value-positions: Bools built from
    # and/or/not where a value is wanted are values.
    fn b_values() errors std::compiler::CompilerError:
        static compile:
            fn id(b: bool) -> bool:
                b
            fn f(x: int):
                a = x > 0 and x < 9
                s = Flag {v: x < 0 or x > 9}
                [a, id(x > 1 and x < 3), [not (x == 2)], s.v]
            fn g(x: int) -> bool:
                return x > 0 and x < 9
            [f(2), g(2), f(n), g(n)]
    std::test::value("bf-nir-value-positions", [[true, true, [false], false], true, [true, false, [true], false], true], b_values)

    # bf-nir-region-consumer: an inlined character predicate as a condition.
    fn b_region() errors std::compiler::CompilerError:
        static compile:
            fn peek(text, index):
                if index < 0 or index >= std::str::length(text):
                    return ""
                std::str::substring(text, index, index + 1)
            fn is_local_char(c):
                std::str::is_tcl_alnum(c) or c == "." or c == "_" or c == "-"
            fn scan(text, index, count):
                if index >= std::str::length(text):
                    return count
                if is_local_char(peek(text, index)):
                    return scan(text, index + 1, count + 1)
                scan(text, index + 1, count)
            scan("ab.c_d-e@f", 0, 0)
    std::test::value("bf-nir-region-consumer", 9, b_region)

fn register_branch_form_boolean_tests():
    register_order_tests(5)
    register_error_tests([1, 5, 9])
    register_proof_tests([3, 12, -1])
    register_size_tests(7)

with context std::test::suite()
register_branch_form_boolean_tests()
std::test::report()
