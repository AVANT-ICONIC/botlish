# methods-byte-without-list.bot -- method-call sugar (METHOD-SUGAR.md) in a
# file that imports byte but neither list nor str: what an import does NOT
# make visible. A method call finds a function only if it is visible by
# that name -- defined in scope, or a member of a namespace the file imports
# directly -- never by searching the receiver's type, and binding one
# namespace's function to a name makes nothing else visible.
#
# Ports the halves of tests/method-sugar.test (which stays authoritative and
# unchanged) whose programs import std::byte and not list (the halves with list
# imported are in methods.bot): method-not-visible-module-function and
# method-alias-does-not-import (its rejection; its accepted half is in
# methods.bot).
#
# Imports: compiler and test (the framework); byte (the Tcl programs' own
# import). The absence of `import std::list` and `import std::str` is the property:
# std::list::any? and the `length` of list and str must not be candidates. (The
# framework's own imports add no member named any? or length to this file.
# They do load list, so the rejected method calls name it: a method call
# whose function exists in a namespace the file does not import is that
# missing import, MissingImport, for every module the compilation loaded --
# DIAGNOSTIC-RECOVERY.md. The Tcl original's program loads no list module,
# and its `.any?` stays NOT-A-STRUCT.)
import std::byte
import std::compiler
import std::test

fn register_visibility_tests():
    # method-not-visible-module-function: a module function of a namespace
    # the file does not import is not found by the sugar, though its first
    # parameter would accept the receiver (no search by receiver type), and
    # its qualified name is not even authorized: both spellings are the
    # missing import.
    fn b_module_function_method() errors std::compiler::CompilerError:
        static compile:
            fn big(x):
                x > 1
            [1, 2, 3].any?(big)
    fn b_module_function_qualified() errors std::compiler::CompilerError:
        static compile:
            fn big(x):
                x > 1
            std::list::any?([1, 2, 3], big)
    std::test::rejects_message("method-not-visible-module-function/method", std::compiler::DiagnosticCode::MissingImport, "namespace \"std::list\" is not imported; add `import std::list` to use `std::list::any?` (the method-style call \".any?(...)\" applies only a function visible by that name)", b_module_function_method)
    std::test::rejects_message("method-not-visible-module-function/qualified", std::compiler::DiagnosticCode::MissingImport, "namespace \"std::list\" is not imported; add `import std::list` to use `std::list::any?`", b_module_function_qualified)

fn register_alias_tests():
    # method-alias-does-not-import: binding one namespace's function makes
    # nothing of another namespace visible: `[1].length()` finds no
    # function (list is what is missing). (That the import, not the
    # binding, makes the namespace's other members visible is the half in
    # methods.bot.)
    fn b_other_namespace() errors std::compiler::CompilerError:
        static compile:
            transform = std::byte::complement
            [1].length()
    std::test::rejects_containing("method-alias-does-not-import/other-namespace", std::compiler::DiagnosticCode::MissingImport, "namespace \"std::list\" is not imported; add `import std::list` to use `std::list::length`", b_other_namespace)

with context std::test::suite()
register_visibility_tests()
register_alias_tests()
std::test::report()
