# names-and-scoping.bot -- name resolution as source semantics, as a
# source-level specification.
#
# A binding is visible from where it is established, never before (strict
# reference determinism, STRICT-REFERENCE-DETERMINISM.md):
#
# * A function may call the functions declared before it and itself, never a
#   later one: callee-first order is the canonical order, mutual recursion
#   has a forward edge whichever function comes first and is rejected, and a
#   forward reference is rejected whether or not it runs after the binding
#   exists, is reachable or is in a function nobody calls. An alias or a
#   list literal is no route to a later binding either.
# * A value is not visible in its own initializer (an initializer naming its
#   own binding reads the outer one) or before its binding, and the compiler
#   never reorders bindings to satisfy a dependency chain.
# * Every kind of scope is sequential: a function body, a nested function, an
#   if and an else branch, a loop body and a handler body; a loop's header is
#   resolved in the enclosing scope, before its body binds anything; the
#   parameters and the loop's bindings are established on entry; a nested
#   function is a new callable, so loop control does not cross it.
# * A scope binds a name once (Duplicate, at the second binding; duplicate
#   parameters at the parameter list); a nested scope may shadow it. A later
#   shadowing binding never reaches back: an earlier reference, and a closure
#   created before it, keep the outer binding; a closure captures only what
#   exists where it is created.
# * An unbound reference is reported where it is written (not at the later
#   declaration), and the message says "declared later" exactly when a later
#   binding of that name is in scope; diagnostics spell names as the source
#   does.
# * Names the front end introduces cannot be shadowed: a program binding,
#   parameter or captured binding named `list` changes no list literal. A
#   local named like a namespace does not hide that namespace's qualified
#   names.
# * `and`, `or`, `not` and `!=` compute their truth tables, and `and`/`or`
#   do not evaluate their right operand when the left one decides.
#
# Ported from tests/strict-references.test, tests/surface-lowering.test and
# tests/hir-syntax.test (sr-later-sibling-function,
# sr-duplicate-parameter-bind and lower-semantic-break-outside are in
# diagnostics.bot, sr-no-derivative-diagnostics in harness.bot). The Tcl
# tests stay authoritative and unchanged: the HIR they inspect (binding
# identities, scope kinds, hygiene renames, Core IR text, the complete
# -strict 0 diagnostic list) stays there; what a program computes or how it
# is rejected is here.
#
# Conventions:
#
# * Each Tcl program is an entry program there; here it is the code of one
#   block, its top-level scope the block's scope (a function body's, not an
#   entry program's top level). A rejected program that ends in a function
#   declaration gets a final `0`, so no block ends in a function value.
# * No scope enclosing a block binds a name a test's program binds or
#   references: an outer binding would be read instead (or turn a message's
#   plain "unbound name" into a "declared later" one). Hence the long body
#   names and the registration parameters' names.
# * Every rejection is pinned at its primary location, the reference or
#   binding the rule is about (lines and columns of this file), also where
#   the Tcl test checks only the error code. A message is compared only where
#   its wording is the property (the "declared later" hint, its absence, the
#   source spelling of a renamed name): rejects_saying (exact) and
#   rejects_opening (a prefix, as the Tcl glob), below.
# * Two Tcl tests of one program share one golden test
#   (duplicate-function-in-one-scope, duplicate-value-in-one-scope,
#   lower-hygiene-list); its comment names both.
#
# Imports: compiler and test (the framework); mathish (the namespace of
# sr-module-local-shadow-of-namespace-name, standing in for the Tcl test's
# private module m); str (rejects_opening's prefix).
import compiler
import mathish
import str
import test

# ---------------------------------------------------------------------------
# Declarations (top-level only)

# sr-scope-handler-body: the error its handler handles (the Tcl program's
# `error Bad`).
error HandledProbeFailure

# lower-boolean-short-circuit: what a right operand raises if it is evaluated
# (the Tcl program's unbound `nope()`, which would fail when evaluated).
error RightOperandEvaluated

# ---------------------------------------------------------------------------
# Custom checks: a located rejection whose message is part of the property

# BODY's block must be rejected with diagnostic code EXPECTED at LINE and
# COLUMN of this file, with exactly the message WORDING.
nomethod fn rejects_saying(name: str, expected: compiler::DiagnosticCode, line: int, column: int, wording: str, body) -> unit:
    fn check() -> test::Match:
        shown = test::diagnostic_text(expected, compiler::SourceLocation {line: line, column: column}).concat(", message: ").concat(wording)
        actual = body():
            on compiler::CompilerError {code, primary, message}:
                located = primary.line == line and primary.column == column
                if code == expected and located and message == wording:
                    return test::passed()
                return test::mismatch(shown, test::diagnostic_text(code, primary), message)
        test::mismatch(shown, "value ".concat(test::describe(actual)), "")
    test::case(name, check)

# The first K characters of TEXT (all of TEXT when it is shorter).
fn opening_of(text: str, k: int) -> str:
    piece = str::substring(text, 0, k):
        on LowerUnderrun:
            ""
        on UpperOverrun:
            text
    piece

# BODY's block must be rejected with diagnostic code EXPECTED at LINE and
# COLUMN of this file, with a message that begins with OPENING (the Tcl
# test's glob "OPENING*").
nomethod fn rejects_opening(name: str, expected: compiler::DiagnosticCode, line: int, column: int, opening: str, body) -> unit:
    fn check() -> test::Match:
        shown = test::diagnostic_text(expected, compiler::SourceLocation {line: line, column: column}).concat(", message beginning: ").concat(opening)
        actual = body():
            on compiler::CompilerError {code, primary, message}:
                located = primary.line == line and primary.column == column
                if code == expected and located and opening_of(message, str::length(opening)) == opening:
                    return test::passed()
                return test::mismatch(shown, test::diagnostic_text(code, primary), message)
        test::mismatch(shown, "value ".concat(test::describe(actual)), "")
    test::case(name, check)

# ---------------------------------------------------------------------------
# A binding is visible from where it is established: callee first, no
# forward references, no reordering

fn register_source_order_tests():
    # sr-callee-first-accepted: a helper declared before its caller is the
    # canonical order: the call resolves and runs.
    fn callee_first_accepted() errors compiler::CompilerError:
        static compile:
            fn helper():
                41

            fn caller():
                helper() + 1

            caller()
    test::value("sr-callee-first-accepted", 42, callee_first_accepted)

    # sr-mutual-recursion: ordinary mutual recursion is not supported: one
    # edge must point forward. even?'s call of odd? is that edge, reported
    # at the call as a forward reference.
    fn mutual_recursion_rejected() errors compiler::CompilerError:
        static compile:
            fn even?(n):
                if n == 0:
                    return true
                odd?(n - 1)

            fn odd?(n):
                if n == 0:
                    return false
                even?(n - 1)

            0
    rejects_saying("sr-mutual-recursion", compiler::DiagnosticCode::Unbound, 152, 17, "unbound name \"odd?\": \"odd?\" is declared later; forward references are not allowed (a binding is visible only after it is established)", mutual_recursion_rejected)

    # sr-mutual-recursion-either-order: declaring odd? first only moves the
    # forward edge: now odd?'s call of even? is rejected.
    fn mutual_recursion_either_order() errors compiler::CompilerError:
        static compile:
            fn odd?(n):
                if n == 0:
                    return false
                even?(n - 1)

            fn even?(n):
                if n == 0:
                    return true
                odd?(n - 1)

            0
    test::rejects_at("sr-mutual-recursion-either-order", compiler::DiagnosticCode::Unbound, 169, 17, mutual_recursion_either_order)

    # lower-hir-mutual-recursion: of two mutually recursive functions, the
    # earlier one's reference to the later one is the unresolved one (the
    # later one's reference to the earlier resolves).
    fn mutual_recursion_earlier_edge_unbound() errors compiler::CompilerError:
        static compile:
            fn even(n):
                if n == 0:
                    return true
                odd(n - 1)
            fn odd(n):
                if n == 0:
                    return false
                even(n - 1)
            even(4)
    test::rejects_at("lower-hir-mutual-recursion", compiler::DiagnosticCode::Unbound, 187, 17, mutual_recursion_earlier_edge_unbound)

    # sr-runtime-order-irrelevant: a forward reference is illegal even though
    # the referencing function only runs after the binding exists: rejected
    # at the call of later.
    fn runtime_order_irrelevant() errors compiler::CompilerError:
        static compile:
            fn call_later():
                later()

            fn later():
                1

            call_later()
    test::rejects_at("sr-runtime-order-irrelevant", compiler::DiagnosticCode::Unbound, 201, 17, runtime_order_irrelevant)

    # sr-unreachable-branch: legality is a resolution rule, not
    # reachability: a forward reference in a branch that never runs is
    # rejected there.
    fn forward_reference_in_unreachable_branch() errors compiler::CompilerError:
        static compile:
            if false:
                later()

            fn later():
                1

            0
    test::rejects_at("sr-unreachable-branch", compiler::DiagnosticCode::Unbound, 215, 17, forward_reference_in_unreachable_branch)

    # sr-unused-function: a function that is never called must still contain
    # only valid references: rejected at its call of later.
    fn forward_reference_in_unused_function() errors compiler::CompilerError:
        static compile:
            fn unused():
                later()

            fn later():
                1

            0
    test::rejects_at("sr-unused-function", compiler::DiagnosticCode::Unbound, 228, 17, forward_reference_in_unused_function)

    # sr-forward-value-alias: an alias of a later function is illegal, even
    # if it would only be called later.
    fn forward_value_alias() errors compiler::CompilerError:
        static compile:
            g = f

            fn f():
                1

            0
    test::rejects_at("sr-forward-value-alias", compiler::DiagnosticCode::Unbound, 240, 17, forward_value_alias)

    # sr-forward-higher-order: building an aggregate is no route to a later
    # binding.
    fn forward_reference_in_list_literal() errors compiler::CompilerError:
        static compile:
            callbacks = [later]

            fn later():
                1

            0
    test::rejects_at("sr-forward-higher-order", compiler::DiagnosticCode::Unbound, 252, 26, forward_reference_in_list_literal)

    # sr-forward-module-value: values obey the same source order as
    # functions: the reference to a later value is a forward reference.
    fn forward_value_reference() errors compiler::CompilerError:
        static compile:
            a = b
            b = 3
    rejects_opening("sr-forward-module-value", compiler::DiagnosticCode::Unbound, 264, 17, "unbound name \"b\": \"b\" is declared later", forward_value_reference)

    # sr-value-dependency-order: values are accepted once their dependencies
    # come first.
    fn value_dependency_order() errors compiler::CompilerError:
        static compile:
            c = 1
            b = c + 1
            a = b + 1
            a
    test::value("sr-value-dependency-order", 3, value_dependency_order)

    # sr-value-order-not-reordered: a dependency chain written backwards is
    # rejected at its first reference, never sorted.
    fn value_order_not_reordered() errors compiler::CompilerError:
        static compile:
            a = b + 1
            b = c + 1
            c = 1
    test::rejects_at("sr-value-order-not-reordered", compiler::DiagnosticCode::Unbound, 282, 17, value_order_not_reordered)

    # sr-own-initializer: a value is not visible in its own initializer:
    # rejected at the initializer's x.
    fn own_initializer_rejected() errors compiler::CompilerError:
        static compile:
            x = x + 1
    test::rejects_at("sr-own-initializer", compiler::DiagnosticCode::Unbound, 291, 17, own_initializer_rejected)

    # sr-own-initializer-outer: an initializer that names its own binding
    # reads the outer binding of that name.
    fn own_initializer_reads_outer() errors compiler::CompilerError:
        static compile:
            x = 1
            if true:
                x = x + 1
                x
    test::value("sr-own-initializer-outer", 2, own_initializer_reads_outer)

# ---------------------------------------------------------------------------
# Every kind of scope is sequential

fn register_scope_kind_tests():
    # In each scope, `a = b` before `b = 1` is rejected at that b.

    # sr-scope-function-body: a function body is sequential.
    fn function_body_sequential() errors compiler::CompilerError:
        static compile:
            fn f():
                a = b
                b = 1
                a

            0
    test::rejects_at("sr-scope-function-body", compiler::DiagnosticCode::Unbound, 314, 21, function_body_sequential)

    # sr-scope-nested-function: a nested function may not call a later
    # sibling: rejected at g's call of h.
    fn nested_function_sequential() errors compiler::CompilerError:
        static compile:
            fn f():
                fn g():
                    h()

                fn h():
                    1

                g()

            0
    test::rejects_at("sr-scope-nested-function", compiler::DiagnosticCode::Unbound, 327, 21, nested_function_sequential)

    # sr-scope-if-branch: an if branch is sequential.
    fn if_branch_sequential() errors compiler::CompilerError:
        static compile:
            if true:
                a = b
                b = 1
    test::rejects_at("sr-scope-if-branch", compiler::DiagnosticCode::Unbound, 341, 21, if_branch_sequential)

    # sr-scope-else-branch: an else branch is sequential.
    fn else_branch_sequential() errors compiler::CompilerError:
        static compile:
            if false:
                1
            else:
                a = b
                b = 1
    test::rejects_at("sr-scope-else-branch", compiler::DiagnosticCode::Unbound, 351, 21, else_branch_sequential)

    # sr-scope-loop-body: a loop body is sequential.
    fn loop_body_sequential() errors compiler::CompilerError:
        static compile:
            loop:
                a = b
                b = 1
                break
    test::rejects_at("sr-scope-loop-body", compiler::DiagnosticCode::Unbound, 359, 21, loop_body_sequential)

    # sr-scope-loop-header: a loop's header is resolved in the enclosing
    # scope: a binding of its body is not visible in it (rejected at the
    # header's ys).
    fn loop_header_in_enclosing_scope() errors compiler::CompilerError:
        static compile:
            loop x in ys:
                ys = [1]
                x
    test::rejects_at("sr-scope-loop-header", compiler::DiagnosticCode::Unbound, 369, 23, loop_header_in_enclosing_scope)

    # sr-scope-count-loop-header: a counted loop's bounds are resolved
    # before its body binds anything (rejected at the header's n).
    fn count_loop_bounds_in_enclosing_scope() errors compiler::CompilerError:
        static compile:
            loop i from 0 to n:
                n = 3
                i
    test::rejects_at("sr-scope-count-loop-header", compiler::DiagnosticCode::Unbound, 378, 30, count_loop_bounds_in_enclosing_scope)

    # sr-scope-handler-body: a handler body is sequential.
    fn handler_body_sequential() errors compiler::CompilerError:
        static compile:
            fn f() errors HandledProbeFailure:
                fail HandledProbeFailure

            fn g():
                r = f():
                    on HandledProbeFailure:
                        a = b
                        b = 1
                        0
                r

            0
    test::rejects_at("sr-scope-handler-body", compiler::DiagnosticCode::Unbound, 392, 29, handler_body_sequential)

    # lower-semantic-break-in-fn: a function declared in a loop body is a new
    # callable: its `continue` is outside any loop of its own.
    fn loop_control_does_not_cross_function() errors compiler::CompilerError:
        static compile:
            loop:
                fn f():
                    continue
                break
    test::rejects_at("lower-semantic-break-in-fn", compiler::DiagnosticCode::ContinueOutsideLoop, 406, 21, loop_control_does_not_cross_function)

    # sr-loop-bindings-visible-in-body: a loop's element binding is
    # established on body entry.
    fn loop_binding_visible_in_body() errors compiler::CompilerError:
        static compile:
            loop x in [1, 2, 3]:
                x + 1
    test::value("sr-loop-bindings-visible-in-body", [2, 3, 4], loop_binding_visible_in_body)

    # sr-parameters-visible-in-body: parameters are established at function
    # entry.
    fn parameters_visible_in_body() errors compiler::CompilerError:
        static compile:
            fn f(a, b):
                a + b

            f(20, 22)
    test::value("sr-parameters-visible-in-body", 42, parameters_visible_in_body)

# ---------------------------------------------------------------------------
# A named function sees itself, and nothing later

fn register_self_reference_tests():
    # sr-self-recursion: a named function calls itself directly.
    fn self_recursion() errors compiler::CompilerError:
        static compile:
            fn factorial(n):
                if n == 0:
                    1
                else:
                    n * factorial(n - 1)

            factorial(5)
    test::value("sr-self-recursion", 120, self_recursion)

    # sr-self-recursion-nested: a nested named function calls itself.
    fn nested_self_recursion() errors compiler::CompilerError:
        static compile:
            fn outer(n):
                fn count(k):
                    if k == 0:
                        0
                    else:
                        1 + count(k - 1)

                count(n)

            outer(4)
    test::value("sr-self-recursion-nested", 4, nested_self_recursion)

    # sr-self-binding-not-a-sibling: a named function sees itself, not a
    # later function: rejected at f's call of g.
    fn self_binding_not_a_sibling() errors compiler::CompilerError:
        static compile:
            fn f():
                g()

            fn g():
                f()

            0
    test::rejects_at("sr-self-binding-not-a-sibling", compiler::DiagnosticCode::Unbound, 464, 17, self_binding_not_a_sibling)

    # sr-function-value-alias: an alias of an existing function is legal,
    # and calls it.
    fn function_value_alias() errors compiler::CompilerError:
        static compile:
            fn f(x):
                x + 1

            g = f
            g(41)
    test::value("sr-function-value-alias", 42, function_value_alias)

    # sr-value-does-not-see-itself: a value bound in a function is never
    # visible before its binding there: rejected at g in `f = g`.
    fn value_does_not_see_itself() errors compiler::CompilerError:
        static compile:
            fn make():
                f = g
                g = 1
                f

            0
    test::rejects_at("sr-value-does-not-see-itself", compiler::DiagnosticCode::Unbound, 488, 21, value_does_not_see_itself)

# ---------------------------------------------------------------------------
# A scope binds a name once; a nested scope may shadow it

fn register_duplicate_tests():
    # sr-duplicate-function, lower-semantic-duplicate-fn: two functions of
    # one name in one scope are a duplicate, at the second.
    fn duplicate_function() errors compiler::CompilerError:
        static compile:
            fn f():
                1
            fn f():
                2

            0
    test::rejects_at("duplicate-function-in-one-scope", compiler::DiagnosticCode::Duplicate, 505, 13, duplicate_function)

    # sr-duplicate-value, lower-semantic-duplicate: a second binding of a
    # value name in one scope is a duplicate, at the second.
    fn duplicate_value() errors compiler::CompilerError:
        static compile:
            x = 1
            x = 2
    test::rejects_at("duplicate-value-in-one-scope", compiler::DiagnosticCode::Duplicate, 516, 13, duplicate_value)

    # lower-semantic-param-rebind: binding a parameter's name in the body is
    # a duplicate, at the binding.
    fn parameter_rebinding() errors compiler::CompilerError:
        static compile:
            fn f(a):
                a = 1

            0
    test::rejects_at("lower-semantic-param-rebind", compiler::DiagnosticCode::Duplicate, 524, 17, parameter_rebinding)

    # lower-duplicate-params-located: duplicate parameters are reported at
    # the function's parameter list.
    fn duplicate_parameters() errors compiler::CompilerError:
        static compile:
            x = 1
            fn f(a, b, a):
                a

            0
    test::rejects_at("lower-duplicate-params-located", compiler::DiagnosticCode::Duplicate, 534, 17, duplicate_parameters)

    # sr-shadowing-in-nested-scope-allowed: a nested scope may shadow an
    # outer name.
    fn nested_scope_shadows() errors compiler::CompilerError:
        static compile:
            x = 1
            if true:
                x = 2
                x
    test::value("sr-shadowing-in-nested-scope-allowed", 2, nested_scope_shadows)

# ---------------------------------------------------------------------------
# A later shadowing binding never reaches back; a closure captures what
# exists where it is created

fn register_shadowing_tests():
    # sr-forward-closure-capture: a closure cannot capture a binding
    # introduced after it: rejected at get's x, as a forward reference.
    fn forward_closure_capture() errors compiler::CompilerError:
        static compile:
            fn make():
                fn get():
                    x

                x = 5
                get

            0
    rejects_opening("sr-forward-closure-capture", compiler::DiagnosticCode::Unbound, 561, 21, "unbound name \"x\": \"x\" is declared later", forward_closure_capture)

    # sr-backward-closure-capture: a closure captures a binding established
    # before it.
    fn backward_closure_capture() errors compiler::CompilerError:
        static compile:
            fn make():
                x = 5
                fn get():
                    x

                get

            make()()
    test::value("sr-backward-closure-capture", 5, backward_closure_capture)

    # sr-shadow-early-reference: a reference before a shadowing binding
    # reads the outer binding; one after it, the new inner binding.
    fn shadow_early_reference() errors compiler::CompilerError:
        static compile:
            x = "outer"
            if true:
                early = x
                x = "inner"
                [early, x]
    test::value("sr-shadow-early-reference", ["outer", "inner"], shadow_early_reference)

    # sr-shadow-hygiene-straight-line: the same in straight-line code
    # (the Tcl test's lowering renames the later binding).
    fn shadow_straight_line() errors compiler::CompilerError:
        static compile:
            x = 1
            if true:
                a = x
                x = 2
                [a, x]
    test::value("sr-shadow-hygiene-straight-line", [1, 2], shadow_straight_line)

    # sr-shadow-closure: a closure made before a shadowing binding captures
    # the outer binding; one made after it, the inner.
    fn shadow_closure() errors compiler::CompilerError:
        static compile:
            x = "outer"
            if true:
                fn before():
                    x

                x = "inner"
                fn after():
                    x

                [before(), after()]
    test::value("sr-shadow-closure", ["outer", "inner"], shadow_closure)

    # sr-shadow-closure-in-function: the same, through a function's own
    # scope.
    fn shadow_closure_in_function() errors compiler::CompilerError:
        static compile:
            x = 10
            fn f():
                fn before():
                    x

                x = 20
                [before(), x]

            f()
    test::value("sr-shadow-closure-in-function", [10, 20], shadow_closure_in_function)

    # sr-shadow-parameter: a later local named like an outer parameter does
    # not capture an earlier closure.
    fn shadow_parameter() errors compiler::CompilerError:
        static compile:
            fn outer(x):
                fn inner():
                    fn get():
                        x

                    x = 99
                    [get(), x]

                inner()

            outer(1)
    test::value("sr-shadow-parameter", [1, 99], shadow_parameter)

    # lower-if-value-scopes: an if value's branches are scopes of their own:
    # the branch binding shadows x only inside the if value.
    fn if_value_branch_scope() errors compiler::CompilerError:
        static compile:
            x = 1
            y = if x == 1:
                x = 2
                x
            else:
                0
            [x, y]
    test::value("lower-if-value-scopes", [1, 2], if_value_branch_scope)

# ---------------------------------------------------------------------------
# An unbound reference is reported where it is written, and says "declared
# later" exactly when a later binding of its name is in scope

fn register_unbound_diagnostic_tests():
    # lower-semantic-unbound: a name nothing binds, at the reference.
    fn unbound_name() errors compiler::CompilerError:
        static compile:
            y = nope
    test::rejects_at("lower-semantic-unbound", compiler::DiagnosticCode::Unbound, 674, 17, unbound_name)

    # lower-semantic-before-binding: a reference before the binding of its
    # name is a forward reference, and the message says so.
    fn reference_before_binding() errors compiler::CompilerError:
        static compile:
            y = x
            x = 1
    rejects_saying("lower-semantic-before-binding", compiler::DiagnosticCode::Unbound, 681, 17, "unbound name \"x\": \"x\" is declared later; forward references are not allowed (a binding is visible only after it is established)", reference_before_binding)

    # sr-error-locality: the diagnostic is at the illegal reference, not at
    # the later declaration.
    fn error_at_reference() errors compiler::CompilerError:
        static compile:
            a = 1
            b = later
            fn f():
                b

            later = 3
    test::rejects_at("sr-error-locality", compiler::DiagnosticCode::Unbound, 690, 17, error_at_reference)

    # sr-decl-hint-only-in-message: an undeclared name gets the plain
    # message, without the "declared later" hint.
    fn undeclared_name_plain_message() errors compiler::CompilerError:
        static compile:
            fn f():
                nothing_here()

            0
    rejects_saying("sr-decl-hint-only-in-message", compiler::DiagnosticCode::Unbound, 702, 17, "unbound name \"nothing_here\"", undeclared_name_plain_message)

    # sr-decl-hint-is-scope-accurate: a binding of the same name in an
    # unrelated scope does not make the message claim "declared later".
    fn unrelated_binding_no_hint() errors compiler::CompilerError:
        static compile:
            fn f():
                helper()

            fn g():
                helper = 1
                helper

            0
    rejects_saying("sr-decl-hint-is-scope-accurate", compiler::DiagnosticCode::Unbound, 712, 17, "unbound name \"helper\"", unrelated_binding_no_hint)

    # lower-elif-error-location: an unbound name in an elif condition is
    # reported at the condition.
    fn unbound_in_elif_condition() errors compiler::CompilerError:
        static compile:
            x = 1
            if x < 0:
                1
            elif nope:
                2
            elif x > 3:
                3
            else:
                4
    test::rejects_at("lower-elif-error-location", compiler::DiagnosticCode::Unbound, 728, 18, unbound_in_elif_condition)

    # lower-elif-error-location-in-branch: an unbound name in the final else
    # branch of an elif chain is reported there.
    fn unbound_in_elif_chain_else() errors compiler::CompilerError:
        static compile:
            x = 1
            if x < 0:
                1
            elif x > 3:
                2
            else:
                nope
    test::rejects_at("lower-elif-error-location-in-branch", compiler::DiagnosticCode::Unbound, 746, 17, unbound_in_elif_chain_else)

# ---------------------------------------------------------------------------
# Boolean operators: truth tables and short-circuiting
#
# YES and NO are true and false, FAILING is a positive Int, given at the call
# site: the operands are run-time values.

fn register_boolean_operator_tests(yes: bool, no: bool, failing: int):
    # lower-boolean-values: the truth tables of and, or, not and != over the
    # four pairs of Bools.
    fn boolean_truth_tables() errors compiler::CompilerError:
        static compile:
            fn t(a, b):
                [a and b, a or b, not a, a != b]
            [t(yes, yes), t(yes, no), t(no, yes), t(no, no)]
    test::value("lower-boolean-values", [[true, true, false, false], [false, true, false, true], [false, true, true, true], [false, false, true, false]], boolean_truth_tables)

    # lower-boolean-short-circuit: the right operand is not evaluated when
    # the left one decides: probe(failing) would fail.
    fn boolean_short_circuit() errors compiler::CompilerError:
        static compile:
            fn probe(k: int) -> bool errors RightOperandEvaluated:
                if k > 0:
                    fail RightOperandEvaluated
                false

            fn f(x: bool) errors RightOperandEvaluated:
                [x or probe(failing), not x and probe(failing)]

            r = f(yes):
                on RightOperandEvaluated:
                    []
            r
    test::value("lower-boolean-short-circuit", [true, false], boolean_short_circuit)

# ---------------------------------------------------------------------------
# Names the front end introduces cannot be shadowed: a binding named `list`
# changes no list literal

fn register_hygiene_tests():
    # lower-hygiene-list, hir-rootref-program-binding: a binding named list
    # does not change a list literal after it.
    fn list_binding_keeps_literals() errors compiler::CompilerError:
        static compile:
            list = 5
            [1, list]
    test::value("lower-hygiene-list", [1, 5], list_binding_keeps_literals)

    # hir-rootref-used-before-shadowing-binding: a list literal before a
    # binding named list, and one after it, both build lists.
    fn list_literal_before_and_after_binding() errors compiler::CompilerError:
        static compile:
            x = [1]
            list = 2
            [x, list]
    test::value("hir-rootref-used-before-shadowing-binding", [[1], 2], list_literal_before_and_after_binding)

    # lower-hygiene-nested: a parameter named list and a branch binding
    # named list.
    fn list_parameter_and_branch_binding() errors compiler::CompilerError:
        static compile:
            fn f(list):
                if true:
                    list = 2
                    [list]
                else:
                    [list]

            [f(1), []]
    test::value("lower-hygiene-nested", [[2], []], list_parameter_and_branch_binding)

    # hir-rootref-closure-frames: a captured binding named list keeps its
    # value in the closure, and list literals still build lists.
    fn list_binding_captured() errors compiler::CompilerError:
        static compile:
            list = 3
            fn g():
                list

            [g(), list]
    test::value("hir-rootref-closure-frames", [3, 3], list_binding_captured)

    # lower-hygiene-diagnostics: a diagnostic about a binding named list
    # spells it list, as the source does.
    fn list_duplicate_spelled_as_written() errors compiler::CompilerError:
        static compile:
            list = 1
            list = 2
            []
    rejects_saying("lower-hygiene-diagnostics", compiler::DiagnosticCode::Duplicate, 835, 13, "duplicate binding \"list\" in the same lexical scope", list_duplicate_spelled_as_written)

# ---------------------------------------------------------------------------
# A local named like a namespace does not hide its qualified names

fn register_namespace_tests():
    # sr-module-local-shadow-of-namespace-name: mathish::inc is still the
    # module's function after a local named mathish.
    fn local_named_like_namespace() errors compiler::CompilerError:
        static compile:
            mathish = 5
            [mathish, mathish::inc(0)]
    test::value("sr-module-local-shadow-of-namespace-name", [5, 1], local_named_like_namespace)

with context test::suite()
register_source_order_tests()
register_scope_kind_tests()
register_self_reference_tests()
register_duplicate_tests()
register_shadowing_tests()
register_unbound_diagnostic_tests()
register_boolean_operator_tests(true, false, 1)
register_hygiene_tests()
register_namespace_tests()
test::report()
