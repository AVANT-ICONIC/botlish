    std::test::rejects("hoc-wrong-twin-reverse-declaring", std::compiler::DiagnosticCode::UnhandledError, wrong_twin_reverse)

    fn all_handled() errors std::compiler::CompilerError:
        static compile:
            fn observe(k: int):
                r = generic(k):
                    on E3 d:
                        return ["E3", d.code]
                    on E1:
