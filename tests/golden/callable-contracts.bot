    fn wrong_twin() errors std::compiler::CompilerError:
        static compile:
            fn observe(k: int):
                r = generic(k):
                    on E1:
                        return ["E1"]
                    on E2 {code}:
                        return ["E2", code]
                [r]
            [observe(k0), observe(k1), observe(k2), observe(k3)]
