            [observe(k0), observe(k1), observe(k2), observe(k3)]
    std::test::rejects("hoc-wrong-twin-capture", std::compiler::DiagnosticCode::UnhandledError, wrong_twin)

    fn wrong_twin_reverse() errors std::compiler::CompilerError:
        static compile:
            fn observe(k: int):
                r = outer(raise, k):
                    on E1:
                        return ["E1"]
                    on E3 d:
                        return ["E3", d.code]
