fn register_unit_table_tests():
    register_unit_shorthand_tests()
    register_unit_one_field_tests()
    register_unit_last_field_tests()
    register_unit_all_fields_tests()
    register_unit_renamed_tests()
    register_unit_renamed_swap_tests()
    register_unit_reordered_tests()
    register_unit_trailing_comma_tests()

fn register_unit_statement_tests():
    # destructure-value-rename: renamed bindings are usable in a larger body;
    # as the last statement a destructure is unit, also after other ones.
    fn rename_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: y} = Rec {a: 1, b: "x", c: 3, d: 4}
            f()
    std::test::value("destructure-value-rename/last", unit, rename_last)

    fn rename_bound() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: y} = Rec {a: 1, b: "x", c: 3, d: 4}
                [x, y]
            f()
    std::test::value("destructure-value-rename/bound", [1, "x"], rename_bound)

    fn rename_then_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: y} = Rec {a: 1, b: "x", c: 3, d: 4}
                z = [x, y]
                {a: p} = Rec {a: 1, b: "x", c: 3, d: 4}
            f()
    std::test::value("destructure-value-rename/later-destructure-last", unit, rename_then_last)

    # destructure-value-statement-order: the statements around a destructure
    # keep their order (probes 1 before it, 2 and 3 in its source, 4 after).
    fn statement_order() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                x = bump(1, 5)
                {a, b} = {a: bump(2, 1), b: bump(3, 2)}
                y = bump(4, 7)
                [x, a, b, y]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-value-statement-order", [1, 2, 3, 4, [5, 1, 2, 7]], statement_order)

    # destructure-value-ordinary-binding-unchanged: an ordinary binding ending
    # a body still yields its value: unit is the destructure's alone. (Its
    # projections from an untyped parameter, /projection and /hoisted, are in
    # destructuring-instances.bot.)
    fn plain_binding() errors std::compiler::CompilerError:
        static compile:
            fn f():
                x = 5
            f()
    std::test::value("destructure-value-ordinary-binding-unchanged/plain", 5, plain_binding)

    # destructure-value-top-level: a block (the Tcl program's top level)
    # ending in a destructure is unit.
    fn top_level_all() errors std::compiler::CompilerError:
        static compile:
            {a, b} = {a: 1, b: 2}
    std::test::value("destructure-value-top-level/literal-source", unit, top_level_all)

    fn top_level_binding() errors std::compiler::CompilerError:
        static compile:
            r = {a: 1, b: 2}
            {b} = r
    std::test::value("destructure-value-top-level/binding-source", unit, top_level_binding)

fn register_unit_loop_tests():
    # destructure-value-collecting-loop: a collecting loop whose body ends in
    # a destructure collects unit for each normal iteration. (The loops over
    # an untyped parameter's elements, /in, /two-fields and /empty, and the
    # branch, continue and break tests are in destructuring-instances.bot.)
    fn loop_counted() errors std::compiler::CompilerError:
        static compile:
            fn run():
                loop i from 0 to 3:
                    {s} = {s: i}
            run()
    std::test::value("destructure-value-collecting-loop/counted", [unit, unit, unit], loop_counted)

    fn loop_lockstep() errors std::compiler::CompilerError:
        static compile:
            fn run():
                pts = [{x: 1}, {x: 2}]
                loop p in pts and i from 0 to 2:
                    {x} = p
            run()
    std::test::value("destructure-value-collecting-loop/lockstep", [unit, unit], loop_lockstep)

fn register_unit_error_tests(negative: int):
    # destructure-value-error-capable: an error-capable source: success gives
    # the bindings and unit; failure is the ordinary error and no unit is
    # observed -- statically with the constant -5 (KnownError, what the Tcl
    # test observes), and at run time with a run-time argument: the caller's
    # handler returns "Oops" (a normal completion, unit, would answer
    # "completed").
    fn success() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
            run(3)
    std::test::value("destructure-value-error-capable/success/destructured", unit, success)

    fn success_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                unit
            run(3)
    std::test::value("destructure-value-error-capable/success/explicit", unit, success_explicit)

    fn failure_known() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
            run(-5)
    std::test::rejects("destructure-value-error-capable/failure/destructured", std::compiler::DiagnosticCode::KnownError, failure_known)

    fn failure_known_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                unit
            run(-5)
    std::test::rejects("destructure-value-error-capable/failure/explicit", std::compiler::DiagnosticCode::KnownError, failure_known_explicit)

    fn failure() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
            fn attempt(n):
                run(n):
                    on Oops:
                        return "Oops"
                "completed"
            attempt(negative)
    std::test::value("destructure-value-error-capable/failure/run-time/destructured", "Oops", failure)

    fn failure_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                unit
            fn attempt(n):
                run(n):
                    on Oops:
                        return "Oops"
                "completed"
            attempt(negative)
    std::test::value("destructure-value-error-capable/failure/run-time/explicit", "Oops", failure_explicit)

    # destructure-value-handled: a handled destructure is unit on both the
    # success and the handled path.
    fn handled() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                {a, b} = risky(n):
                    on Oops:
                        {a: -1, b: -2}
            [run(3), run(-1)]
    std::test::value("destructure-value-handled/destructured", [unit, unit], handled)

    fn handled_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                t = risky(n):
                    on Oops:
                        {a: -1, b: -2}
                a = t.a
                b = t.b
                unit
            [run(3), run(-1)]
    std::test::value("destructure-value-handled/explicit", [unit, unit], handled_explicit)

    # destructure-value-handled-bindings-and-order: the handled destructure
    # still binds on both paths and is followed by the next statement.
    fn handled_bindings() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                {a, b} = risky(n):
                    on Oops:
                        {a: -1, b: -2}
                [a, b]
            [run(3), run(-1)]
    std::test::value("destructure-value-handled-bindings-and-order", [[3, 6], [-1, -2]], handled_bindings)

fn register_unit_values_tests():
    # destructure-value-evaluate-once: a source is evaluated once whatever
    # follows the destructure: two destructures, then a unit statement, trace
    # each source once (1, 2 for mk_named, then 1, 2 for mk_anon); one
    # destructure traces its source once.
    fn two_sources() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, b, c} = mk_named()
                {a: a2} = mk_anon()
                unit
                [a, a2]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-value-evaluate-once/two-sources", [1, 2, 1, 2, [1, 1]], two_sources)

    fn one_source() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, c} = mk_named()
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-value-evaluate-once/one-source", [1, 2, [1, 3]], one_source)

    # destructure-value-mutable-field-still-same-value: a MutableArray field's
    # binding is a logical copy (a write to it leaves the field unchanged),
    # and a destructure ending the body is unit.
    fn mutable_last() errors std::compiler::CompilerError:
        static compile:
            fn run():
                h = Holder {items: std::mutable_array::create(2, 0), n: 1}
                {items} = h
            run()
    std::test::value("destructure-value-mutable-field-still-same-value/last", unit, mutable_last)

    fn mutable_copy() errors std::compiler::CompilerError:
        static compile:
            fn run():
                h = Holder {items: std::mutable_array::create(2, 0), n: 1}
                {items} = h
                a = std::mutable_array::set(items, 0, 5):
                    on IndexNotFound:
                        unit
                [std::mutable_array::get(h.items, 0, -1), std::mutable_array::get(items, 0, -1)]
            run()
    std::test::value("destructure-value-mutable-field-still-same-value/copy", [0, 5], mutable_copy)

    # destructure-value-bindings-are-values: a binding keeps its value when a
    # later struct is destructured.
    fn bindings_are_values() errors std::compiler::CompilerError:
        static compile:
            fn run():
                s = {a: 1}
                {a} = s
                t = {a: 2}
                {a: other} = t
                [a, other, s.a, t.a]
            run()
    std::test::value("destructure-value-bindings-are-values", [1, 2, 1, 2], bindings_are_values)

fn register_unit_rejection_tests():
    # destructure-value-static-errors-unchanged: the same diagnostic with the
    # destructure as the last statement (/last) as with a statement after it
    # (/inner). (The Tcl test's two parser cases, a duplicate field and a
    # List pattern, are parse errors: Tcl.)
    fn unknown_field_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, nope} = {a: 1}
            f()
    fn unknown_field_inner() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, nope} = {a: 1}
                1
            f()
    std::test::rejects("destructure-value-static-errors-unchanged/unknown-field/last", std::compiler::DiagnosticCode::UnknownField, unknown_field_last)
    std::test::rejects("destructure-value-static-errors-unchanged/unknown-field/inner", std::compiler::DiagnosticCode::UnknownField, unknown_field_inner)
    same_diagnostic("destructure-value-static-errors-unchanged/unknown-field/same-diagnostic", unknown_field_last, unknown_field_inner)

    fn not_a_struct_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a} = 5
            f()
    fn not_a_struct_inner() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a} = 5
                1
            f()
    std::test::rejects("destructure-value-static-errors-unchanged/not-a-struct/last", std::compiler::DiagnosticCode::NotAStruct, not_a_struct_last)
    std::test::rejects("destructure-value-static-errors-unchanged/not-a-struct/inner", std::compiler::DiagnosticCode::NotAStruct, not_a_struct_inner)
    same_diagnostic("destructure-value-static-errors-unchanged/not-a-struct/same-diagnostic", not_a_struct_last, not_a_struct_inner)

    fn duplicate_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: x} = {a: 1, b: 2}
            f()
    fn duplicate_inner() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: x} = {a: 1, b: 2}
                1
            f()
    std::test::rejects("destructure-value-static-errors-unchanged/duplicate/last", std::compiler::DiagnosticCode::Duplicate, duplicate_last)
    std::test::rejects("destructure-value-static-errors-unchanged/duplicate/inner", std::compiler::DiagnosticCode::Duplicate, duplicate_inner)
    same_diagnostic("destructure-value-static-errors-unchanged/duplicate/same-diagnostic", duplicate_last, duplicate_inner)

    fn nested_not_a_struct_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: {b}} = {a: 1}
            f()
    fn nested_not_a_struct_inner() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: {b}} = {a: 1}
                1
            f()
    std::test::rejects("destructure-value-static-errors-unchanged/nested-not-a-struct/last", std::compiler::DiagnosticCode::NotAStruct, nested_not_a_struct_last)
    std::test::rejects("destructure-value-static-errors-unchanged/nested-not-a-struct/inner", std::compiler::DiagnosticCode::NotAStruct, nested_not_a_struct_inner)
    same_diagnostic("destructure-value-static-errors-unchanged/nested-not-a-struct/same-diagnostic", nested_not_a_struct_last, nested_not_a_struct_inner)

    # destructure-value-unproven-shape-unchanged: a call passing an Int to a
    # destructuring function is the ordinary projection error (Type, at the
    # call), with the destructure last or not.
    fn unproven_last() errors std::compiler::CompilerError:
        static compile:
            fn f(x):
                {a} = x
            f(3)
    std::test::rejects("destructure-value-unproven-shape-unchanged/last", std::compiler::DiagnosticCode::Type, unproven_last)

    fn unproven_inner() errors std::compiler::CompilerError:
        static compile:
            fn f(x):
                {a} = x
                1
            f(3)
    std::test::rejects("destructure-value-unproven-shape-unchanged/inner", std::compiler::DiagnosticCode::Type, unproven_inner)

    # destructure-value-static-error-locations: the unit is not a
    # source-visible statement: a rejection points where it did before.
    fn location_unknown_field() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, nope} = {a: 1}
            f()
    std::test::rejects_at("destructure-value-static-error-locations/unknown-field", std::compiler::DiagnosticCode::UnknownField, 3304, 21, location_unknown_field)

    fn location_continuation() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {good,
              mising} = {good: 1}
            f()
    std::test::rejects_at("destructure-value-static-error-locations/continuation-line", std::compiler::DiagnosticCode::UnknownField, 3312, 15, location_continuation)

    fn location_duplicate() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a: x, b: x} = {a: 1, b: 2}
            f()
    std::test::rejects_at("destructure-value-static-error-locations/duplicate", std::compiler::DiagnosticCode::Duplicate, 3319, 27, location_duplicate)

    fn location_inner() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, nope} = {a: 1}
                1
            f()
    std::test::rejects_at("destructure-value-static-error-locations/inner", std::compiler::DiagnosticCode::UnknownField, 3326, 21, location_inner)


# ---------------------------------------------------------------------------
# The same program: the Tcl tests also require the two spellings to have one
# HIR, core IR, NIR and analysis (Tcl only); their values, on every backend,
# are these.

fn register_same_program_tests():
    # destructure-same-program-scalar: Int fields read in a typed function.
    fn scalar() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                {a, b: c} = {a: n, b: n + 1}
                a * c
            [run(1), run(2)]
    std::test::value("destructure-same-program-scalar/destructured", [2, 6], scalar)

    fn scalar_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                tmp = {a: n, b: n + 1}
                a = tmp.a
                c = tmp.b
                unit
                a * c
            [run(1), run(2)]
    std::test::value("destructure-same-program-scalar/explicit", [2, 6], scalar_explicit)

    # destructure-same-program-named: a declared struct literal source.
    fn named() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                {x, y} = Point {x: n, y: n * 2}
                x + y
            [run(1), run(5)]
    std::test::value("destructure-same-program-named/destructured", [3, 15], named)

    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                tmp = Point {x: n, y: n * 2}
                x = tmp.x
                y = tmp.y
                unit
                x + y
            [run(1), run(5)]
    std::test::value("destructure-same-program-named/explicit", [3, 15], named_explicit)

    # destructure-same-program-call-source: a declared struct returned by a
    # call, read out of declaration order.
    fn call_source() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int) -> Point:
                Point {x: n, y: n + 1}
            fn run(n: int) -> int:
                {y, x} = make(n)
                x * 100 + y
            [run(1), run(5)]
    std::test::value("destructure-same-program-call-source/destructured", [102, 506], call_source)

    fn call_source_explicit() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int) -> Point:
                Point {x: n, y: n + 1}
            fn run(n: int) -> int:
                tmp = make(n)
                y = tmp.y
                x = tmp.x
                unit
                x * 100 + y
            [run(1), run(5)]
    std::test::value("destructure-same-program-call-source/explicit", [102, 506], call_source_explicit)

    # destructure-same-program-nested: a nested pattern.
    fn nested() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                {u: {a, b}, v} = {u: {a: n, b: n + 1, c: 0}, v: n * 3}
                a + b + v
            [run(1), run(5)]
    std::test::value("destructure-same-program-nested/destructured", [6, 26], nested)

    fn nested_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int) -> int:
                tmp = {u: {a: n, b: n + 1, c: 0}, v: n * 3}
                tmp2 = tmp.u
                a = tmp2.a
                b = tmp2.b
                v = tmp.v
                unit
                a + b + v
            [run(1), run(5)]
    std::test::value("destructure-same-program-nested/explicit", [6, 26], nested_explicit)

    # destructure-same-program-capture: bindings captured by a closure.
    fn capture() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int):
                {a, b: c} = {a: n, b: n + 1}
                fn f(k: int) -> int:
                    a * k + c
                f
            make(3)(4)
    std::test::value("destructure-same-program-capture/destructured", 16, capture)

    fn capture_explicit() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int):
                tmp = {a: n, b: n + 1}
                a = tmp.a
                c = tmp.b
                unit
                fn f(k: int) -> int:
                    a * k + c
                f
            make(3)(4)
    std::test::value("destructure-same-program-capture/explicit", 16, capture_explicit)

    # destructure-same-program-in-loop: in a counted loop's body.
    fn in_loop() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                loop i from 0 to n:
                    {s, t} = {s: i, t: i * i}
                    s + t
            run(4)
    std::test::value("destructure-same-program-in-loop/destructured", [0, 2, 6, 12], in_loop)

    fn in_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                loop i from 0 to n:
                    tmp = {s: i, t: i * i}
                    s = tmp.s
                    t = tmp.t
                    unit
                    s + t
            run(4)
    std::test::value("destructure-same-program-in-loop/explicit", [0, 2, 6, 12], in_loop_explicit)

    # destructure-same-program-refined: fields computed from a refined
    # parameter.
    fn refined() errors std::compiler::CompilerError:
        static compile:
            fn run(n: Small) -> int:
                {a, b} = {a: n + 1, b: n * 2}
                a + b
            [run(1), run(9)]
    std::test::value("destructure-same-program-refined/destructured", [4, 28], refined)

    fn refined_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: Small) -> int:
                tmp = {a: n + 1, b: n * 2}
                a = tmp.a
                b = tmp.b
                unit
                a + b
            [run(1), run(9)]
    std::test::value("destructure-same-program-refined/explicit", [4, 28], refined_explicit)

    # destructure-same-program-last-statement: a destructure ending a body.
    fn last_statement() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                {a, b: c} = {a: n, b: n + 1}
            [run(1), run(2)]
    std::test::value("destructure-same-program-last-statement/destructured", [unit, unit], last_statement)

    fn last_statement_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                tmp = {a: n, b: n + 1}
                a = tmp.a
                c = tmp.b
                unit
            [run(1), run(2)]
    std::test::value("destructure-same-program-last-statement/explicit", [unit, unit], last_statement_explicit)

    # destructure-same-program-last-statement-nested: a nested one.
    fn last_nested() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                {u: {a, b}, v} = {u: {a: n, b: n + 1}, v: n * 3}
            [run(1), run(5)]
    std::test::value("destructure-same-program-last-statement-nested/destructured", [unit, unit], last_nested)

    fn last_nested_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                tmp = {u: {a: n, b: n + 1}, v: n * 3}
                tmp2 = tmp.u
                a = tmp2.a
                b = tmp2.b
                v = tmp.v
                unit
            [run(1), run(5)]
    std::test::value("destructure-same-program-last-statement-nested/explicit", [unit, unit], last_nested_explicit)

    # destructure-same-program-last-in-branch: ending a branch.
    fn last_in_branch() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                if n > 2:
                    {a, b} = {a: n, b: n + 1}
                else:
                    unit
            [run(1), run(5)]
    std::test::value("destructure-same-program-last-in-branch/destructured", [unit, unit], last_in_branch)

    fn last_in_branch_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                if n > 2:
                    tmp = {a: n, b: n + 1}
                    a = tmp.a
                    b = tmp.b
                    unit
                else:
                    unit
            [run(1), run(5)]
    std::test::value("destructure-same-program-last-in-branch/explicit", [unit, unit], last_in_branch_explicit)

    # destructure-same-program-last-in-loop: ending a loop body.
    fn last_in_loop() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                loop i from 0 to n:
                    {s, t} = {s: i, t: i * i}
            run(4)
    std::test::value("destructure-same-program-last-in-loop/destructured", [unit, unit, unit, unit], last_in_loop)

    fn last_in_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n: int):
                loop i from 0 to n:
                    tmp = {s: i, t: i * i}
                    s = tmp.s
                    t = tmp.t
                    unit
            run(4)
    std::test::value("destructure-same-program-last-in-loop/explicit", [unit, unit, unit, unit], last_in_loop_explicit)

    # destructure-same-program-last-capturing-unit-result: a body with a
    # capturing closure, ending in a destructure of its result.
    fn last_capturing() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int):
                {a, b} = {a: n, b: n + 1}
                fn f(k: int) -> int:
                    a * k + b
                r = f(2)
                {p} = {p: r}
            make(3)
    std::test::value("destructure-same-program-last-capturing-unit-result/destructured", unit, last_capturing)

    fn last_capturing_explicit() errors std::compiler::CompilerError:
        static compile:
            fn make(n: int):
                tmp = {a: n, b: n + 1}
                a = tmp.a
                b = tmp.b
                unit
                fn f(k: int) -> int:
                    a * k + b
                r = f(2)
                tmp2 = {p: r}
                p = tmp2.p
                unit
            make(3)
    std::test::value("destructure-same-program-last-capturing-unit-result/explicit", unit, last_capturing_explicit)

# ---------------------------------------------------------------------------
# The standalone-executable program (its executables are Tcl's): a typed
# accumulator whose fields are probed; each run evaluates its source once
# (probes 1, 2) and reads total and last.

fn register_standalone_program_tests():
    # destructure-standalone-executable
    fn typed_program() errors std::compiler::CompilerError:
        static compile:
            fn step(n: int) -> Acc:
                Acc {total: bump(1, n * 2), count: bump(2, n), last: n}
            fn run(n: int) -> int:
                {total, last: l} = step(n)
                total * 1000 + l * 100
            fn program() -> any:
                [run(1), run(20)]
            coroutine {step: resume, first} = program()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(resume):
                    break
                else:
                    resume()
    std::test::value("destructure-standalone-executable/destructured", [1, 2, 1, 2, [2100, 42000]], typed_program)

    fn typed_program_explicit() errors std::compiler::CompilerError:
        static compile:
            fn step(n: int) -> Acc:
                Acc {total: bump(1, n * 2), count: bump(2, n), last: n}
            fn run(n: int) -> int:
                tmp = step(n)
                total = tmp.total
                l = tmp.last
                total * 1000 + l * 100
            fn program() -> any:
                [run(1), run(20)]
            coroutine {step: resume, first} = program()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(resume):
                    break
                else:
                    resume()
    std::test::value("destructure-standalone-executable/explicit", [1, 2, 1, 2, [2100, 42000]], typed_program_explicit)

