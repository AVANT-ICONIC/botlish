# destructuring.bot -- struct destructuring (STRUCT-DESTRUCTURING.md), as a
# source-level specification.
#
#     {user, expires: expiry} = result
#
# selects fields of a struct value by name and binds each to an ordinary,
# immutable local:
#   * the statement evaluates its source exactly once, then reads every
#     selected field by the ordinary static projection and binds it: the
#     left name of an entry is the field read, the right name the binding
#     made (`{a}` is short for `{a: a}`). It is the explicit spelling
#     `tmp = result; user = tmp.user; expiry = tmp.expires` and nothing more;
#     the statement's own value is `unit`, never the last field read;
#   * named and anonymous struct values destructure alike; a pattern selects
#     any subset of the fields, in any order, may rename, may end in a
#     trailing comma and may span lines; an omitted field is simply not
#     bound (there is no rest value) and the source struct stays whole;
#   * a field may be destructured in turn (`{user: {name, id}} = r`): only
#     the leaves are bound;
#   * the bindings are values: a destructured MutableArray field is a logical
#     copy, a closure captures a destructured binding like any other, a
#     later struct never retargets an earlier binding;
#   * the source is any expression: a call (method sugar included), a struct
#     literal, a handled call; an error-capable source propagates, or is
#     handled, exactly as for an ordinary binding;
#   * the ordinary scope rules hold: a destructured name is local to its
#     block, may shadow an outer name in an inner scope, is not visible
#     before the statement (the source is resolved first, as an ordinary
#     initializer is) and collides with any other binding of its scope
#     (Duplicate);
#   * a rejection is the ordinary projection diagnostic, reported at the
#     field name written in the pattern: UnknownField, NotAStruct (a List
#     source with struct syntax included: that is never the List
#     destructuring policy), UnprovenField, and Type for a call passing a
#     non-struct to a destructuring function.
#
# Ported from tests/struct-destructuring.test
# (audit/golden/migration/fragments/destructuring.tsv maps every Tcl test to
# its golden tests). Most Tcl tests run two spellings of one program -- the
# destructured one and the explicit `tmp = SOURCE; x = tmp.f` one -- and
# require one outcome of both on every backend: each becomes two golden
# tests, NAME/destructured and NAME/explicit, with the same expected value;
# a rejection the Tcl test requires to be the same for both spellings also
# gets a NAME/same-diagnostic test comparing the two diagnostics' codes and
# messages. The Tcl programs' top level is the body's block.
#
# destructuring-instances.bot holds the tests whose source is an untyped
# parameter, its struct type proven call by call by a semantic instance: the
# unspecialized native baseline cannot compile those (NATIVE UNSUPPORTED
# struct-shape), and run.tcl would otherwise stand the specialized outcome
# in for this whole suite's cranelift-generic run. collections.bot already
# holds destructure-basic-named-names-swapped and
# destructure-once-nested-once. The parser tests (AST shape, syntax errors,
# the LIST-DESTRUCTURING policy of `[a, b] = v`), the lowering, HIR, core IR
# and NIR identity tests, the module-level rejection and the fuzz smoke test
# stay in Tcl.
#
# Imports: compiler and test are the framework's (bodies declare
# std::compiler::CompilerError; DiagnosticCode cases; std::compiler::SourceLocation is
# also the module struct of destructure-module-struct-source); list for
# std::list::at, std::list::length and the method sugar `xs.length()`; str for
# std::str::length (destructure-fields-of-different-types); mutable_array for the
# MutableArray fields and sources; coroutine for std::coroutine::done?, which
# drives the evaluation probe `bump`.
import std::compiler
import std::coroutine
import std::list
import std::mutable_array
import std::str
import std::test

# ---------------------------------------------------------------------------
# Shared declarations (top-level only)

# The destructuring theorem's record: every basic, unit-value and rejection
# test reads it (the Tcl tests' Rec, also named in UnknownField's message).
struct Rec:
    a: int
    b: str
    c: int
    d: int

# The evaluate-once tests' record (the Tcl $countDecls' three-field Rec).
struct CountedRec:
    a: int
    b: str
    c: int

# destructure-bound-mutable-value-is-the-same-value: a struct holding a
# MutableArray.
struct Holder:
    items: MutableArray[int]
    n: int

# destructure-field-order-is-not-layout: fields declared z, y, x (the Tcl
# test's Z).
struct DeclaredBackwards:
    z: int
    y: int
    x: int

# destructure-omitted-named-struct-gains-a-field: the two versions of one
# declared result (the Tcl test's R before and after it gains `token`).
struct Session:
    user: str
    expires: int

struct SessionWithToken:
    user: str
    expires: int
    token: str

# destructure-scope-in-nested-function: the inner and outer functions'
# argument structs (the Tcl test's P and R).
struct InnerArg:
    a: int

struct OuterArg:
    b: int

# destructure-function-result-named-return: the declared result (the Tcl
# test's User).
struct UserRecord:
    name: str
    id: int
    token: str
    expires: int

# destructure-nested-basic: a struct with a struct field (the Tcl test's
# User and Result).
struct User:
    name: str
    id: int
    admin: bool

struct Login:
    user: User
    expires: int

# destructure-capture-struct-value: a struct field holding a struct (the
# Tcl test's K and W).
struct Knob:
    k: int

struct Wrapper:
    inner: Knob

# destructure-same-program-named and -call-source: the Tcl tests' P.
struct Point:
    x: int
    y: int

# destructure-same-program-refined: a refined parameter type.
type Small = Int in 0..10

# destructure-standalone-executable: the typed accumulator.
struct Acc:
    total: int
    count: int
    last: int

# The error-capable source of the Tcl $errDecls: risky fails with Oops for a
# negative argument and returns a two-field struct otherwise.
error Oops

fn risky(n: int) errors Oops:
    if n < 0:
        fail Oops
    {a: n, b: n * 2}

# An evaluation probe, standing in for the Tcl tests' context-held Log
# (bump, logged, reset over a MutableArray of digits): each call yields its
# ID to the coroutine a body drives, then returns V. A body starts its
# program (a root function declared `-> any`, so that the yielded Ints and
# the final result share the outward type) as a coroutine and collects the
# trace: every probe ID in call order, then the program's result. The Tcl
# log 12 is the trace 1, 2.
fn bump(id: int, v: int) -> int:
    yield id
    v

# The Tcl $countDecls' sources: a named and an anonymous struct whose a and
# c fields are probed (1, then 2).
fn mk_named() -> CountedRec:
    CountedRec {a: bump(1, 1), b: "x", c: bump(2, 3)}

fn mk_anon():
    {a: bump(1, 1), b: "x", c: bump(2, 3)}

# ---------------------------------------------------------------------------
# The one diagnostic check beyond stdlib/test.bot's helpers: the Tcl tests that
# require two programs to be rejected with the same diagnostic (same code,
# same message). It reaches its verdict through std::test::passed / std::test::mismatch
# / std::test::equal.

# A block's outcome as a diagnostic: whether BODY's block was rejected, and
# if so with which code and message.
struct Rejection:
    rejected: bool
    code: std::compiler::DiagnosticCode
    message: str

fn rejection_of(body) -> Rejection:
    accepted = body():
        on std::compiler::CompilerError {code, message}:
            return Rejection {rejected: true, code: code, message: message}
    Rejection {rejected: false, code: std::compiler::DiagnosticCode::Type, message: ""}

# NAME: the blocks of ONE and OTHER are both rejected, with the same code and
# the same message.
nomethod fn same_diagnostic(name: str, one, other) -> unit:
    fn check() -> std::test::Match:
        first = rejection_of(one)
        second = rejection_of(other)
        if not first.rejected or not second.rejected:
            return std::test::mismatch("both blocks rejected", "a block was accepted", "")
        if first.code != second.code:
            return std::test::mismatch("compiler diagnostic ".concat(std::test::code_name(first.code)), "compiler diagnostic ".concat(std::test::code_name(second.code)), second.message)
        std::test::equal(first.message, second.message)
    std::test::case(name, check)

# ---------------------------------------------------------------------------
# Struct syntax is not the List policy; Lists keep their meaning

fn register_list_policy_tests():
    # destructure-list-struct-syntax-on-list-source-is-not-list-policy:
    # `{a} = xs` names a field, so a List source is the ordinary projection
    # error, naming the field and the List type -- never the
    # LIST-DESTRUCTURING diagnostic of `[a, b] = xs` (a parse error).
    fn struct_syntax_on_list() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2]
            {a} = xs
    std::test::rejects_message("destructure-list-struct-syntax-on-list-source-is-not-list-policy", std::compiler::DiagnosticCode::NotAStruct, "cannot project field \"a\" from a value of type List[int]: only a struct has fields", struct_syntax_on_list)

    # destructure-list-ordinary-list-uses: a List literal followed by `=`
    # anywhere else keeps its meaning.
    fn list_bindings() errors std::compiler::CompilerError:
        static compile:
            xs = [1, 2]
            ys = [3]
            [xs, ys]
    std::test::value("destructure-list-ordinary-list-uses/bindings", [[1, 2], [3]], list_bindings)

    fn list_equality() errors std::compiler::CompilerError:
        static compile:
            [1, 2] == [1, 2]
    std::test::value("destructure-list-ordinary-list-uses/equality", true, list_equality)

    fn bound_equality() errors std::compiler::CompilerError:
        static compile:
            x = [1] == [1]
            x
    std::test::value("destructure-list-ordinary-list-uses/bound-equality", true, bound_equality)

    fn element_source() errors std::compiler::CompilerError:
        static compile:
            xs = [{a: 1}]
            {a} = std::list::at(xs, 0)
            a
    std::test::value("destructure-list-ordinary-list-uses/element-source", 1, element_source)

    # destructure-list-indexing-unchanged: List indexing is still an
    # ordinary call, through method sugar or spelled out.
    fn indexing_sugar() errors std::compiler::CompilerError:
        static compile:
            at = std::list::at
            xs = [10, 20, 30]
            xs.at(1)
    std::test::value("destructure-list-indexing-unchanged/sugar", 20, indexing_sugar)

    fn indexing_explicit() errors std::compiler::CompilerError:
        static compile:
            xs = [10, 20, 30]
            std::list::at(xs, 1)
    std::test::value("destructure-list-indexing-unchanged/explicit", 20, indexing_explicit)

# ---------------------------------------------------------------------------
# What the lowering's temporaries leave observable: nothing

fn register_lowering_tests():
    # destructure-lowering-user-names-cannot-collide: a program binding
    # `destructure` or `tmp` is not disturbed by the hidden temporary.
    fn user_names() errors std::compiler::CompilerError:
        static compile:
            destructure = 1
            tmp = 2
            {a, b} = {a: destructure, b: tmp}
            [a, b, destructure, tmp]
    std::test::value("destructure-lowering-user-names-cannot-collide", [1, 2, 1, 2], user_names)

    # destructure-lowering-two-destructures-one-scope: several destructures
    # in one scope (one nested) each get their own temporary.
    fn two_in_one_scope() errors std::compiler::CompilerError:
        static compile:
            {a} = {a: 1}
            {b} = {b: 2}
            {c: {d}} = {c: {d: 3}}
            [a, b, d]
    std::test::value("destructure-lowering-two-destructures-one-scope", [1, 2, 3], two_in_one_scope)

# ---------------------------------------------------------------------------
# The theorem: a destructure is its explicit spelling, for a named struct value
# (Rec) and an anonymous one alike. Each Tcl table row is four golden tests:
# the named and the anonymous source, each destructured and explicit, all
# with the row's one expected value. (destructure-basic-named-names-swapped
# is in collections.bot.)

# destructure-basic-*-all: every field, in declaration order.
fn register_basic_all_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, b, c, d} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, b, c, d]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            b = tmp.b
            c = tmp.c
            d = tmp.d
            [a, b, c, d]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, b, c, d} = {a: 1, b: "x", c: 3, d: 4}
            [a, b, c, d]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            b = tmp.b
            c = tmp.c
            d = tmp.d
            [a, b, c, d]
    std::test::value("destructure-basic-named-all/destructured", [1, "x", 3, 4], named)
    std::test::value("destructure-basic-named-all/explicit", [1, "x", 3, 4], named_explicit)
    std::test::value("destructure-basic-anonymous-all/destructured", [1, "x", 3, 4], anonymous)
    std::test::value("destructure-basic-anonymous-all/explicit", [1, "x", 3, 4], anonymous_explicit)

# destructure-basic-*-one: a single field.
fn register_basic_one_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {c} = Rec {a: 1, b: "x", c: 3, d: 4}
            c
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            c = tmp.c
            c
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {c} = {a: 1, b: "x", c: 3, d: 4}
            c
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            c = tmp.c
            c
    std::test::value("destructure-basic-named-one/destructured", 3, named)
    std::test::value("destructure-basic-named-one/explicit", 3, named_explicit)
    std::test::value("destructure-basic-anonymous-one/destructured", 3, anonymous)
    std::test::value("destructure-basic-anonymous-one/explicit", 3, anonymous_explicit)

# destructure-basic-*-two: two fields that are not adjacent.
fn register_basic_two_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, d} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, d]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            d = tmp.d
            [a, d]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, d} = {a: 1, b: "x", c: 3, d: 4}
            [a, d]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            d = tmp.d
            [a, d]
    std::test::value("destructure-basic-named-two/destructured", [1, 4], named)
    std::test::value("destructure-basic-named-two/explicit", [1, 4], named_explicit)
    std::test::value("destructure-basic-anonymous-two/destructured", [1, 4], anonymous)
    std::test::value("destructure-basic-anonymous-two/explicit", [1, 4], anonymous_explicit)

# destructure-basic-*-all-but-one: every field but the last.
fn register_basic_all_but_one_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, b, c} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, b, c]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            b = tmp.b
            c = tmp.c
            [a, b, c]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, b, c} = {a: 1, b: "x", c: 3, d: 4}
            [a, b, c]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            b = tmp.b
            c = tmp.c
            [a, b, c]
    std::test::value("destructure-basic-named-all-but-one/destructured", [1, "x", 3], named)
    std::test::value("destructure-basic-named-all-but-one/explicit", [1, "x", 3], named_explicit)
    std::test::value("destructure-basic-anonymous-all-but-one/destructured", [1, "x", 3], anonymous)
    std::test::value("destructure-basic-anonymous-all-but-one/explicit", [1, "x", 3], anonymous_explicit)

# destructure-basic-*-last-field: only the last declared field.
fn register_basic_last_field_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {d} = Rec {a: 1, b: "x", c: 3, d: 4}
            d
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            d = tmp.d
            d
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {d} = {a: 1, b: "x", c: 3, d: 4}
            d
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            d = tmp.d
            d
    std::test::value("destructure-basic-named-last-field/destructured", 4, named)
    std::test::value("destructure-basic-named-last-field/explicit", 4, named_explicit)
    std::test::value("destructure-basic-anonymous-last-field/destructured", 4, anonymous)
    std::test::value("destructure-basic-anonymous-last-field/explicit", 4, anonymous_explicit)

# destructure-basic-*-reordered: every field, in reverse order.
fn register_basic_reordered_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {d, c, b, a} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, b, c, d]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            d = tmp.d
            c = tmp.c
            b = tmp.b
            a = tmp.a
            [a, b, c, d]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {d, c, b, a} = {a: 1, b: "x", c: 3, d: 4}
            [a, b, c, d]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            d = tmp.d
            c = tmp.c
            b = tmp.b
            a = tmp.a
            [a, b, c, d]
    std::test::value("destructure-basic-named-reordered/destructured", [1, "x", 3, 4], named)
    std::test::value("destructure-basic-named-reordered/explicit", [1, "x", 3, 4], named_explicit)
    std::test::value("destructure-basic-anonymous-reordered/destructured", [1, "x", 3, 4], anonymous)
    std::test::value("destructure-basic-anonymous-reordered/explicit", [1, "x", 3, 4], anonymous_explicit)

# destructure-basic-*-reordered-subset: a subset, out of declaration order.
fn register_basic_reordered_subset_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {c, a} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, c]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            c = tmp.c
            a = tmp.a
            [a, c]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {c, a} = {a: 1, b: "x", c: 3, d: 4}
            [a, c]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            c = tmp.c
            a = tmp.a
            [a, c]
    std::test::value("destructure-basic-named-reordered-subset/destructured", [1, 3], named)
    std::test::value("destructure-basic-named-reordered-subset/explicit", [1, 3], named_explicit)
    std::test::value("destructure-basic-anonymous-reordered-subset/destructured", [1, 3], anonymous)
    std::test::value("destructure-basic-anonymous-reordered-subset/explicit", [1, 3], anonymous_explicit)

# destructure-basic-*-rename-one: one field bound under another name.
fn register_basic_rename_one_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a: x} = Rec {a: 1, b: "x", c: 3, d: 4}
            x
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            x
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a: x} = {a: 1, b: "x", c: 3, d: 4}
            x
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            x
    std::test::value("destructure-basic-named-rename-one/destructured", 1, named)
    std::test::value("destructure-basic-named-rename-one/explicit", 1, named_explicit)
    std::test::value("destructure-basic-anonymous-rename-one/destructured", 1, anonymous)
    std::test::value("destructure-basic-anonymous-rename-one/explicit", 1, anonymous_explicit)

# destructure-basic-*-rename-then-short: a renaming entry, then a shorthand
# one.
fn register_basic_rename_then_short_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a: x, b} = Rec {a: 1, b: "x", c: 3, d: 4}
            [x, b]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            b = tmp.b
            [x, b]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a: x, b} = {a: 1, b: "x", c: 3, d: 4}
            [x, b]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            b = tmp.b
            [x, b]
    std::test::value("destructure-basic-named-rename-then-short/destructured", [1, "x"], named)
    std::test::value("destructure-basic-named-rename-then-short/explicit", [1, "x"], named_explicit)
    std::test::value("destructure-basic-anonymous-rename-then-short/destructured", [1, "x"], anonymous)
    std::test::value("destructure-basic-anonymous-rename-then-short/explicit", [1, "x"], anonymous_explicit)

# destructure-basic-*-rename-both: two renaming entries.
fn register_basic_rename_both_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a: x, b: y} = Rec {a: 1, b: "x", c: 3, d: 4}
            [x, y]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            y = tmp.b
            [x, y]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a: x, b: y} = {a: 1, b: "x", c: 3, d: 4}
            [x, y]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            x = tmp.a
            y = tmp.b
            [x, y]
    std::test::value("destructure-basic-named-rename-both/destructured", [1, "x"], named)
    std::test::value("destructure-basic-named-rename-both/explicit", [1, "x"], named_explicit)
    std::test::value("destructure-basic-anonymous-rename-both/destructured", [1, "x"], anonymous)
    std::test::value("destructure-basic-anonymous-rename-both/explicit", [1, "x"], anonymous_explicit)

# destructure-basic-*-mixed-three: shorthand and renaming entries mixed.
fn register_basic_mixed_three_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, b: y, c} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, y, c]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            y = tmp.b
            c = tmp.c
            [a, y, c]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, b: y, c} = {a: 1, b: "x", c: 3, d: 4}
            [a, y, c]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            y = tmp.b
            c = tmp.c
            [a, y, c]
    std::test::value("destructure-basic-named-mixed-three/destructured", [1, "x", 3], named)
    std::test::value("destructure-basic-named-mixed-three/explicit", [1, "x", 3], named_explicit)
    std::test::value("destructure-basic-anonymous-mixed-three/destructured", [1, "x", 3], anonymous)
    std::test::value("destructure-basic-anonymous-mixed-three/explicit", [1, "x", 3], anonymous_explicit)

# destructure-basic-*-names-swapped: two fields bound under each other's
# names.
fn register_basic_names_swapped_tests():
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a: b, b: a} = {a: 1, b: "x", c: 3, d: 4}
            [a, b]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            b = tmp.a
            a = tmp.b
            [a, b]
    std::test::value("destructure-basic-anonymous-names-swapped/destructured", ["x", 1], anonymous)
    std::test::value("destructure-basic-anonymous-names-swapped/explicit", ["x", 1], anonymous_explicit)

# destructure-basic-*-rename-to-other-field-name: the binding names are other
# fields' names: the left name is always the field read.
fn register_basic_rename_to_other_field_name_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a: d, d: a} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, d]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            d = tmp.a
            a = tmp.d
            [a, d]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a: d, d: a} = {a: 1, b: "x", c: 3, d: 4}
            [a, d]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            d = tmp.a
            a = tmp.d
            [a, d]
    std::test::value("destructure-basic-named-rename-to-other-field-name/destructured", [4, 1], named)
    std::test::value("destructure-basic-named-rename-to-other-field-name/explicit", [4, 1], named_explicit)
    std::test::value("destructure-basic-anonymous-rename-to-other-field-name/destructured", [4, 1], anonymous)
    std::test::value("destructure-basic-anonymous-rename-to-other-field-name/explicit", [4, 1], anonymous_explicit)

# destructure-basic-*-trailing-comma: a trailing comma, as in a struct
# literal.
fn register_basic_trailing_comma_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, d: z,} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, z]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            z = tmp.d
            [a, z]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, d: z,} = {a: 1, b: "x", c: 3, d: 4}
            [a, z]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            z = tmp.d
            [a, z]
    std::test::value("destructure-basic-named-trailing-comma/destructured", [1, 4], named)
    std::test::value("destructure-basic-named-trailing-comma/explicit", [1, 4], named_explicit)
    std::test::value("destructure-basic-anonymous-trailing-comma/destructured", [1, 4], anonymous)
    std::test::value("destructure-basic-anonymous-trailing-comma/explicit", [1, 4], anonymous_explicit)

# destructure-basic-*-multiline: the pattern spans lines, as a struct literal
# may.
fn register_basic_multiline_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {
                a,
                d: z,
            } = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, z]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            z = tmp.d
            [a, z]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {
                a,
                d: z,
            } = {a: 1, b: "x", c: 3, d: 4}
            [a, z]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            z = tmp.d
            [a, z]
    std::test::value("destructure-basic-named-multiline/destructured", [1, 4], named)
    std::test::value("destructure-basic-named-multiline/explicit", [1, 4], named_explicit)
    std::test::value("destructure-basic-anonymous-multiline/destructured", [1, 4], anonymous)
    std::test::value("destructure-basic-anonymous-multiline/explicit", [1, 4], anonymous_explicit)

# destructure-basic-*-bound-names-usable: the bound names are ordinary
# operands.
fn register_basic_bound_names_usable_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a, c} = Rec {a: 1, b: "x", c: 3, d: 4}
            a + c * 10
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            c = tmp.c
            a + c * 10
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, c} = {a: 1, b: "x", c: 3, d: 4}
            a + c * 10
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            c = tmp.c
            a + c * 10
    std::test::value("destructure-basic-named-bound-names-usable/destructured", 31, named)
    std::test::value("destructure-basic-named-bound-names-usable/explicit", 31, named_explicit)
    std::test::value("destructure-basic-anonymous-bound-names-usable/destructured", 31, anonymous)
    std::test::value("destructure-basic-anonymous-bound-names-usable/explicit", 31, anonymous_explicit)

# destructure-basic-*-from-binding: the source is a binding, still usable
# afterwards.
fn register_basic_from_binding_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            s = Rec {a: 1, b: "x", c: 3, d: 4}
            {a, d} = s
            [a, d, s.b]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            s = Rec {a: 1, b: "x", c: 3, d: 4}
            tmp = s
            a = tmp.a
            d = tmp.d
            [a, d, s.b]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            s = {a: 1, b: "x", c: 3, d: 4}
            {a, d} = s
            [a, d, s.b]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            s = {a: 1, b: "x", c: 3, d: 4}
            tmp = s
            a = tmp.a
            d = tmp.d
            [a, d, s.b]
    std::test::value("destructure-basic-named-from-binding/destructured", [1, 4, "x"], named)
    std::test::value("destructure-basic-named-from-binding/explicit", [1, 4, "x"], named_explicit)
    std::test::value("destructure-basic-anonymous-from-binding/destructured", [1, 4, "x"], anonymous)
    std::test::value("destructure-basic-anonymous-from-binding/explicit", [1, 4, "x"], anonymous_explicit)

# destructure-basic-*-repeated: two destructures of two evaluations of the
# source.
fn register_basic_repeated_tests():
    fn named() errors std::compiler::CompilerError:
        static compile:
            {a} = Rec {a: 1, b: "x", c: 3, d: 4}
            {b: bb} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, bb]
    fn named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            tmp2 = Rec {a: 1, b: "x", c: 3, d: 4}
            bb = tmp2.b
            [a, bb]
    fn anonymous() errors std::compiler::CompilerError:
        static compile:
            {a} = {a: 1, b: "x", c: 3, d: 4}
            {b: bb} = {a: 1, b: "x", c: 3, d: 4}
            [a, bb]
    fn anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            tmp2 = {a: 1, b: "x", c: 3, d: 4}
            bb = tmp2.b
            [a, bb]
    std::test::value("destructure-basic-named-repeated/destructured", [1, "x"], named)
    std::test::value("destructure-basic-named-repeated/explicit", [1, "x"], named_explicit)
    std::test::value("destructure-basic-anonymous-repeated/destructured", [1, "x"], anonymous)
    std::test::value("destructure-basic-anonymous-repeated/explicit", [1, "x"], anonymous_explicit)


fn register_basic_tests():
    register_basic_all_tests()
    register_basic_one_tests()
    register_basic_two_tests()
    register_basic_all_but_one_tests()
    register_basic_last_field_tests()
    register_basic_reordered_tests()
    register_basic_reordered_subset_tests()
    register_basic_rename_one_tests()
    register_basic_rename_then_short_tests()
    register_basic_rename_both_tests()
    register_basic_mixed_three_tests()
    register_basic_names_swapped_tests()
    register_basic_rename_to_other_field_name_tests()
    register_basic_trailing_comma_tests()
    register_basic_multiline_tests()
    register_basic_bound_names_usable_tests()
    register_basic_from_binding_tests()
    register_basic_repeated_tests()

    # destructure-named-and-anonymous-agree: one pattern, a named and an
    # anonymous source, one value.
    fn agree_named() errors std::compiler::CompilerError:
        static compile:
            {a, b: y, c} = Rec {a: 1, b: "x", c: 3, d: 4}
            [a, y, c]
    std::test::value("destructure-named-and-anonymous-agree/named", [1, "x", 3], agree_named)

    fn agree_anonymous() errors std::compiler::CompilerError:
        static compile:
            {a, b: y, c} = {a: 1, b: "x", c: 3, d: 4}
            [a, y, c]
    std::test::value("destructure-named-and-anonymous-agree/anonymous", [1, "x", 3], agree_anonymous)

# ---------------------------------------------------------------------------
# Omitted fields: partial destructuring is the normal model, and nothing is
# made of the rest

fn register_omitted_tests():
    # destructure-omitted-adding-a-field-does-not-break-consumers: a consumer
    # that does not name a field stays valid when the returned anonymous
    # struct gains it (v1 before, v2 after).
    fn consumer_v1() errors std::compiler::CompilerError:
        static compile:
            fn get_user():
                {user: "u", expires: 9}
            {user, expires} = get_user()
            [user, expires]
    std::test::value("destructure-omitted-adding-a-field-does-not-break-consumers/v1", ["u", 9], consumer_v1)

    fn consumer_v2() errors std::compiler::CompilerError:
        static compile:
            fn get_user():
                {user: "u", expires: 9, token: "t"}
            {user, expires} = get_user()
            [user, expires]
    std::test::value("destructure-omitted-adding-a-field-does-not-break-consumers/v2", ["u", 9], consumer_v2)

    # destructure-omitted-named-struct-gains-a-field: the same for a declared
    # result (Session, then SessionWithToken).
    fn declared_v1() errors std::compiler::CompilerError:
        static compile:
            fn get_user() -> Session:
                Session {user: "u", expires: 9}
            {user, expires} = get_user()
            [user, expires]
    std::test::value("destructure-omitted-named-struct-gains-a-field/v1", ["u", 9], declared_v1)

    fn declared_v2() errors std::compiler::CompilerError:
        static compile:
            fn get_user() -> SessionWithToken:
                SessionWithToken {user: "u", expires: 9, token: "t"}
            {user, expires} = get_user()
            [user, expires]
    std::test::value("destructure-omitted-named-struct-gains-a-field/v2", ["u", 9], declared_v2)

    # destructure-omitted-no-rest-value: an omitted field is not bound
    # anywhere, and no remainder is.
    fn omitted_b() errors std::compiler::CompilerError:
        static compile:
            {a} = Rec {a: 1, b: "x", c: 3, d: 4}
            b
    std::test::rejects("destructure-omitted-no-rest-value/b", std::compiler::DiagnosticCode::Unbound, omitted_b)

    fn omitted_rest() errors std::compiler::CompilerError:
        static compile:
            {a} = Rec {a: 1, b: "x", c: 3, d: 4}
            rest
    std::test::rejects("destructure-omitted-no-rest-value/rest", std::compiler::DiagnosticCode::Unbound, omitted_rest)

    fn omitted_c() errors std::compiler::CompilerError:
        static compile:
            {a} = Rec {a: 1, b: "x", c: 3, d: 4}
            c
    std::test::rejects("destructure-omitted-no-rest-value/c", std::compiler::DiagnosticCode::Unbound, omitted_c)

    # destructure-omitted-source-unchanged: the source is only read: it is
    # still whole afterwards, and may be destructured again.
    fn source_unchanged() errors std::compiler::CompilerError:
        static compile:
            s = Rec {a: 1, b: "x", c: 3, d: 4}
            {a, c} = s
            {d} = s
            [a, c, d, s]
    std::test::value("destructure-omitted-source-unchanged", [1, 3, 4, Rec {a: 1, b: "x", c: 3, d: 4}], source_unchanged)

    # destructure-field-order-is-not-layout: the pattern's order, the
    # literal's order and the declaration's order are unrelated.
    fn pattern_order() errors std::compiler::CompilerError:
        static compile:
            {x, y, z} = DeclaredBackwards {x: 1, y: 2, z: 3}
            [x, y, z]
    std::test::value("destructure-field-order-is-not-layout/named", [1, 2, 3], pattern_order)

    fn declaration_order() errors std::compiler::CompilerError:
        static compile:
            {z, y, x} = DeclaredBackwards {z: 3, y: 2, x: 1}
            [x, y, z]
    std::test::value("destructure-field-order-is-not-layout/named-declaration-order", [1, 2, 3], declaration_order)

    fn anonymous_order() errors std::compiler::CompilerError:
        static compile:
            {x, y, z} = {z: 3, y: 2, x: 1}
            [x, y, z]
    std::test::value("destructure-field-order-is-not-layout/anonymous", [1, 2, 3], anonymous_order)

    fn anonymous_subset_order() errors std::compiler::CompilerError:
        static compile:
            {z, x} = {x: 1, y: 2, z: 3}
            [x, z]
    std::test::value("destructure-field-order-is-not-layout/anonymous-subset", [1, 3], anonymous_subset_order)

    # destructure-fields-of-different-types: heterogeneous fields come out as
    # ordinary typed values.
    fn different_types() errors std::compiler::CompilerError:
        static compile:
            {n, s, xs, p} = {n: 3, s: "text", xs: [1, 2], p: {q: true}}
            [n + 1, std::str::length(s), std::list::length(xs), p.q]
    std::test::value("destructure-fields-of-different-types", [4, 4, 2, true], different_types)

# ---------------------------------------------------------------------------
# The source is evaluated exactly once (the probe trace shows every probed
# field expression of the source once, in order, then the program's value)

fn register_evaluate_once_tests():
    # destructure-once-named-once: a named struct source.
    fn named_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, c} = mk_named()
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-named-once/destructured", [1, 2, [1, 3]], named_once)

    fn named_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                tmp = mk_named()
                a = tmp.a
                c = tmp.c
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-named-once/explicit", [1, 2, [1, 3]], named_once_explicit)

    # destructure-once-anon-once: an anonymous struct source.
    fn anon_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, c} = mk_anon()
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-anon-once/destructured", [1, 2, [1, 3]], anon_once)

    fn anon_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                tmp = mk_anon()
                a = tmp.a
                c = tmp.c
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-anon-once/explicit", [1, 2, [1, 3]], anon_once_explicit)

    # destructure-once-one-field-once: selecting one field still evaluates
    # the whole source, once.
    fn one_field_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {c} = mk_named()
                [c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-one-field-once/destructured", [1, 2, [3]], one_field_once)

    fn one_field_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                tmp = mk_named()
                c = tmp.c
                [c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-one-field-once/explicit", [1, 2, [3]], one_field_once_explicit)

    # destructure-once-repeated-field-name-in-source-fields: renaming entries.
    fn renamed_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a: x, c: y} = mk_named()
                [x, y]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-repeated-field-name-in-source-fields/destructured", [1, 2, [1, 3]], renamed_once)

    fn renamed_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                tmp = mk_named()
                x = tmp.a
                y = tmp.c
                [x, y]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-repeated-field-name-in-source-fields/explicit", [1, 2, [1, 3]], renamed_once_explicit)

    # destructure-once-direct-source-struct-literal: a struct literal source
    # evaluates every field expression once, in written order -- the omitted
    # field b's (probe 4) included.
    fn literal_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, c} = {a: bump(1, 1), b: bump(4, 0), c: bump(2, 3)}
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-direct-source-struct-literal/destructured", [1, 4, 2, [1, 3]], literal_once)

    fn literal_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                tmp = {a: bump(1, 1), b: bump(4, 0), c: bump(2, 3)}
                a = tmp.a
                c = tmp.c
                [a, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-direct-source-struct-literal/explicit", [1, 4, 2, [1, 3]], literal_once_explicit)

    # destructure-once-in-loop-body: once per iteration.
    fn loop_once() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                xs = loop i from 0 to 3:
                    {a, c} = mk_named()
                    a + c + i
                xs
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-in-loop-body/destructured", [1, 2, 1, 2, 1, 2, [4, 5, 6]], loop_once)

    fn loop_once_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                xs = loop i from 0 to 3:
                    tmp = mk_named()
                    a = tmp.a
                    c = tmp.c
                    a + c + i
                xs
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-in-loop-body/explicit", [1, 2, 1, 2, 1, 2, [4, 5, 6]], loop_once_explicit)

    # destructure-once-not-per-field: three fields, one evaluation -- never
    # one per field (which would trace 1, 2 three times).
    fn not_per_field() errors std::compiler::CompilerError:
        static compile:
            fn run() -> any:
                {a, b, c} = mk_named()
                [a, b, c]
            coroutine {step, first} = run()
            loop k from 0 to 20:
                if k == 0:
                    first
                elif std::coroutine::done?(step):
                    break
                else:
                    step()
    std::test::value("destructure-once-not-per-field", [1, 2, [1, "x", 3]], not_per_field)

# ---------------------------------------------------------------------------
# Bindings are values, not references into the source struct

fn register_bound_value_tests():
    # destructure-bound-mutable-value-is-the-same-value: a MutableArray field's
    # binding is a logical copy of the field's array (an array is a value,
    # MUTABLE-ARRAY.md): a write through either name is never seen through
    # the other.
    fn mutable_field() errors std::compiler::CompilerError:
        static compile:
            fn run():
                h = Holder {items: std::mutable_array::create(2, 0), n: 1}
                {items} = h
                a = std::mutable_array::set(items, 0, 5):
                    on IndexNotFound:
                        unit
                b = std::mutable_array::set(h.items, 1, 6):
                    on IndexNotFound:
                        unit
                [std::mutable_array::get(h.items, 0, -1), std::mutable_array::get(items, 0, -1), std::mutable_array::get(h.items, 1, -1), std::mutable_array::get(items, 1, -1)]
            run()
    std::test::value("destructure-bound-mutable-value-is-the-same-value", [0, 5, 6, 0], mutable_field)

    # destructure-bound-name-is-not-a-field-slot: the bound name is an
    # ordinary binding: it cannot be assigned through (a second binding of it
    # is Duplicate). (Assigning the field, `s.a = 2`, is a parse error: Tcl.)
    fn not_a_slot() errors std::compiler::CompilerError:
        static compile:
            {a} = {a: 1}
            a = 2
    std::test::rejects("destructure-bound-name-is-not-a-field-slot", std::compiler::DiagnosticCode::Duplicate, not_a_slot)

    # destructure-bound-value-independent-of-later-struct: a binding is not
    # retargeted by a later destructure of another struct.
    fn independent() errors std::compiler::CompilerError:
        static compile:
            s = {a: 1}
            {a} = s
            t = {a: 2}
            {a: other} = t
            [a, other, s.a, t.a]
    std::test::value("destructure-bound-value-independent-of-later-struct", [1, 2, 1, 2], independent)

    # destructure-binds-values-not-lvalues: a field's binding is the field's
    # value, a struct-valued field included.
    fn field_values() errors std::compiler::CompilerError:
        static compile:
            s = {p: {q: 1}, r: [1, 2]}
            {p, r} = s
            [p.q, r, s]
    std::test::value("destructure-binds-values-not-lvalues/destructured", [1, [1, 2], {p: {q: 1}, r: [1, 2]}], field_values)

    fn field_values_explicit() errors std::compiler::CompilerError:
        static compile:
            s = {p: {q: 1}, r: [1, 2]}
            tmp = s
            p = tmp.p
            r = tmp.r
            [p.q, r, s]
    std::test::value("destructure-binds-values-not-lvalues/explicit", [1, [1, 2], {p: {q: 1}, r: [1, 2]}], field_values_explicit)

# ---------------------------------------------------------------------------
# Static rejection: parasitic on ordinary field projection. Each Tcl table row
# requires the destructure to be rejected exactly as its explicit spelling is:
# NAME/destructured and NAME/explicit pin the code, NAME/same-diagnostic that
# both blocks report one code and one message.

fn register_rejection_table_tests():
    # destructure-reject-missing-named: a field the named struct does not
    # have.
    fn missing_named() errors std::compiler::CompilerError:
        static compile:
            {missing} = Rec {a: 1, b: "x", c: 3, d: 4}
    fn missing_named_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            missing = tmp.missing
    std::test::rejects("destructure-reject-missing-named/destructured", std::compiler::DiagnosticCode::UnknownField, missing_named)
    std::test::rejects("destructure-reject-missing-named/explicit", std::compiler::DiagnosticCode::UnknownField, missing_named_explicit)
    same_diagnostic("destructure-reject-missing-named/same-diagnostic", missing_named, missing_named_explicit)

    # destructure-reject-missing-anon: a field the anonymous struct does not
    # have.
    fn missing_anon() errors std::compiler::CompilerError:
        static compile:
            {missing} = {a: 1, b: "x", c: 3, d: 4}
    fn missing_anon_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: "x", c: 3, d: 4}
            missing = tmp.missing
    std::test::rejects("destructure-reject-missing-anon/destructured", std::compiler::DiagnosticCode::UnknownField, missing_anon)
    std::test::rejects("destructure-reject-missing-anon/explicit", std::compiler::DiagnosticCode::UnknownField, missing_anon_explicit)
    same_diagnostic("destructure-reject-missing-anon/same-diagnostic", missing_anon, missing_anon_explicit)

    # destructure-reject-missing-second: a missing field after a present one.
    fn missing_second() errors std::compiler::CompilerError:
        static compile:
            {a, missing} = Rec {a: 1, b: "x", c: 3, d: 4}
    fn missing_second_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            a = tmp.a
            missing = tmp.missing
    std::test::rejects("destructure-reject-missing-second/destructured", std::compiler::DiagnosticCode::UnknownField, missing_second)
    std::test::rejects("destructure-reject-missing-second/explicit", std::compiler::DiagnosticCode::UnknownField, missing_second_explicit)
    same_diagnostic("destructure-reject-missing-second/same-diagnostic", missing_second, missing_second_explicit)

    # destructure-reject-missing-renamed: a missing field under a renaming
    # entry.
    fn missing_renamed() errors std::compiler::CompilerError:
        static compile:
            {missing: x} = Rec {a: 1, b: "x", c: 3, d: 4}
    fn missing_renamed_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = Rec {a: 1, b: "x", c: 3, d: 4}
            x = tmp.missing
    std::test::rejects("destructure-reject-missing-renamed/destructured", std::compiler::DiagnosticCode::UnknownField, missing_renamed)
    std::test::rejects("destructure-reject-missing-renamed/explicit", std::compiler::DiagnosticCode::UnknownField, missing_renamed_explicit)
    same_diagnostic("destructure-reject-missing-renamed/same-diagnostic", missing_renamed, missing_renamed_explicit)

    # destructure-reject-int-source: an Int source.
    fn int_source() errors std::compiler::CompilerError:
        static compile:
            {a} = 42
    fn int_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = 42
            a = tmp.a
    std::test::rejects("destructure-reject-int-source/destructured", std::compiler::DiagnosticCode::NotAStruct, int_source)
    std::test::rejects("destructure-reject-int-source/explicit", std::compiler::DiagnosticCode::NotAStruct, int_source_explicit)
    same_diagnostic("destructure-reject-int-source/same-diagnostic", int_source, int_source_explicit)

    # destructure-reject-string-source: a String source.
    fn string_source() errors std::compiler::CompilerError:
        static compile:
            {a} = "text"
    fn string_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = "text"
            a = tmp.a
    std::test::rejects("destructure-reject-string-source/destructured", std::compiler::DiagnosticCode::NotAStruct, string_source)
    std::test::rejects("destructure-reject-string-source/explicit", std::compiler::DiagnosticCode::NotAStruct, string_source_explicit)
    same_diagnostic("destructure-reject-string-source/same-diagnostic", string_source, string_source_explicit)

    # destructure-reject-list-source: a List source.
    fn list_source() errors std::compiler::CompilerError:
        static compile:
            {a} = [1, 2, 3]
    fn list_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = [1, 2, 3]
            a = tmp.a
    std::test::rejects("destructure-reject-list-source/destructured", std::compiler::DiagnosticCode::NotAStruct, list_source)
    std::test::rejects("destructure-reject-list-source/explicit", std::compiler::DiagnosticCode::NotAStruct, list_source_explicit)
    same_diagnostic("destructure-reject-list-source/same-diagnostic", list_source, list_source_explicit)

    # destructure-reject-bool-source: a Bool source.
    fn bool_source() errors std::compiler::CompilerError:
        static compile:
            {a} = true
    fn bool_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = true
            a = tmp.a
    std::test::rejects("destructure-reject-bool-source/destructured", std::compiler::DiagnosticCode::NotAStruct, bool_source)
    std::test::rejects("destructure-reject-bool-source/explicit", std::compiler::DiagnosticCode::NotAStruct, bool_source_explicit)
    same_diagnostic("destructure-reject-bool-source/same-diagnostic", bool_source, bool_source_explicit)

    # destructure-reject-unit-source: the unit source.
    fn unit_source() errors std::compiler::CompilerError:
        static compile:
            {a} = unit
    fn unit_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = unit
            a = tmp.a
    std::test::rejects("destructure-reject-unit-source/destructured", std::compiler::DiagnosticCode::NotAStruct, unit_source)
    std::test::rejects("destructure-reject-unit-source/explicit", std::compiler::DiagnosticCode::NotAStruct, unit_source_explicit)
    same_diagnostic("destructure-reject-unit-source/same-diagnostic", unit_source, unit_source_explicit)

    # destructure-reject-function-source: a function value source (the message
    # names the function's block, whose internal id differs between the two
    # blocks: codes only).
    fn function_source() errors std::compiler::CompilerError:
        static compile:
            fn f(x):
                x
            {a} = f
    fn function_source_explicit() errors std::compiler::CompilerError:
        static compile:
            fn f(x):
                x
            tmp = f
            a = tmp.a
    std::test::rejects("destructure-reject-function-source/destructured", std::compiler::DiagnosticCode::NotAStruct, function_source)
    std::test::rejects("destructure-reject-function-source/explicit", std::compiler::DiagnosticCode::NotAStruct, function_source_explicit)

    # destructure-reject-native-source: a native function value source.
    fn native_source() errors std::compiler::CompilerError:
        static compile:
            {a} = std::list::length
    fn native_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = std::list::length
            a = tmp.a
    std::test::rejects("destructure-reject-native-source/destructured", std::compiler::DiagnosticCode::NotAStruct, native_source)
    std::test::rejects("destructure-reject-native-source/explicit", std::compiler::DiagnosticCode::NotAStruct, native_source_explicit)
    same_diagnostic("destructure-reject-native-source/same-diagnostic", native_source, native_source_explicit)

    # destructure-reject-mutarray-source: a MutableArray source.
    fn mutarray_source() errors std::compiler::CompilerError:
        static compile:
            {a} = std::mutable_array::create(1, 0)
    fn mutarray_source_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = std::mutable_array::create(1, 0)
            a = tmp.a
    std::test::rejects("destructure-reject-mutarray-source/destructured", std::compiler::DiagnosticCode::NotAStruct, mutarray_source)
    std::test::rejects("destructure-reject-mutarray-source/explicit", std::compiler::DiagnosticCode::NotAStruct, mutarray_source_explicit)
    same_diagnostic("destructure-reject-mutarray-source/same-diagnostic", mutarray_source, mutarray_source_explicit)

    # destructure-reject-unknown-shape: an untyped parameter source, called
    # with an Int: the call is rejected (its message embeds the projection's
    # location, which differs between the two blocks: codes only).
    fn unknown_shape() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                {a} = x
                a
            first(1)
    fn unknown_shape_explicit() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                tmp = x
                a = tmp.a
                a
            first(1)
    std::test::rejects("destructure-reject-unknown-shape/destructured", std::compiler::DiagnosticCode::Type, unknown_shape)
    std::test::rejects("destructure-reject-unknown-shape/explicit", std::compiler::DiagnosticCode::Type, unknown_shape_explicit)

    # destructure-reject-unknown-shape-escaping: an untyped parameter source
    # of a function that escapes as a value: its struct type is not known.
    fn unknown_shape_escaping() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                {a} = x
                a
            g = first
            1
    fn unknown_shape_escaping_explicit() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                tmp = x
                a = tmp.a
                a
            g = first
            1
    std::test::rejects("destructure-reject-unknown-shape-escaping/destructured", std::compiler::DiagnosticCode::UnprovenField, unknown_shape_escaping)
    std::test::rejects("destructure-reject-unknown-shape-escaping/explicit", std::compiler::DiagnosticCode::UnprovenField, unknown_shape_escaping_explicit)
    same_diagnostic("destructure-reject-unknown-shape-escaping/same-diagnostic", unknown_shape_escaping, unknown_shape_escaping_explicit)

    # destructure-reject-nested-missing: a missing field of a nested pattern.
    fn nested_missing() errors std::compiler::CompilerError:
        static compile:
            {u: {nope}} = {u: {a: 1}}
    fn nested_missing_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {u: {a: 1}}
            tmp2 = tmp.u
            nope = tmp2.nope
    std::test::rejects("destructure-reject-nested-missing/destructured", std::compiler::DiagnosticCode::UnknownField, nested_missing)
    std::test::rejects("destructure-reject-nested-missing/explicit", std::compiler::DiagnosticCode::UnknownField, nested_missing_explicit)
    same_diagnostic("destructure-reject-nested-missing/same-diagnostic", nested_missing, nested_missing_explicit)

    # destructure-reject-nested-non-struct: a nested pattern over an Int
    # field.
    fn nested_non_struct() errors std::compiler::CompilerError:
        static compile:
            {u: {a}} = {u: 5}
    fn nested_non_struct_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {u: 5}
            tmp2 = tmp.u
            a = tmp2.a
    std::test::rejects("destructure-reject-nested-non-struct/destructured", std::compiler::DiagnosticCode::NotAStruct, nested_non_struct)
    std::test::rejects("destructure-reject-nested-non-struct/explicit", std::compiler::DiagnosticCode::NotAStruct, nested_non_struct_explicit)
    same_diagnostic("destructure-reject-nested-non-struct/same-diagnostic", nested_non_struct, nested_non_struct_explicit)

    # destructure-reject-nested-missing-outer: a nested pattern over a missing
    # field.
    fn nested_missing_outer() errors std::compiler::CompilerError:
        static compile:
            {nope: {a}} = {u: {a: 1}}
    fn nested_missing_outer_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {u: {a: 1}}
            tmp2 = tmp.nope
            a = tmp2.a
    std::test::rejects("destructure-reject-nested-missing-outer/destructured", std::compiler::DiagnosticCode::UnknownField, nested_missing_outer)
    std::test::rejects("destructure-reject-nested-missing-outer/explicit", std::compiler::DiagnosticCode::UnknownField, nested_missing_outer_explicit)
    same_diagnostic("destructure-reject-nested-missing-outer/same-diagnostic", nested_missing_outer, nested_missing_outer_explicit)


# ---------------------------------------------------------------------------
# The rejection messages (their wording is these tests' property) and what a
# rejected destructure leaves

fn register_rejection_message_tests():
    # destructure-reject-missing-field-message: the unknown-field diagnostic
    # is the ordinary one, naming the struct type and its known fields.
    fn missing_field() errors std::compiler::CompilerError:
        static compile:
            {missing} = Rec {a: 1, b: "x", c: 3, d: 4}
    std::test::rejects_message("destructure-reject-missing-field-message", std::compiler::DiagnosticCode::UnknownField, "struct type Rec has no field \"missing\" (known fields: a, b, c, d)", missing_field)

    # destructure-reject-anonymous-missing-field-message: for an anonymous
    # struct too.
    fn anonymous_missing_field() errors std::compiler::CompilerError:
        static compile:
            {missing} = {a: 1, b: 2}
    std::test::rejects_message("destructure-reject-anonymous-missing-field-message", std::compiler::DiagnosticCode::UnknownField, "struct type struct{a: int, b: int} has no field \"missing\" (known fields: a, b)", anonymous_missing_field)

    # destructure-reject-int-source-message: a non-struct source reports the
    # projection type error, naming the field and the type.
    fn int_source() errors std::compiler::CompilerError:
        static compile:
            {a} = 42
    std::test::rejects_message("destructure-reject-int-source-message", std::compiler::DiagnosticCode::NotAStruct, "cannot project field \"a\" from a value of type int: only a struct has fields", int_source)

    # destructure-reject-list-source-message: a List source with struct
    # syntax is a plain NotAStruct, never the List policy diagnostic.
    fn list_source() errors std::compiler::CompilerError:
        static compile:
            {a, b} = [1, 2]
    std::test::rejects_message("destructure-reject-list-source-message", std::compiler::DiagnosticCode::NotAStruct, "cannot project field \"a\" from a value of type List[int]: only a struct has fields", list_source)

    # destructure-reject-unproven-shape-message: a source whose struct type is
    # not known (a parameter of a function that also escapes as a value) is
    # the ordinary unproven-field diagnostic: no run-time field lookup.
    fn unproven_shape() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                {a} = x
                a
            first(1)
            first(2)
            g = first
    std::test::rejects("destructure-reject-unproven-shape-message", std::compiler::DiagnosticCode::UnprovenField, unproven_shape)

    # destructure-reject-nothing-bound-on-error: a rejected destructure binds
    # nothing observable: the first diagnostic is the missing field, not a
    # use of `a`.
    fn nothing_bound() errors std::compiler::CompilerError:
        static compile:
            {a, missing} = {a: 1}
            a
    std::test::rejects("destructure-reject-nothing-bound-on-error", std::compiler::DiagnosticCode::UnknownField, nothing_bound)

# ---------------------------------------------------------------------------
# Where a rejection points: the field name written in the pattern (a line and
# column of this file)

fn register_location_tests():
    # destructure-location-second-field: at the second entry's field.
    fn second_field() errors std::compiler::CompilerError:
        static compile:
            x = {good: 1}
            {good, mising} = x
    std::test::rejects_at("destructure-location-second-field", std::compiler::DiagnosticCode::UnknownField, 1545, 20, second_field)

    # destructure-location-first-field: at the first entry's field.
    fn first_field() errors std::compiler::CompilerError:
        static compile:
            x = {good: 1}
            {mising, good} = x
    std::test::rejects_at("destructure-location-first-field", std::compiler::DiagnosticCode::UnknownField, 1552, 14, first_field)

    # destructure-location-renamed-field: at the field read, not the binding
    # made.
    fn renamed_field() errors std::compiler::CompilerError:
        static compile:
            x = {good: 1}
            {good, mising: other} = x
    std::test::rejects_at("destructure-location-renamed-field", std::compiler::DiagnosticCode::UnknownField, 1560, 20, renamed_field)

    # destructure-location-non-struct: a non-struct source, at the field.
    fn non_struct() errors std::compiler::CompilerError:
        static compile:
            {a} = 5
    std::test::rejects_at("destructure-location-non-struct", std::compiler::DiagnosticCode::NotAStruct, 1566, 14, non_struct)

    # destructure-location-nested: at the nested pattern's field.
    fn nested() errors std::compiler::CompilerError:
        static compile:
            x = {u: {a: 1}}
            {u: {nope}} = x
    std::test::rejects_at("destructure-location-nested", std::compiler::DiagnosticCode::UnknownField, 1573, 18, nested)

    # destructure-location-indented: inside a function body.
    fn indented() errors std::compiler::CompilerError:
        static compile:
            fn f():
                x = {a: 1}
                {a, z} = x
            f()
    std::test::rejects_at("destructure-location-indented", std::compiler::DiagnosticCode::UnknownField, 1581, 21, indented)

    # destructure-location-multiline-pattern: a field name on its own line is
    # located there.
    fn multiline_pattern() errors std::compiler::CompilerError:
        static compile:
            x = {good: 1}
            {
                good,
                mising,
            } = x
    std::test::rejects_at("destructure-location-multiline-pattern", std::compiler::DiagnosticCode::UnknownField, 1592, 17, multiline_pattern)

# ---------------------------------------------------------------------------
# Duplicates: the ordinary duplicate-binding rule, with no shadowing or
# assignment semantics of its own

fn register_duplicate_tests():
    # destructure-duplicate-destination: two entries binding one name are the
    # ordinary duplicate-binding error, the explicit spelling's.
    fn destination() errors std::compiler::CompilerError:
        static compile:
            {a: x, b: x} = {a: 1, b: 2}
    fn destination_explicit() errors std::compiler::CompilerError:
        static compile:
            tmp = {a: 1, b: 2}
            x = tmp.a
            x = tmp.b
    std::test::rejects("destructure-duplicate-destination/destructured", std::compiler::DiagnosticCode::Duplicate, destination)
    std::test::rejects("destructure-duplicate-destination/explicit", std::compiler::DiagnosticCode::Duplicate, destination_explicit)
    same_diagnostic("destructure-duplicate-destination/same-diagnostic", destination, destination_explicit)

    # destructure-duplicate-destination-location: reported at the second
    # binding written.
    fn destination_location() errors std::compiler::CompilerError:
        static compile:
            {a: x, b: x} = {a: 1, b: 2}
    std::test::rejects_at("destructure-duplicate-destination-location", std::compiler::DiagnosticCode::Duplicate, 1619, 23, destination_location)

    # destructure-duplicate-destination-shorthand: a shorthand entry colliding
    # with a renaming one, in either order.
    fn shorthand_first() errors std::compiler::CompilerError:
        static compile:
            {a, b: a} = {a: 1, b: 2}
    std::test::rejects("destructure-duplicate-destination-shorthand/shorthand-first", std::compiler::DiagnosticCode::Duplicate, shorthand_first)

    fn rename_first() errors std::compiler::CompilerError:
        static compile:
            {b: a, a} = {a: 1, b: 2}
    std::test::rejects("destructure-duplicate-destination-shorthand/rename-first", std::compiler::DiagnosticCode::Duplicate, rename_first)

    # destructure-duplicate-existing-binding: a name already bound in the
    # scope is the ordinary duplicate-binding error, the explicit
    # spelling's.
    fn existing() errors std::compiler::CompilerError:
        static compile:
            x = 1
            {a: x} = {a: 2}
    fn existing_explicit() errors std::compiler::CompilerError:
        static compile:
            x = 1
            tmp = {a: 2}
            x = tmp.a
    std::test::rejects("destructure-duplicate-existing-binding/destructured", std::compiler::DiagnosticCode::Duplicate, existing)
    std::test::rejects("destructure-duplicate-existing-binding/explicit", std::compiler::DiagnosticCode::Duplicate, existing_explicit)
    same_diagnostic("destructure-duplicate-existing-binding/same-diagnostic", existing, existing_explicit)

    # destructure-duplicate-with-earlier-destructure: two destructures of one
    # scope binding the same name.
    fn earlier_destructure() errors std::compiler::CompilerError:
        static compile:
            {a} = {a: 1}
            {a} = {a: 2}
    std::test::rejects("destructure-duplicate-with-earlier-destructure", std::compiler::DiagnosticCode::Duplicate, earlier_destructure)

    # destructure-not-assignment-existing-name: `{a: existing}` is a
    # duplicate binding, never an assignment to the existing variable.
    fn not_assignment() errors std::compiler::CompilerError:
        static compile:
            existing = 1
            {a: existing} = {a: 2}
            existing
    std::test::rejects("destructure-not-assignment-existing-name", std::compiler::DiagnosticCode::Duplicate, not_assignment)

# ---------------------------------------------------------------------------
# Scopes: shadowing, functions, branches, loops, nested functions, the top of
# the block (shadowing inside a function over an untyped parameter is in
# destructuring-instances.bot)

fn register_shadowing_tests():
    # destructure-source-sees-scope-before-the-names: the source is resolved
    # before the pattern's names exist, as an ordinary initializer is: with
    # no outer `a` it is unbound; with one, the source reads it.
    fn source_unbound() errors std::compiler::CompilerError:
        static compile:
            {a} = {a: a}
            a
    std::test::rejects("destructure-source-sees-scope-before-the-names/unbound", std::compiler::DiagnosticCode::Unbound, source_unbound)

    fn source_outer() errors std::compiler::CompilerError:
        static compile:
            a = 1
            fn f():
                {a} = {a: a}
                a
            f()
    std::test::value("destructure-source-sees-scope-before-the-names/outer", 1, source_outer)

fn register_scope_tests():
    # destructure-scope-in-function: in a function body.
    fn in_function() errors std::compiler::CompilerError:
        static compile:
            fn get():
                {n: 1, s: "x"}
            fn run():
                {n, s} = get()
                [n, s]
            run()
    std::test::value("destructure-scope-in-function/destructured", [1, "x"], in_function)

    fn in_function_explicit() errors std::compiler::CompilerError:
        static compile:
            fn get():
                {n: 1, s: "x"}
            fn run():
                tmp = get()
                n = tmp.n
                s = tmp.s
                [n, s]
            run()
    std::test::value("destructure-scope-in-function/explicit", [1, "x"], in_function_explicit)

    # destructure-scope-in-if: in both branches of an if.
    fn in_if() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                if flag:
                    {n} = {n: 1, m: 2}
                    n
                else:
                    {m} = {n: 1, m: 2}
                    m
            [run(true), run(false)]
    std::test::value("destructure-scope-in-if/destructured", [1, 2], in_if)

    fn in_if_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                if flag:
                    t = {n: 1, m: 2}
                    n = t.n
                    n
                else:
                    t = {n: 1, m: 2}
                    m = t.m
                    m
            [run(true), run(false)]
    std::test::value("destructure-scope-in-if/explicit", [1, 2], in_if_explicit)

    # destructure-scope-in-elif: in the clauses of an elif chain.
    fn in_elif() errors std::compiler::CompilerError:
        static compile:
            fn run(k):
                if k == 0:
                    {v} = {v: 10}
                    v
                elif k == 1:
                    {v: w} = {v: 20}
                    w
                elif k == 2:
                    {v, u} = {v: 30, u: 1}
                    v + u
                else:
                    0
            [run(0), run(1), run(2), run(3)]
    std::test::value("destructure-scope-in-elif/destructured", [10, 20, 31, 0], in_elif)

    fn in_elif_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(k):
                if k == 0:
                    t = {v: 10}
                    v = t.v
                    v
                elif k == 1:
                    t = {v: 20}
                    w = t.v
                    w
                elif k == 2:
                    t = {v: 30, u: 1}
                    v = t.v
                    u = t.u
                    v + u
                else:
                    0
            [run(0), run(1), run(2), run(3)]
    std::test::value("destructure-scope-in-elif/explicit", [10, 20, 31, 0], in_elif_explicit)

    # destructure-scope-in-if-value: in the branches of an if used as a value.
    fn in_if_value() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                r = if flag:
                    {n} = {n: 1}
                    n + 100
                else:
                    {n} = {n: 2}
                    n + 200
                r
            [run(true), run(false)]
    std::test::value("destructure-scope-in-if-value/destructured", [101, 202], in_if_value)

    fn in_if_value_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                r = if flag:
                    t = {n: 1}
                    n = t.n
                    n + 100
                else:
                    t = {n: 2}
                    n = t.n
                    n + 200
                r
            [run(true), run(false)]
    std::test::value("destructure-scope-in-if-value/explicit", [101, 202], in_if_value_explicit)

    # destructure-scope-same-name-in-branches: one name destructured in two
    # branches is two bindings, no duplicate.
    fn same_name_in_branches() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                if flag:
                    {n} = {n: 1}
                else:
                    {n} = {n: 2}
                0
            [run(true), run(false)]
    std::test::value("destructure-scope-same-name-in-branches/destructured", [0, 0], same_name_in_branches)

    fn same_name_in_branches_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(flag):
                if flag:
                    t = {n: 1}
                    n = t.n
                else:
                    t = {n: 2}
                    n = t.n
                0
            [run(true), run(false)]
    std::test::value("destructure-scope-same-name-in-branches/explicit", [0, 0], same_name_in_branches_explicit)

    # destructure-scope-in-collecting-loop: in an iterable loop's body.
    fn in_collecting_loop() errors std::compiler::CompilerError:
        static compile:
            fn run():
                pts = [{x: 1, y: 2}, {x: 3, y: 4}, {x: 5, y: 6}]
                loop p in pts:
                    {x, y: why} = p
                    x * 10 + why
            run()
    std::test::value("destructure-scope-in-collecting-loop/destructured", [12, 34, 56], in_collecting_loop)

    fn in_collecting_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run():
                pts = [{x: 1, y: 2}, {x: 3, y: 4}, {x: 5, y: 6}]
                loop p in pts:
                    t = p
                    x = t.x
                    why = t.y
                    x * 10 + why
            run()
    std::test::value("destructure-scope-in-collecting-loop/explicit", [12, 34, 56], in_collecting_loop_explicit)

    # destructure-scope-in-counted-loop: in a counted loop's body.
    fn in_counted_loop() errors std::compiler::CompilerError:
        static compile:
            fn run():
                loop i from 0 to 3:
                    {sq, cube} = {sq: i * i, cube: i * i * i}
                    sq + cube
            run()
    std::test::value("destructure-scope-in-counted-loop/destructured", [0, 2, 12], in_counted_loop)

    fn in_counted_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run():
                loop i from 0 to 3:
                    t = {sq: i * i, cube: i * i * i}
                    sq = t.sq
                    cube = t.cube
                    sq + cube
            run()
    std::test::value("destructure-scope-in-counted-loop/explicit", [0, 2, 12], in_counted_loop_explicit)

    # destructure-scope-in-lockstep-loop: in a lockstep loop's body.
    fn in_lockstep_loop() errors std::compiler::CompilerError:
        static compile:
            fn run():
                pts = [{x: 1, y: 2}, {x: 3, y: 4}]
                loop p in pts and i from 0 to 2:
                    {x, y} = p
                    x + y + i
            run()
    std::test::value("destructure-scope-in-lockstep-loop/destructured", [3, 8], in_lockstep_loop)

    fn in_lockstep_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run():
                pts = [{x: 1, y: 2}, {x: 3, y: 4}]
                loop p in pts and i from 0 to 2:
                    t = p
                    x = t.x
                    y = t.y
                    x + y + i
            run()
    std::test::value("destructure-scope-in-lockstep-loop/explicit", [3, 8], in_lockstep_loop_explicit)

    # destructure-scope-in-plain-loop: in a bare loop's body.
    fn in_plain_loop() errors std::compiler::CompilerError:
        static compile:
            fn run():
                n = 0
                loop:
                    {k} = {k: 5}
                    break
                7
            run()
    std::test::value("destructure-scope-in-plain-loop/destructured", 7, in_plain_loop)

    fn in_plain_loop_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run():
                n = 0
                loop:
                    t = {k: 5}
                    k = t.k
                    break
                7
            run()
    std::test::value("destructure-scope-in-plain-loop/explicit", 7, in_plain_loop_explicit)

    # destructure-scope-in-nested-function: in a function and in a function
    # nested in it, over declared struct parameters.
    fn in_nested_function() errors std::compiler::CompilerError:
        static compile:
            fn outer(r: OuterArg) -> int:
                fn inner(q: InnerArg) -> int:
                    {a} = q
                    a + 1
                {b} = r
                inner(InnerArg {a: b * 2})
            outer(OuterArg {b: 5})
    std::test::value("destructure-scope-in-nested-function/destructured", 11, in_nested_function)

    fn in_nested_function_explicit() errors std::compiler::CompilerError:
        static compile:
            fn outer(r: OuterArg) -> int:
                fn inner(q: InnerArg) -> int:
                    t = q
                    a = t.a
                    a + 1
                t = r
                b = t.b
                inner(InnerArg {a: b * 2})
            outer(OuterArg {b: 5})
    std::test::value("destructure-scope-in-nested-function/explicit", 11, in_nested_function_explicit)

    # destructure-scope-top-level: at the top of the block (the Tcl
    # program's top level).
    fn top_level() errors std::compiler::CompilerError:
        static compile:
            {a, b} = {a: 1, b: 2}
            a + b
    std::test::value("destructure-scope-top-level/destructured", 3, top_level)

    fn top_level_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {a: 1, b: 2}
            a = t.a
            b = t.b
            a + b
    std::test::value("destructure-scope-top-level/explicit", 3, top_level_explicit)

    # destructure-scope-binding-not-visible-outside: a destructured name is
    # local to its branch.
    fn not_visible_outside() errors std::compiler::CompilerError:
        static compile:
            if true:
                {n} = {n: 1}
            n
    std::test::rejects("destructure-scope-binding-not-visible-outside", std::compiler::DiagnosticCode::Unbound, not_visible_outside)

    # destructure-scope-use-before: a destructured name is not visible before
    # the destructure.
    fn use_before() errors std::compiler::CompilerError:
        static compile:
            fn f(r):
                before = a
                {a} = r
                a
            f({a: 1})
    std::test::rejects("destructure-scope-use-before", std::compiler::DiagnosticCode::Unbound, use_before)


# ---------------------------------------------------------------------------
# Function results

fn register_function_result_tests():
    # destructure-function-result-named-return: a declared struct result
    # destructures directly at the call.
    fn named_return() errors std::compiler::CompilerError:
        static compile:
            fn get_user(n: str) -> UserRecord:
                UserRecord {name: n, id: 42, token: "t", expires: 99}
            {name, expires: expiry} = get_user("alice")
            [name, expiry]
    std::test::value("destructure-function-result-named-return", ["alice", 99], named_return)

    # destructure-function-result-anonymous-return: an anonymous struct
    # result too.
    fn anonymous_return() errors std::compiler::CompilerError:
        static compile:
            fn get_user(n: str):
                {name: n, id: 42, token: "t", expires: 99}
            {name, expires: expiry} = get_user("alice")
            [name, expiry]
    std::test::value("destructure-function-result-anonymous-return", ["alice", 99], anonymous_return)

    # destructure-function-result-via-binding: the result bound first.
    fn via_binding() errors std::compiler::CompilerError:
        static compile:
            fn get_user(n: str):
                {name: n, id: 42, token: "t", expires: 99}
            result = get_user("alice")
            {name, expires: expiry} = result
            [name, expiry]
    std::test::value("destructure-function-result-via-binding", ["alice", 99], via_binding)

    # destructure-function-result-equivalent-to-hoisted: destructuring a call
    # directly and the hoisted spelling agree.
    fn direct_call() errors std::compiler::CompilerError:
        static compile:
            fn get_user(n: str):
                {name: n, id: 42, expires: 99}
            {name, expires} = get_user("a")
            [name, expires]
    std::test::value("destructure-function-result-equivalent-to-hoisted/destructured", ["a", 99], direct_call)

    fn direct_call_explicit() errors std::compiler::CompilerError:
        static compile:
            fn get_user(n: str):
                {name: n, id: 42, expires: 99}
            t = get_user("a")
            name = t.name
            expires = t.expires
            [name, expires]
    std::test::value("destructure-function-result-equivalent-to-hoisted/explicit", ["a", 99], direct_call_explicit)

    # destructure-function-result-unit-fields: the motivating API, a result
    # carrying a value and a status of different types. (The Tcl program
    # spells the quotient `a / b`, which Botlish does not have: here it is
    # the function `quotient`.)
    fn value_and_status() errors std::compiler::CompilerError:
        static compile:
            fn quotient(a, b):
                if a < b:
                    0
                else:
                    1 + quotient(a - b, b)
            fn divide(a, b):
                if b == 0:
                    {value: 0, ok: false}
                else:
                    {value: quotient(a, b), ok: true}
            {value, ok} = divide(7, 0)
            {value: v2, ok: ok2} = divide(8, 2)
            [value, ok, v2, ok2]
    std::test::value("destructure-function-result-unit-fields", [0, false, 4, true], value_and_status)

# ---------------------------------------------------------------------------
# Error-capable sources behave exactly as ordinary bindings' sources do
# (risky fails with Oops for a negative argument)

fn register_error_capable_tests(negative: int):
    # destructure-error-capable-handled: a handled source; the handler's value
    # is destructured on the failing path.
    fn handled() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                {a, b} = risky(n):
                    on Oops:
                        {a: -1, b: -2}
                [a, b]
            [run(3), run(-1)]
    std::test::value("destructure-error-capable-handled/destructured", [[3, 6], [-1, -2]], handled)

    fn handled_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                t = risky(n):
                    on Oops:
                        {a: -1, b: -2}
                a = t.a
                b = t.b
                [a, b]
            [run(3), run(-1)]
    std::test::value("destructure-error-capable-handled/explicit", [[3, 6], [-1, -2]], handled_explicit)

    # destructure-error-capable-declared-errors: inside a function declaring
    # the error, the source's error is admitted; run(3) provably succeeds.
    fn declared() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
                a
            run(3)
    std::test::value("destructure-error-capable-declared-errors/destructured", 3, declared)

    fn declared_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                a
            run(3)
    std::test::value("destructure-error-capable-declared-errors/explicit", 3, declared_explicit)

    # destructure-error-capable-unhandled-same-diagnostic: the Tcl programs
    # declare `errors Oops`, so both spellings are accepted alike
    # (/declared); without the declaration both are the same ordinary
    # UnhandledError (/undeclared).
    fn unhandled_declared() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
                a
            1
    std::test::value("destructure-error-capable-unhandled-same-diagnostic/declared/destructured", 1, unhandled_declared)

    fn unhandled_declared_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                a
            1
    std::test::value("destructure-error-capable-unhandled-same-diagnostic/declared/explicit", 1, unhandled_declared_explicit)

    fn unhandled_undeclared() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                {a} = risky(n)
                a
            1
    fn unhandled_undeclared_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                t = risky(n)
                a = t.a
                a
            1
    std::test::rejects("destructure-error-capable-unhandled-same-diagnostic/undeclared/destructured", std::compiler::DiagnosticCode::UnhandledError, unhandled_undeclared)
    std::test::rejects("destructure-error-capable-unhandled-same-diagnostic/undeclared/explicit", std::compiler::DiagnosticCode::UnhandledError, unhandled_undeclared_explicit)
    same_diagnostic("destructure-error-capable-unhandled-same-diagnostic/undeclared/same-diagnostic", unhandled_undeclared, unhandled_undeclared_explicit)

    # destructure-error-capable-propagates: a destructure inside an
    # error-declaring function propagates the source's error as a binding
    # does. With the constant -5 the compiler proves the call always fails
    # (KnownError, what the Tcl test observes); with a run-time argument the
    # error reaches the caller's handler, which returns "Oops" (a normal
    # completion would answer "completed").
    fn propagates_known() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
                a
            run(-5)
    fn propagates_known_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                a
            run(-5)
    std::test::rejects("destructure-error-capable-propagates/destructured", std::compiler::DiagnosticCode::KnownError, propagates_known)
    std::test::rejects("destructure-error-capable-propagates/explicit", std::compiler::DiagnosticCode::KnownError, propagates_known_explicit)

    fn propagates() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                {a} = risky(n)
                a
            fn attempt(n):
                run(n):
                    on Oops:
                        return "Oops"
                "completed"
            attempt(negative)
    std::test::value("destructure-error-capable-propagates/run-time/destructured", "Oops", propagates)

    fn propagates_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n) errors Oops:
                t = risky(n)
                a = t.a
                a
            fn attempt(n):
                run(n):
                    on Oops:
                        return "Oops"
                "completed"
            attempt(negative)
    std::test::value("destructure-error-capable-propagates/run-time/explicit", "Oops", propagates_explicit)

    # destructure-error-field-value-is-just-a-value: a field holding an
    # error-capable function is just a value: destructuring neither calls
    # nor unwraps it, and calling it afterwards is handled as ordinary.
    fn field_function() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                {f} = {f: risky}
                r = f(n):
                    on Oops:
                        {a: 0, b: 0}
                r.a
            [run(-1), run(4)]
    std::test::value("destructure-error-field-value-is-just-a-value/destructured", [0, 4], field_function)

    fn field_function_explicit() errors std::compiler::CompilerError:
        static compile:
            fn run(n):
                t = {f: risky}
                f = t.f
                r = f(n):
                    on Oops:
                        {a: 0, b: 0}
                r.a
            [run(-1), run(4)]
    std::test::value("destructure-error-field-value-is-just-a-value/explicit", [0, 4], field_function_explicit)

# ---------------------------------------------------------------------------
# Closures capture destructured bindings as ordinary bindings (the closures
# over an untyped parameter's fields are in destructuring-instances.bot)

fn register_capture_tests():
    # destructure-capture-struct-value: a struct-valued binding captured, its
    # field read in the closure.
    fn capture_struct_value() errors std::compiler::CompilerError:
        static compile:
            fn make(r: Wrapper):
                {inner} = r
                fn f():
                    inner.k
                f
            make(Wrapper {inner: Knob {k: 9}})()
    std::test::value("destructure-capture-struct-value/destructured", 9, capture_struct_value)

    fn capture_struct_value_explicit() errors std::compiler::CompilerError:
        static compile:
            fn make(r: Wrapper):
                t = r
                inner = t.inner
                fn f():
                    inner.k
                f
            make(Wrapper {inner: Knob {k: 9}})()
    std::test::value("destructure-capture-struct-value/explicit", 9, capture_struct_value_explicit)

# ---------------------------------------------------------------------------
# Method sugar (destructures in elif chains, over an untyped parameter, are in
# destructuring-instances.bot)

fn register_method_sugar_tests():
    # destructure-method-sugar: a destructured binding is an ordinary
    # receiver (the Tcl $sugarFns: list_sum, unused, and visible).
    fn receiver() errors std::compiler::CompilerError:
        static compile:
            fn list_sum(xs):
                total = 0
                loop x in xs:
                    total
                std::list::length(xs)
            fn visible(items, n):
                std::list::length(items) + n
            {items, index} = {items: [1, 2, 3], index: 10}
            items.visible(index)
    std::test::value("destructure-method-sugar/destructured", 13, receiver)

    fn receiver_explicit() errors std::compiler::CompilerError:
        static compile:
            fn list_sum(xs):
                total = 0
                loop x in xs:
                    total
                std::list::length(xs)
            fn visible(items, n):
                std::list::length(items) + n
            t = {items: [1, 2, 3], index: 10}
            items = t.items
            index = t.index
            items.visible(index)
    std::test::value("destructure-method-sugar/explicit", 13, receiver_explicit)

    # destructure-method-sugar-source: a method-call source destructures like
    # any other call.
    fn method_source() errors std::compiler::CompilerError:
        static compile:
            fn make(n):
                {a: n, b: n + 1}
            {a, b} = 5.make()
            [a, b]
    std::test::value("destructure-method-sugar-source/destructured", [5, 6], method_source)

    fn method_source_explicit() errors std::compiler::CompilerError:
        static compile:
            fn make(n):
                {a: n, b: n + 1}
            t = make(5)
            a = t.a
            b = t.b
            [a, b]
    std::test::value("destructure-method-sugar-source/explicit", [5, 6], method_source_explicit)

    # destructure-method-sugar-library: a library call through a destructured
    # List binding.
    fn library_method() errors std::compiler::CompilerError:
        static compile:
            {xs} = {xs: [3, 1, 2]}
            xs.length()
    std::test::value("destructure-method-sugar-library/destructured", 3, library_method)

    fn library_method_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {xs: [3, 1, 2]}
            xs = t.xs
            std::list::length(xs)
    std::test::value("destructure-method-sugar-library/explicit", 3, library_method_explicit)

    # destructure-method-sugar-field-callable: a field holding a function is
    # called as a value (no sugar, no ambiguity).
    fn field_callable() errors std::compiler::CompilerError:
        static compile:
            fn inc(x):
                x + 1
            {f} = {f: inc}
            f(1)
    std::test::value("destructure-method-sugar-field-callable/destructured", 2, field_callable)

    fn field_callable_explicit() errors std::compiler::CompilerError:
        static compile:
            fn inc(x):
                x + 1
            t = {f: inc}
            f = t.f
            f(1)
    std::test::value("destructure-method-sugar-field-callable/explicit", 2, field_callable_explicit)

# ---------------------------------------------------------------------------
# Nesting: recursive named projection

fn register_nested_tests():
    # destructure-nested-basic: `{user: {name, id}, expires} = result` over
    # declared structs.
    fn nested_named() errors std::compiler::CompilerError:
        static compile:
            {user: {name, id}, expires} = Login {user: User {name: "ada", id: 7, admin: true}, expires: 99}
            [name, id, expires]
    std::test::value("destructure-nested-basic/destructured", ["ada", 7, 99], nested_named)

    fn nested_named_explicit() errors std::compiler::CompilerError:
        static compile:
            t = Login {user: User {name: "ada", id: 7, admin: true}, expires: 99}
            t2 = t.user
            name = t2.name
            id = t2.id
            expires = t.expires
            [name, id, expires]
    std::test::value("destructure-nested-basic/explicit", ["ada", 7, 99], nested_named_explicit)

    # destructure-nested-anonymous: the same for anonymous structs.
    fn nested_anonymous() errors std::compiler::CompilerError:
        static compile:
            {user: {name, id}, expires} = {user: {name: "ada", id: 7, admin: true}, expires: 99}
            [name, id, expires]
    std::test::value("destructure-nested-anonymous/destructured", ["ada", 7, 99], nested_anonymous)

    fn nested_anonymous_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {user: {name: "ada", id: 7, admin: true}, expires: 99}
            t2 = t.user
            name = t2.name
            id = t2.id
            expires = t.expires
            [name, id, expires]
    std::test::value("destructure-nested-anonymous/explicit", ["ada", 7, 99], nested_anonymous_explicit)

    # destructure-nested-renaming-inside: left names are fields at every
    # level.
    fn renaming_inside() errors std::compiler::CompilerError:
        static compile:
            {user: {name: n, id: i}, expires: e} = {user: {name: "ada", id: 7}, expires: 99}
            [n, i, e]
    std::test::value("destructure-nested-renaming-inside/destructured", ["ada", 7, 99], renaming_inside)

    fn renaming_inside_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {user: {name: "ada", id: 7}, expires: 99}
            t2 = t.user
            n = t2.name
            i = t2.id
            e = t.expires
            [n, i, e]
    std::test::value("destructure-nested-renaming-inside/explicit", ["ada", 7, 99], renaming_inside_explicit)

    # destructure-nested-omitted-inner-fields: inner fields may be omitted.
    fn omitted_inner() errors std::compiler::CompilerError:
        static compile:
            {u: {b}} = {u: {a: 1, b: 2, c: 3}, v: 4}
            b
    std::test::value("destructure-nested-omitted-inner-fields", 2, omitted_inner)

    # destructure-nested-binds-only-leaves: a field destructured further is
    # not itself bound.
    fn only_leaves() errors std::compiler::CompilerError:
        static compile:
            {u: {b}} = {u: {b: 1}}
            u
    std::test::rejects("destructure-nested-binds-only-leaves", std::compiler::DiagnosticCode::Unbound, only_leaves)

    # destructure-nested-deep: three levels.
    fn deep() errors std::compiler::CompilerError:
        static compile:
            {a: {b: {c}}} = {a: {b: {c: 1, d: 2}}}
            c
    std::test::value("destructure-nested-deep/destructured", 1, deep)

    fn deep_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {a: {b: {c: 1, d: 2}}}
            t2 = t.a
            t3 = t2.b
            c = t3.c
            c
    std::test::value("destructure-nested-deep/explicit", 1, deep_explicit)

    # destructure-nested-siblings-order: nested and flat entries mix.
    fn siblings() errors std::compiler::CompilerError:
        static compile:
            {x, u: {p, q}, y, w: {r}} = {x: 1, u: {p: 2, q: 3}, y: 4, w: {r: 5}}
            [x, p, q, y, r]
    std::test::value("destructure-nested-siblings-order/destructured", [1, 2, 3, 4, 5], siblings)

    fn siblings_explicit() errors std::compiler::CompilerError:
        static compile:
            t = {x: 1, u: {p: 2, q: 3}, y: 4, w: {r: 5}}
            x = t.x
            t2 = t.u
            p = t2.p
            q = t2.q
            y = t.y
            t3 = t.w
            r = t3.r
            [x, p, q, y, r]
    std::test::value("destructure-nested-siblings-order/explicit", [1, 2, 3, 4, 5], siblings_explicit)

    # destructure-nested-duplicate-destination: one name bound at two levels
    # is the ordinary duplicate-binding error.
    fn duplicate_across_levels() errors std::compiler::CompilerError:
        static compile:
            {a: x, u: {b: x}} = {a: 1, u: {b: 2}}
    std::test::rejects("destructure-nested-duplicate-destination", std::compiler::DiagnosticCode::Duplicate, duplicate_across_levels)

    # destructure-nested-same-field-name-at-two-levels: one field name at two
    # levels is no duplicate.
    fn same_name_two_levels() errors std::compiler::CompilerError:
        static compile:
            {a: {a: inner}, b} = {a: {a: 1}, b: 2}
            [inner, b]
    std::test::value("destructure-nested-same-field-name-at-two-levels", [1, 2], same_name_two_levels)

    # destructure-nested-struct-field-is-struct-only: a field that is not a
    # struct cannot be destructured further: the ordinary projection error.
    fn int_field() errors std::compiler::CompilerError:
        static compile:
            {u: {a}} = {u: 5}
    std::test::rejects_message("destructure-nested-struct-field-is-struct-only/int", std::compiler::DiagnosticCode::NotAStruct, "cannot project field \"a\" from a value of type int: only a struct has fields", int_field)

    fn list_field() errors std::compiler::CompilerError:
        static compile:
            {u: {a}} = {u: [1, 2]}
    std::test::rejects_message("destructure-nested-struct-field-is-struct-only/list", std::compiler::DiagnosticCode::NotAStruct, "cannot project field \"a\" from a value of type List[int]: only a struct has fields", list_field)

# ---------------------------------------------------------------------------
# Modules

fn register_module_tests():
    # destructure-module-struct-source: a struct declared in a module is
    # destructurable by its fields (std::compiler::SourceLocation stands in for
    # the Tcl test's private module struct).
    fn module_struct() errors std::compiler::CompilerError:
        static compile:
            {line, column: col} = std::compiler::SourceLocation {line: 3, column: 4}
            [line, col]
    std::test::value("destructure-module-struct-source", [3, 4], module_struct)


# ---------------------------------------------------------------------------
# The statement's value is unit. A destructure introduces bindings and
# evaluates to unit: its projections are not its result, so as the last
# statement of a body it makes the body's value unit. The "explicit"
# spelling is the expansion ending in `unit`.

fn register_unit_value_tests():
    # destructure-value-direct: a body ending in a destructure is unit, not
    # the last field's value.
    fn direct() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, b} = {a: 1, b: 2}
            f()
    std::test::value("destructure-value-direct/destructured", unit, direct)

    fn direct_explicit() errors std::compiler::CompilerError:
        static compile:
            fn f():
                tmp = {a: 1, b: 2}
                a = tmp.a
                b = tmp.b
                unit
            f()
    std::test::value("destructure-value-direct/explicit", unit, direct_explicit)

    # destructure-value-is-not-the-last-field: the expansion without the unit
    # answers its last binding's value, 2; the destructure answers unit.
    fn not_last_field() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, b} = {a: 1, b: 2}
            f()
    std::test::value("destructure-value-is-not-the-last-field/destructure", unit, not_last_field)

    fn old_expansion() errors std::compiler::CompilerError:
        static compile:
            fn f():
                tmp = {a: 1, b: 2}
                a = tmp.a
                b = tmp.b
            f()
    std::test::value("destructure-value-is-not-the-last-field/old-expansion", 2, old_expansion)

# The pattern table: for each pattern and each kind of source, a destructure
# ending a function body makes the body's value unit (/last), and the bindings
# it made are usable after it, with the source a struct value (/bound) or a
# binding (/via-binding).

# destructure-value-shorthand-*: two shorthand entries.
fn register_unit_shorthand_tests():
    fn named_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, d} = Rec {a: 1, b: "x", c: 3, d: 4}
            f()
    std::test::value("destructure-value-shorthand-named/last", unit, named_last)

    fn named_bound() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, d} = Rec {a: 1, b: "x", c: 3, d: 4}
                [a, d]
            f()
    std::test::value("destructure-value-shorthand-named/bound", [1, 4], named_bound)

    fn named_via_binding() errors std::compiler::CompilerError:
        static compile:
            fn f():
                r = Rec {a: 1, b: "x", c: 3, d: 4}
                {a, d} = r
                [a, d]
            f()
    std::test::value("destructure-value-shorthand-named/via-binding", [1, 4], named_via_binding)

    fn anonymous_last() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, d} = {a: 1, b: "x", c: 3, d: 4}
            f()
    std::test::value("destructure-value-shorthand-anonymous/last", unit, anonymous_last)

    fn anonymous_bound() errors std::compiler::CompilerError:
        static compile:
            fn f():
                {a, d} = {a: 1, b: "x", c: 3, d: 4}
                [a, d]
            f()
    std::test::value("destructure-value-shorthand-anonymous/bound", [1, 4], anonymous_bound)

    fn anonymous_via_binding() errors std::compiler::CompilerError:
        static compile:
            fn f():
                r = {a: 1, b: "x", c: 3, d: 4}
                {a, d} = r
                [a, d]
            f()
    std::test::value("destructure-value-shorthand-anonymous/via-binding", [1, 4], anonymous_via_binding)

