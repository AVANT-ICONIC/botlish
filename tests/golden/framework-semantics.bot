# ---------------------------------------------------------------------------
# The framework keeps the compiler's precision: the Tcl test compiles each
# code both plainly and as a golden body and compares the verdicts; here is
# the golden body's verdict.

fn register_precision_tests():
    # gf-precision-range-proof: an index the counted loop proves in range
    # needs no IndexNotFound handler.
    fn range_proof() errors compiler::CompilerError:
        static compile:
            xs = [1, 2, 3]
            loop i from 0 to list::length(xs):
                list::at(xs, i)
    test::value("gf-precision-range-proof", [1, 2, 3], range_proof)

    # gf-precision-known-error: a call proven to fail is KnownError.
    fn known_error() errors compiler::CompilerError:
        static compile:
            list::at([1, 2], 5)
    test::rejects("gf-precision-known-error", compiler::DiagnosticCode::KnownError, known_error)

    # gf-precision-error-narrowing: the argument's exact value (9) rules out
    # Large, so only Small needs a handler.
    fn error_narrowing() errors compiler::CompilerError:
        static compile:
            x = 9
            r = pick(x):
                on Small:
                    0
            r
    test::value("gf-precision-error-narrowing", 9, error_narrowing)

    # gf-precision-affine: a coroutine moved to another binding and then
    # resumed is UseAfterMove; the moved-to binding is fine.
    fn resumes_after_move() errors compiler::CompilerError:
        static compile:
            coroutine {step} = finite(1)
            other = step
            step().n
    test::rejects("gf-precision-affine/use-after-move", compiler::DiagnosticCode::UseAfterMove, resumes_after_move)
    fn resumes_moved_binding() errors compiler::CompilerError:
        static compile:
            coroutine {step} = finite(1)
            other = step
            other().n
    test::value("gf-precision-affine/moved-binding", 2, resumes_moved_binding)

    # gf-precision-method-resolution: a typed receiver picks its one
    # admitting candidate (list::length, not mutable_vector::length); an
    # untyped one is ambiguous between the two imported candidates.
    fn typed_receiver() errors compiler::CompilerError:
        static compile:
            xs = [1, 2]
            xs.length()
    test::value("gf-precision-method-resolution/typed", 2, typed_receiver)
    fn untyped_receiver() errors compiler::CompilerError:
        static compile:
            fn first(v):
                v.length()
            first([1])
    test::rejects("gf-precision-method-resolution/untyped", compiler::DiagnosticCode::AmbiguousMethodCall, untyped_receiver)

# ---------------------------------------------------------------------------
# The context-trait surface

fn register_context_trait_tests():
    # gf-context-trait-surface: the installed suite implements, structurally,
    # the application's context trait Listed (its operation spelled like
    # test::registered): how_many() reads the very cases the suite holds --
    # as many as test::count() says, and more than none, since every other
    # test is registered by now. (Config and ProbeLog, the other installed
    # contexts, spell no `registered`.) The negative half -- a trait spelled
    # like test::count() is not satisfied -- is a whole-program
    # MISSING-CONTEXT at the top-level call, which no block can reify: it
    # stays in Tcl.
    listed = how_many()
    counted = test::count()
    fn suite_satisfies_listed() errors compiler::CompilerError:
        static compile:
            [listed == counted, listed > 0]
    test::value("gf-context-trait-surface", [true, true], suite_satisfies_listed)

with context Config {levels: levels()}
with context ProbeLog {notes: no_notes()}
with context test::suite()
register_context_tests()
register_eager_start_tests()
register_coroutine_cleanup_tests(1)
register_affine_capture_tests()
register_body_contract_tests(1)
register_escaping_error_tests(9)
register_text_tests()
register_precision_tests()
register_context_trait_tests()
test::report()
