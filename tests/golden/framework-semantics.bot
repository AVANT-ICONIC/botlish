                test::code_name(compiler::DiagnosticCode::TraitImplOrder),
                test::code_name(compiler::DiagnosticCode::TraitInstanceBudget),
                test::code_name(compiler::DiagnosticCode::TraitNestedPolymorphic),
                test::code_name(compiler::DiagnosticCode::TraitNotSatisfied),
                test::code_name(compiler::DiagnosticCode::TraitPolymorphicFunctionValue),
                test::code_name(compiler::DiagnosticCode::TraitPolymorphicRecursion),
                test::code_name(compiler::DiagnosticCode::TraitStorageUnsupported),
                test::code_name(compiler::DiagnosticCode::TraitUnknownOperation),
                test::code_name(compiler::DiagnosticCode::TraitViewMisuse),
                test::code_name(compiler::DiagnosticCode::TraitWitnessJoin),
                test::code_name(compiler::DiagnosticCode::Type),
                test::code_name(compiler::DiagnosticCode::Unbound),
                test::code_name(compiler::DiagnosticCode::UndeclaredError),
                test::code_name(compiler::DiagnosticCode::UnexpectedErrorPayload),
                test::code_name(compiler::DiagnosticCode::UnhandledError),
                test::code_name(compiler::DiagnosticCode::UnknownEnumCase),
                test::code_name(compiler::DiagnosticCode::UnknownField),
                test::code_name(compiler::DiagnosticCode::UnknownFlag),
                test::code_name(compiler::DiagnosticCode::UnknownNamespace),
                test::code_name(compiler::DiagnosticCode::UnknownStruct),
                test::code_name(compiler::DiagnosticCode::UnknownSymbol),
