# structs-and-enums-instances.bot -- static projection proven by semantic
# instances: the source-level specification that a projection `x.f` from an
# untyped parameter is proven, call by call, by the instance the compiler
# analyzes under each call's actual struct type -- never looked up at run
# time -- that instances chain through wrappers and recursion, and that one
# generic function serves several struct shapes (and MutableArray element
# contracts) with the right value for each.
#
# golden-exclude: cranelift-generic -- NATIVE UNSUPPORTED struct-shape: the unspecialized native baseline has no slot for a projection only a semantic instance proves (STRUCTS.md, "Known limitations"; tests/helpers.tcl's GenericBaselineUndefined); tests/structs.test runs these programs on interp, compile and cranelift only (structInstanceBackends)
#
# Ported from tests/structs.test (structs-and-enums.bot holds the rest of its
# struct tests, the rejected instance calls included). These programs are a
# suite of their own so that the cranelift-generic run of
# structs-and-enums.bot stays a real one: run.tcl substitutes cranelift for
# a whole suite whose unspecialized lowering reports struct-shape.
#
# Imports: compiler and test (the framework); mutable_array
# (struct-specialization-census's array fields). No test here is about an
# import or about method calls.
import std::compiler
import std::mutable_array
import std::test

fn register_instance_projection_tests():
    # struct-projection-instance-proves: first's instances for two
    # anonymous struct shapes project value from each (a String, then an
    # Int: the field's position in the canonical layout differs too).
    fn b_instance_proves() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                x.value
            r = first({value: "a", next: 1})
            s = first({next: 2, value: 7})
            [r, s]
    std::test::value("struct-projection-instance-proves", ["a", 7], b_instance_proves)

    # struct-projection-through-wrapper: instances chain: a wrapper called
    # with a struct gives its callee the struct too.
    fn b_through_wrapper() errors std::compiler::CompilerError:
        static compile:
            fn first(x):
                x.value
            fn wrap(y):
                first(y)
            wrap({value: "deep"})
    std::test::value("struct-projection-through-wrapper", "deep", b_through_wrapper)

    # struct-projection-recursive-struct-parameter: a recursive function
    # threads a struct parameter; its own self-call is not a generic use.
    fn b_recursive_parameter() errors std::compiler::CompilerError:
        static compile:
            fn walk(s, i):
                if i >= 3:
                    return s.value
                walk(s, i + 1)
            walk({value: "done", spare: 1}, 0)
    std::test::value("struct-projection-recursive-struct-parameter", "done", b_recursive_parameter)

    # struct-specialization-census: one generic get(p) projecting x from five
    # struct shapes -- two with MutableArray fields of different element
    # contracts, an Int, a String, and a wider struct -- returns each field
    # (the Tcl test also pins five semantic instances lowered to four native
    # functions).
    fn b_specialization_census() errors std::compiler::CompilerError:
        static compile:
            fn get(p):
                p.x
            a = {x: std::mutable_array::create(2, 0)}
            b = {x: std::mutable_array::create(2, "s")}
            c = {x: 7}
            d = {x: "s"}
            e = {x: 1, y: 2}
            a0 = std::mutable_array::at(get(a), 0):
                on IndexNotFound:
                    0
            b0 = std::mutable_array::at(get(b), 0):
                on IndexNotFound:
                    ""
            [a0, b0, get(c), get(d), get(e)]
    std::test::value("struct-specialization-census", [0, "s", 7, "s", 1], b_specialization_census)

with context std::test::suite()
register_instance_projection_tests()
std::test::report()
