# ---------------------------------------------------------------------------
# str-append-char.test

# str-append-char-values: one character of every UTF-8 width (one to four
# bytes, the astral one as one unit) and a newline appended, read back by
# index.
fn b_append_char_values() errors std::compiler::CompilerError:
    static compile:
        s = "".append_char('a').append_char('\n').append_char('é').append_char('世').append_char('😀').append_char('z')
        codes = loop i from 0 to std::str::length(s):
            std::char::scalar_value(std::str::char_at(s, i))
        [s, std::str::length(s), codes]

# str-append-char-reads-back: the appended character is the last one, and
# the length grows by exactly one.
fn b_append_char_reads_back() errors std::compiler::CompilerError:
    static compile:
        fn last_is(s, c) -> bool:
            t = s.append_char(c)
            n = std::str::length(s)
            if std::str::length(t) != n + 1:
                return false
            r = t.char_at(n):
                on IndexNotFound:
                    return false
            r == c

        [last_is("ab", '\n'), last_is("é", '😀'), last_is("😀", 'x'), last_is("", '世'), last_is("x\n", '\n')]

# str-append-char-empty: "" followed by a character is that character's
# one-character String.
fn b_append_char_empty() errors std::compiler::CompilerError:
    static compile:
        ["".append_char('😀') == "😀", std::str::length("".append_char('😀')), "".append_char('\n') == "\n", "".append_char('\n')]

# str-append-char-agrees-with-concat: appending each character builds the
# text concatenating its one-character slices builds.
fn b_append_char_agrees_with_concat() errors std::compiler::CompilerError:
    static compile:
        s = "a é\n世😀~"
        fn same_from(i, by_char, by_text) -> bool:
            if i < 0 or i >= std::str::length(s):
                return by_char == by_text and by_char == s
            c = s.char_at(i)
            same_from(i + 1, by_char.append_char(c), by_text.concat(s.substring(i, i + 1)))

        same_from(0, "", "")

# str-append-char-operand-unchanged: a new String each time; the operand
# keeps its value.
fn b_append_char_operand_unchanged() errors std::compiler::CompilerError:
    static compile:
        a = "ab"
        b = a.append_char('c')
        c = a.append_char('😀')
        [a, b, c, b.append_char('\n'), b]

# str-append-char-as-a-value: called as a first-class value.
fn b_append_char_as_a_value() errors std::compiler::CompilerError:
    static compile:
        fs = [std::str::append_char]

        fn apply(f, s, c):
            f(s, c)

        [apply(std::list::at(fs, 0), "x", 'y'), apply(std::list::at(fs, 0), "é", '😀'), apply(std::str::append_char, "", '\n')]

# str-append-char-name-beside-list-append: with list and str both imported
# (this suite imports both), .append and .append_char each have one
# candidate.
fn b_append_char_beside_list_append() errors std::compiler::CompilerError:
    static compile:
        fn add(acc, x):
            acc.append(x)

        fn line(acc, c):
            acc.append_char(c)

        [add([1], 2), line("ab", '\n')]

# str-append-char-representations: the operand as a one-character slice, a
# slice consumed in place, a concat construction and a self-recursive
# accumulator (whatever each is natively, the same text).
fn b_append_char_representations() errors std::compiler::CompilerError:
    static compile:
        fn first(t: str) -> str errors LowerUnderrun, UpperOverrun:
            if std::str::length(t) == 0:
                return ""
            t.substring(0, 1)

        fn tag(t: str) -> str errors LowerUnderrun, UpperOverrun:
            h = first(t)
            h.append_char('!')

        fn slice_then(t: str) -> str errors LowerUnderrun, UpperOverrun:
            t.substring(1, 3).append_char('😀')

        fn scan(t: str, i: int, acc: str) -> str:
            if i < 0 or i >= std::str::length(t):
                return acc
            scan(t, i + 1, acc.append_char(t.char_at(i)).append_char('.'))

        fn chain(t: str) -> str:
            t.concat("x").append_char('y').concat("z")

        fn all() -> List[str] errors LowerUnderrun, UpperOverrun:
            [tag("é😀"), tag(""), slice_then("aé世b"), scan("a😀é", 0, ""), chain("ab")]

        r = all():
            on LowerUnderrun:
                ["LowerUnderrun"]
            on UpperOverrun:
                ["UpperOverrun"]
        r

fn register_str_append_char_tests():
    std::test::value("str-append-char-values", ["a\né世😀z", 6, [97, 10, 233, 19990, 128512, 122]], b_append_char_values)
    std::test::value("str-append-char-reads-back", [true, true, true, true, true], b_append_char_reads_back)
    std::test::value("str-append-char-empty", [true, 1, true, "\n"], b_append_char_empty)
    std::test::value("str-append-char-agrees-with-concat", true, b_append_char_agrees_with_concat)
    std::test::value("str-append-char-operand-unchanged", ["ab", "abc", "ab😀", "abc\n", "abc"], b_append_char_operand_unchanged)
    std::test::value("str-append-char-as-a-value", ["xy", "é😀", "\n"], b_append_char_as_a_value)
    std::test::value("str-append-char-name-beside-list-append", [[1, 2], "ab\n"], b_append_char_beside_list_append)
    std::test::value("str-append-char-representations", ["é!", "!", "é世😀", "a.😀.é.", "abxyz"], b_append_char_representations)

