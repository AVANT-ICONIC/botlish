# emailish-predicate.test: std::web::emailish?

# emailish-predicate-parity-LABEL: std::web::emailish?(ADDRESS) is EXPECTED.
fn register_emailish_verdict(label: str, address: str, expected: bool):
    fn b_verdict() errors std::compiler::CompilerError:
        static compile:
            std::web::emailish?(address)
    std::test::value("emailish-predicate-parity-".concat(label), expected, b_verdict)

fn register_emailish_tests():
    register_emailish_verdict("ascii-valid", "someone@example.com", true)
    register_emailish_verdict("unicode-valid", "café@例え.テスト", true)
    register_emailish_verdict("no-at", "not-an-email", false)
    register_emailish_verdict("empty-local-part", "@example.com", false)
    register_emailish_verdict("invalid-local-char", "\"a b\"@example.com", false)
    register_emailish_verdict("invalid-domain-label", "foo@bad_domain.com", false)
    register_emailish_verdict("tld-too-short", "foo@example.c", false)
    register_emailish_verdict("empty-string", "", false)
    register_emailish_verdict("at-only", "@", false)

    # emailish-predicate-refines: a true std::web::emailish?(s) refines s to
    # std::web::Emailish in the true branch (/true-branch: accepted where an
    # Emailish is required) and only there (/else-branch: Type).
    fn b_refines_true() errors std::compiler::CompilerError:
        static compile:
            fn need(e: std::web::Emailish) -> str:
                e
            fn f(s: str) -> str:
                if std::web::emailish?(s):
                    need(s)
                else:
                    "no"
            [f("a@b.io"), f("x")]
    std::test::value("emailish-predicate-refines/true-branch", ["a@b.io", "no"], b_refines_true)

    fn b_refines_else() errors std::compiler::CompilerError:
        static compile:
            fn need(e: std::web::Emailish) -> str:
                e
            fn f(s: str) -> str:
                if std::web::emailish?(s):
                    "yes"
                else:
                    need(s)
            f("a@b.io")
    std::test::rejects_at("emailish-predicate-refines/else-branch", std::compiler::DiagnosticCode::Type, 891, 26, b_refines_else)

    # emailish-predicate-ordinary-bool: the result is an ordinary bool.
    fn b_ordinary_bool() errors std::compiler::CompilerError:
        static compile:
            x = std::web::emailish?("a@b.io")
            [x, not x]
    std::test::value("emailish-predicate-ordinary-bool", [true, false], b_ordinary_bool)

    # emailish-predicate-redundant-check-nir-shape: a re-check inside its own
    # true branch answers like the first check.
    fn b_redundant_check() errors std::compiler::CompilerError:
        static compile:
            fn f(s: str) -> str:
                if std::web::emailish?(s):
                    if std::web::emailish?(s):
                        "yes"
                    else:
                        "no"
                else:
                    "no"
            [f("someone@example.com"), f("nope")]
    std::test::value("emailish-predicate-redundant-check-nir-shape", ["yes", "no"], b_redundant_check)

    # emailish-predicate-user-block: a user function refining and re-checking
    # (method sugar s.emailish?(), web being imported).
    fn b_user_block() errors std::compiler::CompilerError:
        static compile:
            fn check(s: str):
                if std::web::emailish?(s):
                    if s.emailish?():
                        s
                    else:
                        "no"
                else:
                    "no"
            [check("someone@example.com"), check("not-an-email"), check("café@例え.テスト")]
    std::test::value("emailish-predicate-user-block", ["someone@example.com", "no", "café@例え.テスト"], b_user_block)

