    std::test::value("elif-long-chain/nested", [0, 1, 57, 99, -1], b_long_chain_nested)

# ---------------------------------------------------------------------------
# loop-counted.test

fn register_loop_counted_tests():
    # loop-counted-large-int-sum: bounds far beyond i64 sum exactly (no
    # native i64 wraparound).
    fn b_large_int_sum() errors std::compiler::CompilerError:
        static compile:
            fn f():
                fn go(i, n, acc):
                    loop j from i to n:
                        return go(j + 1, n, acc + j)
                    acc
                go(9223372036854775806, 9223372036854775810, 0)
            f()
    std::test::value("loop-counted-large-int-sum", 36893488147419103230, b_large_int_sum)

    # loop-counted-bounds-evaluated-once: START and END are evaluated once
    # each, START first, not once per iteration. Each bound is a probe that
    # yields [its value]; the loop runs three times and its value [0, 1, 2]
    # is the coroutine's result.
    fn b_bounds_once() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int) -> int:
                yield [n]
                n
            fn program() -> List[int]:
                v = loop i from log(0) to log(3):
                    i
                v
            coroutine {step, first} = program()
            rest = loop k from 0 to 10:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("loop-counted-bounds-evaluated-once", [[0], [[3], [0, 1, 2]]], b_bounds_once)

# ---------------------------------------------------------------------------
# loop-collecting.test

fn register_loop_collecting_tests():
    # loop-collecting-big-down-through-past-i64min: a descending inclusive
    # loop is exact past i64::MIN.
    fn b_big_down_through() errors std::compiler::CompilerError:
        static compile:
            fn f():
                loop i down from -9223372036854775807 through -9223372036854775810:
                    i
            f()
    std::test::value("loop-collecting-big-down-through-past-i64min", [-9223372036854775807, -9223372036854775808, -9223372036854775809, -9223372036854775810], b_big_down_through)

    # loop-collecting-lockstep-three-way: three clauses with one proven
    # common cardinality advance together.
    fn b_lockstep_three_way() errors std::compiler::CompilerError:
        static compile:
            fn f(xs):
                loop x in xs and i from 0 to std::list::length(xs) and j down from std::list::length(xs) through 1:
                    [x, i, j]
            f([7, 8, 9])
    std::test::value("loop-collecting-lockstep-three-way", [[7, 0, 3], [8, 1, 2], [9, 2, 1]], b_lockstep_three_way)

# ---------------------------------------------------------------------------
# loop-in.test

fn register_loop_in_tests():
    # loop-in-closure-per-iteration: closures made in different iterations
    # capture that iteration's own x.
    fn b_closure_per_iteration() errors std::compiler::CompilerError:
        static compile:
            fs = loop x in [1, 2, 3]:
                fn f():
                    x
                f
            results = loop g in fs:
                g()
            results
    std::test::value("loop-in-closure-per-iteration", [1, 2, 3], b_closure_per_iteration)

    # loop-in-error-propagates: a failing checked construction in the body
    # propagates its error out of the whole loop, with no partial result.
    # The Tcl program (untyped check(n) -> Small, compiled -strict 0) is a
    # static TYPE under strict compilation, and its error reaches the
    # program boundary (UNCAUGHT-ERROR); here check is typed and guarded so
    # that its result proves Small, and the escaping error is handled by
    # the loop's caller ("TooBig": nothing of the loop's List survives).
    fn b_error_propagates() errors std::compiler::CompilerError:
        static compile:
            fn check(n: int) -> Small errors TooBig:
                if n > 10:
                    fail TooBig
                elif n < 0:
                    fail TooBig
                else:
                    n
            fn run(xs: List[int]) errors TooBig:
                loop x in xs:
                    check(x)
            fn outcome(xs: List[int]):
                v = run(xs):
                    on TooBig:
                        return "TooBig"
                v
            [outcome([1, 20, 2]), outcome([1, 2])]
    std::test::value("loop-in-error-propagates", ["TooBig", [1, 2]], b_error_propagates)

# ---------------------------------------------------------------------------

fn register_values_tests():
    register_surface_samples_tests()
    register_calls_tests(123456789012345678901234567890, 987654321098765432109876543210, 9223372036854775807)
    register_blocks_tests()
    register_control_tests()
    register_inference_tests()
    register_elif_tests()
    register_loop_counted_tests()
    register_loop_collecting_tests()
    register_loop_in_tests()

with context std::test::suite()
register_values_tests()
std::test::report()
