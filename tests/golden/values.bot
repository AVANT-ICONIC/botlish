# values.bot -- ordinary successful value tests (manifest: category values):
# arithmetic on arbitrary-precision Ints, functions, closures, recursion,
# if/elif, counted, collecting and lockstep loops, inference results, and the
# examples/surface/*.bot samples with an `# expect:` value.
#
# Evaluation-order tests of the Tcl suite observe a Tcl-side effect native
# (test-log, test-tick, test_log) or a context-held log; neither is
# available in a body, so their ports observe the order with a coroutine
# log instead: a probe `yield`s its id, and the body drives the coroutine,
# collecting [FIRST, REST] -- FIRST the first yielded id, REST every later
# yield followed by the coroutine's final result.
import std::compiler
import std::coroutine
import std::list
import std::str
import std::test

# ---------------------------------------------------------------------------
# Declarations the tests need (top-level only).

# examples/surface/15-enums.bot.
enum Light:
    Red,
    Yellow,
    Green,

enum Signal:
    Red,
    Green,

# elif.test: elif-fail's Boom.
error Boom

# elif.test: elif-branch-values-error-capable's TooBig; loop-in.test:
# loop-in-error-propagates' TooBig and Small (one payload-free declaration of
# TooBig serves both).
error TooBig

type Small = Int in 0..10

# ---------------------------------------------------------------------------
# surface-samples.test (examples/surface/*.bot and its surface-run-* programs)

fn register_surface_samples_tests():
    # 03-closure: a nested function is a real closure; add10 keeps
    # make_adder's x after the call returned.
    fn b_03_closure() errors std::compiler::CompilerError:
        static compile:
            fn make_adder(x):
                fn add(y):
                    x + y

                add

            add10 = make_adder(10)
            add10(32)
    std::test::value("03-closure", 42, b_03_closure)

    # 07-loop-break: break never carries a value; a bare loop's value is
    # unit.
    fn b_07_loop_break() errors std::compiler::CompilerError:
        static compile:
            loop:
                break
    std::test::value("07-loop-break", unit, b_07_loop_break)

    # 13-hygiene: binding `list` (the native list literals call) does not
    # change what list-literal syntax means.
    fn b_13_hygiene() errors std::compiler::CompilerError:
        static compile:
            fn pair(list, x):
                [list, x]

            list = 3
            [1.pair(2), list]
    std::test::value("13-hygiene", [[1, 2], 3], b_13_hygiene)

    # 15-enums: enum cases are nominal; Light::Red and Signal::Red are
    # unequal even through a generic identity function.
    fn b_15_enums() errors std::compiler::CompilerError:
        static compile:
            fn next(light: Light) -> Light:
                if light == Light::Red:
                    Light::Green
                elif light == Light::Green:
                    Light::Yellow
                else:
                    Light::Red

            fn same(x):
                x

            start = Light::Red
            [next(start), next(next(start)), next(Light::Yellow) == start, same(Light::Red) == same(Signal::Red), Light::Red == Light::Green]
    std::test::value("15-enums", [Light::Green, Light::Yellow, true, false, false], b_15_enums)

    # surface-run-factorial: recursion with arbitrary-precision results.
    fn b_factorial() errors std::compiler::CompilerError:
        static compile:
            fn factorial(n):
                if n <= 1:
                    return 1

                n * factorial(n - 1)

            factorial(30)
    std::test::value("surface-run-factorial", 265252859812191058636308480000000, b_factorial)

    # surface-run-evaluation-order: arguments evaluate left to right, each
    # once (the Tcl test's test_log(1), (2), (3) are probes here; the value
    # is the last argument, 3).
    fn b_evaluation_order() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int) -> int:
                yield n
                n
            fn pick(a: int, b: int, c: int) -> int:
                c
            fn program() -> int:
                pick(log(1), log(2), log(3))
            coroutine {step, first} = program()
            rest = loop i from 0 to 10:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("surface-run-evaluation-order", [1, [2, 3, 3]], b_evaluation_order)

# ---------------------------------------------------------------------------
# calls.test (Core IR there; the operands arrive as parameters X, Y and MAX
# so that no exact-value fact of a literal stands in for the arithmetic)

fn register_calls_tests(x: int, y: int, max: int):
    # call-5: natives are first-class values. The Tcl test passes the
    # native `*`, which source cannot name as a value (an operator is not
    # an expression); `mod` is a native of the same int x int -> int shape.
    fn b_call_5() errors std::compiler::CompilerError:
        static compile:
            fn apply(f, a, b):
                f(a, b)
            apply(mod, 47, 5)
    std::test::value("call-5", 2, b_call_5)

    # arith-2: a 30-digit by 30-digit product is exact.
    fn b_arith_2() errors std::compiler::CompilerError:
        static compile:
            x * y
    std::test::value("arith-2", 121932631137021795226185032733622923332237463801111263526900, b_arith_2)

    # arith-3: i64::MAX + 1 promotes; no fixed-width overflow.
    fn b_arith_3() errors std::compiler::CompilerError:
        static compile:
            max + 1
    std::test::value("arith-3", 9223372036854775808, b_arith_3)

# ---------------------------------------------------------------------------
# blocks.test

fn register_blocks_tests():
    # closure-2: a closure reads the x where it was defined (10), not the
    # caller's x (20).
    fn b_closure_2() errors std::compiler::CompilerError:
        static compile:
            x = 10
            fn f():
                x
            fn g():
                x = 20
                f()
            g()
    std::test::value("closure-2", 10, b_closure_2)

# ---------------------------------------------------------------------------
# control.test

fn register_control_tests():
    # return-2: code after return is not evaluated. The Tcl test logs
    # "before" and "after" around `return 10`; here log(1) and log(2), so
    # an evaluated log(2) would appear in the trace before the result 10.
    fn b_return_2() errors std::compiler::CompilerError:
        static compile:
            fn log(n: int) -> int:
                yield n
                n
            fn body() -> int:
                log(1)
                return 10
                log(2)
            coroutine {step, first} = body()
            rest = loop i from 0 to 10:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value("return-2", [1, [10]], b_return_2)

# ---------------------------------------------------------------------------
# inference.test (a differential there: interp and compile must agree; here
# every backend must produce the value they agree on)

fn register_inference_tests():
    # inference-recursive-mixed-result-type: f's result is an Int on one
    # path and a String on the other; integer? sees each result's own kind.
    fn b_recursive_mixed() errors std::compiler::CompilerError:
        static compile:
            fn f(n):
                if n < 1:
                    7
                else:
                    r = f(n - 1)
                    "seven"
            [integer?(f(0)), integer?(f(2))]
    std::test::value("inference-recursive-mixed-result-type", [true, false], b_recursive_mixed)

# ---------------------------------------------------------------------------
# elif.test (every program there runs in its elif spelling and its nested
# if/else spelling, which must agree: each spelling is a golden test here,
# suffixed /elif and /nested, with the same expected value)

# elif-order-NAME: the conditions run in written order, each at most once,
# none after the selected one, then only the selected body. The Tcl test's
# value [V, DIGITS] (DIGITS the probe ids in order) is the trace
# [FIRST, [REST..., V]] here: [10, 15] is [1, [5, 10]].
fn register_elif_order_test(name: str, a: bool, b: bool, c: bool, expected):
    fn b_elif() errors std::compiler::CompilerError:
        static compile:
            fn probe(id: int, result: bool) -> bool:
                yield id
                result
            fn pick(a: bool, b: bool, c: bool) -> int:
                return if probe(1, a):
                    probe(5, true)
                    10
                elif probe(2, b):
                    probe(6, true)
                    20
                elif probe(3, c):
                    probe(7, true)
                    30
                else:
                    probe(8, true)
                    40
            coroutine {step, first} = pick(a, b, c)
            rest = loop i from 0 to 10:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value(name.concat("/elif"), expected, b_elif)
    fn b_nested() errors std::compiler::CompilerError:
        static compile:
            fn probe(id: int, result: bool) -> bool:
                yield id
                result
            fn pick(a: bool, b: bool, c: bool) -> int:
                return if probe(1, a):
                    probe(5, true)
                    10
                else:
                    if probe(2, b):
                        probe(6, true)
                        20
                    else:
                        if probe(3, c):
                            probe(7, true)
                            30
                        else:
                            probe(8, true)
                            40
            coroutine {step, first} = pick(a, b, c)
            rest = loop i from 0 to 10:
                if std::coroutine::done?(step):
                    break
                step()
            [first, rest]
    std::test::value(name.concat("/nested"), expected, b_nested)

fn register_elif_tests():
    register_elif_order_test("elif-order-first", true, true, true, [1, [5, 10]])
    register_elif_order_test("elif-order-second", false, true, true, [1, [2, 6, 20]])
    register_elif_order_test("elif-order-third", false, false, true, [1, [2, 3, 7, 30]])
    register_elif_order_test("elif-order-else", false, false, false, [1, [2, 3, 8, 40]])

    # elif-fail: a fail in an elif branch raises Boom; the caller's handler
    # turns it into a value.
    fn b_fail_elif() errors std::compiler::CompilerError:
        static compile:
            fn f(a, b) errors Boom:
                if a:
                    1
                elif b:
                    fail Boom
                else:
                    3
            fn run(a, b):
                v = f(a, b):
                    on Boom:
                        -7
                v
            [run(true, false), run(false, true), run(false, false)]
    std::test::value("elif-fail/elif", [1, -7, 3], b_fail_elif)
    fn b_fail_nested() errors std::compiler::CompilerError:
        static compile:
            fn f(a, b) errors Boom:
                if a:
                    1
                else:
                    if b:
                        fail Boom
                    else:
                        3
            fn run(a, b):
                v = f(a, b):
                    on Boom:
                        -7
                v
            [run(true, false), run(false, true), run(false, false)]
    std::test::value("elif-fail/nested", [1, -7, 3], b_fail_nested)

    # elif-branch-values-error-capable: branches calling an error-capable
    # check; the n < 5 branch's unhandled call is proven not to fail.
    fn b_error_capable_elif() errors std::compiler::CompilerError:
        static compile:
            fn check(n) errors TooBig:
                if n > 10:
                    fail TooBig
                else:
                    n
            fn classify(n):
                v = if n < 0:
                    0
                elif n < 5:
                    check(n)
                elif n < 50:
                    check(n):
                        on TooBig:
                            -1
                else:
                    100
                v
            [classify(-4), classify(3), classify(7), classify(20), classify(60)]
    std::test::value("elif-branch-values-error-capable/elif", [0, 3, 7, -1, 100], b_error_capable_elif)
    fn b_error_capable_nested() errors std::compiler::CompilerError:
        static compile:
            fn check(n) errors TooBig:
                if n > 10:
                    fail TooBig
                else:
                    n
            fn classify(n):
                v = if n < 0:
                    0
                else:
                    if n < 5:
                        check(n)
                    else:
                        if n < 50:
                            check(n):
                                on TooBig:
                                    -1
                        else:
                            100
                v
            [classify(-4), classify(3), classify(7), classify(20), classify(60)]
    std::test::value("elif-branch-values-error-capable/nested", [0, 3, 7, -1, 100], b_error_capable_nested)

