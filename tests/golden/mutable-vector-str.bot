# mutable-vector-str.bot -- MutableVector[T] copies over heap Strings, ported
# from tests/mutable-vector.test (mv-cow-gc-stress); the rest of that file's
# ports are mutable-vector.bot.
#
# Strings made at run time (std::str::concat) and reachable only through vector
# elements stay valid while copies of the vector are mutated, collected and
# read: a copy shares nothing observable with its original. The Tcl test
# also runs the program natively under a collection at every allocation
# (BOTLISH_NATIVE_GC_STRESS); this suite runs under that stress only when
# the whole run does (CI's gc-stress job, through tests/golden.test).
#
# Imports: compiler and test for the framework; mutable_vector and str are
# the Tcl program's own (and only) imports. The test lives apart from
# mutable-vector.bot because `import std::str` there would give every
# `q.length()` a third candidate, std::str::length, turning its UseAfterMove
# rejections into NoApplicableMethod.
import std::compiler
import std::mutable_vector
import std::str
import std::test

fn register_heap_string_tests():
    # b = a is a copy; a's push and take and b's swap never show through the
    # other, also after 50 more allocations.
    fn b_heap_strings() errors std::compiler::CompilerError:
        static compile:
            fn f() -> List[str] errors IndexNotFound:
                a = std::mutable_vector::from_list([std::str::concat("x", "1"), std::str::concat("y", "2")])
                b = a
                a.push(std::str::concat("z", "3"))
                junk = loop i from 0 to 50:
                    std::str::concat("j", "k")
                s = b.swap(0, std::str::concat("w", "4"))
                t = a.take(0)
                [a.at(0), a.at(1), b.at(0), b.at(1), s, t]
            r = f():
                on IndexNotFound:
                    []
            r
    std::test::value("mv-cow-gc-stress", ["y2", "z3", "w4", "y2", "x1", "x1"], b_heap_strings)

with context std::test::suite()
register_heap_string_tests()
std::test::report()
