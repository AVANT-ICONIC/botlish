# destructuring-instances.bot -- struct destructuring of an untyped
# parameter, as a source-level specification: `{a, b} = r`, where r is a
# parameter with no declared type (or a loop variable over the elements of
# one), is the ordinary static projection, proven call by call by the
# semantic instance the compiler analyzes under each call's actual struct
# type -- never a run-time field lookup. Destructured this way in function
# bodies, closures, elif chains, branches and loops, the bindings are the
# explicit spelling's (`tmp = r; a = tmp.a; ...`), and a destructure that ends
# a body, a branch or an iteration contributes unit.
#
# golden-exclude: cranelift-generic -- NATIVE UNSUPPORTED struct-shape: the unspecialized native baseline has no slot for a projection only a semantic instance proves (STRUCTS.md, "Known limitations"; tests/helpers.tcl's GenericBaselineUndefined); tests/struct-destructuring.test's outcomeUnderHir stands the specialized outcome in for cranelift-generic on these programs
#
# Ported from tests/struct-destructuring.test, like destructuring.bot, which
# holds the rest of its tests and states the conventions (NAME/destructured
# and NAME/explicit are the two spellings of one Tcl program, with one
# expected value). These programs are a suite of their own so that the
# cranelift-generic run of destructuring.bot stays a real one: run.tcl
# substitutes cranelift for a whole suite whose unspecialized lowering
# reports struct-shape. Its fragment,
# audit/golden/migration/fragments/destructuring-instances.tsv, maps their
# Tcl tests to these golden tests.
#
# Imports: compiler and test (the framework); list for list::at
# (destructure-capture-two-closures). No test here is about an import or
# about method calls, and no declaration is needed: every source is an
# anonymous struct value.
import compiler
import list
import test

# ---------------------------------------------------------------------------
# The statement's value where it is observable

fn register_statement_value_tests():
    # destructure-source-statement-value: where the statement's value is
    # observable (the last statement of a function body) it is unit, not
    # the value of the last binding it makes.
    fn statement_value() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {a, b} = r
            f({a: 1, b: 2})
    test::value("destructure-source-statement-value/destructured", unit, statement_value)

    fn statement_value_explicit() errors compiler::CompilerError:
        static compile:
            fn f(r):
                tmp = r
                a = tmp.a
                b = tmp.b
                unit
            f({a: 1, b: 2})
    test::value("destructure-source-statement-value/explicit", unit, statement_value_explicit)

# ---------------------------------------------------------------------------
# Shadowing: the ordinary scope rule inside a function

fn register_shadowing_tests():
    # destructure-same-name-in-inner-scope: a destructured name may shadow an
    # outer one in an inner scope.
    fn inner_scope() errors compiler::CompilerError:
        static compile:
            x = 1
            fn f(r):
                {a: x} = r
                x
            [f({a: 5}), x]
    test::value("destructure-same-name-in-inner-scope/destructured", [5, 1], inner_scope)

    fn inner_scope_explicit() errors compiler::CompilerError:
        static compile:
            x = 1
            fn f(r):
                tmp = r
                x = tmp.a
                x
            [f({a: 5}), x]
    test::value("destructure-same-name-in-inner-scope/explicit", [5, 1], inner_scope_explicit)

    # destructure-shadowing-reference-before: a reference before a shadowing
    # destructure still sees the outer binding.
    fn reference_before() errors compiler::CompilerError:
        static compile:
            x = 1
            fn f(r):
                before = x
                {a: x} = r
                [before, x]
            f({a: 5})
    test::value("destructure-shadowing-reference-before/destructured", [1, 5], reference_before)

    fn reference_before_explicit() errors compiler::CompilerError:
        static compile:
            x = 1
            fn f(r):
                before = x
                tmp = r
                x = tmp.a
                [before, x]
            f({a: 5})
    test::value("destructure-shadowing-reference-before/explicit", [1, 5], reference_before_explicit)

# ---------------------------------------------------------------------------
# Scopes: a branch inside a loop body inside a function

fn register_scope_tests():
    # destructure-scope-in-nested-in-loop-in-fn: in a branch inside a loop
    # body inside a function.
    fn in_nested_in_loop() errors compiler::CompilerError:
        static compile:
            fn run(rows):
                total = 0
                r = loop row in rows:
                    {n} = row
                    if n > 1:
                        {m} = row
                        m
                    else:
                        0
                r
            run([{n: 1, m: 10}, {n: 2, m: 20}])
    test::value("destructure-scope-in-nested-in-loop-in-fn/destructured", [0, 20], in_nested_in_loop)

    fn in_nested_in_loop_explicit() errors compiler::CompilerError:
        static compile:
            fn run(rows):
                total = 0
                r = loop row in rows:
                    t = row
                    n = t.n
                    if n > 1:
                        t2 = row
                        m = t2.m
                        m
                    else:
                        0
                r
            run([{n: 1, m: 10}, {n: 2, m: 20}])
    test::value("destructure-scope-in-nested-in-loop-in-fn/explicit", [0, 20], in_nested_in_loop_explicit)

# ---------------------------------------------------------------------------
# Closures capture destructured bindings as ordinary bindings

fn register_capture_tests():
    # destructure-capture-short: shorthand bindings captured by a closure.
    fn capture_short() errors compiler::CompilerError:
        static compile:
            fn make(r):
                {n, step} = r
                fn next(x):
                    x + n * step
                next
            make({n: 3, step: 10})(1)
    test::value("destructure-capture-short/destructured", 31, capture_short)

    fn capture_short_explicit() errors compiler::CompilerError:
        static compile:
            fn make(r):
                t = r
                n = t.n
                step = t.step
                fn next(x):
                    x + n * step
                next
            make({n: 3, step: 10})(1)
    test::value("destructure-capture-short/explicit", 31, capture_short_explicit)

    # destructure-capture-renamed: renamed bindings captured.
    fn capture_renamed() errors compiler::CompilerError:
        static compile:
            fn make(r):
                {n: count, step: by} = r
                fn next(x):
                    x + count * by
                next
            make({n: 3, step: 10})(1)
    test::value("destructure-capture-renamed/destructured", 31, capture_renamed)

    fn capture_renamed_explicit() errors compiler::CompilerError:
        static compile:
            fn make(r):
                t = r
                count = t.n
                by = t.step
                fn next(x):
                    x + count * by
                next
            make({n: 3, step: 10})(1)
    test::value("destructure-capture-renamed/explicit", 31, capture_renamed_explicit)

    # destructure-capture-in-list: a destructured binding passed on to calls.
    fn capture_in_list() errors compiler::CompilerError:
        static compile:
            fn fn_a(n):
                n
            fn fn_b(n):
                n + 1
            fn run(r):
                {n} = r
                fs = [fn_a(n), fn_b(n)]
                fs
            run({n: 4})
    test::value("destructure-capture-in-list/destructured", [4, 5], capture_in_list)

    fn capture_in_list_explicit() errors compiler::CompilerError:
        static compile:
            fn fn_a(n):
                n
            fn fn_b(n):
                n + 1
            fn run(r):
                t = r
                n = t.n
                fs = [fn_a(n), fn_b(n)]
                fs
            run({n: 4})
    test::value("destructure-capture-in-list/explicit", [4, 5], capture_in_list_explicit)

    # destructure-capture-two-closures: two closures capturing one binding.
    fn two_closures() errors compiler::CompilerError:
        static compile:
            fn make(r):
                {n} = r
                fn get():
                    n
                fn bump(k):
                    n + k
                [get, bump]
            fs = make({n: 7})
            [list::at(fs, 0)(), list::at(fs, 1)(1)]
    test::value("destructure-capture-two-closures/destructured", [7, 8], two_closures)

    fn two_closures_explicit() errors compiler::CompilerError:
        static compile:
            fn make(r):
                t = r
                n = t.n
                fn get():
                    n
                fn bump(k):
                    n + k
                [get, bump]
            fs = make({n: 7})
            [list::at(fs, 0)(), list::at(fs, 1)(1)]
    test::value("destructure-capture-two-closures/explicit", [7, 8], two_closures_explicit)

    # destructure-capture-nested: leaves of a nested pattern captured.
    fn capture_nested() errors compiler::CompilerError:
        static compile:
            fn make(r):
                {u: {a, b}} = r
                fn f():
                    a * b
                f
            make({u: {a: 6, b: 7}})()
    test::value("destructure-capture-nested/destructured", 42, capture_nested)

    fn capture_nested_explicit() errors compiler::CompilerError:
        static compile:
            fn make(r):
                t = r
                t2 = t.u
                a = t2.a
                b = t2.b
                fn f():
                    a * b
                f
            make({u: {a: 6, b: 7}})()
    test::value("destructure-capture-nested/explicit", 42, capture_nested_explicit)

# ---------------------------------------------------------------------------
# Destructures in elif chains

fn register_elif_tests():
    # destructure-elif-chains: destructures in every clause of an elif chain.
    fn elif_chains() errors compiler::CompilerError:
        static compile:
            fn pick(k, r):
                if k == 0:
                    {a} = r
                    a
                elif k == 1:
                    {b: a} = r
                    a
                else:
                    {a, b} = r
                    a + b
            [pick(0, {a: 1, b: 2}), pick(1, {a: 1, b: 2}), pick(2, {a: 1, b: 2})]
    test::value("destructure-elif-chains/destructured", [1, 2, 3], elif_chains)

    fn elif_chains_explicit() errors compiler::CompilerError:
        static compile:
            fn pick(k, r):
                if k == 0:
                    t = r
                    a = t.a
                    a
                elif k == 1:
                    t = r
                    a = t.b
                    a
                else:
                    t = r
                    a = t.a
                    b = t.b
                    a + b
            [pick(0, {a: 1, b: 2}), pick(1, {a: 1, b: 2}), pick(2, {a: 1, b: 2})]
    test::value("destructure-elif-chains/explicit", [1, 2, 3], elif_chains_explicit)

    # destructure-elif-condition-uses-bindings: a destructured binding in the
    # conditions of an elif chain.
    fn elif_conditions() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {n} = r
                if n == 0:
                    10
                elif n == 1:
                    20
                else:
                    30
            [f({n: 0}), f({n: 1}), f({n: 5})]
    test::value("destructure-elif-condition-uses-bindings/destructured", [10, 20, 30], elif_conditions)

    fn elif_conditions_explicit() errors compiler::CompilerError:
        static compile:
            fn f(r):
                t = r
                n = t.n
                if n == 0:
                    10
                elif n == 1:
                    20
                else:
                    30
            [f({n: 0}), f({n: 1}), f({n: 5})]
    test::value("destructure-elif-condition-uses-bindings/explicit", [10, 20, 30], elif_conditions_explicit)

# ---------------------------------------------------------------------------
# The statement's value is unit (the "explicit" spelling is the expansion
# ending in `unit`)

fn register_unit_value_tests():
    # destructure-value-field-order-irrelevant: {a, b} and {b, a} read and
    # bind in different orders but have the same statement value.
    fn order_ab() errors compiler::CompilerError:
        static compile:
            fn f(v):
                {a, b} = v
            f({a: 1, b: 2})
    test::value("destructure-value-field-order-irrelevant/ab", unit, order_ab)

    fn order_ba() errors compiler::CompilerError:
        static compile:
            fn g(v):
                {b, a} = v
            g({a: 1, b: 2})
    test::value("destructure-value-field-order-irrelevant/ba", unit, order_ba)

    fn order_both() errors compiler::CompilerError:
        static compile:
            fn f(v):
                {a, b} = v
            fn g(v):
                {b, a} = v
            [f({a: 1, b: 2}), g({a: 1, b: 2})]
    test::value("destructure-value-field-order-irrelevant/both", [unit, unit], order_both)

    # destructure-value-nested: a nested destructure is one statement: unit,
    # not id, expires, user or the nested struct, whatever its order.
    fn nested_last() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {user: {name, id}, expires} = r
            f({user: {name: "ada", id: 7, admin: true}, expires: 99})
    test::value("destructure-value-nested/destructured", unit, nested_last)

    fn nested_last_explicit() errors compiler::CompilerError:
        static compile:
            fn f(r):
                tmp = r
                tmp2 = tmp.user
                name = tmp2.name
                id = tmp2.id
                expires = tmp.expires
                unit
            f({user: {name: "ada", id: 7, admin: true}, expires: 99})
    test::value("destructure-value-nested/explicit", unit, nested_last_explicit)

    fn nested_bound() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {user: {name, id}, expires} = r
                [name, id, expires]
            f({user: {name: "ada", id: 7, admin: true}, expires: 99})
    test::value("destructure-value-nested/bound", ["ada", 7, 99], nested_bound)

    fn nested_reordered() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {expires, user: {id, name}} = r
            f({user: {name: "ada", id: 7, admin: true}, expires: 99})
    test::value("destructure-value-nested/reordered", unit, nested_reordered)

    fn nested_partial() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {user: {name}} = r
            f({user: {name: "ada", id: 7, admin: true}, expires: 99})
    test::value("destructure-value-nested/partial", unit, nested_partial)

    # destructure-value-bindings-still-work: statements after a destructure
    # see its bindings; the unit does not disturb them.
    fn still_work() errors compiler::CompilerError:
        static compile:
            fn f(v):
                {a, b} = v
                a + b
            f({a: 1, b: 2})
    test::value("destructure-value-bindings-still-work/destructured", 3, still_work)

    fn still_work_explicit() errors compiler::CompilerError:
        static compile:
            fn f(v):
                tmp = v
                a = tmp.a
                b = tmp.b
                unit
                a + b
            f({a: 1, b: 2})
    test::value("destructure-value-bindings-still-work/explicit", 3, still_work_explicit)

    # destructure-value-ordinary-binding-unchanged: an ordinary binding ending
    # a body still yields its value: unit is the destructure's alone. Here
    # the bindings of a projection from an untyped parameter (/plain, a
    # constant, is in destructuring.bot).
    fn projection_binding() errors compiler::CompilerError:
        static compile:
            fn f(v):
                a = v.a
            f({a: 1, b: 2})
    test::value("destructure-value-ordinary-binding-unchanged/projection", 1, projection_binding)

    fn hoisted_binding() errors compiler::CompilerError:
        static compile:
            fn f(v):
                t = v
                b = t.b
            f({a: 1, b: 2})
    test::value("destructure-value-ordinary-binding-unchanged/hoisted", 2, hoisted_binding)

    # destructure-value-not-source-narrowing-or-remainder: the value is not
    # the source, a narrowed struct, the omitted fields or a List of the
    # bound values: for every pattern it is unit.
    fn pattern_ab() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {a, b} = r
            f({a: 1, b: 2, c: 3})
    test::value("destructure-value-not-source-narrowing-or-remainder/ab", unit, pattern_ab)

    fn pattern_ba() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {b, a} = r
            f({a: 1, b: 2, c: 3})
    test::value("destructure-value-not-source-narrowing-or-remainder/ba", unit, pattern_ba)

    fn pattern_a() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {a} = r
            f({a: 1, b: 2, c: 3})
    test::value("destructure-value-not-source-narrowing-or-remainder/a", unit, pattern_a)

    fn pattern_abc() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {a, b, c} = r
            f({a: 1, b: 2, c: 3})
    test::value("destructure-value-not-source-narrowing-or-remainder/abc", unit, pattern_abc)

    fn pattern_renamed() errors compiler::CompilerError:
        static compile:
            fn f(r):
                {c: z} = r
            f({a: 1, b: 2, c: 3})
    test::value("destructure-value-not-source-narrowing-or-remainder/renamed", unit, pattern_renamed)

# ---------------------------------------------------------------------------
# Branches and loops: no destructuring-specific rule; the ordinary join and
# collection see unit

fn register_unit_branch_and_loop_tests():
    # destructure-value-branch: a branch ending in a destructure produces
    # unit and joins with the other branches by the ordinary rules.
    fn else_unit() errors compiler::CompilerError:
        static compile:
            fn run(c, v):
                if c:
                    {a} = v
                else:
                    unit
            [run(true, {a: 1}), run(false, {a: 1})]
    test::value("destructure-value-branch/else-unit", [unit, unit], else_unit)

    fn both_branches() errors compiler::CompilerError:
        static compile:
            fn run(c, v):
                r = if c:
                    {a} = v
                else:
                    {b} = v
                r
            [run(true, {a: 1, b: 2}), run(false, {a: 1, b: 2})]
    test::value("destructure-value-branch/both-branches", [unit, unit], both_branches)

    fn else_int() errors compiler::CompilerError:
        static compile:
            fn run(c, v):
                if c:
                    {a} = v
                else:
                    7
            [run(true, {a: 1}), run(false, {a: 1})]
    test::value("destructure-value-branch/else-int", [unit, 7], else_int)

    fn elif_branches() errors compiler::CompilerError:
        static compile:
            fn run(k, v):
                if k == 0:
                    {a} = v
                elif k == 1:
                    {b: a} = v
                else:
                    unit
            [run(0, {a: 1, b: 2}), run(1, {a: 1, b: 2}), run(2, {a: 1, b: 2})]
    test::value("destructure-value-branch/elif", [unit, unit, unit], elif_branches)

    # destructure-value-branch-type-join: a destructure in one branch and an
    # Int in the other do not join to an Int: the ordinary join sees unit.
    fn type_join() errors compiler::CompilerError:
        static compile:
            fn run(c, v):
                r = if c:
                    {a} = v
                else:
                    7
                r
            run(false, {a: 1})
    test::value("destructure-value-branch-type-join/destructured", 7, type_join)

    fn type_join_explicit() errors compiler::CompilerError:
        static compile:
            fn run(c, v):
                r = if c:
                    t = v
                    a = t.a
                    unit
                else:
                    7
                r
            run(false, {a: 1})
    test::value("destructure-value-branch-type-join/explicit", 7, type_join_explicit)

    # destructure-value-collecting-loop: a collecting loop whose body ends in
    # a destructure collects unit for each normal iteration. Here the loops
    # over an untyped parameter's elements (/counted and /lockstep, over
    # literals, are in destructuring.bot).
    fn loop_in() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
            run([{a: 1}, {a: 2}, {a: 3}])
    test::value("destructure-value-collecting-loop/in", [unit, unit, unit], loop_in)

    fn loop_two_fields() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a, b} = x
            run([{a: 1, b: 5}, {a: 2, b: 6}])
    test::value("destructure-value-collecting-loop/two-fields", [unit, unit], loop_two_fields)

    fn loop_empty() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
            run([])
    test::value("destructure-value-collecting-loop/empty", [], loop_empty)

    # destructure-value-loop-old-collection-gone: the expansion without the
    # unit collected each element's last field; the destructure collects
    # unit.
    fn old_collection() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    tmp = x
                    a = tmp.a
            run([{a: 1}, {a: 2}])
    test::value("destructure-value-loop-old-collection-gone/old-expansion", [1, 2], old_collection)

    fn new_collection() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
            run([{a: 1}, {a: 2}])
    test::value("destructure-value-loop-old-collection-gone/destructure", [unit, unit], new_collection)

    # destructure-value-continue: continue and break after a destructure run
    # normally: the unit is never collected before the later statements.
    fn continue_after() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
                    if a == 2:
                        continue
                    a
            run([{a: 1}, {a: 2}, {a: 3}])
    test::value("destructure-value-continue/destructured", [1, 3], continue_after)

    fn continue_after_explicit() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    t = x
                    a = t.a
                    unit
                    if a == 2:
                        continue
                    a
            run([{a: 1}, {a: 2}, {a: 3}])
    test::value("destructure-value-continue/explicit", [1, 3], continue_after_explicit)

    fn continue_then_destructure() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
                    if a == 2:
                        continue
                    {b} = x
            run([{a: 1, b: 9}, {a: 2, b: 8}, {a: 3, b: 7}])
    test::value("destructure-value-continue/destructure-last", [unit, unit], continue_then_destructure)

    fn break_after() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {a} = x
                    if a == 2:
                        break
                    a
            run([{a: 1}, {a: 2}, {a: 3}])
    test::value("destructure-value-continue/break", [1], break_after)

    # destructure-value-loop-body-nested: a destructure ending a branch inside
    # a loop body is the iteration's value when that branch is taken.
    fn loop_body_nested() errors compiler::CompilerError:
        static compile:
            fn run(xs):
                loop x in xs:
                    {n} = x
                    if n > 1:
                        {m} = x
                    else:
                        0
            run([{n: 1, m: 10}, {n: 2, m: 20}])
    test::value("destructure-value-loop-body-nested", [0, unit], loop_body_nested)

# ---------------------------------------------------------------------------

with context test::suite()
register_statement_value_tests()
register_shadowing_tests()
register_scope_tests()
register_capture_tests()
register_elif_tests()
register_unit_value_tests()
register_unit_branch_and_loop_tests()
test::report()
