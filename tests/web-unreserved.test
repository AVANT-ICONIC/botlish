# web-unreserved.test -- std::web::is_unreserved (stdlib/web.bot): RFC 3986
# URI-unreserved classification, rewritten as ASCII structure (stdlib/ascii.
# bot's std::ascii::is_alphanumeric) OR a retained URI-owned punctuation set
# (additional_unreserved_chars = std::byte::set(['-', '.', '_', '~'])). See
# ASCII-AND-URI-UNRESERVED.md.
#
# Before this milestone, is_unreserved was a private function nested
# inside uri_escape_text (stdlib/web.bot), a single ascending-threshold
# ladder (see e.g. BYTE-NIBBLE-BIT-ARITHMETIC.md, NATIVE-URI-ESCAPE.md) --
# never independently callable, so there was no dedicated test file for
# it on its own. It is now a top-level std::web::is_unreserved(b: Byte) ->
# bool, exactly like std::byte::set got its own byte-set.test; this file is
# its equivalent. tests/native-uri-escape.test's own existing tests (the
# actual URI/string consumer workload: uri_escape_text/uriEscape's text
# output, byte for byte) are deliberately left untouched -- rerunning them
# unmodified, as part of the full suite, is this milestone's "existing
# workload regression" check (spec item 47).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]

interp recursionlimit {} 100000

set parityBackends {interp compile cranelift-generic cranelift}

proc moduleParity {path} {
    set hir [surface::readProgramFile $path -strict 0]
    set exprs [hir::lower $hir]
    set outcomes [lmap backend $::parityBackends {outcomeUnder $backend $exprs}]
    if {[llength [lsort -unique $outcomes]] == 1} {
        return same
    }
    return [join [lmap backend $::parityBackends outcome $outcomes {list $backend $outcome}] " / "]
}

proc moduleValue {path} {
    set hir [surface::readProgramFile $path -strict 0]
    lindex [outcomeUnder interp [hir::lower $hir]] 1
}

# The item-17/19 reference definition of URI-unreserved: A-Za-z0-9._~-,
# nothing else -- an independent host-side model, not a second production
# implementation (spec item 51), used only to check std::web::is_unreserved
# against, never as itself a thing under test.
proc referenceUnreserved {b} {
    return [expr {
        ($b >= 48 && $b <= 57) || ($b >= 65 && $b <= 90) || ($b >= 97 && $b <= 122)
        || $b == 45 || $b == 46 || $b == 95 || $b == 126
    }]
}

# ---------------------------------------------------------------------------
# Acceptance table (spec items 20, 78): the four punctuation members, the
# alphanumeric class, and immediately adjacent/nonmember punctuation and
# high-bit bytes.

test web-unreserved-acceptance-table {std::web::is_unreserved's item-78/20 acceptance table} -body {
    set path [makeFile {import std::web
[
    std::web::is_unreserved(45), std::web::is_unreserved(46),
    std::web::is_unreserved(95), std::web::is_unreserved(126),
    std::web::is_unreserved(44), std::web::is_unreserved(47),
    std::web::is_unreserved(58), std::web::is_unreserved(64),
    std::web::is_unreserved(91), std::web::is_unreserved(96),
    std::web::is_unreserved(123), std::web::is_unreserved(127),
    std::web::is_unreserved(128), std::web::is_unreserved(255),
    std::web::is_unreserved(65), std::web::is_unreserved(97), std::web::is_unreserved(48)
]} web-unreserved-table.bot]
    try {
        list [moduleParity $path] [moduleValue $path]
    } finally {
        removeFile web-unreserved-table.bot
    }
} -result {same {[true, true, true, true, false, false, false, false, false, false, false, false, false, false, true, true, true]}}

# ---------------------------------------------------------------------------
# Byte contract (spec items 21, 36): a plain out-of-range/unproven Int, a
# UnicodeChar, or a str are all static type errors -- never a coercion.

test web-unreserved-rejects-unicode-char {std::web::is_unreserved('-') (UnicodeChar) is a static type error -- no UnicodeChar/Byte equality shortcut} -body {
    set path [makeFile {import std::web
std::web::is_unreserved('-')} web-unreserved-reject-char.bot]
    try {
        catch {surface::readProgramFile $path -strict 1} err options
        dict get $options -errorcode
    } finally {
        removeFile web-unreserved-reject-char.bot
    }
} -result {CORE SEMANTIC TYPE}

test web-unreserved-rejects-unproven-int {std::web::is_unreserved(std::char::scalar_value('-')) is a static type error -- the value (45) is right, but carries no static Byte proof} -body {
    set path [makeFile {import std::char
import std::web
std::web::is_unreserved(std::char::scalar_value('-'))} web-unreserved-reject-int.bot]
    try {
        catch {surface::readProgramFile $path -strict 1} err options
        dict get $options -errorcode
    } finally {
        removeFile web-unreserved-reject-int.bot
    }
} -result {CORE SEMANTIC TYPE}

test web-unreserved-result-type {std::web::is_unreserved(...) has static result type bool} -body {
    set path [makeFile {import std::web
std::web::is_unreserved(65)} web-unreserved-restype.bot]
    try {
        set hir [surface::readProgramFile $path -strict 0]
        set e [lindex [dict get $hir roots] end]
        hir::types::show [hir::typeOf $hir $e]
    } finally {
        removeFile web-unreserved-restype.bot
    }
} -result bool

# ---------------------------------------------------------------------------
# Exhaustive 0..255 equivalence (spec items 18, 54), exact cardinality 66
# (spec item 19), and the item-54 compositional identity
# (std::web::is_unreserved(b) == std::ascii::is_alphanumeric(b) or b in the
# punctuation set) -- all in one pass over the full domain.

test web-unreserved-exhaustive {std::web::is_unreserved matches the reference definition over all 256 Byte values; cardinality exactly 66; equals std::ascii::is_alphanumeric(b) or membership in the punctuation set, everywhere} -body {
    set nums [lseq 0 255]
    set src "import std::ascii\nimport std::byte\nimport std::immutable_set\nimport std::web\n\nns = \[[join $nums {, }]\]\nloop n in ns:\n    b = std::byte::from_int(n):\n        on std::byte::BelowRange:\n            0\n        on std::byte::AboveRange:\n            0\n    \[std::web::is_unreserved(b), std::ascii::is_alphanumeric(b), std::immutable_set::contains(std::web::additional_unreserved_chars, b)\]"
    set path [makeFile $src web-unreserved-exhaustive.bot]
    try {
        set hir [surface::readProgramFile $path -strict 0]
        set shown [lindex [outcomeUnder interp [hir::lower $hir]] 1]
        set rows [regexp -all -inline {\[[^\[\]]*\]} $shown]
        set mismatches 0
        set identityMismatches 0
        set trueCount 0
        for {set b 0} {$b < 256} {incr b} {
            set inner [string range [lindex $rows $b] 1 end-1]
            lassign [lsearch -all -inline -not -exact [split $inner ", "] ""] got alnum member
            set ref [referenceUnreserved $b]
            set refWord [expr {$ref ? "true" : "false"}]
            if {$got ne $refWord} { incr mismatches }
            set composed [expr {$alnum eq "true" || $member eq "true"}]
            set composedWord [expr {$composed ? "true" : "false"}]
            if {$got ne $composedWord} { incr identityMismatches }
            if {$got eq "true"} { incr trueCount }
        }
        list $mismatches $identityMismatches $trueCount
    } finally {
        removeFile web-unreserved-exhaustive.bot
    }
} -result {0 0 66}

# ---------------------------------------------------------------------------
# Backend parity (spec item 38): all four backends agree over the whole
# domain, in one pass.

test web-unreserved-backend-parity-256 {std::web::is_unreserved agrees across interp/compile/cranelift-generic/cranelift over the entire 0..255 domain} -body {
    set nums [lseq 0 255]
    set src "import std::byte\nimport std::web\n\nns = \[[join $nums {, }]\]\nloop n in ns:\n    b = std::byte::from_int(n):\n        on std::byte::BelowRange:\n            0\n        on std::byte::AboveRange:\n            0\n    std::web::is_unreserved(b)"
    set path [makeFile $src web-unreserved-parity256.bot]
    try {
        moduleParity $path
    } finally {
        removeFile web-unreserved-parity256.bot
    }
} -result same

# ---------------------------------------------------------------------------
# C2 (COMPREHENSIVE-GENERATED-CODE-AUDIT.md sec. C2;
# M0-MODULE-CLOSURE-AND-URI-BASELINE.md): the exact real-world reproduction.
# Every std::web::is_unreserved call above is either at program top level or
# inside a top-level `loop` body -- neither creates a new hir::aot region
# (a loop body shares its enclosing invocation's region), so none of them
# ever exercised the bug: an ordinary *user function* referencing
# std::web::is_unreserved, which is itself a closure over the retained
# additional_unreserved_chars. Before the fix, native lowering raised
# "NATIVE BUG: binding ... is not reachable" here; interp was always
# correct. tests/surface-modules.test has the generic (web-independent)
# fixture and the capture-set/structural inspection; this is the one
# concrete case the milestone names.

test web-unreserved-user-fn-wraps-module-closure {fn f(b: Byte) -> bool: std::web::is_unreserved(b) -- f(45) -- agrees on every backend (was a native-only crash)} -body {
    set path [makeFile "import std::web\nimport type std::byte::Byte\nfn f(b: Byte) -> bool:\n    std::web::is_unreserved(b)\n\nf(45)\n" web-unreserved-user-fn-wrap.bot]
    try {
        list [moduleParity $path] [moduleValue $path]
    } finally {
        removeFile web-unreserved-user-fn-wrap.bot
    }
} -result {same true}

# ---------------------------------------------------------------------------
# Module retention (spec items 22-23, 39-42, 56-57): the four-byte
# punctuation set is built exactly once, at module initialization, and
# reused by every later std::web::is_unreserved call -- never reconstructed,
# never iterated, checked only by membership/cardinality (never display
# order, spec item 56).

# R2.a.1 (R2A1-MODULE-FN-BRIDGE-REACHABILITY.md) retains web.bot's second
# module set, local_extra_chars (web.bot's own std::immutable_set::from_list), at
# module scope again, so loading web now initializes two retained sets --
# each exactly once: additional_unreserved_chars through std::byte::set's own
# terminal setfromlist (byte.bot), local_extra_chars directly (web.bot).
test web-unreserved-set-built-once {additional_unreserved_chars (byte.bot's std::byte::set site) and web.bot's own local_extra_chars are each constructed exactly once, regardless of how many std::web::is_unreserved calls follow} -body {
    set path [makeFile {import std::web
[std::web::is_unreserved(45), std::web::is_unreserved(46), std::web::is_unreserved(95),
std::web::is_unreserved(126), std::web::is_unreserved(65), std::web::is_unreserved(128)]} web-unreserved-once.bot]
    try {
        set hir [surface::readProgramFile $path -strict 0]
        native::lower::program $hir -repr-opt 0
        set report [native::allocationReport $hir sites]
        set setfromlistSites {}
        foreach site [dict get $report sites] {
            # M4-EQUALITY-TOTAL-SETFROMLIST-EFFECT.md:
            # additional_unreserved_chars's own List[Byte] source is
            # statically proven equality-total, so this site now carries
            # the refined opcode's own operation label -- same
            # rt_set_from_list helper, same allocation, only the site name
            # differs.
            if {[dict get $site operation] in {setfromlist setfromlisttotal}} {
                lappend setfromlistSites [list [file tail [dict get $site location file]] \
                    [dict get $site allocations]]
            }
        }
        lsort $setfromlistSites
    } finally {
        removeFile web-unreserved-once.bot
    }
} -result {{byte.bot 1} {web.bot 1}}

test web-unreserved-set-exact-members {additional_unreserved_chars contains exactly the four bytes 45/46/95/126, and no others among nearby candidates} -body {
    set path [makeFile {import std::immutable_set
import std::web
[
    std::immutable_set::contains(std::web::additional_unreserved_chars, 45),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 46),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 95),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 126),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 44),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 47),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 94),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 96),
    std::immutable_set::contains(std::web::additional_unreserved_chars, 65)
]} web-unreserved-members.bot]
    try {
        list [moduleParity $path] [moduleValue $path]
    } finally {
        removeFile web-unreserved-members.bot
    }
} -result {same {[true, true, true, true, false, false, false, false, false]}}

# ---------------------------------------------------------------------------
# Allocation (spec items 41, 58): a std::web::is_unreserved call, after module
# init, allocates nothing of its own (the module-scope hex_digits list,
# the additional_unreserved_chars set, and the two module functions' own
# closures are one-time program-init costs -- see the report's "Generated-
# code baseline for module set"; they do not grow with call count).

test web-unreserved-allocations-dont-grow-with-call-count {total allocations are the same one-time module-init cost whether std::web::is_unreserved is called once or four times} -body {
    set path1 [makeFile {import std::web
std::web::is_unreserved(55)} web-unreserved-alloc1.bot]
    set path4 [makeFile {import std::web
[std::web::is_unreserved(55), std::web::is_unreserved(56), std::web::is_unreserved(57), std::web::is_unreserved(58)]} web-unreserved-alloc4.bot]
    try {
        set hir1 [surface::readProgramFile $path1 -strict 0]
        native::lower::program $hir1 -repr-opt 0
        set total1 [dict get [native::allocationReport $hir1 summary] total allocations]
        set hir4 [surface::readProgramFile $path4 -strict 0]
        native::lower::program $hir4 -repr-opt 0
        set total4 [dict get [native::allocationReport $hir4 summary] total allocations]
        # path4's own outer 4-element list literal is the only difference:
        # one extra `listnew` allocation, nothing from is_unreserved itself.
        expr {$total4 - $total1}
    } finally {
        removeFile web-unreserved-alloc1.bot
        removeFile web-unreserved-alloc4.bot
    }
} -result 1

# ---------------------------------------------------------------------------
# Short-circuit evaluation (spec items 59-60): is_unreserved's "or" is
# ordinary short-circuit Boolean evaluation -- the set-membership operand
# is never evaluated once std::ascii::is_alphanumeric(b) is already true. Uses
# this project's own test-log probe (tests/helpers.tcl) in is_unreserved's
# exact two-operand shape, since is_digit/is_alphanumeric/
# std::immutable_set::contains have no observable side effect of their own to
# probe directly.

# "or" has no dedicated IR form of its own: hir::lower desugars it
# directly to "if" (surface/lower.tcl) -- `std::ascii::is_alphanumeric(b) or
# std::immutable_set::contains(...)` is exactly `if std::ascii::is_alphanumeric(b)
# {true} else {std::immutable_set::contains(...)}`, confirmed below by lowering
# `std::ascii::is_alphanumeric(65)` itself and inspecting its own body's
# IR shape. Laziness is therefore inherited from "if"'s own evaluator
# (core::forms::op-if: it only ever descends into the taken branch),
# never a property "or" could accidentally lose on its own -- the same
# guarantee 11-boolean-operators.bot's example and control.test's own
# lazy-branch tests already pin for every "if"/"and"/"or" in this
# language. This test confirms is_unreserved's own exact shape inherits
# it too: appending a raw-IR probe (tests/helpers.tcl's test-log native,
# reachable only from raw core IR -- ordinary ".bot" identifiers cannot
# spell its hyphen) in is_unreserved's own right-operand position, spliced
# onto the real compiled ascii:: bindings hir::lower already produced.
test web-unreserved-is-alphanumeric-lowers-to-if {std::ascii::is_alphanumeric(b) or SIDE-EFFECT lowers to an "if" whose else-branch (only) is SIDE-EFFECT} -body {
    set path [makeFile {import std::ascii
std::ascii::is_alphanumeric(65)} web-unreserved-ir-shape.bot]
    try {
        set hir [surface::readProgramFile $path -strict 0]
        set exprs [hir::lower $hir]
        set last [lindex $exprs end-1]
        expr {[lindex $last 0] eq "bind" && [lindex $last 1] eq "std::ascii::is_alphanumeric"
            && [lindex [lindex $last 2] 0] eq "block"
            && [lindex [lindex [lindex $last 2] 2] 0] eq "if"}
    } finally {
        removeFile web-unreserved-ir-shape.bot
    }
} -result 1

test web-unreserved-or-short-circuits {an "or" shaped exactly like is_unreserved's own never evaluates its right operand once the left is already true} -body {
    resetEffects
    set path [makeFile {import std::ascii
std::ascii::is_alphanumeric(65)} web-unreserved-shortcircuit.bot]
    try {
        set hir [surface::readProgramFile $path -strict 0]
        set binds [lrange [hir::lower $hir] 0 end-1]
        set trueByte {const 65}
        set nonMemberByte {const 45}
        set probe {block {} {call {ref test-log} {const 999}}}
        set trueProgram [concat $binds [list [list if [list call {ref std::ascii::is_alphanumeric} $trueByte] {block {} {ref true}} $probe]]]
        set nonMemberProgram [concat $binds [list [list if [list call {ref std::ascii::is_alphanumeric} $nonMemberByte] {block {} {ref true}} $probe]]]
        resetEffects
        set v1 [core::value::show [core::evalProgram $trueProgram]]
        set log1 $::testLog
        resetEffects
        set v2 [core::value::show [core::evalProgram $nonMemberProgram]]
        set log2 $::testLog
        list $v1 $log1 $v2 $log2
    } finally {
        removeFile web-unreserved-shortcircuit.bot
    }
} -result {true {} 999 999}

::tcltest::cleanupTests
