# ---------------------------------------------------------------------------
# The C ABI

# Plain char's range on this host's target: unsigned on Linux AArch64 only
# (signed on x86-64, and on Apple AArch64, whose C ABI is not Linux's).
set cfCharRange [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {aarch64 arm64} ? {0 255} : {-128 127}}]

