    appValues [bcfApp "import ffi::c\nimport bcf\n\nbcf::nothing()\n"] {cranelift}
} -cleanup removeApps -result unit

test cf-pointers {raw pointers cross as raw machine addresses: null both ways (ffi::c::null[T]() into C, a NULL from C), a C address round-trips with its identity (C compares the two), no borrowing involved} -constraints cfFixture -body {
    appValues [bcfApp "import ffi::c\nimport bcf\n\np = bcf::address()\nq = bcf::echo_ptr(p)\nn = bcf::null()\nz = ffi::c::null\[ffi::c::Void\]()\n\[bcf::same(p, q), p.null?(), n.null?(), bcf::is_null(z), bcf::is_null(p), bcf::is_null(n)\]\n"] {cranelift cranelift-generic}
} -cleanup removeApps -result {{[1, false, true, 1, 0, 1]} {[1, false, true, 1, 0, 1]}}

test cf-function-pointers {a C function pointer is an ABI value: C returns one and takes it back, and calls it itself (Botlish never calls one)} -constraints cfFixture -body {
    appValues [bcfApp "import ffi::c\nimport bcf\n\nf = bcf::callback_twice()\nbcf::apply(f, 21)\n"] {cranelift}
} -cleanup removeApps -result 42

test cf-nir {the call lowers to one foreigncall of the program's foreign table -- symbol, ABI classes, alias -- after the argument evaluation and exposures, with the keepalives after it; the link plan in the header} -constraints cfFixture -body {
    set nir [appNir [bcfApp "${::bytesPrelude}src = text(\"hello\")\nr = bcf::reverse(src, len(src), abi::bytes::zeroed(abi::usize(5)))\nbcf::add(1, 2)\n"]]
    set lines [split $nir \n]
    set call [lsearch -regexp $lines {foreigncall}]
    list [lsearch -all -inline -regexp $lines {^(link|foreign) }] \
        [lindex [regexp -inline {op mbytesclone} [lindex $lines [expr {$call - 3}]]] 0] \
        [lindex [regexp -inline {op bytesaddr} [lindex $lines [expr {$call - 2}]]] 0] \
        [lindex [regexp -inline {op mbytesaddr} [lindex $lines [expr {$call - 1}]]] 0] \
        [lindex [regexp -inline {op keepalive} [lindex $lines [expr {$call + 1}]]] 0] \
        [lindex [regexp -inline {op keepalive} [lindex $lines [expr {$call + 2}]]] 0]
} -cleanup removeApps -result {{{link "botlish_cffi_fixture"} {foreign 0 "bcf_reverse" params="ptr u64 ptr" result=ptr alias=2 name="bcf::reverse"} {foreign 1 "bcf_add" params="i32 i32" result=i32 name="bcf::add"}} {op mbytesclone} {op bytesaddr} {op mbytesaddr} {op keepalive} {op keepalive}}

test cf-clif {natively the call is one direct call of the imported symbol with the platform C signature -- narrow parameters extended by their class, the result at its width -- no helper, no lookup, no Tcl} -constraints {cfFixture} -body {
    set hir [appHir [bcfApp "import ffi::c\nimport bcf\n\nfn f(x: ffi::c::UChar, y: ffi::c::Short) -> int:\n    bcf::widen_uchar(x) + bcf::widen_short(y)\n\nf(1, 2)\n"]]
    set clif [native::clif $hir]
    regexp {; u0:(\d+) = bcf_widen_uchar \(C bcf::widen_uchar\)} $clif -> id
    regexp "fn(\\d+) = u0:$id (sig\\d+)" $clif -> fn sig
    list [regexp "$sig = \\(i8 uext\\) -> i64 system_v" $clif] [regexp {sig\d+ = \(i16 sext\) -> i64 system_v} $clif] \
        [regexp "= call fn$fn\\(v\\d+\\)" $clif]
} -cleanup removeApps -result {1 1 1}

# ---------------------------------------------------------------------------
# Backends

test cf-tcl-backends {the Tcl backends have no machine to call C on: a C call is NATIVE-ONLY at run time (after its exposures were modeled), and a program that declares but does not call one runs on all four backends} -constraints cfFixture -body {
    set calls [bcfApp "import ffi::c\nimport bcf\n\nbcf::add(1, 2)\n"]
    set declares [bcfApp "import ffi::c\nimport bcf\n\n1 + 1\n"]
    list [lmap backend {interp compile} {lindex [appCode $calls $backend] end}] [appValues $declares {interp compile cranelift-generic cranelift}]
} -cleanup removeApps -result {{NATIVE-ONLY NATIVE-ONLY} {2 2 2 2}}

test cf-strict0-replay {an unchecked (-strict 0) program's refused exposure replays the refusal on every backend, the C call never made} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport abi\nimport abi::bytes\nimport ffi::c\nimport str\nimport r\n\nr::keep(abi::bytes::from_list(str::encode_utf8(\"x\")))\n" r.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\nextern c fn keep named \"bcf_keep\"(p: ffi::c::Ptr\[ffi::c::UChar\] read captures) -> unit\n"]]
    set hir [appHir $dir main.bot 0]
    native::withLinkDirs [list $::fixtureDir] {
        lmap backend {interp compile cranelift} {lindex [lindex [outcomeUnderHir $backend $hir] 1] end}
    }
} -cleanup removeApps -result {TYPE TYPE TYPE}

# ---------------------------------------------------------------------------
# Linking

test cf-missing-library {a library the linker cannot find compiles through the front end and fails at the native link, with the linker's own words, as NATIVE LINK -- never an UNKNOWN-NAMESPACE, a TYPE or a HIR error} -constraints {nativeBuilt rustcLinker} -body {
    set dir [app [list main.bot "extern c library \"definitely_missing_botlish_lib\"\n1 + 1\n"]]
    set hir [appHir $dir]
    lassign [native::withLinkDirs {} {outcomeUnderHir cranelift $hir}] tag code message
    list [hir::foreign::links $hir] [outcomeUnderHir interp $hir] $code \
        [string match "native link failed: the system linker could not link this program with the C functions and libraries it declares (libraries -ldefinitely_missing_botlish_lib):*" $message] \
        [regexp {(cannot|unable to) find[^\n]*definitely_missing_botlish_lib} $message]
} -cleanup removeApps -result {definitely_missing_botlish_lib {value 2 {}} {NATIVE LINK} 1 1}

test cf-undefined-symbol {a symbol no library defines is the linker's undefined symbol, reported as NATIVE LINK; an unused declaration needs no definition} -constraints cfFixture -body {
    set used [bcfApp "import ffi::c\nimport m\n\nm::nope(1)\n" [list m.bot "import ffi::c\n\nextern c fn nope named \"botlish_no_such_symbol\"(x: ffi::c::Int) -> ffi::c::Int\n"]]
    set unused [bcfApp "import ffi::c\nimport m\nimport bcf\n\nbcf::add(1, 2)\n" [list m.bot "import ffi::c\n\nextern c fn nope named \"botlish_no_such_symbol\"(x: ffi::c::Int) -> ffi::c::Int\n"]]
    lassign [lindex [appValues $used {cranelift}] 0] code message
    list $code [regexp {undefined (symbol|reference).*botlish_no_such_symbol} $message] [appValues $unused {cranelift}]
} -cleanup removeApps -result {{NATIVE LINK} 1 3}

test cf-named-symbol {`named` changes exactly the link symbol: the Botlish name stays the declaration's; without it the symbol is the name} -constraints cfFixture -body {
    set lib "extern c library \"botlish_cffi_fixture\"\n"
    set renamed [bcfApp "import ffi::c\nimport m\n\nm::plus(40, 2)\n" [list m.bot "import ffi::c\n\n${lib}extern c fn plus named \"bcf_add\"(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int\n"]]
    set plain [bcfApp "import ffi::c\nimport m\n\nm::bcf_add(40, 2)\n" [list m.bot "import ffi::c\n\n${lib}extern c fn bcf_add(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int\n"]]
    set unrenamed [bcfApp "import ffi::c\nimport m\n\nm::plus(40, 2)\n" [list m.bot "import ffi::c\n\n${lib}extern c fn plus(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int\n"]]
    list [appValues $renamed {cranelift}] [appValues $plain {cranelift}] [lindex [lindex [appValues $unrenamed {cranelift}] 0] 0]
} -cleanup removeApps -result {42 42 {NATIVE LINK}}

test cf-link-order {the declared libraries link as one group, so their order never decides a static link: an archive declared before the archive that needs it still resolves it} -constraints cfFixture -body {
    set dir [app [list main.bot "import ffi::c\nimport m\n\nm::add_twice(20, 1)\n" m.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\nextern c library \"botlish_cffi_dependent\"\n\nextern c fn add_twice named \"bcf_add_twice\"(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int\n"]]
    appValues $dir {cranelift cranelift-generic}
} -cleanup removeApps -result {42 42}

test cf-executable {a program that calls C links as a standalone executable with the libraries it declares and runs with no Tcl, no rustc and no source} -constraints cfFixture -body {
    set dir [bcfApp "${::bytesPrelude}src = text(\"hello\")\nr = bcf::reverse(src, len(src), abi::bytes::zeroed(abi::usize(5)))\n\[bcf::add(40, 2), abi::bytes::freeze(r.out) == text(\"olleh\")\]\n"]
    set exe [file join $dir program]
    native::withLinkDirs [list $::fixtureDir] {native::executable [appHir $dir] $exe}
    string trim [exec $exe]
} -cleanup removeApps -result {[42, true]}

test cf-stub-linker {the stub linker links no native library: it refuses a program that calls C or declares a library, naming what it calls and links and the linker that can} -constraints {cfFixture} -body {
    set calls [bcfApp "import ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    set declares [app [list main.bot "extern c library \"botlish_cffi_fixture\"\n1 + 1\n"]]
    set saved [expr {[info exists ::env(BOTLISH_NATIVE_LINKER)] ? $::env(BOTLISH_NATIVE_LINKER) : ""}]
    set ::env(BOTLISH_NATIVE_LINKER) stub
    try {
        lmap dir [list $calls $declares] {
            catch {native::withLinkDirs [list $::fixtureDir] {native::executable [appHir $dir] [file join $dir program]}} message options
            list [dict get $options -errorcode] $message
        }
    } finally {
        if {$saved eq ""} { unset ::env(BOTLISH_NATIVE_LINKER) } else { set ::env(BOTLISH_NATIVE_LINKER) $saved }
    }
} -cleanup removeApps -result {{{NATIVE LINK} {native link failed: this program calls C or declares a C library (symbols bcf_add; libraries -lbotlish_cffi_fixture), which only the system linker resolves, and the stub linker (BOTLISH_NATIVE_LINKER=stub, the single executable's) links no native library: link it with the rustc linker of a Botlish checkout whose native backend is built (BOTLISH_NATIVE_LINKER=rustc; C-FFI.md)}} {{NATIVE LINK} {native link failed: this program calls C or declares a C library (libraries -lbotlish_cffi_fixture), which only the system linker resolves, and the stub linker (BOTLISH_NATIVE_LINKER=stub, the single executable's) links no native library: link it with the rustc linker of a Botlish checkout whose native backend is built (BOTLISH_NATIVE_LINKER=rustc; C-FFI.md)}}}

test cf-main-tcl {main.tcl -backend cranelift -L DIR compiles, links with the declared libraries, runs and reports the value, the program's own output in its place (native program output is main.tcl's own)} -constraints cfFixture -body {
    set dir [bcfApp "import ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    exec [info nameofexecutable] $::mainScript -backend cranelift -warnings off -L $::fixtureDir [file join $dir main.bot]
} -cleanup removeApps -result "== main.bot (cranelift)\n   value: 42"

test cf-argv {the linked run of a program that calls C gets the run's argument vector} -constraints cfFixture -body {
    set dir [bcfApp "import ffi::c\nimport bcf\nimport list\n\nargs = argv():\n    on InvalidArgumentEncoding:\n        \[\]\n\[bcf::add(1, 1), list::length(args)\]\n"]
    exec [info nameofexecutable] $::mainScript -backend cranelift -warnings off -L $::fixtureDir -argv a -argv b -argv c [file join $dir main.bot]
} -cleanup removeApps -result "== main.bot (cranelift)\n   value: \[2, 3\]"

# ---------------------------------------------------------------------------
# direct

test cf-direct-noescape-ordinary {a foreign call is not direct by being foreign: a module whose C calls are all noescape (and pass and return raw pointers) is ordinary} -constraints cfFixture -body {
    set hir [appHir [bcfApp "import ffi::c\nimport bcf\n\nfn f() -> int:\n    p = bcf::address()\n    bcf::is_null(p)\n\nf()\n"]]
    statuses $hir {bcf ""}
} -cleanup removeApps -result {bcf ordinary {} ordinary}

test cf-direct-retaining {a call of a C function whose contract may keep a pointer (captures, or no escape fact: unknown) is an authority source: from a context-free function DIRECT, naming the function and the retaining parameter} -constraints cfFixture -body {
    lmap fn {keep keep_unknown} {
        appRejection [app [list main.bot "import ffi::c\nimport r\n\nfn f():\n    p = r::address()\n    r::$fn\(p)\n\nf()\n" r.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    }
} -cleanup removeApps -result {{DIRECT: main.bot:6:5: the entry program uses direct authority: function "f" calls r::keep, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape captures), without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "f", the function that makes the direct call, or declare the module direct with `direct module` as its first line} {DIRECT: main.bot:6:5: the entry program uses direct authority: function "f" calls r::keep_unknown, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape unknown), without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "f", the function that makes the direct call, or declare the module direct with `direct module` as its first line}}

test cf-direct-contextualized {the retaining call from a function requiring a context the calling module declares is mediated: contextualized, and it runs} -constraints cfFixture -body {
    set dir [app [list main.bot "import ffi::c\nimport r\n\ncontext struct Keeper:\n    ok: bool\n\nfn f(context k: Keeper) -> int:\n    p = r::address()\n    r::keep(p)\n    1\n\nwith context Keeper {ok: true}\nf()\n" r.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    list [statuses [appHir $dir] {r ""}] [appValues $dir {cranelift}]
} -cleanup removeApps -result {{r ordinary {} contextualized} 1}

test cf-direct-declared {the same call in a `direct module` is a deliberate direct module, justified by it (not stale)} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport ffi::c\nimport r\n\np = r::address()\nr::keep(p)\n1\n" r.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    list [statuses [appHir $dir] {r ""}] [appValues $dir {cranelift}]
} -cleanup removeApps -result {{r ordinary {} direct} 1}

test cf-direct-not-predesignated {declaring a retaining extern designates nothing: the declaring module is ordinary while it does not call it, stale if marked, and the authority is its caller's -- a call of it in its own module is an edge too} -constraints cfFixture -body {
    set decls "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"
    set marked [app [list main.bot "import r\n1\n" r.bot "direct module\n\n$decls"]]
    set own [app [list main.bot "import r\nr::wrap()\n" r.bot "${decls}\nfn wrap():\n    p = address()\n    keep(p)\n"]]
    list [lindex [split [appRejection $marked] :] 0] [appRejection $own]
} -cleanup removeApps -result {STALE-DIRECT-MODULE {DIRECT: r.bot:10:5: module "r" uses direct authority: function "r::wrap" calls r::keep, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape captures), without a context defined by "r"; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by "r") in "r::wrap", the function that makes the direct call, or declare the module direct with `direct module` as its first line}}

test cf-direct-two-modules-one-library {one C library, two Botlish modules: an ordinary one binding its noescape functions and a direct one binding its retaining function, both declaring the library; the capability boundary is the module, the link plan has the library once} -constraints cfFixture -body {
    set lib "extern c library \"botlish_cffi_fixture\"\n"
    set dir [app [list \
        main.bot "import ffi::c\nimport cfoo::basic\nimport cfoo::direct\n\ncontext struct Holder:\n    ok: bool\n\nfn hold(context h: Holder) -> int:\n    cfoo::direct::hold()\n\nwith context Holder {ok: true}\n\[cfoo::basic::add(40, 2), hold()\]\n" \
        cfoo/basic.bot "import ffi::c\n\n${lib}\nextern c fn add named \"bcf_add\"(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int\n" \
        cfoo/direct.bot "direct module\n\nimport ffi::c\n\n${lib}\nextern c fn keep named \"bcf_keep\"(p: ffi::c::Ptr\[ffi::c::Void\] captures) -> unit\nextern c fn address named \"bcf_address\"() -> ffi::c::Ptr\[ffi::c::Void\] independent\n\nfn hold() -> int:\n    p = address()\n    keep(p)\n    7\n"]]
    set hir [appHir $dir]
    list [statuses $hir {cfoo::basic cfoo::direct ""}] [hir::foreign::links $hir] [appValues $dir {cranelift}]
} -cleanup removeApps -result {{cfoo::basic ordinary cfoo::direct direct {} contextualized} botlish_cffi_fixture {{[42, 7]}}}

test cf-direct-summary {main.tcl -direct names a retaining C call among the edges} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport ffi::c\nimport r\n\np = r::address()\nr::keep(p)\n1\n" r.bot "import ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    string map [list $dir/ ""] [lindex [split [hir::direct::explain [appHir $dir] ""] \n] 1]
} -cleanup removeApps -result {    top-level code -> r::keep, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape captures) (a retaining C call, main.bot:7:1): undischarged}

# ---------------------------------------------------------------------------
# static compile

test cf-static-compile {a static block diagnoses a C call like any call -- arity, a C scalar's range, a refused exposure, an unmediated retaining call -- as compiler::DiagnosticCode values; nothing is executed at compile time, and an accepted block is the ordinary call} -constraints cfFixture -body {
    set decls "extern c fn keep named \"bcf_keep\"(p: ffi::c::Ptr\[ffi::c::Void\] captures) -> unit\n"
    lmap {body code} {
        "bcf::add(1)" Arity
        "bcf::add(x, 2)" Type
        "bcf::keep(abi::bytes::from_list(str::encode_utf8(\"x\")))" ForeignBorrow
        "p = bcf::address()\n        bcf::keep(p)" Direct
        "bcf::add(1, 2)" Arity
    } {
        set dir [app [list main.bot "import abi\nimport abi::bytes\nimport compiler\nimport ffi::c\nimport str\nimport bcf\n\nfn probe(x: int) -> int errors compiler::CompilerError:\n    static compile:\n        $body\n        0\n\nr = probe(5):\n    on compiler::CompilerError {code}:\n        if code == compiler::DiagnosticCode::$code:\n            1\n        else:\n            2\nr\n" bcf.bot "${::bcfModule}${decls}"]]
        set v [lindex [appValues $dir {interp}] 0]
        expr {[llength $v] == 2 ? [lindex $v 0 end] : $v}
    }
} -cleanup removeApps -result {1 1 1 1 NATIVE-ONLY}

# ---------------------------------------------------------------------------
# Interchange, cache, isolation

test cf-interchange {HIR interchange text carries everything a C call needs past the front end -- the declarations, contracts, link symbols, link plan, transports -- and its HIR, read back in a fresh process with no front end, lowers to the identical NIR and runs} -constraints cfFixture -body {
    set dir [bcfApp "${::bytesPrelude}src = text(\"hello\")\nr = bcf::reverse(src, len(src), abi::bytes::zeroed(abi::usize(5)))\n\[bcf::add(40, 2), abi::bytes::freeze(r.out) == text(\"olleh\")\]\n"]
    set hir [appHir $dir]
    set path [file join $dir main.hirx]
    hir::interchange::writeFile $path $hir
    set direct [native::nir $hir]
    set script [file join $dir read.tcl]
    set channel [open $script w]
    puts $channel "source [list [file join $::projectRoot native native.tcl]]\nset h \[hir::interchange::readFile [list $path]\]\nputs -nonewline \[native::nir \$h\]"
    close $channel
    set read [exec [info nameofexecutable] $script]
    list [expr {$read eq [string trimright $direct \n]}] [native::withLinkDirs [list $::fixtureDir] {
        lindex [outcomeUnderHir cranelift [hir::interchange::readFile $path]] 1
    }]
} -cleanup removeApps -result {1 {[42, true]}}

test cf-cache {the front-end cache keeps a program that calls C as its build (a hit runs identically), and a changed library name, link symbol, signature or contract of an imported binding module is a miss} -constraints cfFixture -body {
    set dir [bcfApp "import ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    set cache [makeDirectory cf-cache-[pid]]
    set path [file join $dir main.bot]
    set first [surface::readProgramFile $path -warnings off -cache $cache]
    set hit [surface::readProgramFile $path -warnings off -cache $cache]
    set misses {}
    foreach {from to} {
        {extern c library "botlish_cffi_fixture"} {extern c library "botlish_cffi_fixture2"}
        {named "bcf_add"} {named "bcf_add2"}
        {extern c fn add named "bcf_add"(a: ffi::c::Int, b: ffi::c::Int)} {extern c fn add named "bcf_add"(a: ffi::c::Long, b: ffi::c::Int)}
        {(p: ffi::c::Ptr[ffi::c::Void] noescape) -> ffi::c::Int} {(p: ffi::c::Ptr[ffi::c::Void] captures) -> ffi::c::Int}
    } {
        set channel [open [file join $dir bcf.bot] w]
        puts -nonewline $channel [string map [list $from $to] $::bcfModule]
        close $channel
        set changed [surface::readProgramFile $path -warnings off -cache $cache]
        lappend misses [expr {[dict get $changed foreign] ne [dict get $first foreign] || [dict get $changed links] ne [dict get $first links]}]
    }
    list [expr {[native::nir $hit] eq [native::nir $first]}] $misses \
        [native::withLinkDirs [list $::fixtureDir] {lindex [outcomeUnderHir cranelift $hit] 1}]
} -cleanup {removeApps; file delete -force [file join [temporaryDirectory] cf-cache-[pid]]} -result {1 {1 1 1 1} 42}

test cf-isolation {extern declarations, link plans and their natives are compilation-local: compiling another program (with other externs of the same names, or none) never changes an earlier HIR's lowering, and no later compilation links an earlier one's library} -constraints cfFixture -body {
    set a [bcfApp "import ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    set b [app [list main.bot "import ffi::c\nimport bcf\n\nbcf::add(1)\n" bcf.bot "import ffi::c\n\nextern c library \"other\"\nextern c fn add named \"other_add\"(a: ffi::c::Int) -> ffi::c::Int\n"]]
    set c [app [list main.bot "1 + 1\n"]]
    set hirA [appHir $a]
    set nirA [native::nir $hirA]
    set hirB [appHir $b]
    set hirC [appHir $c]
    set nirC [native::nir $hirC]
    set registered [lsearch -all -inline -glob [core::native::names] extern#*]
    list [expr {[native::nir $hirA] eq $nirA}] [regexp {link|foreign} $nirC] \
        [lsearch -all -inline -regexp [split [native::nir $hirB] \n] {^(link|foreign) }] \
        $registered \
        [native::withLinkDirs [list $::fixtureDir] {lindex [outcomeUnderHir cranelift $hirA] 1}]
} -cleanup removeApps -result {1 0 {{link "other"} {foreign 0 "other_add" params="i32" result=i32 name="bcf::add"}} {} 42}

# ---------------------------------------------------------------------------
# Acceptance

test cf-tcl-acceptance {Botlish calls the Tcl C library: Tcl_CreateInterp gives a non-null interpreter, Tcl_EvalEx of a valid script is TCL_OK (and Tcl prints), of an invalid one not, Tcl_DeleteInterp deletes it -- on both native backends, from an application-module binding, warning-free} -constraints tclLibrary -body {
    set path [file join $::projectRoot examples ffi tcl demo.bot]
    set hir [surface::readProgramFile $path -warnings error -cache ""]
    list [statuses $hir {tcl ""}] \
        [exec [info nameofexecutable] $::mainScript -backend cranelift $path] \
        [exec [info nameofexecutable] $::mainScript -backend cranelift-generic $path]
} -result "{tcl ordinary {} ordinary} {== demo.bot (cranelift)\nhello from Tcl\n   value: \[true, true, true\]} {== demo.bot (cranelift-generic)\nhello from Tcl\n   value: \[true, true, true\]}"

test cf-sha256-acceptance {Botlish Bytes through real BoringSSL SHA-256: the digests of "", "abc" and a longer message byte for byte, the write-back MutableBytes holding C's writes, the input Bytes and the original MutableBytes unchanged -- statically linked BoringSSL, on both native backends} -constraints boringssl -body {
    set path [file join $::projectRoot examples ffi sha256 demo.bot]
    set hir [surface::readProgramFile $path -warnings error -cache ""]
    native::withLinkDirs [list [cffi::boringsslDir]] {
        list [statuses $hir {boringssl sha256 ""}] [hir::foreign::links $hir] \
            [lindex [outcomeUnderHir cranelift $hir] 1] [lindex [outcomeUnderHir cranelift-generic $hir] 1]
    }
} -result {{boringssl ordinary sha256 ordinary {} ordinary} {crypto stdc++} {[true, true, true, true, true, true]} {[true, true, true, true, true, true]}}

test cf-sha256-executable {the SHA-256 demo as a standalone executable: BoringSSL linked into it (no libcrypto it needs at run time), the prefixed symbol inside} -constraints boringssl -body {
    set path [file join $::projectRoot examples ffi sha256 demo.bot]
    set dir [makeDirectory cf-sha-exe-[pid]]
    set exe [file join $dir demo]
    native::withLinkDirs [list [cffi::boringsslDir]] {
        native::executable [surface::readProgramFile $path -warnings off -cache ""] $exe
    }
    list [string trim [exec $exe]] [regexp {libcrypto} [exec ldd $exe]]
} -cleanup {file delete -force [file join [temporaryDirectory] cf-sha-exe-[pid]]} -result {{[true, true, true, true, true, true]} 0}

test cf-gc-stress {under BOTLISH_NATIVE_GC_STRESS=1 (a collection attempt at every allocation site) the exposures survive real C calls: the read and write borrows, the Tcl script, the SHA-256 digests} -constraints cfFixture -body {
    set saved [expr {[info exists ::env(BOTLISH_NATIVE_GC_STRESS)] ? $::env(BOTLISH_NATIVE_GC_STRESS) : ""}]
    set ::env(BOTLISH_NATIVE_GC_STRESS) 1
    try {
        set results [list [appValues [bcfApp "${::bytesPrelude}src = text(\"hello, world\")\nr = bcf::reverse(src, len(src), abi::bytes::zeroed(abi::usize(12)))\n\[bcf::sum(src, len(src)), abi::bytes::freeze(r.out) == text(\"dlrow ,olleh\")\]\n"] {cranelift cranelift-generic}]]
        if {[testConstraint tclLibrary]} {
            lappend results [lindex [outcomeUnderHir cranelift [surface::readProgramFile [file join $::projectRoot examples ffi tcl demo.bot] -warnings off -cache ""]] 1]
        } else {
            lappend results {[true, true, true]}
        }
        if {[testConstraint boringssl]} {
            lappend results [native::withLinkDirs [list [cffi::boringsslDir]] {
                lindex [outcomeUnderHir cranelift [surface::readProgramFile [file join $::projectRoot examples ffi sha256 demo.bot] -warnings off -cache ""]] 1
            }]
        } else {
            lappend results {[true, true, true, true, true, true]}
        }
    } finally {
        if {$saved eq ""} { unset ::env(BOTLISH_NATIVE_GC_STRESS) } else { set ::env(BOTLISH_NATIVE_GC_STRESS) $saved }
    }
    set results
} -cleanup removeApps -result {{{[1160, true]} {[1160, true]}} {[true, true, true]} {[true, true, true, true, true, true]}}

cleanupTests
