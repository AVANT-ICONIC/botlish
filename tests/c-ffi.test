    set dir [app [list \
        main.bot "import std::ffi::c\nimport cfoo::basic\nimport cfoo::direct\n\ncontext struct Holder:\n    ok: bool\n\nfn hold(context h: Holder) -> int:\n    cfoo::direct::hold()\n\nwith context Holder {ok: true}\n\[cfoo::basic::add(40, 2), hold()\]\n" \
        cfoo/basic.bot "import std::ffi::c\n\n${lib}\nextern c fn add named \"bcf_add\"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n" \
        cfoo/direct.bot "direct module\n\nimport std::ffi::c\n\n${lib}\nextern c fn keep named \"bcf_keep\"(p: std::ffi::c::Ptr\[std::ffi::c::Void\] captures) -> unit\nextern c fn address named \"bcf_address\"() -> std::ffi::c::Ptr\[std::ffi::c::Void\] independent\n\nfn hold() -> int:\n    p = address()\n    keep(p)\n    7\n"]]
    set hir [appHir $dir]
