extern c fn user_top named "bcf_user_top"() -> std::ffi::c::Ptr[std::ffi::c::Void] independent
extern c fn high_address named "bcf_high_address"() -> std::ffi::c::Ptr[std::ffi::c::Void] independent
extern c fn needs_64_bits named "bcf_needs_64_bits"(p: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int
extern c fn pointer_mix named "bcf_pointer_mix"(a: std::ffi::c::Ptr[std::ffi::c::Void] noescape, b: std::ffi::c::SChar, c: std::ffi::c::Ptr[std::ffi::c::Void] noescape, d: std::ffi::c::UShort, e: std::ffi::c::Long, f: std::ffi::c::Ptr[std::ffi::c::Void] noescape, g: std::ffi::c::Int, h: std::ffi::c::Ptr[std::ffi::c::Void] noescape, s0: std::ffi::c::Ptr[std::ffi::c::Void] noescape, s1: std::ffi::c::SChar, s2: std::ffi::c::Ptr[std::ffi::c::Void] noescape, s3: std::ffi::c::Short) -> std::ffi::c::Int
extern c fn checked_div named "bcf_checked_div"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int
extern c fn deep named "bcf_deep"(n: std::ffi::c::Long) -> std::ffi::c::Long
extern c fn available named "bcf_available"() -> std::ffi::c::Int
}

# The retaining part of the fixture's API, for the direct tests: keep stores
# its pointer (escape captures); keep_unknown is the same function with no
# escape fact (unknown, which retains).
set retainingDecls {extern c fn keep named "bcf_keep"(p: std::ffi::c::Ptr[std::ffi::c::Void] captures) -> unit
extern c fn keep_unknown named "bcf_keep"(p: std::ffi::c::Ptr[std::ffi::c::Void]) -> unit
extern c fn address named "bcf_address"() -> std::ffi::c::Ptr[std::ffi::c::Void] independent
}

# The byte helpers the borrow programs share.
set bytesPrelude {import std::abi
import std::abi::bytes
import std::ffi::c
import std::str
import bcf

fn text(s: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(std::str::encode_utf8(s))

fn len(d: std::abi::bytes::Bytes) -> std::ffi::c::ULong:
    std::abi::bytes::length(d).value

}

# An application of the fixture binding and MAIN (an entry program's text).
proc bcfApp {main {extra {}}} {
    return [app [concat [list main.bot $main bcf.bot $::bcfModule] $extra]]
}

test cf-fixture-built {the C fixture builds with the host's C compiler wherever C calls run -- a fixture that does not build would leave every test that needs it skipped, never failed -- as an object of the host's format and architecture, its archive defining the fixture's functions under their C names in the object format's spelling (Mach-O's `_` user label prefix on macOS)} -constraints {cCompiler nativeCCalls nativeBuilt rustcLinker} -body {
    set prefix [expr {$::tcl_platform(os) eq "Darwin" ? "_" : ""}]
    set defined [lmap line [split [exec nm -g [file join $::fixtureDir libbotlish_cffi_fixture.a]] \n] {
        expr {[regexp {^[0-9a-fA-F]+ T (\S+)$} $line -> symbol] ? $symbol : [continue]}
    }]
    list [expr {$::fixtureDir ne ""}] [binaryHeader [file join $::fixtureDir fixture.o]] \
        [lmap name {bcf_add bcf_capture bcf_dirty_short bcf_pick bcf_deep} {expr {"$prefix$name" in $defined}}]
} -result [list 1 [hostBinaryHeader object] {1 1 1 1 1}]

# ---------------------------------------------------------------------------
# Syntax

test cf-parse-forms {the two declarations: a library by its linker name, a function by its C signature, with an optional link symbol, pointer facts per parameter and a pointer result's provenance; no body} -body {
    set ast [surface::parse "import std::ffi::c\n\nextern c library \"crypto\"\n\nextern c fn SHA256 named \"PRE_SHA256\"(\n    data: std::ffi::c::Ptr\[std::ffi::c::UChar\] read noescape,\n    len: std::ffi::c::ULong,\n    out: std::ffi::c::Ptr\[std::ffi::c::UChar\] write proven noescape,\n) -> std::ffi::c::Ptr\[std::ffi::c::UChar\] alias out\nextern c fn f(p: std::ffi::c::Ptr\[std::ffi::c::Void\] captures) -> unit\nextern c fn g() -> std::ffi::c::Ptr\[std::ffi::c::Void\] independent\n" t.bot]
    lrange [split [surface::formatAst $ast] \n] 1 end
} -result {{extern c library "crypto"} {extern c fn SHA256 named "PRE_SHA256"(data: std::ffi::c::Ptr[std::ffi::c::UChar] read noescape, len: std::ffi::c::ULong, out: std::ffi::c::Ptr[std::ffi::c::UChar] write proven noescape) -> std::ffi::c::Ptr[std::ffi::c::UChar] alias out} {extern c fn f(p: std::ffi::c::Ptr[std::ffi::c::Void] captures) -> unit} {extern c fn g() -> std::ffi::c::Ptr[std::ffi::c::Void] independent}}

test cf-parse-errors {malformed declarations are located EXTERN-SYNTAX errors: no ABI, an unknown ABI, an unquoted or path-like library, a body colon, a malformed or duplicate `named`, varargs, an untyped parameter, an unknown fact, a repeated access, no result type, an errors clause, an unknown result fact, a declaration inside a function} -body {
    lmap src [list \
        "extern fn f() -> unit\n" \
        "extern rust fn f() -> unit\n" \
        "extern c library foo\n" \
        "extern c library \"/usr/lib/libfoo.so\"\n" \
        "extern c library \"-Wl,--wrap=x\"\n" \
        "extern c fn f() -> unit:\n    1\n" \
        "extern c fn f named (x: int) -> unit\n" \
        "extern c fn f named \"a\" named \"b\"() -> unit\n" \
        "extern c fn f(x: int, ...) -> unit\n" \
        "extern c fn f(x) -> unit\n" \
        "extern c fn f(x: int const) -> unit\n" \
        "extern c fn f(x: int read write) -> unit\n" \
        "extern c fn f(x: int)\n" \
        "extern c fn f(x: int) -> int errors E\n" \
        "extern c fn f(x: int) -> int fresh\n" \
        "extern c thing\n" \
        "fn g():\n    extern c fn f() -> unit\n"] {
        if {[catch {surface::parse $src t.bot} message]} {
            regexp {^t.bot:([0-9]+:[0-9]+): ([A-Z-]+):} $message -> at code
            list $at $code
        } else {
            set src
        }
    }
} -result {{1:8 EXTERN-SYNTAX} {1:8 EXTERN-SYNTAX} {1:18 EXTERN-SYNTAX} {1:18 EXTERN-SYNTAX} {1:18 EXTERN-SYNTAX} {1:24 EXTERN-SYNTAX} {1:21 EXTERN-SYNTAX} {1:25 EXTERN-SYNTAX} {1:23 EXTERN-SYNTAX} {1:15 EXTERN-SYNTAX} {1:22 EXTERN-SYNTAX} {1:27 EXTERN-SYNTAX} {1:22 EXTERN-SYNTAX} {1:30 EXTERN-SYNTAX} {1:30 EXTERN-SYNTAX} {1:10 EXTERN-SYNTAX} {2:5 EXTERN-SYNTAX}}

test cf-parse-messages {the messages name what is wrong and the remedy} -body {
    lmap src [list "extern fn f() -> unit\n" "extern c fn f() -> unit:\n" "extern c fn f(x: int, ...) -> unit\n" "extern c fn f(x: int)\n"] {
        catch {surface::parse $src t.bot} message
        set message
    }
} -result {{t.bot:1:8: EXTERN-SYNTAX: an extern declaration names its foreign ABI: write "extern c fn NAME(...) -> T" (the only foreign ABI is c)} {t.bot:1:24: EXTERN-SYNTAX: an extern c fn is a declaration with no body: it has no trailing ":" (write "extern c fn f(...) -> T" on its own)} {t.bot:1:23: EXTERN-SYNTAX: variadic C functions are not supported: extern c fn "f" must have a fixed signature (there is no variadic C ABI here: bind a function of fixed parameters instead)} {t.bot:1:22: EXTERN-SYNTAX: expected "->" and the C result type after the parameter list of extern c fn "f", found end of line (a C function returning void is "-> unit")}}

test cf-parse-recover {a recovering parse reports each malformed declaration once and keeps the valid ones: no cascade} -body {
    set ast [surface::parse "extern fn f()\nextern c fn g() -> unit\nextern c fn h(x: int, ...) -> unit\nextern c library \"m\"\nx = 1\n" t.bot -recover 1]
    list [lmap d [dict get $ast diagnostics] {dict get $d line}] [lmap s [dict get $ast body] {dict get $s kind}]
} -result {{1 3} {error externfn error externlib bind}}

test cf-parse-contextual {extern, c, library, named, read, write, noescape, proven, captures, independent and alias are contextual: ordinary names everywhere else} -body {
    set hir [surface::compile "extern = 1\nfn f(named, alias, read, write, library, c, noescape, proven, captures, independent):\n    named + alias + read + write + library + c + noescape + proven + captures + independent\nf(extern, 1, 1, 1, 1, 1, 1, 1, 1, 1)\n" -warnings off]
    outcomeUnderHir interp $hir
} -result {value 10 {}}

# ---------------------------------------------------------------------------
# Declarations

test cf-decl-types {every parameter and result type is a C ABI value type (a C integer scalar, a Ptr, a FnPtr; the result also unit), located in the declaring file} -body {
    lmap decl [list \
        "extern c fn f(x: int) -> unit" \
        "extern c fn f(x: std::ffi::c::Int) -> str" \
        "extern c fn f(x: std::ffi::c::Ptr\[int\]) -> unit" \
        "extern c fn f(x: unit) -> unit" \
        "extern c fn f(x: std::ffi::c::Ptr\[T\]) -> unit" \
        "extern c fn f(x: Nope) -> unit"] {
        appRejection [app [list main.bot "import m\n1\n" m.bot "import std::ffi::c\n\n$decl\n"]]
    }
} -cleanup removeApps -result {{TYPE: m.bot:3:18: parameter "x" of extern c fn "f": int is not a C ABI value type (a C integer scalar such as std::ffi::c::Int, std::ffi::c::Bool, std::ffi::c::Double, std::ffi::c::Ptr[...] or std::ffi::c::FnPtr[...])} {TYPE: m.bot:3:39: the result of extern c fn "f": str is not a C ABI value type (a C integer scalar such as std::ffi::c::Int, std::ffi::c::Bool, std::ffi::c::Double, std::ffi::c::Ptr[...] or std::ffi::c::FnPtr[...])} {TYPE: m.bot:3:18: unknown or invalid type std::ffi::c::Ptr[int] for parameter "x" of extern c fn "f": invalid pointee in std::ffi::c::Ptr[int]: int has no C representation: a pointee is std::ffi::c::Void, a C integer scalar, std::ffi::c::Bool, an opaque struct or another pointer} {TYPE: m.bot:3:18: parameter "x" of extern c fn "f": unit is not a C parameter type (a C function of no parameters has an empty parameter list)} {TYPE: m.bot:3:18: unknown or invalid type std::ffi::c::Ptr[T] for parameter "x" of extern c fn "f": core::type: unknown type "T"} {TYPE: m.bot:3:18: unknown or invalid type Nope for parameter "x" of extern c fn "f": core::type: unknown type "Nope"}}

test cf-decl-facts {a fact is a pointer's: access a data pointer's, escape any pointer's; a provenance a data pointer result's, and an alias names a parameter of the result's own type} -body {
    lmap decl [list \
        "extern c fn f(x: std::ffi::c::Int noescape) -> unit" \
        "extern c fn f(x: std::ffi::c::FnPtr\[Fn{args: \[\], return: unit}\] read) -> unit" \
        "extern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int independent" \
        "extern c fn f(x: std::ffi::c::Ptr\[std::ffi::c::UChar\]) -> std::ffi::c::Ptr\[std::ffi::c::UChar\] alias y" \
        "extern c fn f(x: std::ffi::c::Ptr\[std::ffi::c::Char\]) -> std::ffi::c::Ptr\[std::ffi::c::UChar\] alias x" \
        "extern c fn f(result: std::ffi::c::Ptr\[std::ffi::c::UChar\] write noescape) -> unit" \
        "extern c fn f(x: std::ffi::c::Int, x: std::ffi::c::Int) -> unit"] {
        appRejection [app [list main.bot "import m\n1\n" m.bot "import std::ffi::c\n\n$decl\n"]]
    }
} -cleanup removeApps -result {{TYPE: m.bot:3:35: parameter "x" of extern c fn "f" is a C value (std::ffi::c::Int), not a pointer: access and escape are facts of a pointer parameter} {TYPE: m.bot:3:65: parameter "x" of extern c fn "f" is a C function pointer: C reads or writes through a data pointer only, so it states no access (its escape says whether C keeps it)} {TYPE: m.bot:3:56: extern c fn "f" returns std::ffi::c::Int, not a data pointer: only a pointer result has a provenance ("independent" or "alias PARAM")} {TYPE: m.bot:3:96: the result of extern c fn "f" is declared an alias of "y", which is not one of its parameters} {TYPE: m.bot:3:95: the result of extern c fn "f" (std::ffi::c::Ptr[std::ffi::c::UChar]) is declared an alias of parameter "x" (std::ffi::c::Ptr[std::ffi::c::Char]): an exact alias is the same pointer, of the same type} {TYPE: m.bot:3:15: write parameter "result" of extern c fn "f": a written parameter's bytes come back as the call result's field of its name, beside `result`, so it needs another name} {DUPLICATE: m.bot:3:36: duplicate parameter "x" of extern c fn "f"}}

test cf-decl-duplicate {two declarations of one Botlish qualified name are DUPLICATE, never merged (even with one signature); an extern and a function of one name are the ordinary duplicate binding; two modules may bind the same C symbol} -body {
    set same [app [list main.bot "import m\n1\n" m.bot "import std::ffi::c\n\nextern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int\nextern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set fnToo [app [list main.bot "import std::ffi::c\n\nextern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int\n\nfn f(x):\n    x\n\n1\n"]]
    set twoModules [app [list main.bot "import a\nimport b\n1\n" \
        a.bot "import std::ffi::c\n\nextern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int\n" \
        b.bot "import std::ffi::c\n\nextern c fn f named \"f\"(x: std::ffi::c::Long) -> std::ffi::c::Long\n"]]
    set hir [appHir $twoModules]
    list [appRejection $same] [appRejection $fnToo] \
        [lmap key [lsort [dict keys [hir::foreign::declarations $hir]]] {list $key [dict get [hir::foreign::declarations $hir] $key symbol]}]
} -cleanup removeApps -result {{DUPLICATE: m.bot:4:13: extern c fn "f" is already declared in module "m" (at m.bot:3:13): two declarations of one Botlish name are never merged, whatever their signatures} {DUPLICATE: main.bot:5:1: duplicate binding "f" in the same lexical scope} {{a::f f} {b::f f}}}

test cf-hir-foreign-table {the HIR keeps every declaration: its Botlish identity, its link symbol (the name, or `named`'s), the one normalized foreign contract (an unstated fact unknown; noescape declared, `proven noescape` proven) and the ABI class of each parameter and the result (for -target linux-x86_64: plain char is the target's)} -body {
    set dir [app [list main.bot "import m\n1\n" m.bot "import std::ffi::c\n\nextern c library \"x\"\n\nextern c fn f named \"F_SYM\"(a: std::ffi::c::Char, b: std::ffi::c::UShort, p: std::ffi::c::Ptr\[std::ffi::c::UChar\] read proven noescape, q: std::ffi::c::Ptr\[std::ffi::c::Void\]) -> std::ffi::c::Ptr\[std::ffi::c::UChar\] alias p\nextern c fn g(x: std::ffi::c::LongLong) -> unit\n"]]
    set table [hir::foreign::declarations [surface::readProgramFile [file join $dir main.bot] -warnings off -cache "" -target linux-x86_64]]
    lmap key [lsort [dict keys $table]] {
        set r [dict get $table $key]
        list $key [dict get $r namespace] [dict get $r name] [dict get $r symbol] [dict get $r native] \
            [dict get $r contract] [dict get $r abi]
    }
} -cleanup removeApps -result {{m::f m f F_SYM extern#m::f {vars {} params {{name a type {refined int std::ffi::c::Char}} {name b type {refined int std::ffi::c::UShort}} {name p type {cptr {refined int std::ffi::c::UChar}} access read escape proven-noescape} {name q type {cptr void} access unknown escape unknown}} result {cptr {refined int std::ffi::c::UChar}} provenance {alias p}} {params {i8 u16 ptr ptr} result ptr}} {m::g m g g extern#m::g {vars {} params {{name x type {refined int std::ffi::c::LongLong}}} result unit provenance unknown} {params i64 result void}}}

test cf-abi-classes-follow-the-target {a parameter's ABI class is its C type's width and signedness on the compilation's target, read from the registry: long is 64 bits on LP64 and 32 on LLP64, plain char signed on x86-64 and unsigned on Linux AArch64} -body {
    set dir [app [list main.bot "import std::ffi::c\n\nextern c fn f(a: std::ffi::c::Long, b: std::ffi::c::Char, c: std::ffi::c::ULong) -> std::ffi::c::Long\n1\n"]]
    lmap target {linux-x86_64 windows-x86_64 linux-aarch64} {
        set hir [surface::readProgramFile [file join $dir main.bot] -warnings off -cache "" -target $target]
        dict get [hir::foreign::declarations $hir] f abi
    }
} -cleanup removeApps -result {{params {i64 i8 u64} result i64} {params {i32 i8 u32} result i32} {params {i64 u8 u64} result i64}}

test cf-link-plan {the link plan is every extern c library of the program, each name once, in first-declaration order (modules after their imports, the entry program last); a library is associated with no function} -body {
    set dir [app [list main.bot "import a\nimport b\n\nextern c library \"z\"\nextern c library \"a1\"\n1\n" \
        a.bot "import b\n\nextern c library \"a1\"\nextern c library \"shared\"\n" \
        b.bot "import std::ffi::c\n\nextern c library \"shared\"\nextern c library \"b1\"\nextern c fn f(x: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set hir [appHir $dir]
    list [hir::foreign::links $hir] [lmap entry [dict get $hir links] {llength [dict get $entry origins]}] \
        [lsort [dict keys [dict get [hir::foreign::declarations $hir] b::f]]] \
        [regexp -all -line {^link } [native::nir $hir]] [lsearch -all -inline -regexp [split [native::nir $hir] \n] {^link }]
} -cleanup removeApps -result {{shared b1 a1 z} {2 1 2 1} {abi contract key name namespace native origin symbol} 4 {{link "shared"} {link "b1"} {link "a1"} {link "z"}}}

# ---------------------------------------------------------------------------
# Calls and typing

test cf-call-typing {a call is typed by the declaration: its result's C type, arguments held to the C types by the ordinary admission proof (an Int where a C scalar is declared needs its range proven), arity checked} -constraints cfFixture -body {
    set ok [bcfApp "import std::ffi::c\nimport bcf\n\nfn f(x: std::ffi::c::Int) -> int:\n    bcf::add(x, 2)\n\nf(40)\n"]
    set unproven [bcfApp "import std::ffi::c\nimport bcf\n\nfn f(x: int) -> int:\n    bcf::add(x, 2)\n\nf(40)\n"]
    set arity [bcfApp "import std::ffi::c\nimport bcf\n\nbcf::add(1)\n"]
    set ptr [bcfApp "import std::ffi::c\nimport bcf\n\nbcf::is_null(5)\n"]
    list [appValues $ok {cranelift}] [appRejection $unproven] [appRejection $arity] [appRejection $ptr]
} -cleanup removeApps -result {42 {TYPE: main.bot:5:14: argument 1 of bcf::add cannot be proven to satisfy std::ffi::c::Int (argument type: int)} {ARITY: main.bot:4:1: bcf::add is a C function of 2 parameter(s), its declaration's C signature, and this call passes 1 argument(s)} {TYPE: main.bot:4:14: argument 1 of bcf::is_null cannot be proven to satisfy std::ffi::c::Ptr[std::ffi::c::Void] (argument type: int)}}

test cf-not-a-value {an extern c fn is only called: bound, passed or returned as a value it is TYPE (it would be called with no contract and no symbol)} -constraints cfFixture -body {
    list [appRejection [bcfApp "import std::ffi::c\nimport bcf\n\nf = bcf::add\n1\n"]] \
        [appRejection [bcfApp "import std::ffi::c\nimport bcf\n\nfn g(h):\n    h\n\ng(bcf::add)\n"]]
} -cleanup removeApps -result {{TYPE: main.bot:4:5: bcf::add can only be called directly: it is a C function (extern c fn), and a call through a function value would have no C signature, no contract and no link symbol -- it is not a value (a C function pointer value is std::ffi::c::FnPtr, which Botlish does not call)} {TYPE: main.bot:7:3: bcf::add can only be called directly: it is a C function (extern c fn), and a call through a function value would have no C signature, no contract and no link symbol -- it is not a value (a C function pointer value is std::ffi::c::FnPtr, which Botlish does not call)}}

test cf-method-syntax {method syntax reaches an extern c fn as it reaches any visible function of an imported namespace: no FFI-specific rule} -constraints cfFixture -body {
    appValues [bcfApp "import std::ffi::c\nimport bcf\n\nfn f(x: std::ffi::c::Int) -> int:\n    x.add(2)\n\nf(40)\n"] {cranelift}
} -cleanup removeApps -result 42

test cf-entry-program-declares {the entry program declares and calls its own extern c fn like a module: visible in the whole program, not in any module} -constraints cfFixture -body {
    set dir [app [list main.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n\nfn f() -> int:\n    plus(40, 2)\n\nextern c fn plus named \"bcf_add\"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n\nf()\n"]]
    set hidden [app [list main.bot "import m\nimport std::ffi::c\n\nextern c fn plus named \"bcf_add\"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n\nm::g()\n" m.bot "fn g() -> int:\n    plus(1, 2)\n"]]
    list [appValues $dir {cranelift}] [appRejection $hidden]
} -cleanup removeApps -result {42 {UNBOUND: m.bot:2:5: unbound name "plus"}}

# ---------------------------------------------------------------------------
# Byte borrowing through real C

test cf-borrow-read {a Bytes (and a MutableBytes) at a read/noescape byte pointer is exposed for the call as it is, no copy; C reads the real storage} -constraints cfFixture -body {
    appValues [bcfApp "${::bytesPrelude}m = std::abi::bytes::from_bytes(text(\"hello\"))\n\[bcf::sum(text(\"hello\"), 5), bcf::sum(m, 5), bcf::sum(text(\"\"), 0), bcf::sum_proven(text(\"\u00ff\"), 2)\]\n"] {cranelift cranelift-generic}
} -cleanup removeApps -result {{[532, 532, 0, 386]} {[532, 532, 0, 386]}}

test cf-borrow-write {a MutableBytes at a write/noescape byte pointer: C writes a private copy, which the call returns as the parameter's field of the write-back struct; the caller's value, and every copy of it, is unchanged} -constraints cfFixture -body {
    appValues [bcfApp "import std::byte\n${::bytesPrelude}fn byte_of(n: int) -> std::byte::Byte:\n    if n >= 0 and n <= 255:\n        return n\n    0\n\nm = std::abi::bytes::zeroed(std::abi::usize(5))\nkept = m\nr = bcf::fill(m, 5, 7)\nexpected = std::abi::bytes::from_list(\[byte_of(7), byte_of(44), byte_of(81), byte_of(118), byte_of(155)\])\n\[std::abi::bytes::freeze(r.out) == expected, std::abi::bytes::freeze(m) == std::abi::bytes::freeze(std::abi::bytes::zeroed(std::abi::usize(5))), std::abi::bytes::freeze(kept) == std::abi::bytes::freeze(m), r.result\]\n"] {cranelift}
} -cleanup removeApps -result {{[true, true, true, unit]}}

test cf-borrow-sha256-shape {SHA256's shape: read input, write output, and a pointer result that is exactly the output: the call yields unit in its place, the write-back carries the bytes} -constraints cfFixture -body {
    set dir [bcfApp "${::bytesPrelude}src = text(\"hello\")\nout = std::abi::bytes::zeroed(std::abi::usize(5))\nr = bcf::reverse(src, len(src), out)\n\[std::abi::bytes::freeze(r.out) == text(\"olleh\"), r.result, src == text(\"hello\"), std::abi::bytes::freeze(out) == std::abi::bytes::freeze(std::abi::bytes::zeroed(std::abi::usize(5)))\]\n"]
    set hir [appHir $dir]
    set call [lindex [lsearch -all -inline -regexp [split [native::nir $hir] \n] {foreigncall}] 0]
    list [appValues $dir {cranelift cranelift-generic}] [regexp {foreigncall \d+ %\d+ %\d+ %\d+ exposed=0,2 discard} $call]
} -cleanup removeApps -result {{{[true, unit, true, true]} {[true, unit, true, true]}} 1}

