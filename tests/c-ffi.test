# c-ffi.test -- `extern c library` and `extern c fn`: real link-time C calls
# (C-FFI.md).
#
# An extern c fn is a truthful C ABI declaration with no body, carrying the
# foreign call contract every foreign call has (C-POINTER-BORROWING.md); an
# extern c library names a library of the program's link plan. The native
# backends link a program that calls C with the system linker and call the
# symbols directly with the platform C ABI; the Tcl backends refuse a C call
# at run time (NATIVE-ONLY).
#
# The C side of most tests is tests/cffi/fixture.c, compiled here with the
# host C compiler (GCC or Clang on Linux, Apple clang on macOS) into a static
# archive in a private directory (test infrastructure only) and bound by the
# module text below. The Tcl and BoringSSL acceptance tests run examples/ffi/
# against the installed libtcl9.0 and the package-owned static BoringSSL
# (tests/cffi/boringssl.tcl; skipped when it is not built). Every
# application is a fresh directory of the tcltest temporary directory.
#
# C calls run on every host the native backend links them on (nativeCCalls:
# Linux x86-64 and AArch64, macOS AArch64). What differs by target is the
# target's own C ABI, which the tests below model from the ABI documents
# (`::abi`) -- plain char's signedness, how many arguments go in registers,
# how stack arguments are laid out, which bits of a narrow argument the
# caller defines -- and check against the machine state a call arrives in
# and against calls the C compiler makes itself (MACOS-AARCH64-MILESTONE-6.md).

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]
source [file join $::projectRoot tests cffi boringssl.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint cCompiler [expr {[auto_execok cc] ne ""}]
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]
set ::hostTarget [core::cabi::hostTarget]
# The host compiles C with Apple clang for macOS, whose __builtin_available
# a C library may use (cf-availability-check).
testConstraint appleAvailability [expr {$::hostTarget eq "macos-aarch64" && [testConstraint nativeCCalls]}]

set mainScript [file join $::projectRoot main.tcl]
set ::appCounter 0

# The fixture library: built once, in a private directory, when a C compiler
# is there.
set ::fixtureDir ""
if {[testConstraint cCompiler] && [testConstraint nativeCCalls]} {
    set ::fixtureDir [makeDirectory cffi-fixture-[pid]]
    if {[catch {
        exec cc -c -O2 -fPIC [file join $::projectRoot tests cffi fixture.c] -o [file join $::fixtureDir fixture.o]
        exec ar rcs [file join $::fixtureDir libbotlish_cffi_fixture.a] [file join $::fixtureDir fixture.o]
        # A second archive that depends on the first (cf-link-order).
        set channel [open [file join $::fixtureDir dependent.c] w]
        puts $channel "int bcf_add(int a, int b);\nint bcf_add_twice(int a, int b) { return 2 * bcf_add(a, b); }"
        close $channel
        exec cc -c -O2 -fPIC [file join $::fixtureDir dependent.c] -o [file join $::fixtureDir dependent.o]
        exec ar rcs [file join $::fixtureDir libbotlish_cffi_dependent.a] [file join $::fixtureDir dependent.o]
    } message]} {
        puts stderr "c-ffi.test: the fixture library did not build: $message"
        set ::fixtureDir ""
    }
}
testConstraint cfFixture [expr {$::fixtureDir ne "" && [testConstraint nativeBuilt] && [testConstraint rustcLinker]}]
# libtcl9.0, as the Tcl acceptance links it: a probe link with the host's
# linker driver.
proc tclLinkable {} {
    if {![testConstraint cCompiler]} {
        return 0
    }
    set dir [makeDirectory cffi-tclprobe-[pid]]
    set src [file join $dir probe.c]
    set channel [open $src w]
    puts $channel "void *Tcl_CreateInterp(void);\nint main(void) { return Tcl_CreateInterp() == 0; }"
    close $channel
    set ok [expr {![catch {exec cc $src -o [file join $dir probe] -ltcl9.0}]}]
    file delete -force $dir
    return $ok
}
testConstraint tclLibrary [expr {[testConstraint nativeBuilt] && [testConstraint rustcLinker] && [tclLinkable]}]
testConstraint boringssl [expr {[testConstraint nativeBuilt] && [testConstraint rustcLinker] && [cffi::boringsslDir] ne ""}]

# The C calling convention a foreign call is compiled with on this host: the
# driver's reading of the host target's triple (system_v on Linux,
# apple_aarch64 on macOS arm64).
set ::cConvention [expr {[testConstraint nativeBuilt] && $::hostTarget ne ""
    ? [dict get [native::targetFacts [dict get [core::cabi::target $::hostTarget] triple]] c-call-conv] : "none"}]

# The host target's C ABI as these tests model it, from the platform ABI
# documents (the SysV x86-64 psABI, AAPCS64, Apple's "Writing ARM64 code for
# Apple platforms") -- never from core::cabi or the compiler:
#
#   registers  integer argument registers: six on x86-64, eight on AArch64
#   stack      how stack arguments are laid out: `natural` (Apple: each at its
#              natural size and alignment, packed: a char one byte) or
#              `slot8` (each in its own 8-byte slot)
#   extended   how many low bits of a narrow argument's register the caller
#              defines: 32 (extended to 32 bits by its type: Apple's rule,
#              and x86-64's as GCC and Clang callers make it and their callees
#              read it), or 0 (only the argument's own width: AAPCS64, whose
#              callee extends)
switch -- $::hostTarget {
    macos-aarch64 { set ::abi {registers 8 stack natural extended 32} }
    linux-aarch64 { set ::abi {registers 8 stack slot8 extended 0} }
    default { set ::abi {registers 6 stack slot8 extended 32} }
}

# The C types the ABI tests pass: Botlish name -> {bytes signed}, plain char
# at the host target's signedness (cfCharRange, below).
proc cType {name} {
    switch -- $name {
        SChar { return {1 1} }
        UChar - Bool { return {1 0} }
        Char { return [list 1 [expr {[lindex $::cfCharRange 0] < 0}]] }
        Short { return {2 1} }
        UShort { return {2 0} }
        Int { return {4 1} }
        UInt { return {4 0} }
        Long - LongLong { return {8 1} }
        ULong - ULongLong - Ptr { return {8 0} }
    }
    error "no C type $name"
}

# Where the parameters of C types TYPES arrive under ::abi: {reg N} or
# {stack OFFSET} each, OFFSET from the stack pointer at the call.
proc abiLocations {types} {
    set out {}
    set reg 0
    set next 0
    foreach type $types {
        set size [lindex [cType $type] 0]
        if {$reg < [dict get $::abi registers]} {
            lappend out [list reg $reg]
            incr reg
            continue
        }
        if {[dict get $::abi stack] eq "natural"} {
            set offset [expr {($next + $size - 1) / $size * $size}]
            set next [expr {$offset + $size}]
        } else {
            set offset $next
            incr next 8
        }
        lappend out [list stack $offset]
    }
    return $out
}

# The mismatches between what a call of C types TYPES with VALUES arrived in
# -- REGS (each register's low 32 bits) and STACK (the bytes at the stack
# pointer) -- and ::abi: in a register, the low 32 bits (`extended` 32) or
# the argument's own width, as its value extended by its type; on the stack,
# the argument's own bytes at its offset, little-endian. Bytes and bits the
# ABI leaves undefined (padding, the rest of a slot or a register) are not
# read. Empty when everything matches.
proc abiMismatches {who types values regs stack} {
    set mismatches {}
    foreach type $types value $values location [abiLocations $types] {
        lassign [cType $type] size
        lassign $location where at
        if {$where eq "reg"} {
            set bits [expr {$size < 4 && [dict get $::abi extended] == 32 ? 32 : min(8 * $size, 32)}]
            set expected [expr {$value & ((1 << $bits) - 1)}]
            set observed [expr {[lindex $regs $at] & ((1 << $bits) - 1)}]
        } else {
            set expected [lmap i [lrange {0 1 2 3 4 5 6 7} 0 $size-1] {expr {($value >> (8 * $i)) & 0xff}}]
            set observed [lrange $stack $at [expr {$at + $size - 1}]]
        }
        if {$expected != $observed} {
            lappend mismatches [list $who $type $value $location expected $expected observed $observed]
        }
    }
    return $mismatches
}

# A Botlish list display (of Ints and lists of them) as a Tcl list.
proc botlishList {text} {
    return [lindex [string map {[ "{" ] "}" , ""} $text] 0]
}

# The dynamic libraries executable EXE loads, as the host's tools list them:
# otool -L on macOS, ldd elsewhere.
proc dynamicLibraries {exe} {
    if {$::tcl_platform(os) eq "Darwin"} {
        return [exec otool -L $exe]
    }
    return [exec ldd $exe]
}

# A fresh application directory holding FILES ({RELATIVE-PATH TEXT ...}): its
# absolute path.
proc app {files} {
    set dir [makeDirectory cf-app-[pid]-[incr ::appCounter]]
    foreach {relative text} $files {
        set path [file join $dir {*}[file split $relative]]
        file mkdir [file dirname $path]
        set channel [open $path w]
        fconfigure $channel -encoding utf-8 -translation lf
        puts -nonewline $channel $text
        close $channel
    }
    return $dir
}

proc removeApps {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] cf-app-[pid]-*] {
        file delete -force $dir
    }
}

# The HIR of DIR/MAIN (strict unless STRICT is 0).
proc appHir {dir {main main.bot} {strict 1}} {
    return [surface::readProgramFile [file join $dir $main] -warnings off -cache "" -strict $strict]
}

# "KIND: MESSAGE" of the compilation of DIR/MAIN, with DIR spelled away, or
# accepted.
proc appRejection {dir {main main.bot}} {
    if {[catch {appHir $dir $main} message options]} {
        set kind [lindex [dict get $options -errorcode] end]
        return "$kind: [string map [list $dir/ ""] $message]"
    }
    return accepted
}

# The value of DIR/MAIN on each of BACKENDS (with the fixture's directory on
# the linker's search path), or the backend's error: {CODE MESSAGE} with DIR
# spelled away.
proc appValues {dir backends {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [list $::fixtureDir] {
        lmap backend $backends {
            lassign [outcomeUnderHir $backend $hir] tag value message
            expr {$tag eq "value" ? $value : [list [lrange $value end-1 end] [string map [list $dir/ ""] $message]]}
        }
    }
}

# The error code's last words of DIR/MAIN on BACKEND, or its value.
proc appCode {dir backend {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [list $::fixtureDir] {
        lassign [outcomeUnderHir $backend $hir] tag value
    }
    return [expr {$tag eq "value" ? $value : [lrange $value end-1 end]}]
}

# {UNIT STATUS ...} of HIR's module directness, for UNITS (all when empty).
proc statuses {hir {units {}}} {
    set result {}
    dict for {unit u} [dict get $hir direct units] {
        if {$units ne {} && $unit ni $units} continue
        lappend result $unit [dict get $u status]
    }
    return $result
}

# The NIR of DIR/MAIN.
proc appNir {dir {main main.bot}} {
    return [native::nir [appHir $dir $main]]
}

