# Interchange, cache, isolation

test cf-interchange {HIR interchange text carries everything a C call needs past the front end -- the declarations, contracts, link symbols, link plan, transports -- and its HIR, read back in a fresh process with no front end, lowers to the identical NIR and runs} -constraints cfFixture -body {
    set dir [bcfApp "${::bytesPrelude}src = text(\"hello\")\nr = bcf::reverse(src, len(src), std::abi::bytes::zeroed(std::abi::usize(5)))\n\[bcf::add(40, 2), std::abi::bytes::freeze(r.out) == text(\"olleh\")\]\n"]
    set hir [appHir $dir]
    set path [file join $dir main.hirx]
    hir::interchange::writeFile $path $hir
    set direct [native::nir $hir]
    set script [file join $dir read.tcl]
    set channel [open $script w]
    puts $channel "source [list [file join $::projectRoot native native.tcl]]\nset h \[hir::interchange::readFile [list $path]\]\nputs -nonewline \[native::nir \$h\]"
    close $channel
    set read [exec [info nameofexecutable] $script]
    list [expr {$read eq [string trimright $direct \n]}] [native::withLinkDirs [list $::fixtureDir] {
        lindex [outcomeUnderHir cranelift [hir::interchange::readFile $path]] 1
    }]
} -cleanup removeApps -result {1 {[42, true]}}

test cf-cache {the front-end cache keeps a program that calls C as its build (a hit runs identically), and a changed library name, link symbol, signature or contract of an imported binding module is a miss} -constraints cfFixture -body {
    set dir [bcfApp "import std::ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    set cache [makeDirectory cf-cache-[pid]]
    set path [file join $dir main.bot]
    set first [surface::readProgramFile $path -warnings off -cache $cache]
    set hit [surface::readProgramFile $path -warnings off -cache $cache]
    set misses {}
    foreach {from to} {
        {extern c library "botlish_cffi_fixture"} {extern c library "botlish_cffi_fixture2"}
        {named "bcf_add"} {named "bcf_add2"}
        {extern c fn add named "bcf_add"(a: std::ffi::c::Int, b: std::ffi::c::Int)} {extern c fn add named "bcf_add"(a: std::ffi::c::Long, b: std::ffi::c::Int)}
        {(p: std::ffi::c::Ptr[std::ffi::c::Void] noescape) -> std::ffi::c::Int} {(p: std::ffi::c::Ptr[std::ffi::c::Void] captures) -> std::ffi::c::Int}
    } {
        set channel [open [file join $dir bcf.bot] w]
        puts -nonewline $channel [string map [list $from $to] $::bcfModule]
        close $channel
        set changed [surface::readProgramFile $path -warnings off -cache $cache]
        lappend misses [expr {[dict get $changed foreign] ne [dict get $first foreign] || [dict get $changed links] ne [dict get $first links]}]
    }
    list [expr {[native::nir $hit] eq [native::nir $first]}] $misses \
        [native::withLinkDirs [list $::fixtureDir] {lindex [outcomeUnderHir cranelift $hit] 1}]
} -cleanup {removeApps; file delete -force [file join [temporaryDirectory] cf-cache-[pid]]} -result {1 {1 1 1 1} 42}

test cf-isolation {extern declarations, link plans and their natives are compilation-local: compiling another program (with other externs of the same names, or none) never changes an earlier HIR's lowering, and no later compilation links an earlier one's library} -constraints cfFixture -body {
    set a [bcfApp "import std::ffi::c\nimport bcf\n\nbcf::add(40, 2)\n"]
    set b [app [list main.bot "import std::ffi::c\nimport bcf\n\nbcf::add(1)\n" bcf.bot "import std::ffi::c\n\nextern c library \"other\"\nextern c fn add named \"other_add\"(a: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set c [app [list main.bot "1 + 1\n"]]
    set hirA [appHir $a]
    set nirA [native::nir $hirA]
    set hirB [appHir $b]
    set hirC [appHir $c]
    set nirC [native::nir $hirC]
    set registered [lsearch -all -inline -glob [core::native::names] extern#*]
    list [expr {[native::nir $hirA] eq $nirA}] [regexp {link|foreign} $nirC] \
        [lsearch -all -inline -regexp [split [native::nir $hirB] \n] {^(link|foreign) }] \
        $registered \
        [native::withLinkDirs [list $::fixtureDir] {lindex [outcomeUnderHir cranelift $hirA] 1}]
} -cleanup removeApps -result {1 0 {{link "other"} {foreign 0 "other_add" params="i32" result=i32 name="bcf::add"}} {} 42}

