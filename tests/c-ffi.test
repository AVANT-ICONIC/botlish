# ---------------------------------------------------------------------------
# static compile

test cf-static-compile {a static block diagnoses a C call like any call -- arity, a C scalar's range, a refused exposure, an unmediated retaining call -- as std::compiler::DiagnosticCode values; nothing is executed at compile time, and an accepted block is the ordinary call} -constraints cfFixture -body {
    set decls "extern c fn keep named \"bcf_keep\"(p: std::ffi::c::Ptr\[std::ffi::c::Void\] captures) -> unit\n"
    lmap {body code} {
        "bcf::add(1)" Arity
        "bcf::add(x, 2)" Type
        "bcf::keep(std::abi::bytes::from_list(std::str::encode_utf8(\"x\")))" ForeignBorrow
        "p = bcf::address()\n        bcf::keep(p)" Direct
        "bcf::add(1, 2)" Arity
    } {
        set dir [app [list main.bot "import std::abi\nimport std::abi::bytes\nimport std::compiler\nimport std::ffi::c\nimport std::str\nimport bcf\n\nfn probe(x: int) -> int errors std::compiler::CompilerError:\n    static compile:\n        $body\n        0\n\nr = probe(5):\n    on std::compiler::CompilerError {code}:\n        if code == std::compiler::DiagnosticCode::$code:\n            1\n        else:\n            2\nr\n" bcf.bot "${::bcfModule}${decls}"]]
        set v [lindex [appValues $dir {interp}] 0]
        expr {[llength $v] == 2 ? [lindex $v 0 end] : $v}
    }
} -cleanup removeApps -result {1 1 1 1 NATIVE-ONLY}

