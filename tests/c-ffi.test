} -cleanup removeApps -result [lrepeat 2 "\[-128, 127, 0, 255, [join $::cfCharRange {, }], -32768, 32767, 65535, -2147483648, 2147483647, 4294967295, -9223372036854775808, 9223372036854775807, 18446744073709551615, 4611686018427387904, -4611686018427387905, 18446744073709551615\]"]

