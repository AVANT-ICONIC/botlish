# direct

test cf-direct-noescape-ordinary {a foreign call is not direct by being foreign: a module whose C calls are all noescape (and pass and return raw pointers) is ordinary} -constraints cfFixture -body {
    set hir [appHir [bcfApp "import std::ffi::c\nimport bcf\n\nfn f() -> int:\n    p = bcf::address()\n    bcf::is_null(p)\n\nf()\n"]]
    statuses $hir {bcf ""}
} -cleanup removeApps -result {bcf ordinary {} ordinary}

test cf-direct-retaining {a call of a C function whose contract may keep a pointer (captures, or no escape fact: unknown) is an authority source: from a context-free function DIRECT, naming the function and the retaining parameter} -constraints cfFixture -body {
    lmap fn {keep keep_unknown} {
        appRejection [app [list main.bot "import std::ffi::c\nimport r\n\nfn f():\n    p = r::address()\n    r::$fn\(p)\n\nf()\n" r.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    }
} -cleanup removeApps -result {{DIRECT: main.bot:6:5: the entry program uses direct authority: function "f" calls r::keep, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape captures), without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "f", the function that makes the direct call, or declare the module direct with `direct module` as its first line} {DIRECT: main.bot:6:5: the entry program uses direct authority: function "f" calls r::keep_unknown, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape unknown), without a context defined by the entry program; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by the entry program) in "f", the function that makes the direct call, or declare the module direct with `direct module` as its first line}}

test cf-direct-contextualized {the retaining call from a function requiring a context the calling module declares is mediated: contextualized, and it runs} -constraints cfFixture -body {
    set dir [app [list main.bot "import std::ffi::c\nimport r\n\ncontext struct Keeper:\n    ok: bool\n\nfn f(context k: Keeper) -> int:\n    p = r::address()\n    r::keep(p)\n    1\n\nwith context Keeper {ok: true}\nf()\n" r.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    list [statuses [appHir $dir] {r ""}] [appValues $dir {cranelift}]
} -cleanup removeApps -result {{r ordinary {} contextualized} 1}

test cf-direct-declared {the same call in a `direct module` is a deliberate direct module, justified by it (not stale)} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport std::ffi::c\nimport r\n\np = r::address()\nr::keep(p)\n1\n" r.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
    list [statuses [appHir $dir] {r ""}] [appValues $dir {cranelift}]
} -cleanup removeApps -result {{r ordinary {} direct} 1}

test cf-direct-not-predesignated {declaring a retaining extern designates nothing: the declaring module is ordinary while it does not call it, stale if marked, and the authority is its caller's -- a call of it in its own module is an edge too} -constraints cfFixture -body {
    set decls "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"
    set marked [app [list main.bot "import r\n1\n" r.bot "direct module\n\n$decls"]]
    set own [app [list main.bot "import r\nr::wrap()\n" r.bot "${decls}\nfn wrap():\n    p = address()\n    keep(p)\n"]]
    list [lindex [split [appRejection $marked] :] 0] [appRejection $own]
} -cleanup removeApps -result {STALE-DIRECT-MODULE {DIRECT: r.bot:10:5: module "r" uses direct authority: function "r::wrap" calls r::keep, a C function whose contract lets it retain pointer authority past the call (parameter "p": escape captures), without a context defined by "r"; require one of this module's own contexts ("context NAME: T", T a context struct or context trait declared by "r") in "r::wrap", the function that makes the direct call, or declare the module direct with `direct module` as its first line}}

test cf-direct-two-modules-one-library {one C library, two Botlish modules: an ordinary one binding its noescape functions and a direct one binding its retaining function, both declaring the library; the capability boundary is the module, the link plan has the library once} -constraints cfFixture -body {
