    }
} -cleanup removeApps -result {TYPE TYPE TYPE}

# ---------------------------------------------------------------------------
# Linking

test cf-missing-library {a library the linker cannot find compiles through the front end and fails at the native link, with the linker's own words, as NATIVE LINK -- never an UNKNOWN-NAMESPACE, a TYPE or a HIR error} -constraints {nativeBuilt rustcLinker} -body {
    set dir [app [list main.bot "extern c library \"definitely_missing_botlish_lib\"\n1 + 1\n"]]
    set hir [appHir $dir]
    lassign [native::withLinkDirs {} {outcomeUnderHir cranelift $hir}] tag code message
    list [hir::foreign::links $hir] [outcomeUnderHir interp $hir] $code \
        [string match "native link failed: the system linker could not link this program with the C functions and libraries it declares (libraries -ldefinitely_missing_botlish_lib):*" $message] \
        [regexp {(cannot|unable to) find[^\n]*definitely_missing_botlish_lib|library '?definitely_missing_botlish_lib'? not found|library not found for -ldefinitely_missing_botlish_lib} $message]
} -cleanup removeApps -result {definitely_missing_botlish_lib {value 2 {}} {NATIVE LINK} 1 1}

test cf-undefined-symbol {a symbol no library defines is the linker's undefined symbol, reported as NATIVE LINK; an unused declaration needs no definition} -constraints cfFixture -body {
    set used [bcfApp "import std::ffi::c\nimport m\n\nm::nope(1)\n" [list m.bot "import std::ffi::c\n\nextern c fn nope named \"botlish_no_such_symbol\"(x: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set unused [bcfApp "import std::ffi::c\nimport m\nimport bcf\n\nbcf::add(1, 2)\n" [list m.bot "import std::ffi::c\n\nextern c fn nope named \"botlish_no_such_symbol\"(x: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    lassign [lindex [appValues $used {cranelift}] 0] code message
    list $code [regexp -nocase {undefined (symbol|reference).*botlish_no_such_symbol} $message] [appValues $unused {cranelift}]
} -cleanup removeApps -result {{NATIVE LINK} 1 3}

test cf-named-symbol {`named` changes exactly the link symbol: the Botlish name stays the declaration's; without it the symbol is the name} -constraints cfFixture -body {
    set lib "extern c library \"botlish_cffi_fixture\"\n"
    set renamed [bcfApp "import std::ffi::c\nimport m\n\nm::plus(40, 2)\n" [list m.bot "import std::ffi::c\n\n${lib}extern c fn plus named \"bcf_add\"(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set plain [bcfApp "import std::ffi::c\nimport m\n\nm::bcf_add(40, 2)\n" [list m.bot "import std::ffi::c\n\n${lib}extern c fn bcf_add(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    set unrenamed [bcfApp "import std::ffi::c\nimport m\n\nm::plus(40, 2)\n" [list m.bot "import std::ffi::c\n\n${lib}extern c fn plus(a: std::ffi::c::Int, b: std::ffi::c::Int) -> std::ffi::c::Int\n"]]
    list [appValues $renamed {cranelift}] [appValues $plain {cranelift}] [lindex [lindex [appValues $unrenamed {cranelift}] 0] 0]
} -cleanup removeApps -result {42 42 {NATIVE LINK}}

test cf-link-order {the declared libraries link as one group, so their order never decides a static link: an archive declared before the archive that needs it still resolves it} -constraints cfFixture -body {
