    set declares [bcfApp "import std::ffi::c\nimport bcf\n\n1 + 1\n"]
    list [lmap backend {interp compile} {lindex [appCode $calls $backend] end}] [appValues $declares {interp compile cranelift-generic cranelift}]
} -cleanup removeApps -result {{NATIVE-ONLY NATIVE-ONLY} {2 2 2 2}}

test cf-strict0-replay {an unchecked (-strict 0) program's refused exposure replays the refusal on every backend, the C call never made} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport std::abi\nimport std::abi::bytes\nimport std::ffi::c\nimport std::str\nimport r\n\nr::keep(std::abi::bytes::from_list(std::str::encode_utf8(\"x\")))\n" r.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\nextern c fn keep named \"bcf_keep\"(p: std::ffi::c::Ptr\[std::ffi::c::UChar\] read captures) -> unit\n"]]
    set hir [appHir $dir main.bot 0]
