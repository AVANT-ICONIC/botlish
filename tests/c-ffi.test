test cf-direct-summary {main.tcl -direct names a retaining C call among the edges} -constraints cfFixture -body {
    set dir [app [list main.bot "direct module\n\nimport std::ffi::c\nimport r\n\np = r::address()\nr::keep(p)\n1\n" r.bot "import std::ffi::c\n\nextern c library \"botlish_cffi_fixture\"\n$::retainingDecls"]]
