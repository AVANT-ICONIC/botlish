# c-ffi.test -- `extern c library` and `extern c fn`: real link-time C calls
# (C-FFI.md).
#
# An extern c fn is a truthful C ABI declaration with no body, carrying the
# foreign call contract every foreign call has (C-POINTER-BORROWING.md); an
# extern c library names a library of the program's link plan. The native
# backends link a program that calls C with the system linker and call the
# symbols directly with the platform C ABI; the Tcl backends refuse a C call
# at run time (NATIVE-ONLY).
#
# The C side of most tests is tests/cffi/fixture.c, compiled here with the
# host C compiler into a static archive in a private directory (test
# infrastructure only) and bound by the module text below. The Tcl and
# BoringSSL acceptance tests run examples/ffi/ against the installed
# libtcl9.0 and the package-owned static BoringSSL (tests/cffi/boringssl.tcl;
# skipped when it is not built). Every application is a fresh directory of
# the tcltest temporary directory.

source [file join [file dirname [file normalize [info script]]] helpers.tcl]
source [file join $::projectRoot surface surface.tcl]
source [file join $::projectRoot native native.tcl]
source [file join $::projectRoot tests cffi boringssl.tcl]

testConstraint nativeBuilt [expr {![catch {native::binary}]}]
testConstraint linuxNative [expr {$::tcl_platform(os) eq "Linux"
    && $::tcl_platform(machine) in {x86_64 amd64 aarch64 arm64}}]
testConstraint cCompiler [expr {[auto_execok cc] ne ""}]
testConstraint linuxX86_64 [expr {$::tcl_platform(os) eq "Linux" && $::tcl_platform(machine) in {x86_64 amd64}}]

set mainScript [file join $::projectRoot main.tcl]
set ::appCounter 0

# The fixture library: built once, in a private directory, when a C compiler
# is there.
set ::fixtureDir ""
if {[testConstraint cCompiler] && [testConstraint linuxNative]} {
    set ::fixtureDir [makeDirectory cffi-fixture-[pid]]
    if {[catch {
        exec cc -c -O2 -fPIC [file join $::projectRoot tests cffi fixture.c] -o [file join $::fixtureDir fixture.o]
        exec ar rcs [file join $::fixtureDir libbotlish_cffi_fixture.a] [file join $::fixtureDir fixture.o]
        # A second archive that depends on the first (cf-link-order).
        set channel [open [file join $::fixtureDir dependent.c] w]
        puts $channel "int bcf_add(int a, int b);\nint bcf_add_twice(int a, int b) { return 2 * bcf_add(a, b); }"
        close $channel
        exec cc -c -O2 -fPIC [file join $::fixtureDir dependent.c] -o [file join $::fixtureDir dependent.o]
        exec ar rcs [file join $::fixtureDir libbotlish_cffi_dependent.a] [file join $::fixtureDir dependent.o]
    } message]} {
        puts stderr "c-ffi.test: the fixture library did not build: $message"
        set ::fixtureDir ""
    }
}
testConstraint cfFixture [expr {$::fixtureDir ne "" && [testConstraint nativeBuilt] && [testConstraint rustcLinker]}]
# libtcl9.0, as the Tcl acceptance links it: a probe link with the host's
# linker driver.
proc tclLinkable {} {
    if {![testConstraint cCompiler]} {
        return 0
    }
    set dir [makeDirectory cffi-tclprobe-[pid]]
    set src [file join $dir probe.c]
    set channel [open $src w]
    puts $channel "void *Tcl_CreateInterp(void);\nint main(void) { return Tcl_CreateInterp() == 0; }"
    close $channel
    set ok [expr {![catch {exec cc $src -o [file join $dir probe] -ltcl9.0}]}]
    file delete -force $dir
    return $ok
}
testConstraint tclLibrary [expr {[testConstraint nativeBuilt] && [testConstraint rustcLinker] && [tclLinkable]}]
testConstraint boringssl [expr {[testConstraint nativeBuilt] && [testConstraint rustcLinker] && [cffi::boringsslDir] ne ""}]

# A fresh application directory holding FILES ({RELATIVE-PATH TEXT ...}): its
# absolute path.
proc app {files} {
    set dir [makeDirectory cf-app-[pid]-[incr ::appCounter]]
    foreach {relative text} $files {
        set path [file join $dir {*}[file split $relative]]
        file mkdir [file dirname $path]
        set channel [open $path w]
        fconfigure $channel -encoding utf-8 -translation lf
        puts -nonewline $channel $text
        close $channel
    }
    return $dir
}

proc removeApps {} {
    foreach dir [glob -nocomplain -directory [temporaryDirectory] cf-app-[pid]-*] {
        file delete -force $dir
    }
}

# The HIR of DIR/MAIN (strict unless STRICT is 0).
proc appHir {dir {main main.bot} {strict 1}} {
    return [surface::readProgramFile [file join $dir $main] -warnings off -cache "" -strict $strict]
}

# "KIND: MESSAGE" of the compilation of DIR/MAIN, with DIR spelled away, or
# accepted.
proc appRejection {dir {main main.bot}} {
    if {[catch {appHir $dir $main} message options]} {
        set kind [lindex [dict get $options -errorcode] end]
        return "$kind: [string map [list $dir/ ""] $message]"
    }
    return accepted
}

# The value of DIR/MAIN on each of BACKENDS (with the fixture's directory on
# the linker's search path), or the backend's error: {CODE MESSAGE} with DIR
# spelled away.
proc appValues {dir backends {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [list $::fixtureDir] {
        lmap backend $backends {
            lassign [outcomeUnderHir $backend $hir] tag value message
            expr {$tag eq "value" ? $value : [list [lrange $value end-1 end] [string map [list $dir/ ""] $message]]}
        }
    }
}

# The error code's last words of DIR/MAIN on BACKEND, or its value.
proc appCode {dir backend {main main.bot}} {
    set hir [appHir $dir $main]
    native::withLinkDirs [list $::fixtureDir] {
        lassign [outcomeUnderHir $backend $hir] tag value
    }
    return [expr {$tag eq "value" ? $value : [lrange $value end-1 end]}]
}

# {UNIT STATUS ...} of HIR's module directness, for UNITS (all when empty).
proc statuses {hir {units {}}} {
    set result {}
    dict for {unit u} [dict get $hir direct units] {
        if {$units ne {} && $unit ni $units} continue
        lappend result $unit [dict get $u status]
    }
    return $result
}

# The NIR of DIR/MAIN.
proc appNir {dir {main main.bot}} {
    return [native::nir [appHir $dir $main]]
}

# The fixture's binding module (an application module `bcf`).
set bcfModule {import ffi::c

extern c library "botlish_cffi_fixture"

extern c fn echo_schar named "bcf_echo_schar"(x: ffi::c::SChar) -> ffi::c::SChar
extern c fn echo_uchar named "bcf_echo_uchar"(x: ffi::c::UChar) -> ffi::c::UChar
extern c fn echo_char named "bcf_echo_char"(x: ffi::c::Char) -> ffi::c::Char
extern c fn echo_short named "bcf_echo_short"(x: ffi::c::Short) -> ffi::c::Short
extern c fn echo_ushort named "bcf_echo_ushort"(x: ffi::c::UShort) -> ffi::c::UShort
extern c fn echo_int named "bcf_echo_int"(x: ffi::c::Int) -> ffi::c::Int
extern c fn echo_uint named "bcf_echo_uint"(x: ffi::c::UInt) -> ffi::c::UInt
extern c fn echo_long named "bcf_echo_long"(x: ffi::c::Long) -> ffi::c::Long
extern c fn echo_ulong named "bcf_echo_ulong"(x: ffi::c::ULong) -> ffi::c::ULong
extern c fn echo_longlong named "bcf_echo_longlong"(x: ffi::c::LongLong) -> ffi::c::LongLong
extern c fn echo_ulonglong named "bcf_echo_ulonglong"(x: ffi::c::ULongLong) -> ffi::c::ULongLong
extern c fn widen_schar named "bcf_widen_schar"(x: ffi::c::SChar) -> ffi::c::Long
extern c fn widen_uchar named "bcf_widen_uchar"(x: ffi::c::UChar) -> ffi::c::Long
extern c fn widen_short named "bcf_widen_short"(x: ffi::c::Short) -> ffi::c::Long
extern c fn widen_ushort named "bcf_widen_ushort"(x: ffi::c::UShort) -> ffi::c::Long
extern c fn widen_int named "bcf_widen_int"(x: ffi::c::Int) -> ffi::c::LongLong
extern c fn widen_uint named "bcf_widen_uint"(x: ffi::c::UInt) -> ffi::c::ULongLong
extern c fn add named "bcf_add"(a: ffi::c::Int, b: ffi::c::Int) -> ffi::c::Int
extern c fn many named "bcf_many"(a: ffi::c::Long, b: ffi::c::Int, c: ffi::c::Short, d: ffi::c::SChar, e: ffi::c::UChar, f: ffi::c::UShort, g: ffi::c::UInt, h: ffi::c::ULong, i: ffi::c::Long, j: ffi::c::Int) -> ffi::c::LongLong
extern c fn tenth named "bcf_tenth"(a: ffi::c::Int, b: ffi::c::Int, c: ffi::c::Int, d: ffi::c::Int, e: ffi::c::Int, f: ffi::c::Int, g: ffi::c::Int, h: ffi::c::Int, i: ffi::c::Int, j: ffi::c::Int) -> ffi::c::Int
extern c fn nothing named "bcf_nothing"() -> unit
extern c fn dirty_uchar named "bcf_dirty_uchar"() -> ffi::c::UChar
extern c fn dirty_schar named "bcf_dirty_schar"() -> ffi::c::SChar
extern c fn dirty_ushort named "bcf_dirty_ushort"() -> ffi::c::UShort
extern c fn dirty_short named "bcf_dirty_short"() -> ffi::c::Short
extern c fn dirty_uint named "bcf_dirty_uint"() -> ffi::c::UInt
extern c fn dirty_int named "bcf_dirty_int"() -> ffi::c::Int
extern c fn address named "bcf_address"() -> ffi::c::Ptr[ffi::c::Void] independent
extern c fn null named "bcf_null"() -> ffi::c::Ptr[ffi::c::Void] independent
extern c fn is_null named "bcf_is_null"(p: ffi::c::Ptr[ffi::c::Void] noescape) -> ffi::c::Int
extern c fn echo_ptr named "bcf_echo_ptr"(p: ffi::c::Ptr[ffi::c::Void] noescape) -> ffi::c::Ptr[ffi::c::Void] alias p
extern c fn same named "bcf_same"(a: ffi::c::Ptr[ffi::c::Void] noescape, b: ffi::c::Ptr[ffi::c::Void] noescape) -> ffi::c::Int
extern c fn wild named "bcf_wild"() -> ffi::c::Ptr[ffi::c::Void]
extern c fn sum named "bcf_sum"(data: ffi::c::Ptr[ffi::c::UChar] read noescape, count: ffi::c::ULong) -> ffi::c::ULong
extern c fn sum_proven named "bcf_sum"(data: ffi::c::Ptr[ffi::c::UChar] read proven noescape, count: ffi::c::ULong) -> ffi::c::ULong
extern c fn fill named "bcf_fill"(out: ffi::c::Ptr[ffi::c::UChar] write noescape, count: ffi::c::ULong, seed: ffi::c::UChar) -> unit
extern c fn reverse named "bcf_reverse"(data: ffi::c::Ptr[ffi::c::UChar] read noescape, count: ffi::c::ULong, out: ffi::c::Ptr[ffi::c::UChar] write noescape) -> ffi::c::Ptr[ffi::c::UChar] alias out
extern c fn reverse_off named "bcf_reverse_off"(data: ffi::c::Ptr[ffi::c::UChar] read noescape, count: ffi::c::ULong, out: ffi::c::Ptr[ffi::c::UChar] write noescape) -> ffi::c::Ptr[ffi::c::UChar] alias out
extern c fn find named "bcf_find"(data: ffi::c::Ptr[ffi::c::UChar] read noescape, count: ffi::c::ULong, byte: ffi::c::UChar) -> ffi::c::Ptr[ffi::c::UChar]
extern c fn next named "bcf_next"(p: ffi::c::Ptr[ffi::c::UChar] noescape) -> ffi::c::Ptr[ffi::c::UChar] alias p
extern c fn callback_twice named "bcf_callback_twice"() -> ffi::c::FnPtr[Fn{args: [ffi::c::Int], return: ffi::c::Int}]
